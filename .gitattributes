/**/zscript/*.zc	linguist-language=C#
/**/zscript/**/.zc	linguist-language=C#
/**/zscript/**/*.zsc	linguist-language=C#

# Preserve raw engine validation logs, including engine-emitted whitespace.
tools/validation/**/*.log -text -whitespace

# Keep this acceptance snapshot byte-identical to its SHA-256 manifest.
tools/validation/second-pass-2026-09-06/** -text -whitespace
tools/validation/boss-hud-2026-09-07/** -text -whitespace
tools/validation/palette-restore-2026-09-07/** -text -whitespace

# Doom image data contains raw palette indices, never text.
/tutnt/**/*.lmp binary

# Generated native-font data must remain reproducible on Windows and Linux.
/tutnt/fonts/**/font.inf text eol=lf
/tools/font-glyphs.json text eol=lf
/tools/font-sources/*.fon2 binary
/tools/font-sources/*.pal binary

# Skyline generators compare exact output bytes on all build hosts.
/tools/sky-edges-*.json text eol=lf
/tutnt/models/sky-edges/*.obj text eol=lf
/tutnt/skyedges/*.txt text eol=lf
/tutnt/shaders/sky-edges/*.fp text eol=lf
/tutnt/gldefs/GLDEFS.sky-edges text eol=lf
/tutnt/modeldef/MODELDEF.sky-edges text eol=lf
/tutnt/textures/definitions/TEXTURES.sky-edges text eol=lf
/tutnt/zscript/sky-edges-generated.zc text eol=lf
