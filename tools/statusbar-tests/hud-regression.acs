#library "UTHUDREG"
#include "zcommon.acs"
#import "tutnt.acs"

function void verify(int condition, str message)
{
    Log(s:"UTNT_ASSERT ",s:condition ? "PASS: " : "FAIL: ",s:message);
}

script "UTNT_HUDRegression" OPEN
{
    if(GetLevelInfo(LEVELINFO_LEVELNUM)!=90) terminate;
    Delay(20);
    verify(UTNT_KillPercent==100 && UTNT_ItemPercent==100 && UTNT_SecretPercent==100,
        "empty map has complete percentages without division by zero");
    verify(UTNT_KillsLeft==0 && UTNT_ItemsLeft==0 && UTNT_SecretsLeft==0,
        "empty map has no remaining objectives");
    verify(UTNT_StatPercent(1,3)==33 && UTNT_StatRemaining(1,3)==2,
        "partial completion uses integer percent and remaining count");
    verify(UTNT_StatPercent(7,3)==100 && UTNT_StatRemaining(7,3)==0,
        "resurrection or over-count cannot yield negative remaining objectives");
    for(int i=0;i<3;i++) SpawnForced("UTNTHUDTestMonster",300.0,200.0+i*40.0,0.0,31001+i,0);
    Delay(12);
    verify(UTNT_KillPercent==0 && UTNT_KillsLeft==3,"newly spawned monsters refresh live statistics");
    Thing_Damage2(31001,100,"Normal");
    Delay(12);
    verify(UTNT_KillPercent==33 && UTNT_KillsLeft==2,"one kill refreshes percentage and remaining count");
    Thing_Damage2(31002,100,"Normal");
    Thing_Damage2(31003,100,"Normal");
    Delay(12);
    verify(UTNT_KillPercent==100 && UTNT_KillsLeft==0,"all kills reach completion");
    Log(s:"UTNT_HUD_STATS_COMPLETE");
}

script "UTNT_HUDCheckStats" (void)
{
    int total=GetLevelInfo(LEVELINFO_TOTAL_MONSTERS);
    int found=GetLevelInfo(LEVELINFO_KILLED_MONSTERS);
    verify(UTNT_KillPercent==UTNT_StatPercent(found,total) && UTNT_KillsLeft==UTNT_StatRemaining(found,total),
        "current map counters survive load or map change");
}
