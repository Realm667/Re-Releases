version "5.0"
class UTNTSourceTests : EventHandler
{
 int View, FXStamp, FXExpected, InwardSteps;
 double LastOrbit;
 ui int LastFXStamp;
 UTNTSourceBase RenderSource;
 Actor Fallback;
 override void RenderOverlay(RenderEvent e)
 {
  if(FXStamp==0)LastFXStamp=0;
  if(FXStamp>0 && FXStamp!=LastFXStamp)
  {
   LastFXStamp=FXStamp;
   double amount=UTNTSourceImpactView.Render(e);
   Console.Printf("UTNT_ASSERT %s: Source impact shader expected=%d amount=%.4f",(amount>0.001)==(FXExpected!=0)?"PASS":"FAIL",FXExpected,amount);
  }
  if(RenderSource && RenderSource.Health>0 && !RenderSource.ShieldOpen && level.time>=450 && level.time<490)
   Console.Printf("SOURCE_RENDER_ALPHA %.4f",level.lines[RenderSource.ShieldLines[0]].alpha);
 }
 void Assert(bool cond,String name){Console.Printf("UTNT_ASSERT %s: %s",cond?"PASS":"FAIL",name);}
 override void WorldTick()
 {
  if(!(level.MapName~=="TNT04CN"))return;
  RenderSource=UTNTSourceSystem.Find();
  if(RenderSource && RenderSource.DefeatAge>=90 && RenderSource.DefeatAge<150)
  {
   let iter=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
   let emitter=UTNTSourceEmitter(iter.Next());
   if(emitter && emitter.Layers.Size()==72)
   {
    double orbit=(emitter.Layers[44].Pos-emitter.Center).Length();
    if(LastOrbit>orbit+0.1)InwardSteps++;
    LastOrbit=orbit;
   }
  }
  for(int i=0;i<MAXPLAYERS;i++)if(players[i].mo){players[i].mo.bInvulnerable=true;players[i].mo.bNotarget=true;}
  let p=players[0].mo;if(!p || level.time<5)return;
  p.bInvulnerable=true;p.bNotarget=true;p.bNoGravity=true;p.bNoClip=true;
  players[0].camera=p;
  Vector3 pos=(128,-1100,3500);double a=90,pitch=-15;
  if(View==3)pitch=-22;
  if(View==6){pos=(128,-1000,3370);pitch=-52;}
  if(View==7){pos=(10624,-700,5000);a=90;pitch=-60;}
  if(View==5)a=270;
  if(View==4){pos=(128,-1100,3500);pitch=-35;}
  if(View==1){pos=(128,-1650,3370);pitch=-14;}
  if(View==2){pos=(1150,-380,3500);a=180;pitch=-15;}
  p.SetOrigin(pos,false);p.Vel=(0,0,0);p.Angle=a;p.Pitch=pitch;
 }
 override void NetworkProcess(ConsoleEvent e)
 {
  let s=UTNTSourceSystem.Find();
  if(e.Name=="sourcefallback" && !(level.MapName~=="TNT04CN"))
  {
   Fallback=Actor.Spawn("TheSource",players[0].mo.Pos+(100,0,100));
   if(Fallback)Fallback.DamageMobj(players[0].mo,players[0].mo,100000,'None',DMG_FORCED);
  }
  if(e.Name=="sourcefallbackcheck")
  {
   Assert(Fallback && Fallback.Health<=0,"Source fallback test actor is defeated");
   Assert(Fallback && Fallback.sprite==Actor.GetSpriteIndex("SOUR") && Fallback.Alpha>0 && Fallback.Alpha<1,"other maps retain the original visible Source death fade");
  }
  if(e.Name=="sourceenergycheck")
  {
   let it=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
   let em=UTNTSourceEmitter(it.Next());
   Assert(em && em.Layers.Size()==72 && em.WallLights.Size()==8,"beam ornament adds no visual thinkers or light anchors");
   if(em)
   {
    bool masks=em.Ceiling.Size()==8;
    for(int i=0;i<em.Ceiling.Size();i++)masks=masks && em.Ceiling[i].Alpha<1 && em.Ceiling[i].Alpha>.99;
    Assert(masks,"ceiling shader silhouettes retain translucent rendering after load");
   }
  }
  if(e.Name=="sourcematerialcheck")
  {
   int w,h;TextureID tex=TexMan.CheckForTexture("graphics/source-beam/state28.png");[w,h]=TexMan.GetSize(tex);
   Assert(w==1 && h==1,"beam state carrier is a single texel");
   tex=TexMan.CheckForTexture("USB028");Vector2 size=TexMan.GetScaledSize(tex);Assert(abs(size.X-768)<.01 && abs(size.Y-64)<.01,"beam core retains original logical dimensions");
   tex=TexMan.CheckForTexture("USB128");size=TexMan.GetScaledSize(tex);
   Assert(abs(size.X-1500)<.01 && abs(size.Y-512)<.01,"helix retains original logical dimensions");
   tex=TexMan.CheckForTexture("graphics/source-beam/opaque.png");[w,h]=TexMan.GetSize(tex);
   tex=TexMan.CheckForTexture("USVDA0");size=TexMan.GetScaledSize(tex);
   Assert(w==2 && h==2 && size.X==512 && size.Y==512,"singularity carrier is tiny with full logical sprite size");
   let boss=UTNTSourceSystem.Find();
   if(boss && boss.DefeatAge>=158)
   {
    bool gone=true;for(int i=0;i<boss.BeamSides.Size();i++)gone=gone && level.sides[boss.BeamSides[i]].GetTexture(Side.mid)==TexMan.CheckForTexture("-");
    Assert(gone,"spent beam geometry has no zero-output material to render");
   }
  }
  if(e.Name=="sourceimplosioncheck")
  {
   let iter=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
   let em=UTNTSourceEmitter(iter.Next());
   Assert(em && em.Layers.Size()==72,"bounded implosion pool exists");
   if(em)
   {
    if(e.Args[0]<=2)
    {
     Assert(em.Layers[68].Alpha>0.9 && em.Layers[68].Scale.X>0.3,"opaque singularity remains visible during inward pull");
     Assert(InwardSteps>=(e.Args[0]==0?1:5),"rune radius decreases over successive visual updates including restore");
     Assert(em.Layers[44].Alpha>0 && (em.Layers[44].Pos-em.Center).Length()<410,"native rune detached and drawn inward");
    }
    if(e.Args[0]==3)
    {
     Assert(em.Layers[68].Alpha==0 && em.Layers[70].Alpha>0,"black core collapses to a light flash");
     Assert(em.Source.LastBeamState==2,"both beam halves are gone at the collapse");
     bool consumed=true;for(int i=44;i<68;i++)consumed=consumed && em.Layers[i].Alpha==0;
     Assert(consumed,"all orbiting glyphs and trails are consumed at collapse");
    }
    if(e.Args[0]==4)
    {
     bool clear=true;for(int i=0;i<em.Layers.Size();i++)clear=clear && em.Layers[i].Alpha==0;
     Assert(clear,"the centre is empty after the implosion tail");
    }
    Console.Printf("SOURCE_IMPLOSION age=%d inward=%d core=%.3f flash=%.3f",em.DeadAge,InwardSteps,em.Layers[68].Alpha,em.Layers[70].Alpha);
   }
  }
  if(e.Name=="sourcefxreset")FXStamp=0; // Do not save pending render assertions.
  if(e.Name=="sourcefxcheck")
  {
   FXStamp=level.time;FXExpected=e.Args[0];
   let it=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
   let em=UTNTSourceEmitter(it.Next());
   if(em && e.Args[1]>=0)
   {
    int visible=0;bool travelling=true;
    for(int i=44;i<68;i++)if(em.Layers[i].Alpha>0.001)
    {visible++;travelling=travelling && (em.Layers[i].Pos-em.Center).Length()>45;}
    Assert((visible>0)==(e.Args[1]>0),"inward particles obey collapse and quality settings");
    if(visible)Assert(travelling,"detached runes and light remain in flight before collapse");
    Console.Printf("SOURCE_IMPACT age=%d particles=%d quality=%d reduced=%d",em.DeadAge,visible,em.Quality,em.Reduced);
   }
  }
  if(e.Name=="sourceview")View=e.Args[0];
  if(e.Name=="sourcebegin")ACS_ExecuteAlways(140,0);
  if(e.Name=="sourceexitcheck")
  {
   Assert(!(level.MapName~=="TNT04CN"),"real BOSSHP ending advances after finale and stillness");
   Assert(!s,"Source clock is absent in the destination map");
  }
  if(e.Name=="sourcedeathcheck")
  {
   Assert(s!=null,"dead original actor retains the saved finale clock");if(!s)return;
   Assert(s.Health<=0 && s.DefeatAge>=e.Args[0] && s.DefeatAge<=e.Args[1],"authoritative finale age in expected interval");
   Assert(!s.bShootable && !s.bSolid,"defeated sigil cannot obstruct or receive damage");
   let it=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
   int count=0;UTNTSourceEmitter em;
   while(em=UTNTSourceEmitter(it.Next()))
   {
    count++;Assert(abs(em.DeadAge-s.DefeatAge)<=1,"client finale follows saved world clock");
    Assert(em.Ceiling.Size()==8 && em.WallLights.Size()==8,"bounded overhead slabs and room lights");
    Assert(em.Layers.Size()==72,"bounded finale layer pool after restore");
    if(s.DefeatAge<70)Assert(em.Layers[0].Scale.X>1.2,"sigil remains full size before severance");
    if(s.DefeatAge>=245)
    {bool clear=true;for(int i=0;i<em.Layers.Size();i++)clear=clear && em.Layers[i].Alpha==0;Assert(clear,"empty centre after the seven-second finale");}
   }
   Assert(count==1,"one finale emitter after restore");
   Assert(s.LastBeamState==(s.DefeatAge<35?3:s.DefeatAge<70?4:s.DefeatAge<158?5+(s.DefeatAge-70)*24/88:2),"beam severance follows finale phase");
   Console.Printf("SOURCE_DEATH age=%d beam=%d map=%s",s.DefeatAge,s.LastBeamState,level.MapName);
  }
  if(e.Name=="sourcecheck")
  {
   if(!(level.MapName~=="TNT04CN"))
   {
    Assert(!s,"other map has no Source controller");
    let it=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
    Assert(!it.Next(),"other map has no Source visual emitter");return;
   }
   Assert(s!=null,"original TID 666 Source exists");if(!s)return;
   Assert(s.Health==e.Args[0],"boss hit points preserved");
   Assert(s.ShieldOpen==(e.Args[1]!=0),"visual matches actual shield collision");
   Assert(s.Radius==128 && s.Height==128,"original hitbox preserved");
   Assert(s.ShieldLines.Size()>0 && s.BeamSides.Size()>0,"original geometry bound");
   let shield=level.lines[s.ShieldLines[0]].sidedef[0];
   Assert(shield.GetTexture(Side.mid)==TexMan.CheckForTexture(s.ShieldOpen?"-":"USSHIELD"),"shield material agrees with collision even during ACS fade");
   Assert(s.ShieldOpen || abs(level.lines[s.ShieldLines[0]].alpha-0.70)<0.001,"legacy ACS cannot hide the closed membrane");
   Assert(level.sectors.Size()==1560,"sector count unchanged");
   int count=0;let it=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
   UTNTSourceEmitter em;
   while(em=UTNTSourceEmitter(it.Next()))
   {
    count++;Assert(em.Layers.Size()==72,"72 bounded presentation layers including finale");
    bool ceilingOK=em.Ceiling.Size()==8;
    for(int k=0;k<em.Ceiling.Size();k++)
     ceilingOK=ceilingOK && abs(em.Ceiling[k].Angle-(k*45+22.5))<0.1 && em.Ceiling[k].bFlatSprite;
    Assert(ceilingOK,"eight ceiling sectors have distinct world orientations");
    bool roles=em.Layers.Size()==72;
    for(int i=0;i<em.Layers.Size();i++)roles=roles && em.Layers[i].Kind==i;
    Assert(roles,"distinct shield, target and attack layers");
   }
   Assert(count==1,"single local emitter after save/load");
   Vector3 center=s.Center();
   Console.Printf("SOURCE_CEILING %.1f",s.GetZAt(0,0,0,GZF_CEILING|GZF_NO3DFLOOR));
   Console.Printf("SOURCE_POS %.1f %.1f %.1f CENTERZ %.1f SIDES %d SHIELD %d",s.Pos.X,s.Pos.Y,s.Pos.Z,center.Z,s.BeamSides.Size(),s.ShieldLines.Size());
  }
  if(!s)return;
  if(e.Name=="sourceattackcheck")Assert(s.AttackKind==e.Args[0] && level.time-s.AttackStart<110,"real ACS attack drives its announcement");
  if(e.Name=="sourcekill")s.DamageMobj(players[0].mo,players[0].mo,100000,'None',DMG_FORCED);
  if(e.Name=="sourcehp")s.Health=e.Args[0];
  if(e.Name=="sourceattack")ACS_ExecuteAlways(129+e.Args[0],0);
  if(e.Name=="sourcehit")ACS_ExecuteAlways(120,0);
  if(e.Name=="sourceguardian")
  {
   let g=level.CreateActorIterator(667).Next();
   if(g)g.DamageMobj(players[0].mo,players[0].mo,100000,'None',DMG_FORCED);
  }
  if(e.Name=="sourceshield")ACS_ExecuteAlways(122,0);
 }
}
