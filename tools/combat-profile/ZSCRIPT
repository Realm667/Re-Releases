version "5.0.0"
// Fixed-seed, scripted combat workload within each original map's geometry.
class UTNTCombatProfile : EventHandler
{
    override void WorldTick()
    {
        let p=players[0].mo;
        if (!p) return;
        if (level.time==5)
        {
            p.bInvulnerable=true;
            p.player.cheats&=~CF_TOTALLYFROZEN;
            UTNTWorldHandler.SetCutscene(p,false);
            p.ACS_NamedTerminate("IntroText",0);
            p.GiveInventory('UTNTSuperShotgun',1);p.GiveInventory('Shell',400);
            p.player.PendingWeapon=Weapon(p.FindInventory('UTNTSuperShotgun'));
        }
        if (level.time>=70 && level.time<=560 && level.time%35==0)
        {
            p.GiveInventory('Shell',100);
            // Nearby collision-checked targets keep gore and impacts represented.
            for(int j=-1;j<=1;j++)
            {
                Vector3 point=p.Vec3Angle(240,p.Angle+j*15,0);
                let victim=Actor.Spawn('DoomImp',point);
                if (victim && !victim.TestMobjLocation()) victim.Destroy();
            }
        }
        if (level.time==580)
        {
            int actors=0,visuals=0;
            let it=ThinkerIterator.Create('Actor');while(it.Next()) actors++;
            let cs=ThinkerIterator.Create('VisualThinker',Thinker.MAX_STATNUM+1,true);while(cs.Next()) visuals++;
            Console.Printf("UTNT_COMBAT_COUNTS actors=%d visuals=%d kills=%d",actors,visuals,level.killed_monsters);
        }
    }
}
class UTNTFrameSamples : StaticEventHandler
{
    ui Array<double> Frames;
    ui double PreviousTime;
    ui bool Finished;
    override void RenderOverlay(RenderEvent e)
    {
        double now=MSTimeF();
        if(level.time>=140 && level.time<560 && PreviousTime>0) Frames.Push(now-PreviousTime);
        PreviousTime=now;
        if(level.time>=560 && !Finished)
        {
            Finished=true;
            String samples="";
            for(int i=0;i<Frames.Size();i++) samples=samples..String.Format(i ? ",%.4f" : "%.4f",Frames[i]);
            Console.Printf("UTNT_FRAME_MS %s",samples);
        }
    }
}
