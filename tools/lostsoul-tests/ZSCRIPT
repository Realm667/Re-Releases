version "5.0.0"
class UTNTLostSoulTest : EventHandler
{
    Actor Soul, Other;
    override void WorldTick()
    {
        if (level.time!=2) return;
        let p=players[0].mo;
        p.ACS_NamedTerminate("IntroText",0);
        p.SetOrigin((0,-180,0),false); p.Angle=90; p.Pitch=0;
        p.bInvulnerable=true; p.player.cheats|=CF_NOTARGET;
        Soul=Actor.Spawn('LostSoul',(0,0,30),ALLOW_REPLACE);
        Other=Actor.Spawn('Terror',(100,0,30));
        Soul.Angle=Other.Angle=270;
    }
    override void NetworkProcess(ConsoleEvent e)
    {
        if(e.Name=="soulterror")
        {
            let previous=Soul; Soul=Other; Other=previous;
            Soul.SetOrigin((0,0,30),false); Other.SetOrigin((100,0,30),false);
        }
        if(e.Name=="soulangle") Soul.Angle=e.Args[0];
        if(e.Name=="soulview")
        {
            players[0].mo.SetOrigin((0,-110,12),false);
            players[0].mo.Pitch=0;
        }
        if(e.Name=="soulgeometry")
        {
            double facing=Soul.Angle;
            for(int i=0;i<4;i++)
            {
                Soul.Angle=i*90;
                bool valid=true;
                for(int n=0;n<16;n++)
                {
                    let chip=UTNTLostSoulEmber(level.SpawnClientSideVisualThinker('UTNTLostSoulEmber'));
                    chip.Initialize(Soul);
                    Vector3 offset=chip.Pos-Soul.Pos;
                    double rear=-offset.X*cos(Soul.Angle)-offset.Y*sin(Soul.Angle);
                    double side=-offset.X*sin(Soul.Angle)+offset.Y*cos(Soul.Angle);
                    if(rear<Soul.Radius*0.54 || rear>Soul.Radius*0.86
                        || abs(side)>Soul.Radius*0.51 || offset.Z<Soul.Height*0.47
                        || offset.Z>Soul.Height*0.69 || chip.Vel.Z<0.15 || chip.Vel.Z>0.39
                        || !chip.Texture.IsValid() || chip.Alpha!=1) valid=false;
                    chip.Destroy();
                }
                Console.Printf("UTNT_ASSERT %s rear flame origin facing=%d",valid ? "PASS" : "FAIL",i*90);
            }
            Soul.Angle=facing;
        }
        if(e.Name=="soulmove")
        {
            Soul.bDormant=false; Soul.SetOrigin((0,0,30),false);
            Soul.target=players[0].mo;
            if(e.Args[0]==1) Soul.SetStateLabel("See"); else Soul.SetStateLabel("Missile");
        }
        if(e.Name=="soulkill" && Soul) Soul.DamageMobj(null,null,10000,'None');
    }
    override void ConsoleProcess(ConsoleEvent e)
    {
        if(e.Name!="soulcheck") return;
        int count=0,invalid=0,foreign=0,young=0;
        let it=ThinkerIterator.Create('UTNTLostSoulEmber',Thinker.MAX_STATNUM+1,true);
        UTNTLostSoulEmber p;
        while(p=UTNTLostSoulEmber(it.Next()))
        {
            if(p.Source!=Soul && p.Source!=Other) continue;
            string expected=p.Source is "Terror" ? "UTRE" : "ULSE";
            if(!(TexMan.GetName(p.Texture).Left(4)~==expected) || (p.Flags & SPF_ALLOWSHADERS)
                || p.Life<16 || p.Life>24 || p.Age>=p.Life || p.Alpha<=0) invalid++;
            if(p.Source==Other) { foreign++; continue; }
            count++; if(p.Age<16) young++;
        }
        bool expect=e.Args[0]!=0;
        Console.Printf("UTNT_ASSERT %s soul sparks count=%d young=%d invalid=%d companion=%d",
            (expect ? count>0 && young>0 : count==0) && invalid==0 ? "PASS" : "FAIL",
            count,young,invalid,foreign);
        if(Soul) Console.Printf("SOUL_STATE pos=(%.1f,%.1f,%.1f) velocity=(%.1f,%.1f,%.1f) hp=%d skullfly=%d",
            Soul.Pos.X,Soul.Pos.Y,Soul.Pos.Z,Soul.Vel.X,Soul.Vel.Y,Soul.Vel.Z,Soul.Health,Soul.bSkullFly);
    }
}
