class RockRolloutChecks : EventHandler
{
 int Bad; int Count;
 void Check(int index,int tier,String name,double x,double anchor)
 {
  Count++; let s=level.Sides[index];let l=s.linedef;let f=s.sector;
  let b=l.frontsector==f?l.backsector:l.frontsector;
  double ref;
  if(tier==Side.mid)ref=(l.flags&Line.ML_DONTPEGBOTTOM)?f.GetPlaneTexZ(Sector.floor)+1024:f.GetPlaneTexZ(Sector.ceiling);
  else if(tier==Side.top)ref=(l.flags&Line.ML_DONTPEGTOP)?f.GetPlaneTexZ(Sector.ceiling):b.GetPlaneTexZ(Sector.ceiling)+1024;
  else {
   ref=b.GetPlaneTexZ(Sector.floor);
   if(l.flags&Line.ML_DONTPEGBOTTOM){
    bool sky=TexMan.GetName(f.GetTexture(Sector.ceiling))=="F_SKY1"&&TexMan.GetName(b.GetTexture(Sector.ceiling))=="F_SKY1";
    ref=(sky?b.GetPlaneTexZ(Sector.ceiling):f.GetPlaneTexZ(Sector.ceiling))+1024;
   }
  }
  if(TexMan.GetName(s.GetTexture(tier))!=name||abs(s.GetTextureXOffset(tier)-x)>0.001||abs(ref+s.GetTextureYOffset(tier)-anchor)>0.001||abs(s.GetTextureXScale(tier)-1)>0.001||abs(s.GetTextureYScale(tier)-1)>0.001){
   Bad++;if(Bad<12)Console.Printf("Mapping mismatch side=%d tier=%d texture=%s X=%f Yref=%f expected=%f",index,tier,TexMan.GetName(s.GetTexture(tier)),s.GetTextureXOffset(tier),ref+s.GetTextureYOffset(tier),anchor);
  }
 }
 override void NetworkProcess(ConsoleEvent e)
 {
  if(e.Name!="rockcheck")return;
  Bad=0;Count=0;
  {let t=TexMan.CheckForTexture("QROCK1X8"); Vector2 sz=TexMan.GetScaledSize(t);if(abs(sz.X-1024)>0.001||abs(sz.Y-1024)>0.001)Bad++;}
  {let t=TexMan.CheckForTexture("QROCK3X8"); Vector2 sz=TexMan.GetScaledSize(t);if(abs(sz.X-1024)>0.001||abs(sz.Y-1024)>0.001)Bad++;}
  {let t=TexMan.CheckForTexture("QROCK4X8"); Vector2 sz=TexMan.GetScaledSize(t);if(abs(sz.X-1024)>0.001||abs(sz.Y-1024)>0.001)Bad++;}
  {let t=TexMan.CheckForTexture("QROCK5X8"); Vector2 sz=TexMan.GetScaledSize(t);if(abs(sz.X-1024)>0.001||abs(sz.Y-1024)>0.001)Bad++;}
  Console.Printf("UTNT_ASSERT %s: four expanded material dimensions",Bad==0?"PASS":"FAIL");
  if(level.MapName~=="TNT01")
