version "4.14"
class UTNTCreditsTests : EventHandler
{
 Vector3 PreviousPosition;
 double PreviousAngle,PreviousPitch,PeakStep;
 int PreviousPhase,PreviousPage,ObservedTicks,PreviousFlightAge,EntryTicks;
 double EntryMin,EntryMax;
 bool HadPrevious,Watching;
 override void WorldTick()
 {
  let h=UTNTCreditsHandler(EventHandler.Find('UTNTCreditsHandler'));
  if(!Watching || !h || !h.ViewCamera)return;
  let camera=h.ViewCamera;
  if(HadPrevious && PreviousPhase==h.Phase && PreviousPage==h.Page)
  {
   double step=(camera.Pos-PreviousPosition).Length();PeakStep=max(PeakStep,step);ObservedTicks++;
   // WorldTick observes actor positions from the preceding simulation tic.
   int age=level.time-h.PageStart-1;
   if(h.Phase==1 && age>=1 && age<=60 && age==PreviousFlightAge+1)
   {
    EntryMin=EntryTicks?min(EntryMin,step):step;EntryMax=max(EntryMax,step);EntryTicks++;
    if(age==60)
    {
     Check(EntryTicks>=55 && EntryMin>.5 && EntryMax/EntryMin<1.03,"flight moves at cruise speed throughout fade-in without acceleration");
     Console.Printf("FLIGHT_ENTRY ticks=%d min=%.4f max=%.4f",EntryTicks,EntryMin,EntryMax);
    }
   }
   if(step>20 || abs(Actor.deltaangle(PreviousAngle,camera.Angle))>4 || abs(Actor.deltaangle(PreviousPitch,camera.Pitch))>4)
    Check(false,"camera has no per-tick jumps");
  }
  PreviousPosition=camera.Pos;PreviousAngle=camera.Angle;PreviousPitch=camera.Pitch;
  PreviousPhase=h.Phase;PreviousPage=h.Page;PreviousFlightAge=level.time-h.PageStart-1;HadPrevious=true;
 }
 ui int LastLayoutPage;
 ui bool LayoutSeen,LookSeen;
 ui int LookPage,LookPhase,BlurTic,BlurPage,BlurPhase,BlurObservations;
 ui UTNTCreditsLook ObservedLook;
 ui bool TestedBlurRamp;
 ui int SeenSparkPulses,FlightCheckedTic;
 ui void ObserveBlur(UTNTCreditsHandler h)
 {
  if(!h || !h.Look || !h.Look.Ready)return;
  let look=h.Look;
  if(!TestedBlurRamp)
  {
   let probe=new('UTNTCreditsLook');probe.FocusDistance=1024;
   CheckLook(probe.BlurAtDepth(1024)==0,"focus plane remains sharp");
   CheckLook(probe.BlurAtDepth(512)>.1 && probe.BlurAtDepth(256)<.8,"near transition spans hundreds of world units");
   CheckLook(probe.BlurAtDepth(2048)>.1 && probe.BlurAtDepth(3072)<.95,"far transition spans thousands of world units");
   TestedBlurRamp=true;
  }
  if(ObservedLook==look && BlurPage==h.Page && BlurPhase==h.Phase && look.SampleTic==BlurTic+1)
  {
   if(look.LastSampleCut)CheckLook(false,"continuous camera zoom must not reset blur history");
   if(look.MaxBlurStep>.060001)CheckLook(false,"blur change stays bounded across geometry edges");
   BlurObservations++;
   if(BlurObservations==30)CheckLook(true,"continuous depth mask survives 30 moving camera tics without reset or abrupt changes");
  }
  else if(ObservedLook!=look || BlurPage!=h.Page || BlurPhase!=h.Phase || look.SampleTic<BlurTic)BlurObservations=0;
  ObservedLook=look;BlurTic=look.SampleTic;BlurPage=h.Page;BlurPhase=h.Phase;
 }
 ui void CheckLook(bool value,String label){Console.Printf("UTNT_ASSERT %s: %s",value?"PASS":"FAIL",label);}
 override void RenderOverlay(RenderEvent e)
 {
  let h=UTNTCreditsHandler(EventHandler.Find('UTNTCreditsHandler'));
  ObserveBlur(h);
  if(h && h.Phase==1 && h.SparkPulses>0 && level.time-h.LastSparkTic==7 && FlightCheckedTic!=level.time)
  {
   FlightCheckedTic=level.time;
   let sparks=ThinkerIterator.Create('UTNTCreditsEmber',Thinker.MAX_STATNUM+1,true);UTNTCreditsEmber v;int count=0;double travel=0;
   while(v=UTNTCreditsEmber(sparks.Next()))if((v.Origin-(h.SparkFocus+(0,0,12))).Length()<1){count++;travel=max(travel,(v.Pos-v.Origin).Length());}
   CheckLook(count>0 && travel>18,"additional sparks survive and visibly leave the flash core");
   Console.Printf("EMBER_FLIGHT count=%d travel=%.2f",count,travel);
  }
  if(h && h.Phase==1 && h.SparkPulses!=SeenSparkPulses)
  {
   SeenSparkPulses=h.SparkPulses;
   if(level.time-h.LastSparkTic<=1)
   {
    let it=ThinkerIterator.Create('UTNTCreditsSpark',Thinker.STAT_USER+26,true);let fx=UTNTCreditsSpark(it.Next());
    CheckLook(fx && fx.Halo && fx.Anchor,"authored flash has a live halo and local light");
    CheckLook(fx && fx.LastBurstCount>0 && fx.LastBurstCount<=8,"authored flash emits a bounded additional spark burst");
    CheckLook(it.Next()==null,"repeated flashes share one halo controller");
   }
  }
  if(h && h.Initialized)
  {
   if(!LookSeen || LookPage!=h.Page || LookPhase!=h.Phase)
   {
    LookSeen=true;LookPage=h.Page;LookPhase=h.Phase;
    if(h.Phase<2)
    {
     CheckLook(h.Look && h.Look.Enabled && h.Look.Ready,"Ash & Ember is active before the credit overlay");
     if(h.Look)
     {
      CheckLook(h.Look.MaxDepth>h.Look.MinDepth+32,"DOF uses varying scene geometry depth");
      CheckLook(h.Look.FocusDistance>=64 && h.Look.FocusDistance<=8192,"focus plane stays in valid scene range");
      CheckLook(h.Look.TraceCount%144==0,"depth reconstruction uses bounded 16 by 9 batches");
     }
    }
    else
    {
     CheckLook(h.Look==null,"THE END releases the cinematic look");
     let glow=ThinkerIterator.Create('UTNTCreditsSpark',Thinker.STAT_USER+26,true);
     CheckLook(glow.Next()==null,"THE END releases the crater halo and light");
    }
   }
  }
  else if(LookSeen && !(level.MapName~=="ENDMAP01"))
  {CheckLook(!h || !h.Look,"leaving ENDMAP releases depth sampling");LookSeen=false;}
  // Test-only switch: compare the exact same paused frame with the scene pass bypassed.
  if(h && h.Look)PPShader.SetUniform4f("UTNTEndingLook","lookParams",(h.Look.Aperture,h.Look.GrainTime,CVar.FindCVar("creditlookbaseline").GetBool()?0:1,0));
  if(!h || !h.Initialized || h.Phase || !h.CardsUI || (LayoutSeen && LastLayoutPage==h.Page))return;
  let page=h.Pages[h.Page];let view=h.CardsUI;if(view.Cached!=page)return;
  LayoutSeen=true;LastLayoutPage=h.Page;bool fit=true;
  if(view.Body!=Font.GetFont('SmallFont'))fit=false;
  if(page.Layout=="standard" || page.Layout=="dense")
  {
   bool dense=page.Layout=="dense";
   for(int i=0;i<page.Names.Size();i++)
   {
    Array<String> names;page.Names[i].Split(names,"~",TOK_KEEPEMPTY);
    int row=dense?i%3:i;double x=44+(dense && i>=3?296:0),w=dense?286:328;
    double textBottom=16+names.Size()*18.5+7.5+view.Wrapped[i].Count()*13;
    if(textBottom>view.Heights[i]-16 || view.Tops[row]+view.Heights[i]>673 || x+w>view.Width)fit=false;
    if(row<2 && i+1<page.Names.Size() && view.Tops[row]+view.Heights[i]>view.Tops[row+1]-8)fit=false;
   }
   if(view.ContributionSize>(dense?9:10))fit=false;
  }
  if(view.SpecialHeight>0 && (view.SpecialTop+view.SpecialHeight>672 || view.SpecialTop<100))fit=false;
  if(page.Layout=="thanks")
  {
   double bottom=60+view.Wrapped[0].Count()*18+(page.Remaster?0:34);
   if(bottom>view.SpecialHeight-16 || 44+530>view.Width)fit=false;
   if(page.Names[0].Left(1)=="$" && view.Local(page.Names[0])==page.Names[0])fit=false;
  }
  if(page.Layout=="group" && page.Names.Size()>8)fit=false;
  Console.Printf("UTNT_ASSERT %s: reliquiar entry staggers cards",view.CardOpacity(.25,0)>view.CardOpacity(.25,1)?"PASS":"FAIL");
  Console.Printf("UTNT_ASSERT %s: reliquiar slide settles at approved position",view.CardOffset(0)==-18 && view.CardOffset(1)==0?"PASS":"FAIL");
  Console.Printf("UTNT_ASSERT %s: credit page %d layout fits",fit?"PASS":"FAIL",h.Page);
 }
 void Check(bool condition,String what){Console.Printf("UTNT_ASSERT %s: %s",condition?"PASS":"FAIL",what);}
 override void NetworkProcess(ConsoleEvent e)
 {
  if(e.Name!="creditstest")return;
  let h=UTNTCreditsHandler(EventHandler.Find('UTNTCreditsHandler'));Check(h!=null && h.Initialized,"credits initialized");if(!h)return;
  int op=e.Args[0];
  if(op==0)
  {
   int names=0,original=0;bool nash=false,sites=false;
   for(int i=0;i<h.Pages.Size();i++)
   {if(h.Pages[i].Remaster)continue;original++;names+=h.Pages[i].Names.Size();for(int j=0;j<h.Pages[i].Names.Size();j++){if(h.Pages[i].Names[j]=="NASH" && h.Pages[i].Heading=="$UTNT_CREDITS_TEXT_029")nash=true;if(h.Pages[i].Names[j]=="NEWDOOM.COM")sites=true;}}
   Check(original==24,"all 24 original credit cards loaded");Check(names==65,"all 65 original attribution entries loaded");Check(nash && sites,"supplementary original credits retained");
   Check(h.Pages[20].Layout=="group" && h.Pages[20].Names.Size()==8,"all beta testers share one frame");
   int duration=0;for(int i=0;i<h.Pages.Size();i++)if(!h.Pages[i].Remaster)duration+=h.Pages[i].Duration;
   Check(duration>155*35 && duration<=159*35,"original credits run at half duration");
   Check(h.FlightCount==321,"full authored flight route sampled");
   Check(level.SkyTexture1==TexMan.CheckForTexture("USTSKY"),"approved storm sky retained");
   Check(players[0].camera && players[0].camera==h.ViewCamera,"credit camera attached");
  }
  else if(op==1)
  {h.Phase=0;h.Cutting=false;h.Page=clamp(e.Args[1],0,h.Pages.Size()-1);h.PageStart=level.time-min(70,h.Pages[h.Page].Duration-70);h.SetCamera();}
  else if(op==2)
  {int was=h.Page;h.LastInput=0;h.PageStart=level.time-70;h.Advance(UTNTChapterState.Leader(),0);Check(h.Page==was && h.Cutting && h.PendingPage==was+1,"next page waits for black fade");h.Advance(UTNTChapterState.Leader(),0);Check(h.PendingPage==was+1,"input debounce during cut");}
  else if(op==3)
  {Check(h.Page==e.Args[1],"page restored by save/load");Check(h.Phase==0,"credit phase restored");Check(h.Pages[h.Page].Names.Size()>0,"credit strings restored");}
  else if(op==4)
  {h.LastInput=0;h.PageStart=level.time-70;h.Advance(UTNTChapterState.Leader(),2);h.StartFinale();Check(h.Phase==0 && h.Cutting && h.PendingPage==h.Pages.Size(),"skip waits for black fade");}
  else if(op==5)
  {Check(h.Phase==2,"authored finale reaches new THE END");Check(h.FinaleStarts==1,"finale trigger remains single");}
  else if(op==6)
  {Check(h.Page==e.Args[1],"co-op synchronized page");Check(h.Phase==e.Args[2],"co-op synchronized phase");}
  else if(op==7)
  {h.Page=h.Pages.Size()-1;h.PageStart=level.time-h.Pages[h.Page].Duration+3;h.SetCamera();}
  else if(op==8)
  {Check(h.Phase==1 && h.FinaleStarts==1,"natural ending starts finale once");}
  else if(op==9)
  {int total=0;for(int i=0;i<h.Pages.Size();i++)if(h.Pages[i].Remaster && h.Pages[i].Layout!="chapter")total++;Check(total==2,"Remaster entries paginate automatically");Check(h.Pages[24].Layout=="chapter" && h.Pages[24].Remaster,"one Remaster chapter before entries");Check(h.Pages[h.Pages.Size()-4].Layout=="thanks","Remaster follows personal thanks");Check(h.Pages[h.Pages.Size()-1].Names[0]=="FOURTH CONTRIBUTOR","Remaster last entry retained");}
  else if(op==10)
  {h.Phase=0;h.Cutting=false;h.Page=e.Args[1];h.PageStart=level.time-e.Args[2];h.SetCamera();}
  else if(op==12)
  {Check(h.Page==25 && h.Pages[h.Page].Remaster && h.Pages[h.Page].Layout=="standard","chapter naturally advances to Remaster credits");}
  else if(op==13)
  {Check(h.Page==24 && h.Pages[h.Page].Remaster && h.Pages[h.Page].Layout=="chapter","Remaster chapter restored by save/load");}
  else if(op==15)
  {Watching=true;HadPrevious=false;ObservedTicks=0;PeakStep=0;EntryTicks=0;EntryMin=0;EntryMax=0;}
  else if(op==16)
  {Check(EntryTicks>=55 && EntryMin>.5 && EntryMax/EntryMin<1.03,"cruise entry observations survive the full flight and save/load");Check(ObservedTicks>100 && PeakStep>1 && PeakStep<20,"continuous FPV flight observed without jumps");Check(h.Phase==2,"flight fades into THE END");Check(h.SparkPulses>=2,"natural post-credit sequence produces repeated amber accents");}
  else if(op==17)
  {Check(h.Cutting && h.Phase==0,"outgoing black fade is pending");Check(h.PendingPage==e.Args[1],"pending destination restored");}
  else if(op==18)
  {Check(h.Phase==1 && h.FlightCount==321,"flight state restored");Check(players[0].camera==h.ViewCamera,"saved flight rig attached");HadPrevious=false;}
  else if(op==19)
  {
   let it=Level.CreateActorIterator(7,"OrangeSpark_Up");Actor spark=it.Next();
   Check(h.Phase==1 && level.time-h.PageStart>=735 && level.time-h.PageStart<868,"spark shot settles before its flashes and outgoing fade");
   if(h.SparkPulses>0)Check(h.LastSparkTic>=h.PageStart+735,"amber accents follow actual late crater discharges");
   Check(spark && h.HasSparkFocus && (spark.Pos-h.SparkFocus).Length()<.01,"authored floor spark focus survives save/load");
   Check(TexMan.GetName(level.Sectors[501].GetTexture(Sector.floor))=="UECRACK" &&
    level.Sectors[501].GetTexture(Sector.floor)==level.Sectors[513].GetTexture(Sector.floor),"crater floor replaces the lava silhouette with one fracture material");
   Check(abs(level.Sectors[501].GetXOffset(Sector.floor)-4576)<.001 &&
    abs(level.Sectors[513].GetXOffset(Sector.floor)-4576)<.001,"fracture UV phase remains continuous after save/load");
   Check(abs(level.Sectors[501].floorplane.ZatPoint((-4480,-448))-level.Sectors[513].floorplane.ZatPoint((-4480,-448)))<.001,
    "former lava sector has no geometric step or pinwheel edge");
   if(spark)
   {
    let camera=h.ViewCamera;Vector3 delta=spark.Pos-camera.Pos;
    double yaw=atan2(delta.y,delta.x),pitch=-atan2(delta.z,delta.XY.Length());
    Check(abs(Actor.deltaangle(camera.Angle,yaw))<.1 && abs(camera.Pitch-pitch)<.1,"floor spark is centered in the final camera");
    Check(camera.CheckSight(spark),"crater rim does not occlude spark");
    Check(delta.Length()>250 && delta.Length()<320 && camera.Pos.z-spark.Pos.z>180,"close shot clears the near crater slope");
    Check(camera.CameraFOV>=63 && camera.CameraFOV<=65 && abs(camera.Roll)<.01,"spark shot has tighter lens and settled horizon");
   }
  }
  else if(op==20)
  {
   h.Phase=1;h.PageStart=level.time-735;h.ViewCamera.Director=null;
   Vector3 offset=e.Args[1]==0?(0,-130,70):e.Args[1]==1?(-85,-115,90):(0,-180,220);
   let c=h.ViewCamera;c.SetOrigin(h.SparkFocus+offset,true);
   c.Angle=atan2(-offset.y,-offset.x);c.Pitch=-atan2(-offset.z,offset.XY.Length());
   c.Roll=0;c.CameraFOV=64;c.ClearInterpolation();h.AttachCamera();
   Check(h.HasSparkFocus && c.CheckSight(Level.CreateActorIterator(7,"OrangeSpark_Up").Next()),"material inspection sees the authored crater focus");
  }
  else if(op==21)
  {
   Check(h.Pages.Size()==30,"original credits plus chapter, team, director, production tools and two dedications loaded");
   if(h.Pages.Size()!=30)return;
   Check(h.Pages[24].Remaster && h.Pages[24].Layout=="chapter","Remaster chapter precedes contributors");
   let team=h.Pages[25];
   Check(team.Remaster && team.Names.Size()==3 && team.Layout=="standard","three remaster contributors share one compact page");
   if(team.Names.Size()==3)
   {
    Check(team.Names[0]=="Salahmander" && team.Names[1]=="Ozymandias81" && team.Names[2]=="DBThanatos","all remaster names retain authored order");
    Check(team.Contributions[0]=="$UTNT_CREDITS_REMASTER_SUPPORT" && team.Contributions[1]==team.Contributions[0] && team.Contributions[2]=="$UTNT_CREDITS_REMASTER_TAKE_II","all authored roles are assigned to the correct contributors");
   }
   Check(h.Pages[26].Remaster && h.Pages[26].Layout=="creator" && h.Pages[26].Names.Size()==1 && h.Pages[26].Names[0]=="Tormentor667" && h.Pages[26].Contributions[0]=="$UTNT_CREDITS_REMASTER_DIRECTOR","director follows DBThanatos on a dedicated card");
   Check(h.Pages[27].Remaster && h.Pages[27].Layout=="thanks" && h.Pages[27].Names.Size()==1 && h.Pages[27].Names[0]=="OpenAI & GPT-6 Astra" && h.Pages[27].Contributions[0]=="$UTNT_CREDITS_REMASTER_AI","partial AI assistance is acknowledged before the personal dedications");
   Check(h.Pages[28].Remaster && h.Pages[28].Layout=="thanks" && h.Pages[28].Names.Size()==1 && h.Pages[28].Names[0]=="$UTNT_CREDITS_REMASTER_PARENTS_NAME","parents have a dedicated localized card");
   Check(h.Pages[29].Remaster && h.Pages[29].Layout=="thanks" && h.Pages[29].Names.Size()==1 && h.Pages[29].Names[0]=="$UTNT_CREDITS_REMASTER_MINA_NAME","Mina has the closing localized dedication");
  }
  else if(op==14)
  {Check(h.Page==7 && level.time-h.PageStart>=32 && level.time-h.PageStart<50,"animation time restored by save/load");}

 }
}
