version "4.14"
class UTNTCreditsTests : EventHandler
{
 ui int LastLayoutPage;
 ui bool LayoutSeen;
 override void RenderOverlay(RenderEvent e)
 {
  let h=UTNTCreditsHandler(EventHandler.Find('UTNTCreditsHandler'));
  if(!h || !h.Initialized || h.Phase || !h.CardsUI || (LayoutSeen && LastLayoutPage==h.Page))return;
  let page=h.Pages[h.Page];let view=h.CardsUI;if(view.Cached!=page)return;
  LayoutSeen=true;LastLayoutPage=h.Page;bool fit=true;
  if(view.Body!=AlternativeSmallFont)fit=false;
  if(page.Layout=="standard" || page.Layout=="dense")
  {
   bool dense=page.Layout=="dense";
   for(int i=0;i<page.Names.Size();i++)
   {
    Array<String> names;page.Names[i].Split(names,"~",TOK_KEEPEMPTY);
    int row=dense?i%3:i;double x=44+(dense && i>=3?296:0),w=dense?286:328;
    double textBottom=16+names.Size()*18.5+7.5+view.Wrapped[i].Count()*13;
    if(textBottom>view.Heights[i]-6 || view.Tops[row]+view.Heights[i]>673 || x+w>view.Width)fit=false;
    if(row<2 && i+1<page.Names.Size() && view.Tops[row]+view.Heights[i]>view.Tops[row+1]-8)fit=false;
   }
   if(view.ContributionSize>(dense?9:10))fit=false;
  }
  Console.Printf("UTNT_ASSERT %s: reliquiar entry staggers cards",view.CardOpacity(.25,0)>view.CardOpacity(.25,1)?"PASS":"FAIL");
  Console.Printf("UTNT_ASSERT %s: reliquiar slide settles at approved position",view.CardOffset(0)==-18 && view.CardOffset(1)==0?"PASS":"FAIL");
  Console.Printf("UTNT_ASSERT %s: credit page %d layout fits",fit?"PASS":"FAIL",h.Page);
 }
 void Check(bool condition,String what){Console.Printf("UTNT_ASSERT %s: %s",condition?"PASS":"FAIL",what);}
 override void NetworkProcess(ConsoleEvent e)
 {
  if(e.Name!="creditstest")return;
  let h=UTNTCreditsHandler(EventHandler.Find('UTNTCreditsHandler'));Check(h!=null && h.Initialized,"credits initialized");if(!h)return;
  int op=e.Args[0];
  if(op==0)
  {
   int names=0,remaster=0;bool nash=false,sites=false;
   for(int i=0;i<h.Pages.Size();i++)
   {names+=h.Pages[i].Names.Size();if(h.Pages[i].Remaster)remaster++;for(int j=0;j<h.Pages[i].Names.Size();j++){if(h.Pages[i].Names[j]=="NASH" && h.Pages[i].Heading=="$UTNT_CREDITS_TEXT_029")nash=true;if(h.Pages[i].Names[j]=="NEWDOOM.COM")sites=true;}}
   Check(h.Pages.Size()==25,"all 25 original credit cards loaded");Check(names==65,"all 65 attribution entries loaded");Check(remaster==0,"empty Remaster block skipped");Check(nash && sites,"supplementary original credits retained");
   Check(level.SkyTexture1==TexMan.CheckForTexture("USTSKY"),"approved storm sky retained");
   Check(players[0].camera && players[0].camera.TID==h.Pages[h.Page].Camera,"credit camera attached");
  }
  else if(op==1)
  {h.Phase=0;h.Page=clamp(e.Args[1],0,h.Pages.Size()-1);h.PageStart=level.time-min(210,h.Pages[h.Page].Duration-35);h.SetCamera();}
  else if(op==2)
  {int was=h.Page;h.LastInput=0;h.PageStart=level.time-70;h.Advance(UTNTChapterState.Leader(),0);Check(h.Page==was+1,"next page");h.Advance(UTNTChapterState.Leader(),0);Check(h.Page==was+1,"input debounce");}
  else if(op==3)
  {Check(h.Page==e.Args[1],"page restored by save/load");Check(h.Phase==0,"credit phase restored");Check(h.Pages[h.Page].Names.Size()>0,"credit strings restored");}
  else if(op==4)
  {h.LastInput=0;h.PageStart=level.time-70;h.Advance(UTNTChapterState.Leader(),2);h.StartFinale();Check(h.Phase==1 && h.FinaleStarts==1,"skip starts finale exactly once");}
  else if(op==5)
  {Check(h.Phase==2,"authored finale reaches new THE END");Check(h.FinaleStarts==1,"finale trigger remains single");}
  else if(op==6)
  {Check(h.Page==e.Args[1],"co-op synchronized page");Check(h.Phase==e.Args[2],"co-op synchronized phase");}
  else if(op==7)
  {h.Page=h.Pages.Size()-1;h.PageStart=level.time-h.Pages[h.Page].Duration+3;h.SetCamera();}
  else if(op==8)
  {Check(h.Phase==1 && h.FinaleStarts==1,"natural ending starts finale once");}
  else if(op==9)
  {int total=0;for(int i=0;i<h.Pages.Size();i++)if(h.Pages[i].Remaster && h.Pages[i].Layout!="chapter")total++;Check(total==2,"Remaster entries paginate automatically");Check(h.Pages[25].Layout=="chapter" && h.Pages[25].Remaster,"one Remaster chapter before entries");Check(h.Pages[h.Pages.Size()-4].Layout=="thanks","Remaster follows personal thanks");Check(h.Pages[h.Pages.Size()-1].Names[0]=="FOURTH CONTRIBUTOR","Remaster last entry retained");}
  else if(op==10)
  {h.Phase=0;h.Page=e.Args[1];h.PageStart=level.time-e.Args[2];h.SetCamera();}
  else if(op==12)
  {Check(h.Page==26 && h.Pages[h.Page].Remaster && h.Pages[h.Page].Layout=="standard","chapter naturally advances to Remaster credits");}
  else if(op==13)
  {Check(h.Page==25 && h.Pages[h.Page].Remaster && h.Pages[h.Page].Layout=="chapter","Remaster chapter restored by save/load");}
  else if(op==14)
  {Check(h.Page==7 && level.time-h.PageStart>=5 && level.time-h.PageStart<20,"animation time restored by save/load");}

 }
}
