version "5.0.0"
class UTNTBridgeProfile : EventHandler
{
 ui Array<double> Frames; ui double Previous; ui bool Finished;
 override void WorldTick()
 {
  let p=players[0].mo;if(!p)return;
  if(level.time==35){p.bInvulnerable=true;p.ACS_NamedExecuteAlways("UTNT_TNT04A_FinishIntro",0,1);}
  if(level.time==70){p.bNoGravity=true;p.bNoClip=true;p.SetOrigin((-1408,6300,160),false);p.Angle=270;p.Pitch=8;}
  if(level.time==490){int actors=0,client=0;let it=ThinkerIterator.Create('Actor');while(it.Next())actors++;let cs=ThinkerIterator.Create('Actor',Thinker.MAX_STATNUM+1,true);while(cs.Next())client++;Console.Printf("BRIDGE_COUNTS actors=%d client=%d kills=%d",actors,client,level.killed_monsters);}
  if(level.time>=140 && level.time<490)p.Angle=270+sin(level.time*1.5)*20;
 }
 override void RenderOverlay(RenderEvent e)
 {
  double now=MSTimeF();if(level.time>=140 && level.time<490 && Previous>0)Frames.Push(now-Previous);Previous=now;
  if(level.time>=490 && !Finished){Finished=true;String s="";for(int i=0;i<Frames.Size();i++)s=s..String.Format(i?",%.4f":"%.4f",Frames[i]);Console.Printf("UTNT_FRAME_MS %s",s);}
 }
}
