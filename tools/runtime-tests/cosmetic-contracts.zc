        names.Push("WarlordMace");
        names.Push("HellWarriorShield");
        names.Push("HellsFurySkull");
        names.Push("ShadowGhost");
        bool flags=true;
        for(int i=0;i<names.Size();i++){
            Class<Actor> cls=names[i];let d=GetDefaultByType(cls);
            if(!d || !d.IsClientSide() || d.bSolid || d.bShootable){
                flags=false;Console.Printf("UTNT_COSMETIC_BAD_DEFAULT %s",names[i]);
            }
        }
        Check(flags,"all legacy cosmetic defaults use the actual client flag without solid/shootable gameplay");
        Check(!GetDefaultByType('TeleportEffects').IsClientSide() && !GetDefaultByType('PBCluster').IsClientSide() && !GetDefaultByType('MiniFirePuff').IsClientSide()
            && !GetDefaultByType('FTFire').IsClientSide() && !GetDefaultByType('DropFire').IsClientSide()
            && !GetDefaultByType('PyroShot').IsClientSide() && !GetDefaultByType('BruiserFire').IsClientSide()
            && !GetDefaultByType('Comet').IsClientSide(),"damaging projectiles remain authoritative");
        Check(!GetDefaultByType('UpwardSteamer').IsClientSide() && !GetDefaultByType('FireSpawner').IsClientSide()
            && !GetDefaultByType('PortalDecoration_128').IsClientSide() && !GetDefaultByType('DarkSmokeSpawner').IsClientSide(),
            "map switches and TID sources remain authoritative");
        let blood=Actor.Spawn('Blood',(400,-400,48),ALLOW_REPLACE);
        Check(blood is 'UTNTBloodBridge' && !blood.IsClientSide(),"native blood replacement uses a compatible shared bridge");
        let gibBridge=Actor.Spawn('RealGibs',(400,-400,48),ALLOW_REPLACE);
        Check(gibBridge is 'UTNTGibsBridge' && !gibBridge.IsClientSide(),"native gib replacement uses a compatible shared bridge");
        Array<String> samples;
        samples.Push("TeleParticle");
        samples.Push("PistolCasing");
        samples.Push("ShotgunCasing");
        samples.Push("TT1");
        samples.Push("PBDebris");
        samples.Push("PBExploBack");
        samples.Push("PBExploBackHalf");
        samples.Push("PuffSmoke");
        samples.Push("DarkSmoke1");
        samples.Push("FTFlameTrail");
        samples.Push("HellGuardBallParticle");
        samples.Push("CometTail");
        samples.Push("UTNTCacoBallTrail");
        samples.Push("RedFlameSmall");
        samples.Push("NashGoreBloodSpurt");
        samples.Push("NashGoreGibs");
        samples.Push("NashGoreBloodPlane");
        samples.Push("UTNT_WaterSplash");
        samples.Push("NashgoreMasterGenerator");
        samples.Push("UTNTLocalMCBloodFXMain");
        samples.Push("MCBloodParticle");
        samples.Push("WarlordShield");
        samples.Push("EmberShot");
        bool pools=true;
        // Intentionally very different local workloads on every peer.
        for(int pass=0;pass<=consoleplayer*3;pass++)for(int i=0;i<samples.Size();i++){
            Class<Actor> cls=samples[i];let a=Actor.Spawn(cls,(400,-400,128));
            if(a && (!a.IsClientSide() || Object.GetNetworkEntity(a.GetNetworkID())==a))pools=false;
        }
        Check(pools,"different local spawn workloads do not create network entities");
        let owner=players[consoleplayer].mo;
        let first=NashGoreLocalActor.Ensure(owner);let second=NashGoreLocalActor.Ensure(owner);
        Check(first==second && first.IsClientSide(),"emitter registry reuses a client-only watcher");
        // Conservative bucket coverage, including negative coordinates and cell edges.
        let index=new('UTNTSpatialIndex');index.Add((-1024,-.01),0);index.Add((1024,1024),1);index.Add((8192,8192),2);
        Array<int> candidates;index.Query((0,0),1024,candidates);
        Check(candidates.Size()==2,"spatial query retains range-boundary candidates across negative cells");
    }
