        names.Push("NashGore_GibPieceGeneratorSarg");
        names.Push("NashGore_GibPieceGenerator11");
        names.Push("NashGore_GibPieceGenerator10");
        names.Push("NashGore_GibPieceGenerator9");
        names.Push("NashGore_GibPieceGenerator1");
        names.Push("NashgoreMasterGenerator");
        names.Push("NashGore_GibSarg");
        names.Push("NashGore_Gib11");
        names.Push("NashGore_Gib10");
        names.Push("NashGore_Gib9");
