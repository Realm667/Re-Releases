// Visual-only actors migrated from DECORATE. Their gameplay spawners stay shared.
class FakeGoalSparks : Actor
{
	Default
	{
		+CLIENTSIDE
		+MISSILE
		+NOBLOCKMAP
		+NOGRAVITY
		+NOINTERACTION
		Radius 1;
		Height 1;
		RenderStyle "Add";
		Alpha 0;
		Scale 0.1;
	}
	States
	{
	Spawn:
		TNT1 A 8;
		FGST ABCD 3 A_FadeIn(0.25);
	Death:
		FGST ABCD 3 A_FadeOut(0.1);
		Loop;
	}
}

class Thunder_Smoke : Actor
{
	Default
	{
		+CLIENTSIDE
		Height 2;
		Radius 1;
		+MISSILE
		+NOGRAVITY
		+NOINTERACTION
		+NOBLOCKMAP
		RenderStyle "Translucent";
		Alpha 0.5;
		Scale 0.65;
	}
	States
	{
	Spawn:
		SMK1 IHGFEEDDCCBBBBAAAAAA 2 A_FadeOut(0.05);
		Stop;
	}
}
