///////////////////////////////////////
// ALARM ACTOR ////////////////////////
///////////////////////////////////////

class AlarmSounder : Actor
{
    Default
    {
    //$Category Stronghold
    +NOBLOCKMAP;
    +FRIENDLY;
    }
    States
    {
    Spawn:
        TNT1 A 1 A_LookEx(LOF_NOSOUNDCHECK,0,192,0,360,"See");
        Loop;
    See:
        TNT1 A 56 A_PlaySound("AMB16",CHAN_AUTO,1,0,ATTN_NONE);
        goto spawn;

    }
}

////////////////
// UTNT COMET //
////////////////

class CometLarge_Enhanced : Actor
{
    Default
    {
    Radius 6;
    Height 8;
    Speed 10;
    Damage 5;
    PROJECTILE;
    SeeSound "comet/launch";
    DeathSound "comet/explosion";
    }
    States
    {
    Spawn:
        COMT AAAABBBBCCCC 1 Bright LIGHT("Comet") A_SpawnItemEx("CometFire_Orange",Random(-2,2),Random(-2,2),Random(-2,2));
        Loop;
    Death:
        COMT D 3 Bright LIGHT("CometX_1");
        COMT E 3 Bright LIGHT("CometX_2") A_Explode(40,80);
        COMT FGHI 3 Bright;
        Stop;

    }
}

class CometLarge_Enhanced_NoDmg : CometLarge_Enhanced
{
    Default
    {
    Damage 0;
    }
    States
    {
    Death:
        COMT D 3 Bright LIGHT("CometX_1");
        COMT E 3 Bright LIGHT("CometX_2");
        COMT FGHI 3 Bright;
        Stop;

    }
}

