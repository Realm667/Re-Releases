}

class IonCannon_Beam : Thunder_Generator
{
    Default
    {
    //$Category Stronghold_SFX
    XScale 1.5;
    YScale 4.0;
    Alpha 0.01;
    }
    States
    {
    Spawn:
    Active:
        TNT1 A 0;
        TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("Thunder_Spark",0,0,0,random(1,10),0,random(1,10),random(0,359),129);
        SKBM AAAAA 1 Bright A_FadeIn(0.2);
        SKBM A 1 Bright A_SpawnItemEx("Skybeam_Projectile",0,0,0,0,0,30);
        SKBM AAAAAAAAAAAAAA 1 Bright A_SpawnItemEx("Skybeam_ProjectileSmall",random(-32,32),random(-32,32),0,0,0,random(15,25),0);
        SKBM A 1 Bright A_SpawnItemEx("Skybeam_Projectile",0,0,0,0,0,30);
        SKBM AAAAAAAAAAAAAA 1 Bright A_SpawnItemEx("Skybeam_ProjectileSmall",random(-32,32),random(-32,32),0,0,0,random(15,25),0);
        SKBM A 1 Bright A_SpawnItemEx("Skybeam_Projectile",0,0,0,0,0,30);
        SKBM AAAAAAAAAAAAAA 1 Bright A_SpawnItemEx("Skybeam_ProjectileSmall",random(-32,32),random(-32,32),0,0,0,random(15,25),0);
        SKBM A 1 Bright A_SpawnItemEx("Skybeam_Projectile",0,0,0,0,0,30);
        SKBM AAAAAAAAAAAAAA 1 Bright A_SpawnItemEx("Skybeam_ProjectileSmall",random(-32,32),random(-32,32),0,0,0,random(15,25),0);
        SKBM A 1 Bright A_SpawnItemEx("Skybeam_Projectile",0,0,0,0,0,30);
        SKBM AAAAAAAAAAAAAA 1 Bright A_SpawnItemEx("Skybeam_ProjectileSmall",random(-32,32),random(-32,32),0,0,0,random(15,25),0);
        SKBM A 30 Bright;
        SKBM AAAAAAAAA 5 Bright A_FadeOut(0.1);
    Inactive:
        TNT1 A -1;
        Loop;

    }
}

class IonCannon_Beam_XXL : IonCannon_Beam
{
    Default
    {
    //$Category Stronghold_SFX
    XScale 2.75;
