///////////////////////////////////////////////////////////////////////////////////////////
/////////////////////// POWER CORE ////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////

class PowerCore : Actor
{
    Default
    {
    DamageFactor "MarineAlly",0;
    DamageFactor "BossFactor",0;
    DamageFactor "BFGSplash",0;
    DamageFactor "Stunner",0;
    DamageFactor "STBoss",0.015;
    DamageFactor "STBossFactor",0.1;
    DamageFactor "Animate",0;
    DamageFactor "Cyber2Factor",0.25;
    DamageFactor "Normal",0.4;
    DamageFactor "Lightning",0.5;
    DamageFactor "Fire",0.5;
    DamageFactor "RedBlast",0.5;
    DamageFactor "OvermindFactor",0.25;
    //$Category Stronghold
    damagefactor "corefriendly",0;
    damagefactor "massacre",0;
    radius 24;
    height 128;
    mass 0x7FFFFFFF;
    painchance 255;
    deathsound "world/barrelx";
    +SOLID;
    +SHOOTABLE;
    +ISMONSTER;
    +FRIENDLY;
    +NOBLOOD;
    +DONTGIB;
    }
    States
    {
    Spawn:
        SECG ABCD 6;
        SECG A 0 A_JumpIfHealthLower(666,"Spawn_66");
        loop;
    Pain:
        SECG A 0 A_JumpIfHealthLower(333,"Spawn_33");
        SECG A 0 A_JumpIfHealthLower(666,"Spawn_66");
        SECO A 0 ACS_Execute(929,0,1);
        goto Spawn;
    Spawn_66:
        SECY A 0 ACS_Execute(929,0,2);
        SECY ABCD 6;
        SECY A 0 A_JumpIfHealthLower(333,"Spawn_33");
        goto Spawn_66+1;
    Spawn_33:
        SECR A 0 ACS_Execute(929,0,3);
        SECR ABCD 6;
        goto Spawn_33+1;
    Death:
        SECR E 0 ACS_ExecuteAlways(929,0,4);
        SECR E 6 A_Scream;
        SECR FGHJKLMNO 6;
        SECR P -1;
        stop;

    }
}

