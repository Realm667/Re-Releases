class SparkleFountain_W : SwitchableDecoration
{
    Default
    {
//$Category Stronghold_SFX
    Height 0;
    Radius 0;
    +NoBlockMap +NoGravity +NoSector +NoInteraction +NoClip -Solid ;
    }
    States
    {
    Spawn:
    Active:
        TNT1 A 0;
        TNT1 A 1 A_CustomMissile("ParticleSpawnerWhite",0,0,random(0,360),2,0);
        Loop;
    Inactive:
        TNT1 A 1;
        Loop;

    }
}

