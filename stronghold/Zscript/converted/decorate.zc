class BaseWasteShower01 : Actor
{
    Default
    {
    +Missile;
    +NoBlockmap;
    +NoGravity;
    Radius 1;
    Height 1;
    RenderStyle "Add";
    Alpha 0.0;
    Scale 0.2;
    }
    States
    {
    Spawn:
        BLT0 AAAAAAAAAAAAAAAAAAAA 3  A_FadeIn(0.05);
        BLT0 A 50;
        BLT0 AAAAAAAAAAAAAAAAAAAA 3 A_FadeOut(0.05);
    Death:
        BLT0 A 1 A_FadeOut;
        Wait;

    }
}

