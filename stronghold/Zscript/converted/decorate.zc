///////////////
// FAKE GOAL //
///////////////

class FakeGoalBase : Actor
{
    Default
    {
    DamageFactor "MarineAlly",0;
    DamageFactor "CoreFriendly",0;
    DamageFactor "BossFactor",0;
    DamageFactor "BFGSplash",0;
    DamageFactor "Stunner",0;
    DamageFactor "Cyber2Factor",0.5;
    DamageFactor "STBoss",0.02;
    DamageFactor "STBossFactor",0.25;
    DamageFactor "Animate",0.1;
    radius 40;
    height 40;
    mass 0x7fffffff;
    scale 0.3;
    DeathSound "weapons/rocklx";
    RenderStyle "Add";
    +SHOOTABLE;
    +SOLID;
    +NOGRAVITY;
    +NOBLOOD;
    +DONTSPLASH;
    +FRIENDLY;
    }
    States
    {
    Spawn:
        TRGT A 1 A_SpawnItemEx("FakeGoalSparks",0,0,20,random(-3,3),random(-3,3),random(-3,3),0,SXF_TRANSFERTRANSLATION);
        loop;
    Death:
        TNT1 A 1 A_Scream;
        stop;

    }
}

class Goal_Red : FakeGoalBase
{
    Default
    {
    //$Category Stronghold
    Translation "80:111=170:191";
    }
    States
    {
    Death:
        TNT1 A 0 ACS_ExecuteAlways(926,0,1);
        Goto Super::Death;

    }
}

