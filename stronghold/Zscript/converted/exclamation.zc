class Exclamation : Actor
{
    Default
    {
    //$Category Stronghold
    scale 1.2;
    renderstyle "Add";
    +NOGRAVITY;
    +CLIENTSIDEONLY;
    }
    States
    {
    Spawn:
        EXCL A -1 Bright;
        loop;

    }
}
