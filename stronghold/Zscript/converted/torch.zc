class RedTorchFlare : Actor
{
    Default
    {
    +CLIENTSIDE;
    +NoGravity;
    +NoInteraction;
    +NoBlockmap;
    +ForceXYBillboard;
    +NoTeleport;
    RenderStyle "Add";
    Scale 0.4;
    Alpha 0.6;
    }
    States
    {
    Spawn:
        RFLR A 2 Bright;
        Stop;

    }
}

class RedTorchFire1 : RedTorchFlare
{
    Default
    {
    Alpha 1;
    Radius 0;
    Height 0;
    Scale 0.175;
    }
    States
    {
    Spawn:
        FIR1 ABCDEFG 1 Bright;
        FIR1 HIJKL 1 Bright A_FadeOut(0.15);
        Stop;

    }
}

class RedTorchFire2 : RedTorchFire1
{
    States
    {
    Spawn:
        FIR2 ABCDEFG 1 Bright;
        FIR2 HIJKL 1 Bright A_FadeOut(0.15);
        Stop;

    }
}

