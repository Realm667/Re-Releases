class GreenTorchFire1 : RedTorchFire1
{
    States
    {
    Spawn:
        FIG1 ABCDEFG 1 Bright;
        FIG1 HIJKL 1 Bright A_FadeOut(0.15);
        Stop;

    }
}

class GreenTorchFire2 : GreenTorchFire1
{
    States
    {
    Spawn:
        FIG2 ABCDEFG 1 Bright;
        FIG2 HIJKL 1 Bright A_FadeOut(0.15);
        Stop;

    }
}

class GreenTorchFlare : RedTorchFlare
{
    States
    {
    Spawn:
        GFLR A 2 Bright;
        Stop;

    }
}

class FXBurningBarrel : BurningBarrel replaces BurningBarrel
{
    States
    {
    Spawn:
        TNT1 A 0;
        TNT1 A 0 A_SpawnItemEx("BarrelFlare",0,0,30);
        TNT1 A 0 A_CheckSight(6);
        TNT1 A 0 A_Jump(128,2);
        FCAN AAA 0 A_SpawnItemEx("BarrelFire",Random(-6,6),Random(-6,6),Random(24,28),0.001 * Random(10,200),0.001 * Random(10,200),0.001 * Random(1000,2400));
        FCAN A 1;
        Goto Spawn;
        FCAN A 1;
        Goto Spawn;

    }
}

class BarrelFlare : RedTorchFlare
{
    Default
    {
 Scale 0.45;
 RenderStyle "Add";
 Alpha 1;
    }
    States
    {
    Spawn:
        RFLR A 2;
        Stop;

    }
}

class BarrelFire : RedTorchFire1
{
    Default
    {
 Scale 0.185;
    }
}

