//DECAL ANIMATOR
class RedUACPainter : Actor
{
    Default
    {

        Radius 2;
        Height 2;
        +NOINTERACTION
        +NOGRAVITY

    }
    States
    {

        Spawn:
            TNT1 A 0;
            //fall through
        Paint:
            TNT1 A 16 A_SpawnItemEx ("RedUPainter", 0, 0, 0, 100, 0, 0, 0, 0, 0);
            TNT1 A 16 A_SpawnItemEx ("RedAPainter", 0, 0, 0, 100, 0, 0, 0, 0, 0);
            TNT1 A 16 A_SpawnItemEx ("RedCPainter", 0, 0, 0, 100, 0, 0, 0, 0, 0);
            TNT1 A 32;
            loop;

    }
}
