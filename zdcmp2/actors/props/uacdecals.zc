//RED
class RedUPainter : Actor
{
    Default
    {

        Radius 2;
        Height 2;
        Damage 0;
        Speed 100;
        Decal "RedU";
        Projectile;
        //-ACTIVATEIMPACT
        //-ACTIVATECROSS
        +RIPPER
        +BLOODLESSIMPACT

    }
    States
    {

        Spawn:
            TNT1 A 1;
            loop;
        Death:
            TNT1 A 1;
            stop;

    }
}
class RedAPainter : RedUPainter
{
    Default
    {

        Decal "RedA";
    }
}
class RedCPainter : RedUPainter
{
    Default
    {

        Decal "RedC";
    }
}

