//Deimos moon from Doom episode 2 floating above Hell.
class DeimosMoon : Actor
{
    Default
    {

        Radius 2;
        Height 2;
        Scale 0.25;
        Alpha 0.75;
        Renderstyle "STYLE_Translucent";
        +NOGRAVITY
        +FORCEXYBILLBOARD
        +NOINTERACTION

    }
    States
    {

        Spawn:
            DEIM A -1;
            Stop;

    }
}
