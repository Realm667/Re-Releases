class ObjectiveMarker : MapMarker
{
    Default
    {

    }
    States
    {

        Spawn:
            EXCL A -1;
            Stop;

    }
}
class LogBook : FakeInventory
{
    Default
    {

        inventory.pickupmessage "You found a data log!";
        inventory.pickupsound "misc/k_pkup";
        +COUNTITEM

    }
    States
    {

        Spawn:
            LOGB ABCD 4 Bright;
            loop;

    }
}
class LogBookGold : LogBook
{
    Default
    {

        Translation "112:127=160:167", "152:159=80:111";
    }
}
class BlankCard : FakeInventory
{
    Default
    {

        inventory.pickupmessage "Picked up a blank keycard.";
        inventory.pickupsound "misc/k_pkup";
        +COUNTITEM

    }
    States
    {

        Spawn:
            GKEY A -1;
            stop;

    }
}
