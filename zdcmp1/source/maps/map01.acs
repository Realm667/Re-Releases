Script 44 (void)
{
    while (thingcount (0, 34))
	{
	delay (16);
	}

	thingsound(7, "doors/dr2_clos", 127);
	Light_ChangeToValue (58, 112);        //dull the pipe
	Light_ChangeToValue (59, 112);        //dull the pipe
	Light_ChangeToValue (60, 112);        //dull the pipe
}

