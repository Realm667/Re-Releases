/////////////////////////
// Checkpoint system   //
// Copyright (c) to    //
// BioHazard so neeya! //
/////////////////////////
int checkpoint = -1;
int lastSoloCheckpoint = -1;
int lastAutosaveTime = -10000;
int savedMilestones = 0;
script 220 (int set)
{
    if (GameType() == GAME_NET_COOPERATIVE)
    {
		checkpoint = set;
		hudmessagebold(s:"checkpoint ", i:set+1, s:" reached";HUDMSG_PLAIN,0,CR_GRAY,0.5,1.0,2.5);
	}
	ELSE
	{
		if (set != lastSoloCheckpoint && Timer() - lastAutosaveTime >= 15 * 35)
		{
			lastSoloCheckpoint = set;
			lastAutosaveTime = Timer();
			autosave();
		}
	}
}

script "ZDC_MilestoneAutosave" (int milestone)
{
	if (GameType() == GAME_NET_COOPERATIVE || bossdead || (savedMilestones & milestone)
		|| Timer() - lastAutosaveTime < 15 * 35) terminate;
	savedMilestones |= milestone;
	lastAutosaveTime = Timer();
	autosave();
}

script 221 respawn
{
	if (GameType() == GAME_NET_COOPERATIVE)
	{
		if (checkpoint != -1)
		{
			hudmessage(s:"warped to checkpoint ", i:checkpoint+1;HUDMSG_PLAIN,0,CR_GRAY,0.5,1.0,2.5);
			teleport(2000+(checkpoint*4)+playernumber());
		}
	}
}

