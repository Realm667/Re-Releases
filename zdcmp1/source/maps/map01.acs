script 268 (int messid) //scrolls down
{
	sethudsize(640,480,0);
	for (int i=0.0;i<235.0;i+=1.0)
	{
		if(messid == 1){hudmessagebold(s:"Project Leader";HUDMSG_FADEOUT,6,CR_BLUE,575.0,i,3.0,3.0);}
		if(messid == 2){hudmessagebold(s:"Decorate Monsters";HUDMSG_FADEOUT,6,CR_BLUE,575.0,i,3.0,3.0);}
		if(messid == 3){hudmessagebold(s:"Primary detailing team";HUDMSG_FADEOUT,6,CR_BLUE,550.0,i,3.0,3.0);}
		if(messid == 4){hudmessagebold(s:"Credits Sequence";HUDMSG_FADEOUT,6,CR_BLUE,575.0,i,3.0,3.0);}
		if(messid == 5){hudmessagebold(s:"BugFinders";HUDMSG_FADEOUT,6,CR_BLUE,575.0,i,3.0,3.0);}
		if(messid == 6){hudmessagebold(s:"Multiplayer Features";HUDMSG_FADEOUT,6,CR_BLUE,565.0,i,3.0,3.0);}
		if(messid == 7){hudmessagebold(s:"Special thanks to";HUDMSG_FADEOUT,6,CR_BLUE,575.0,i,3.0,3.0);}
		if(messid == 8){hudmessagebold(s:"Music";HUDMSG_FADEOUT,6,CR_BLUE,550.0,i,3.0,3.0);}
		if(messid == 9){hudmessagebold(s:"Intense Playtesting";HUDMSG_FADEOUT,6,CR_BLUE,572.0,i,3.0,3.0);}
		if(messid == 10){hudmessagebold(s:"More special thanks to";HUDMSG_FADEOUT,6,CR_BLUE,565.0,i,3.0,3.0);}
		if(messid == 11){hudmessagebold(s:"Uber mega thanks and stuff plus things";HUDMSG_FADEOUT,6,CR_BLUE,320.0,i,3.0,3.0);}
		if(messid == 12){hudmessagebold(s:"ZDoom 2.1.1 version";HUDMSG_FADEOUT,6,CR_BLUE,575.0,i,3.0,3.0);}
		delay(1);
	}
}

