script 7 (int which)
//first sequence -- Modified by HotWax
{
	Localambientsound ("misc/chat", 127);

	if((which == 1 && CheckInventory("RedSkull")) || (which == 2 && CheckInventory("BlueSkull"))) {
		ClearLineSpecial();
		if(c == 1) {
	print(s: "\cCSequence Complete");
	door_open (4, 30);
	} else {
	print(s:"\cC", s:count[c], s:" more to go");
	c++;
	}
    } else {
	if (which == 1) {
		Print(s:"\cCyou need a red skull to use this switch");
	} else {
		Print(s:"\cCyou need a blue skull to use this switch");
	}
	delay(35*2);
    }
}
//TORMENTOR667 END


// Graf Zahl's scripts

int power=0;

Script 700 OPEN // added by BioHazard
{
	setlineblocking(58,BLOCK_EVERYTHING);
	// Moved by HotWax, gear no longer magically appears when you need it
	spawnspot("PuzzGear1",13,14,0);
	thing_setspecial(14,ACS_Execute,10,0,0); // added by BioHazard

}

script 8(void)
{
	activatorsound ("*usefail", 127);
	delay(16);
	print(s:"\cGHmm...");
	delay(35);
	ceiling_raisebyvalue(12,64,64);
	door_open(14, 64);
	delay(70);
	ScriptCall("ZDCMP1Remaster", "RecordHint", 1, PlayerNumber());
	delay(70);
	if (CheckInventory("PuzzGear1")) { // HotWax: when you've found the gear before trying the switch
		print(s:"\cGHey! Maybe this gear-thingy I found will fix it!");
		delay(105);
	} else {
		GearMode = 1;
		print(s:"\cGSo where do I get some spare parts now...");
		delay(105);
		if (GameSkill() != SKILL_VERY_HARD)
		{
			if (GameSkill() != SKILL_HARD)
			{
				print(s:"\cGMaybe i can use the computer over there to check the parts inventory...");
				delay(70);
			}
		}
		if (GameSkill() != SKILL_VERY_HARD)
		{
			if (GameSkill() != SKILL_HARD)
			{
				Setlinespecial(57,ACS_Execute,14,0); // added by BioHazard
			}
		}
	}
	clearlinespecial();
	spawnspot("DoomImp",17,0,0);
	spawnspot("NamiDarkImp",18,0,0);
}


script 9(int cheat)
{
   if (!power && !cheat)
   {
      localambientsound ("misc/chat", 127);
      print(s:"\cCUnable to drain tank");
      delay(105);
      localambientsound ("misc/chat", 127);
      print(s:"\cCPlease restore power");
   }
   else
   {
      ScriptCall("ZDCMP1Remaster", "RecordHint", 6, -1);
      ACS_NamedExecuteAlways("ZDC_MilestoneAutosave", 0, 1);
      Ceiling_lowerbyvalue(15,2,128);
      ceiling_raisebyvalue(968,2,48);
      spawnspot("DoomImp",17,0,0);
      spawnspot("VoidDarkImp",18,0,0);
      setlineblocking(58,BLOCK_NOTHING);
      Floor_LowerToLowest (64, 64);
      clearlinespecial();
   }
}

script 10(void)
{
	ScriptCall("ZDCMP1Remaster", "RecordHint", 3, PlayerNumber());
