script 21 (void)  //Break a fan
{
    int var0;
    var0 = 8;
    setlinespecial (5, 0, 0, 0, 0, 0, 0);
    setlinetexture(5, SIDE_FRONT, TEXTURE_MIDDLE, "FAN03");
    setlinetexture(5, SIDE_BACK, TEXTURE_MIDDLE, "FAN03");
    setlineblocking(5,BLOCK_NOTHING);
    thingsound(14, "ELECNJ", 127);
    while(var0 > 0)
	{
	 Thing_Activate(14);
	 delay(random(const:16,70));
	 var0--;
	}
 }


