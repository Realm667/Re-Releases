script 990 (int wait,int dist,int height) // i (BioHazard) seperated this from the
{                                         // rest of the script cause i want to use
	int angle = 0;                        // it too! (and i simplified it too! :D )
	for(int i=51;i<59;i++)
	{
		Thing_ProjectileGravity(i, 237, angle, dist, height);
		thing_spawnnofog(i,239,0,0);
		angle += 45;
		delay(wait);
	}
}

