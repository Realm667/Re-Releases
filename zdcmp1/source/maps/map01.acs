// HotWax's scripts begin
script 22 OPEN { // Setup and Enjay's bosses
	SetLineBlocking(130, BLOCK_CREATURES);
	SetLineBlocking(131, BLOCK_CREATURES);
	for (int i=0; i<3; i++) switches[i]=0;

	while (ThingCount(T_NONE, 16)) delay(1);

	delay(20);
	Print(s:"\cGWow.  This is starting to get serious!");
}

script 23 (void) { // Door beyond bosses
	if (ThingCount(T_NONE, 16)) {
		localambientsound("misc/chat", 127);
		Print(s:"\cCKill the monsters first...");
	} else {
		Door_Raise(0, 16, 150);
	}
}




