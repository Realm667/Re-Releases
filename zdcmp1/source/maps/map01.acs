	delay(35/2);

	acs_execute(270,0,3); //Detailing
	ACS_Execute(267,0,3); //display Leha's's profile
	delay(35*17);
	delay(35/2);

	acs_execute(270,0,4); //credits
	ACS_Execute(267,0,4); //display Enjay's profile
	delay(35*18);

	acs_execute(270,0,5); //Bug spotters
	ACS_Execute(267,0,5); //display BioHazard's profile
	delay(35*17);

	ACS_Execute(267,0,6); //display Tormentor's profile
	delay(35*8);
	delay(35/2);
	delay(35/4);

	acs_execute(270,0,6); //Multiplay
	ACS_Execute(267,0,7); //display Graf's profile
	delay(35*18);

	acs_execute(270,0,7); //thanks
	ACS_Execute(267,0,8); //display Lexus's profile
	delay(35*18);

	acs_execute(270,0,8); //We hate you
	ACS_Execute(267,0,9); //display DD_133's profile
	delay(35*17);

	acs_execute(270,0,9); //we really hate you
	ACS_Execute(267,0,10); //display Grubber's profile
	delay(35*17);
	delay(35/2);

	acs_execute(270,0,10); //More special thanks
	ACS_Execute(267,0,11); //display Dochist's profile
	delay(35*18);
	delay(35/2);

	acs_execute(270,0,11); //viewers like you
	ACS_Execute(267,0,12); //display Giest's profile
	delay(35*17);

	acs_execute(270,0,12); // we <3 randy
}

