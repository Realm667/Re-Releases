script 270 (int messid) //saves code
{
	ACS_Execute(268,0,messid);
	ACS_Execute(269,0,messid);
}

script 214 (int automatic) // natural completion or authorized manual skip
{
	if (!automatic && !ScriptCall("ZDCMP1Remaster", "CanSkip", PlayerNumber())) terminate;
	int showReport = !automatic && !ScriptCall("ZDCMP1Results", "HasShown");
	// The original exit trigger remains valid; clean every finale producer.
	acs_terminate(133,0);
	acs_terminate(134,0);
	acs_terminate(259,0);
	acs_terminate(260,0);
	acs_terminate(261,0);
	acs_terminate(264,0);
	acs_terminate(265,0); //  STOP
	acs_terminate(266,0); //   THE
	acs_terminate(267,0); // PRESSES
	acs_terminate(268,0); //   !!!
	acs_terminate(269,0);
	acs_terminate(270,0);
	if (showReport)
	{
		acs_execute(271,0);
		terminate;
	}
	ScriptCall("ZDCMP1Remaster", "SetFinale", 0);
	changecamera(0,1,0);
	setplayerproperty(1,0,Prop_TotallyFrozen);
	fadeto(0,0,0,0.0,0.0);
	exit_normal(0);
}

script 271 (void) // map-specific completion report
{
	ScriptCall("ZDCMP1Remaster", "SetFinale", 3);
	thing_deactivate(60);
	teleport_nofog(59);
	setplayerproperty(1,1,Prop_TotallyFrozen);
	changecamera(135,1,0);
	fadeto(0,0,0,0.0,0.0);
	ScriptCall("ZDCMP1Results", "Begin");
}

script "ZDC_ShowCredits" (void)
{
	acs_execute(264,0);
}

script "ZDC_SkipFinale" (void)
{
	// Only the synchronized event handler requests this after boss death.
	ACS_ExecuteAlways(214, 0);
}

