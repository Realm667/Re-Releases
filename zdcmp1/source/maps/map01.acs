int bossdead=0;

script 133 (void)
{
	ScriptCall("ZDCMP1Remaster", "SetFinale", 1);
	ScriptCall("ZDCMP1Results", "Capture");

	acs_terminate(256,0); //stop the random fountains
	radius_quake(25,35*10,0,128,54);
	fadeto(1,1,1,1.0,10.0); //fade out for dramatic effect

	acs_execute(259,0); //start the fountains on command
	acs_execute(260,0); //more death show! :D
	acs_execute(261,0); //and MORE death show!! :D

	delay(35*5);
	acs_terminate(259,0); //stop the fountains
	acs_terminate(260,0); //stop the ring of fire
	acs_terminate(261,0); //stop the upwards comets

	delay(35*5);
	if (GameType() == GAME_NET_COOPERATIVE)
		acs_execute(271,0); //run report before the original credits
	else
		bossdead=1;
}

script 134 ENTER
{
    if (GameType() != GAME_NET_COOPERATIVE)
	{
		while (bossdead==0)
		{
			delay(2);
		}
		acs_execute(271,0); //run report before the original credits
	}
}

