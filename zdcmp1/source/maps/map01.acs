//Arena thing edited around by Xaser during that 2.1.0 remake period.//
//As such, some fights are a bit harder, but the whole arena thing is//
//much, much shorter in general. Hopefully this helps a wee bit. :P  //
//Any comments starting with <XM> are me saying stuff, obviously. :P //
///////////////////////////////////////////////////////////////////////

script 24 (void) { // Arena begin
	SetMusic("", 0, 0);
	ScriptCall("ZDCMP1SkyCycle", "BeginStorm");
	delay(35*2);
	Printbold(s:"\cGOh snap... that doesn't look good at all.");
	delay(35*5);
	ACS_Execute(57,0);
	delay(35);
	SetMusic("D_OBLVN");

	ACS_Execute(26, 0, 0, 0, 0);
}

// Who took 25?  grumble...grumble...grumble...

// <XM> Watch your back, Bio. :P

int arenadone = 0;

// <XM> some random information so I don't have to go back and forth between here and the map window.

//Spawnspot IDs -
//20 - 4, diamond
//21 - 4, square
//22 - 8, circle
//23 - 1, raft
//24 - 1, raft
//25 - 6, raft
//26 - 4, corners
//28 - bigass ring

script 26 (void) { // Game on!

   //<XM> Blast! This script makes Zen's look like an "ACS for Dummies" handbook. o_O


   //Wave 1 : Imp x4 (Removed for time's sake, as it's so easy it's pointless
   TagWait(76);
   /*
   Thing_SpawnFacing(20, T_IMP, 0, 20000); //<XM> I did not even know this existed until now. >_<
   if (GameSkill() == SKILL_VERY_HARD) Thing_SpawnFacing(21, T_IMP, 0, 20000);

   while(ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
      Thing_Remove(20000);
   }
   */

   //Wave 2 : Imp x8, Demon x4
   Thing_SpawnFacing(22, T_IMP, 0, 20000);
   if (GameSkill() == SKILL_HARD || GameSkill() == SKILL_VERY_HARD) Thing_SpawnFacing(20, T_DEMON, 0, 20000);
   if (GameSkill() == SKILL_VERY_HARD) Thing_SpawnFacing(21, T_SPECTRE, 0, 20000);
   while(ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
      Thing_Remove(20000);
   }

   if (GameSkill() == SKILL_HARD) {
      Thing_Spawn(23, T_STIMPACK, 0, 0);
      Thing_Spawn(24, T_STIMPACK, 0, 0);
   } else {
      Thing_Spawn(23, T_HEALTHBONUS, 0, 0);
      Thing_Spawn(24, T_HEALTHBONUS, 0, 0);
   }
   Thing_Spawn(25, T_HEALTHBONUS, 0, 0);
   delay(35*5);

   //Wave 3 : Lost Soul x8, Imp x4, Spectre x4
   if (GameSkill() == SKILL_HARD || GameSkill() == SKILL_VERY_HARD) {
	  //<XM>Spectres suck in this level because it's too bloody hard to see them!
      //Thing_SpawnFacing(20, T_SPECTRE, 0, 20000);
      Thing_SpawnFacing(20, T_DEMON, 0, 20000);
   } else {
      Thing_SpawnFacing(20, T_DEMON, 0, 20000);
   }
   Thing_SpawnFacing(21, T_IMP, 0, 20000);
   if (GameSkill() == SKILL_HARD) {
      Thing_SpawnFacing(22, T_LOSTSOUL, 0, 20000);
   } else if (GameSkill() == SKILL_VERY_HARD) {
      Thing_SpawnFacing(22, T_CACODEMON, 0, 20000);
   }
   while(ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
      Thing_Remove(20000);
   }

	//Wave 4 : Baron x4, Shotguy x4, Spectre x4
   if (GameSkill() == SKILL_HARD || GameSkill() == SKILL_VERY_HARD) {
      Thing_SpawnFacing(26, T_HELLKNIGHT, 0, 20000); //Used to be a baron, but 4 take too long to kill.
   } else if (GameSkill() == SKILL_VERY_EASY) {
      Thing_SpawnFacing(26, T_IMP, 0, 20000);
   } else {
      Thing_SpawnFacing(26, T_CACODEMON, 0, 20000);
   }

   delay(35*5);

   if (GameSkill() != SKILL_VERY_EASY && GameSkill() != SKILL_EASY) {
      //Thing_SpawnFacing(20, T_SPECTRE, 0, 20000);
      Thing_SpawnFacing(20, T_DEMON, 0, 20000);
      if (GameSkill() == SKILL_NORMAL) {
         Thing_SpawnFacing(21, T_ZOMBIE, 0, 20000);
      } else {
         Thing_SpawnFacing(21, T_SHOTGUY, 0, 20000);
      }
   }

   while(ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
      Thing_Remove(20000);
   }

   Thing_Spawn(27, T_CHAINGUN, 0, 0);
   Thing_Spawn(23, T_AMMOBOX, 0, 0);
   Thing_Spawn(24, T_AMMOBOX, 0, 0);
   Thing_Spawn(25, T_CLIP, 0, 0);

   delay(35*5);

	//Wave 5 : Insane amounts of Lost Souls (too extreme; changed to imps), Imp x8, Chainguy x4
   int hwcount = 2;
   //if (GameSkill() == SKILL_NORMAL) hwcount = 2;
   if (GameSkill() == SKILL_EASY) hwcount = 1;
   if (GameSkill() == SKILL_VERY_EASY) hwcount = 1;

   int i;
   for (i=0;i<hwcount;i++) {
      //<XM> Whoa... Lost Souls take WAAAAY too long to kill here. Maybe Imps would work better.
      //Thing_SpawnFacing(28, T_LOSTSOUL, 0, 20000);
      Thing_SpawnFacing(28, T_IMP, 0, 20000);
      delay(35*3);
   }
   delay(5*35);

   Thing_SpawnFacing(22, T_LOSTSOUL, 0, 20000);
   Thing_Spawn(27, T_SHOTGUN, 0, 0);
   Thing_Spawn(23, T_MEDKIT, 0, 0);
   Thing_Spawn(24, T_MEDKIT, 0, 0);
   if (GameSkill() == SKILL_HARD || GameSkill() == SKILL_VERY_HARD) {
      Thing_Spawn(25, T_SHELLBOX, 0, 0);
   } else {
      Thing_Spawn(25, T_SHELLS, 0, 0);
   }

   delay(5*35);

   if (GameSkill() == SKILL_VERY_HARD) {
      Thing_SpawnFacing(26, T_CHAINGUY, 0, 20000);
   } else {
      Thing_SpawnFacing(26, T_SHOTGUY, 0, 20000);
   }

   delay(5*35);

   if (GameSkill() == SKILL_VERY_EASY || GameSkill() == SKILL_EASY) {
      Thing_SpawnFacing(20, T_DEMON, 0, 20000);
      Thing_SpawnFacing(21, T_ZOMBIE, 0, 20000);
   } else {
      //Thing_SpawnFacing(20, T_SPECTRE, 0, 20000);
      Thing_SpawnFacing(20, T_DEMON, 0, 20000);
      Thing_SpawnFacing(21, T_SHOTGUY, 0, 20000);
   }
   Thing_Spawn(23, T_ARMORBONUS, 0, 0);
   Thing_Spawn(24, T_HEALTHBONUS, 0, 0);
   Thing_Spawn(25, T_CLIP, 0, 0);

   while(ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
      Thing_Remove(20000);
   }

	Printbold(s:"\cGHoly Hell on a Stick, they just keep on coming!");

   Thing_Spawn(27, T_BACKPACK, 0, 20000);
   Thing_Spawn(27, T_BACKPACK, 0, 0);
   Thing_Spawn(27, T_BACKPACK, 0, 0);
   Thing_Spawn(27, T_BACKPACK, 0, 0);
   Thing_Spawn(27, T_BACKPACK, 0, 0);
   Thing_Spawn(23, T_STIMPACK, 0, 0);
   Thing_Spawn(24, T_STIMPACK, 0, 0);
   Thing_Spawn(25, T_SHELLS, 0, 0);

   //Wave 6 : Randomized Chaingun guys

   while(ThingCount(T_NONE, 20000)) delay(1);
   delay(5*35);

   hwcount=10;
   if(GameSkill() == SKILL_VERY_HARD) hwcount=20; //Did he realize that VERY_HARD is Nightmare mode?
                                                  //I thought that would break the entire battle here
                                                  //as Thingcount doesn't work well with respawning
                                                  //monsters. :P

   for(i=0;i<hwcount;i++) { //Isn't it ironic that Hotwax put a chaingun sniping part in here? XD
      Spawn("MapSpot", 65536*(random(-5280, -3040)), 65536*(random(1120, 3296)), 65536*160, 20001, 0);
      if (GameSkill() == SKILL_VERY_EASY || GameSkill() == SKILL_EASY) {
         Thing_Spawn(20001, T_SHOTGUY, 0, 20000);
      } else {
         Thing_Spawn(20001, T_CHAINGUY, 0, 20000);
      }
      Thing_Remove(20001);
      if (GameSkill() == SKILL_VERY_EASY || GameSkill() == SKILL_NORMAL) {
         delay(2*35);
      } else if (GameSkill() == SKILL_VERY_HARD) {
         delay(20);
      } else {
         delay(40);
      }
   }

   while(ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
      Thing_Remove(20000);
   }


   Thing_Spawn(27, T_PLASMAGUN, 0, 0);
   Thing_Spawn(23, T_BATTERY, 0, 0);
   Thing_Spawn(24, T_BATTERY, 0, 0); //<XM> Eh, 'battery?' Odd naming for a Cellpack there...
   if (GameSkill() == SKILL_HARD || GameSkill() == SKILL_VERY_HARD) {
      Thing_Spawn(25, T_MEDKIT, 0, 0);
   } else {
      Thing_Spawn(25, T_STIMPACK, 0, 0);
   }

   delay(5*35);

   //Following wave removed for time and pointlessness

   /*

   if (GameSkill() == SKILL_VERY_EASY || GameSkill() == SKILL_EASY) {
      Thing_SpawnFacing(28, T_ZOMBIE, 0, 20000);
   } else {
      Thing_SpawnFacing(28, T_IMP, 0, 20000);
   }
   while (ThingCount(T_NONE, 20000)) delay(1);
   if (GameSkill() == SKILL_VERY_HARD) {
      delay(12);
