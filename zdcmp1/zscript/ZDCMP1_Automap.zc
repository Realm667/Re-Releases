// Native MapMarker rendering preserves zoom, panning, rotation and clipping.
class ZDCMapMarker : MapMarker
{
    Default
    {
        +DORMANT
        +NOTONAUTOMAP
        Radius 1;
        Height 1;
        Scale 1.0;
    }
    States
    {
    Spawn:
        ZDMA B -1;
        Stop;
    Objective:
        ZDMA A -1;
        Stop;
    Complete:
        ZDMA C -1;
        Stop;
    }
}

class ZDCCoopPing : ZDCMapMarker
{
    States
    {
    Spawn:
        ZDMA B -1;
        Stop;
    }
}

class ZDCMapGuide : Object
{
    static int Count() { return 13; }
    static bool Valid(int id) { return id >= 0 && id < Count(); }
    static int AllMask() { return (1 << Count()) - 1; }
    static bool Complete(int id) { return id == 6 || id == 7 || id == 9 || id == 11; }
    static bool Objective(int id) { return id >= 2 && id <= 5; }
    static bool IsRouteGoal(int id) { return id == 0 || Objective(id) || id == 8 || id == 10; }

    static int RouteGoal(int known, int delivered)
    {
        for (int id = 5; id >= 2; id--)
            if (Eligible(id, known, delivered)) return id;
        if (Eligible(8, known, delivered)) return 8;
        if (Eligible(10, known, delivered)) return 10;
        if (!(known & (1 << 1)) && Eligible(0, known, delivered)) return 0;
        return -1; // Reports about blocked machinery are not destinations.
    }

    static Vector2 RoutePosition(int id)
    {
        if (id == 8) return (488, 856); // Main-switch script 18, linedef 15012.
        if (id == 10) return (5056, 824); // Console thing 1966 executes script 46.
        Vector3 location = Position(id);
        return location.XY;
    }

    static ui String RouteTitle(int id)
    {
        if (id == 8) return StringTable.Localize("$ZDC_ROUTE_SWITCH");
        if (id == 10) return StringTable.Localize("$ZDC_ROUTE_CONSOLE");
        return ZDCLogUI.Title(id);
    }

    static bool Eligible(int id, int known, int delivered)
    {
        if (!Valid(id) || !(known & (1 << id))) return false;
        int superseded = 0;
        switch (id)
        {
        case 0: superseded = 1 << 7; break;
        case 1: superseded = (1 << 3) | (1 << 4) | (1 << 5); break;
        case 2: superseded = (1 << 3) | (1 << 4) | (1 << 5); break;
        case 3:
            if (!(known & (1 << 1))) return false; // No switch location before discovery.
            superseded = (1 << 4) | (1 << 5); break;
        case 4: superseded = 1 << 5; break;
        case 5: superseded = 1 << 6; break;
        case 8: superseded = 1 << 9; break;
        case 10: superseded = 1 << 11; break;
        }
        return !(delivered & superseded);
    }

    static Vector3 Position(int id)
    {
        // MAP01 geometry is release-locked and these anchors are verified by tests.
        if (id == 2) return (1120, 352, 8); // Gear spawn spot, TID 13.
        int index;
        switch (id)
        {
        case 0: case 7: index = 6183; break;
        case 1: case 3: case 4: index = 4080; break;
        case 5: case 6: index = 16183; break;
        case 8: case 9: index = 15634; break;
        case 10: case 11: index = 26576; break;
        default: index = 23199; break;
        }
        let line = level.lines[index];
        Vector2 point = (line.v1.p + line.v2.p) * .5;
        return (point.x, point.y, 0);
    }
}
