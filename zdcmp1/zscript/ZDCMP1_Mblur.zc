class MBlurShaderHandler : StaticEventHandler
{

	//===========================================================================
	// PIXEL EATER MOTIONBLUR EVENTHANDLERS
	//===========================================================================
	
	int			pitch, yaw ;
	ui double xtravel, ytravel;
	ui PlayerPawn previousPawn;
	
	override void WorldTick()
	{
		PlayerInfo	plr = players[ consoleplayer ];
		yaw = pitch = 0;
		if( plr && plr.health > 0 && plr.mo && Cvar.GetCVar( "motionblur", plr ).GetBool()
			&& !CVar.GetCVar("ZDCMP1_comfortpreset", plr).GetBool() )
		{
			yaw		= plr.mo.GetPlayerInput( ModInput_Yaw );
			pitch	= -plr.mo.GetPlayerInput( ModInput_Pitch );
		}
	}
	
	ui void UpdateTravel(PlayerInfo plr)
	{
		if (plr && plr.mo)
		{
			double pitchdimin = max(0.0, 1.0 - abs(plr.mo.pitch / 90.0));
			double decay = 1.0 - clamp(Cvar.GetCVar("motionblur_recovery", plr).GetFloat(), 0.0, 100.0) * .01;
			double amount = clamp(Cvar.GetCVar("motionblur_strength", plr).GetFloat(), 0.0, 100.0) * 10.0 / 32767 * sqrt(pitchdimin);
			xtravel				= xtravel * decay + yaw * amount * .625 ;
			ytravel				= ytravel * decay + pitch * amount ;
			
			if( Cvar.GetCVar( "motionblur_autostop", plr ).GetBool() )
			{
				double threshold = max(0.0, Cvar.GetCVar("motionblur_threshold", plr).GetFloat()) * 30;
				double recovery2 = 1.0 - clamp(Cvar.GetCVar("motionblur_recovery2", plr).GetFloat(), 0.0, 100.0) * .01;
				if( abs( yaw )		<= threshold ) xtravel *= recovery2 ;
				if( abs( pitch )	<= threshold ) ytravel *= recovery2 ;
			}
		}
	}
	
	override void UiTick()
	{
		PlayerInfo	plr = players[ consoleplayer ];
		if (!plr) { PPShader.SetEnabled("motionblur", false); return; }
		if (previousPawn != plr.mo)
		{
			previousPawn = plr.mo;
			xtravel = ytravel = 0;
		}
		if (plr.mo)
		{
			if( plr.health > 0 && Cvar.GetCVar( "motionblur", plr ).GetBool()
				&& !CVar.GetCVar("ZDCMP1_comfortpreset", plr).GetBool()
				&& !plr.mo.FindInventory("isIntro") )
			{
				if (paused) { PPShader.SetEnabled("motionblur", false); return; }
				UpdateTravel(plr);
				if (abs(xtravel) + abs(ytravel) < 0.01)
				{
					xtravel = ytravel = 0;
					PPShader.SetEnabled("motionblur", false);
					return;
				}
				
				int quality = clamp(ZDCMP1_fxquality, 0, 2);
				int copies = 1 + clamp(Cvar.GetCVar("motionblur_samples", plr).GetInt(), 1, 16);
				if (quality < 2) copies = min(copies, quality == 0 ? 2 : 4);
				double increment	= 1. / copies ;
				vector2 travel		= ( xtravel, ytravel ) / screen.getheight() ;
				
				PPShader.SetUniform2f("motionblur", "steps", travel * increment);
				PPShader.SetUniform1i("motionblur", "samples", copies);
				PPShader.SetUniform1f("motionblur", "increment", increment);
				PPShader.SetUniform1i("motionblur", "blendmode", Cvar.GetCVar("motionblur_blendmode", plr).GetInt());
					
				PPShader.SetEnabled("motionblur", true);
			}
			else
			{
				xtravel = ytravel = 0;
				PPShader.SetEnabled("motionblur", false);
			}
		}
		else
		{
			xtravel = ytravel = 0;
			PPShader.SetEnabled("motionblur", false);
		}
	}
}
