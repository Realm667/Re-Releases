// Map-scoped, serialized state. UI only reads it; ACS and player input own writes.
class ZDCMP1Remaster : EventHandler
{
    int hints[MAXPLAYERS];
    int readHints[MAXPLAYERS];
    ui Array<int> notices;
    ui int noticeAge;
    bool finale;
    bool skipRequested;

    static int CanSkip(int who)
    {
        let handler = ZDCMP1Remaster(EventHandler.Find("ZDCMP1Remaster"));
        return handler && handler.finale && ZDCMP1_skippablefinale && who == Net_Arbitrator;
    }

    static void RecordHint(int hint, int who)
    {
        let handler = ZDCMP1Remaster(EventHandler.Find("ZDCMP1Remaster"));
        if (!handler || hint < 0 || hint >= 13) return;
        for (int i = 0; i < MAXPLAYERS; i++)
            if (playeringame[i] && (who == -1 || who == i))
            {
                if (handler.hints[i] & (1 << hint)) continue;
                handler.hints[i] |= 1 << hint;
                EventHandler.SendInterfaceEvent(i, "zdc_hint", hint);
            }
    }

    override void NetworkProcess(ConsoleEvent e)
    {
        if (e.Name == "zdc_hintread" && e.Player >= 0 && e.Player < MAXPLAYERS
            && e.Args[0] >= 0 && e.Args[0] < 13)
            readHints[e.Player] |= hints[e.Player] & (1 << e.Args[0]);
    }

    override void InterfaceProcess(ConsoleEvent e)
    {
        if (e.Name != "zdc_hint" || e.Args[0] < 0 || e.Args[0] >= 13) return;
        if (!ZDCLogUI.Setting("ZDCMP1_hintnotifications")) return;
        for (int i = 0; i < notices.Size(); i++)
            if (notices[i] == e.Args[0]) return;
        if (notices.Size() < 13) notices.Push(e.Args[0]);
    }

    ui bool NoticeVisible()
    {
        let p = players[consoleplayer];
        return notices.Size() > 0 && !Menu.GetCurrentMenu() && !finale
            && p.mo && p.health > 0 && p.camera == p.mo;
    }

    override void UiTick()
    {
        if (!ZDCLogUI.Setting("ZDCMP1_hintnotifications"))
        {
            notices.Clear();
            noticeAge = 0;
        }
        if (!NoticeVisible()) return;
        if (noticeAge == 0 && ZDCLogUI.Setting("ZDCMP1_hintsound"))
            S_StartSound("misc/chat", CHAN_AUTO, CHANF_UI, 0.3);
        if (++noticeAge >= clamp(ZDCLogUI.Setting("ZDCMP1_hintduration"), 3, 15) * 35)
        {
            notices.Delete(0);
            noticeAge = 0;
        }
    }

    static void SetFinale(int enabled)
    {
        let handler = ZDCMP1Remaster(EventHandler.Find("ZDCMP1Remaster"));
        if (!handler) return;
        handler.finale = enabled != 0;
        if (!enabled)
            for (int i = 0; i < MAXPLAYERS; i++)
                if (playeringame[i] && players[i].mo)
                {
                    players[i].mo.TakeInventory("CutsceneEnabled", 1);
                    players[i].mo.TakeInventory("isIntro", 1);
                }
    }

    override void WorldTick()
    {
        for (int i = 0; i < MAXPLAYERS; i++)
        {
            if (!playeringame[i] || !players[i].mo) continue;
            let p = players[i];
            bool cinematic = finale || (p.health > 0 && p.camera && p.camera != p.mo);
            if (cinematic)
            {
                if (!p.mo.FindInventory("CutsceneEnabled")) p.mo.GiveInventory("CutsceneEnabled", 1);
                if (!p.mo.FindInventory("isIntro")) p.mo.GiveInventory("isIntro", 1);
            }
            else
            {
                p.mo.TakeInventory("CutsceneEnabled", 1);
                p.mo.TakeInventory("isIntro", 1);
            }
            // Only the host can end a shared finale. Edge-triggered to avoid
            // skipping it when USE was held before the boss died.
            if (finale && !skipRequested && ZDCMP1_skippablefinale && i == Net_Arbitrator
                && (p.cmd.buttons & BT_USE) && !(p.oldbuttons & BT_USE))
            {
                skipRequested = true;
                p.mo.ACS_NamedExecuteAlways("ZDC_SkipFinale", 0);
            }
        }
    }

    override void RenderOverlay(RenderEvent e)
    {
        if (NoticeVisible()) ZDCLogUI.Notice(notices[0], min(1., noticeAge / 7.));
        if (!finale || !ZDCMP1_skippablefinale) return;
        String text = StringTable.Localize(multiplayer && consoleplayer != Net_Arbitrator ? "$ZDC_SKIPHOST" : "$ZDC_SKIP");
        Screen.DrawText(SmallFont, Font.CR_WHITE, 320, 345, text,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_CenterOffset, true);
    }
}
