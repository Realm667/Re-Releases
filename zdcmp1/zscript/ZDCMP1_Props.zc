Class LightRay_Regular : SwitchableDecoration
{
	override void Tick()
	{
		Super.Tick();
		if (bDormant || ZDCMP1_fxquality == 0) return;
		Alpha = 0.90 + 0.06 * sin(level.time * 0.8 + Pos.X * 0.03);
		if (level.time % 13 != int(abs(Pos.X)) % 13
			|| (ZDCMP1_fxquality == 1 && (level.time / 13) % 2 != 0)) return;
		for (int i = 0; i < MAXPLAYERS; i++)
			if (playeringame[i] && players[i].camera
				&& Distance2D(players[i].camera) < 768)
			{
				A_SpawnParticle(0xffc8d6d9, lifetime: 35, size: 1.5,
					xoff: frandom[rnd_ZDCCosmetic](-14, 14),
					yoff: frandom[rnd_ZDCCosmetic](-14, 14),
					zoff: frandom[rnd_ZDCCosmetic](-12, 12),
					velz: 0.12, startalphaf: 0.24);
				break;
			}
	}

	Default
	{
		//$Category "ZDCMP1 Effects"
		//DistanceCheck "ZDCMP1_lod";
		Radius 8;
		Height 8;
		RenderStyle "Translucent";
		Alpha 1.0;
		+NOBLOCKMAP
		+NOGRAVITY
	}
	States
	{
	Spawn:
	Active:
		VOLT A -1 Bright;
		Stop;
	Inactive:
		VOLT A 1;
		TNT1 A -1;
		Stop;
	}
}

Class LightRay_WallSprite : LightRay_Regular
{
	Default
	{
		DistanceCheck "ZDCMP1_lod";
		+ROLLSPRITE
		+WALLSPRITE
	}
}

