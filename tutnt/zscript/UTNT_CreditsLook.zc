// Ash & Ember: bounded geometry-depth reconstruction for custom scene shaders.
// UZDoom does not expose its depth buffer here. 16x9 rays sample static geometry
// once per game tic; sprite depth is approximated by its surrounding geometry.
class UTNTCreditsLook : Object ui
{
 double Depth[144],Blur[144],PreviousBlur[144];
 int SampleTic,LastPage,LastPhase,TraceCount,ResetCount;
 bool Ready,Enabled,LastSampleCut;
 double FocusDistance,MinDepth,MaxDepth,SampleRatio,SampleFov,MaxBlurStep;
 // World-distance ramps: near blur grows across at least 320 units, far across 768.
 double BlurAtDepth(double z)
 {
  double offset=z-FocusDistance,onset=max(48,FocusDistance*.15);
  double span=offset<0?max(320,FocusDistance*1.1):max(768,FocusDistance*2.5);
  double t=clamp((abs(offset)-onset)/span,0,1);
  return t*t*(3-2*t);
 }
 void Update(UTNTCreditsHandler h,RenderEvent e)
 {
  if(!e.Camera || e.Camera!=h.ViewCamera){Enabled=false;PPShader.SetEnabled("UTNTEndingLook",false);return;}
  String shader="UTNTEndingLook";
  int vx,vy,vw,vh;[vx,vy,vw,vh]=Screen.GetViewWindow();
  double ratio=vw/double(max(1,vh)),fov=e.Camera.CameraFOV;
  double ty=tan(clamp(fov,5,170)*.5)/min(ratio,4.0/3.0),tx=ty*ratio;
  Vector3 forward=(cos(e.ViewAngle)*cos(e.ViewPitch),sin(e.ViewAngle)*cos(e.ViewPitch),-sin(e.ViewPitch));
  Vector3 right=(sin(e.ViewAngle),-cos(e.ViewAngle),0);
  Vector3 up=(cos(e.ViewAngle)*sin(e.ViewPitch),sin(e.ViewAngle)*sin(e.ViewPitch),cos(e.ViewPitch));
  Vector3 rollRight=right*cos(e.ViewRoll)+up*sin(e.ViewRoll);
  up=up*cos(e.ViewRoll)-right*sin(e.ViewRoll);right=rollRight;
  bool cut=!Ready || LastPage!=h.Page || LastPhase!=h.Phase || level.time<SampleTic || SampleRatio!=ratio || abs(SampleFov-fov)>5;
  Vector3 target=h.HasSparkFocus?h.SparkFocus:e.ViewPos+forward*1024;
  if(h.Phase==0)
  {
   target=(64,-1088,48);
  }
  Vector3 delta=target-e.ViewPos;
  // Plane distance keeps equally distant points sharp across a wide field of view.
  FocusDistance=clamp(delta.X*forward.X+delta.Y*forward.Y+delta.Z*forward.Z,64,8192);
  if(cut || SampleTic!=level.time)
  {
   let trace=new('LineTracer');MinDepth=8192;MaxDepth=0;MaxBlurStep=0;LastSampleCut=cut;if(cut)ResetCount++;
   for(int y=0;y<9;y++)for(int x=0;x<16;x++)
   {
    Vector3 ray=(forward+right*((x+.5)/16*2-1)*tx+up*((y+.5)/9*2-1)*ty).Unit();
    trace.Trace(e.ViewPos,level.PointInSector(e.ViewPos.XY),ray,8192,TRACE_HitSky,wallMask:0,ignoreAllActors:true,ignore:e.Camera);
    double d=8192;
    if(trace.Results.HitType!=TRACE_HitNone && trace.Results.HitType!=TRACE_HasHitSky)
    {
     Vector3 hit=trace.Results.HitPos-e.ViewPos;
     d=clamp(hit.X*forward.X+hit.Y*forward.Y+hit.Z*forward.Z,8,8192);
    }
    int i=y*16+x;Depth[i]=d;
    // Interpolate blur, never near/far depth: that would invent a sharp plane at edges.
    double desired=BlurAtDepth(d);
    PreviousBlur[i]=cut?desired:Blur[i];
    Blur[i]=cut?desired:Blur[i]+clamp((desired-Blur[i])*.22,-.06,.06);
    MaxBlurStep=max(MaxBlurStep,abs(Blur[i]-PreviousBlur[i]));
    MinDepth=min(MinDepth,Depth[i]);MaxDepth=max(MaxDepth,Depth[i]);TraceCount++;
   }
   SampleTic=level.time;Ready=true;LastPage=h.Page;LastPhase=h.Phase;SampleRatio=ratio;SampleFov=fov;
  }
  // Three 8-bit blur values fit exactly in one float; interpolate between game tics.
  double words[48];
  for(int i=0;i<48;i++)
  {
   words[i]=0;
   for(int j=0;j<3;j++)
   {
    int n=i*3+j;double b=PreviousBlur[n]+(Blur[n]-PreviousBlur[n])*clamp(e.FracTic,0,1);
    words[i]+=floor(b*255+.5)*(1<<(j*8));
   }
  }
  for(int i=0;i<12;i++)PPShader.SetUniform4f(shader,String.Format("blur%d",i),(words[i*4],words[i*4+1],words[i*4+2],words[i*4+3]));
  PPShader.SetUniform4f(shader,"viewport",(vx/double(Screen.GetWidth()),1-(vy+vh)/double(Screen.GetHeight()),vw/double(Screen.GetWidth()),vh/double(Screen.GetHeight())));
  // During the high descent keep a wider focal range; tighten gently at the crater.
  double arrival=h.Phase==1?clamp((level.time-h.PageStart-385)/280.0,0,1):1;
  arrival=arrival*arrival*(3-2*arrival);
  PPShader.SetUniform1f(shader,"aperture",h.Phase==0?12:6+8*arrival);
  PPShader.SetUniform1f(shader,"strength",1);
  PPShader.SetUniform1f(shader,"grainTime",floor((level.time+e.FracTic)/3));
  Enabled=true;PPShader.SetEnabled(shader,true);
 }
}
