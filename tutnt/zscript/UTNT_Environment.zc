#include "zscript/UTNT_EnvironmentOptics.zc"
#include "zscript/UTNT_LocalHeat.zc"
// Presentation only. No sector geometry, collision, action or gameplay RNG writes.
class UTNTEnvironment : EventHandler
{
 bool Ready;
 ui UTNTEnvironmentOptics Optics;
 String SnowNames;
 int ProbeCursor, NearCursor, Prints, MechanismBursts, SurfaceChecks, DustPuffs;
 Array<UTNTEnvironmentSurface> Surfaces;
 Array<int> NearSurfaces;
 Array<UTNTMechanismWatch> Mechanisms;
 Array<UTNTMechanismQuakeGroup> QuakeGroups;
 Array<UTNTFootState> Feet;
 Array<UTNTFootMark> Marks;
 LineTracer Probe;
 clearscope static bool Option(Name key)
 { return consoleplayer>=0 && CVar.GetCVar(key,players[consoleplayer]).GetBool(); }
 clearscope static int Quality()
 { return consoleplayer<0?0:clamp(CVar.GetCVar('UTNT_fxquality',players[consoleplayer]).GetInt(),0,3); }
 clearscope static bool Reduced() { return Option('UTNT_reducedfx'); }
 static UTNTEnvironment Get() { return UTNTEnvironment(EventHandler.Find('UTNTEnvironment')); }
 clearscope static bool Snow(String textureName) { let h=UTNTEnvironment(EventHandler.Find('UTNTEnvironment'));return textureName.IndexOf("SNOW")>=0 || (h && h.SnowNames.IndexOf(String.Format("|%s|",textureName))>=0); }
 clearscope static bool Water(String textureName)
 { return (textureName.IndexOf("WAT")>=0 && textureName.IndexOf("QWATERT6")<0) || textureName=="FWATER1"; }
 clearscope static String Medium(Actor camera)
 {
  let sec=camera.CurSector;double z=camera.Pos.Z+camera.Height*.5;
  for(int i=0;i<sec.Get3DFloorCount();i++)
  {
   let water=sec.Get3DFloor(i);
   if((water.flags & F3DFloor.FF_SWIMMABLE) && z<water.top.ZatPoint(camera.Pos.XY) && z>water.bottom.ZatPoint(camera.Pos.XY))
    return TextureSource(TexMan.GetName(water.GetTexture(1)));
  }
  return TextureSource(TexMan.GetName(sec.heightsec?sec.heightsec.GetTexture(Sector.floor):sec.GetTexture(Sector.floor)));
 }
 clearscope static String TextureSource(String name)
 {
  let h=UTNTEnvironment(EventHandler.Find('UTNTEnvironment'));
  return h && name.Left(2)=="EV"?UTNTEnvironmentSurface.SourceName(name,h):name;
 }
 override void WorldLoaded(WorldEvent e) { PPShader.SetEnabled("UTNTUnderwaterAtmosphere",false); }
 override void WorldUnloaded(WorldEvent e) { PPShader.SetEnabled("UTNTUnderwaterAtmosphere",false); }
 override void WorldTick()
 {
  if(!Ready && level.time>=5) Initialize();
  if(!Ready || level.isFrozen() || LevelLocals.WorldPaused())return;
  // Older saves have mechanism watchers but no serialized quake groups.
  if(Mechanisms.Size()>0 && QuakeGroups.Size()==0)BuildQuakeGroups();
  for(int i=Marks.Size()-1;i>=0;i--)if(!Marks[i])Marks.Delete(i);
  for(int i=0;i<MAXPLAYERS;i++)
  {
   if(i>=Feet.Size())Feet.Push(new('UTNTFootState'));
   Feet[i].Update(i,self);
  }
  for(int i=0;i<Mechanisms.Size();i++)Mechanisms[i].Update(self);
  for(int i=0;i<QuakeGroups.Size();i++)QuakeGroups[i].Update();
  // Surface maintenance shares the bounded probe queue.
  UpdateSurfaces();
  if(level.time%7==0)for(int i=0;i<Surfaces.Size();i++)Surfaces[i].UpdateReflection();
 }
 void Initialize()
 {
  Ready=true;Probe=new('LineTracer');
  int snowLump=Wads.CheckNumForFullName("environment/snowtextures.txt");if(snowLump>=0)SnowNames=Wads.ReadLump(snowLump);
  ReadSurfaces();
  // Candidate tables derive from door/lift actions and actual sector tags.
  int lump=Wads.CheckNumForFullName(String.Format("environment/%s-mechanisms.txt",level.MapName));
  if(lump>=0)
  {
   Array<String> rows;Wads.ReadLump(lump).Split(rows,"\n",TOK_SKIPEMPTY);
   for(int i=0;i<rows.Size();i++)
   {
    Array<String> r;rows[i].Split(r,"|",TOK_KEEPEMPTY);if(r.Size()!=5)continue;
    int si=r[0].ToInt();if(si<0 || si>=level.Sectors.Size())continue;
    bool duplicate=false;for(int j=0;j<Mechanisms.Size();j++)if(Mechanisms[j].Sec.Index()==si){duplicate=true;break;}if(duplicate)continue;
    let m=new('UTNTMechanismWatch');m.Sec=level.Sectors[si];m.Point=(r[1].ToDouble(),r[2].ToDouble());
    m.Stone=r[3].ToInt()!=0;m.Group=r[4].ToInt();
    m.Floor=m.Sec.floorplane.ZatPoint(m.Point);m.Ceiling=m.Sec.ceilingplane.ZatPoint(m.Point);Mechanisms.Push(m);
   }
  }
  BuildQuakeGroups();
 }
 void BuildQuakeGroups()
 {
  Array<int> lookup;lookup.Resize(level.Sectors.Size());for(int i=0;i<lookup.Size();i++)lookup[i]=-1;
  for(int i=0;i<Mechanisms.Size();i++){lookup[Mechanisms[i].Sec.Index()]=i;Mechanisms[i].Measure();}
  for(int i=0;i<Mechanisms.Size();i++)
  {
   let first=Mechanisms[i];if(first.QuakeGroup)continue;
   let group=new('UTNTMechanismQuakeGroup');QuakeGroups.Push(group);group.Members.Push(first);first.QuakeGroup=group;
   for(int j=0;j<group.Members.Size();j++)
   {
    let m=group.Members[j];group.TotalArea+=m.Area;
    for(int k=0;k<m.Sec.Lines.Size();k++)
    {
     let line=m.Sec.Lines[k];let neighbor=line.FrontSector==m.Sec?line.BackSector:line.FrontSector;
     if(!neighbor)continue;int index=lookup[neighbor.Index()];if(index<0)continue;
     let next=Mechanisms[index];if(next.QuakeGroup || m.Group<=0 || next.Group!=m.Group)continue;
     next.QuakeGroup=group;group.Members.Push(next);
    }
   }
  }
 }
 void ReadSurfaces()
 {
  int lump=Wads.CheckNumForFullName(String.Format("environment/%s-surfaces.txt",level.MapName));if(lump<0)return;
  Array<String> rows;Wads.ReadLump(lump).Split(rows,"\n",TOK_SKIPEMPTY);
  for(int i=0;i<rows.Size();i++)
  {
   Array<String> r;rows[i].Split(r,"|",TOK_KEEPEMPTY);if(r.Size()!=16)continue;
   let s=new('UTNTEnvironmentSurface');
   s.Kind=r[0].ToInt();s.Index=r[1].ToInt();s.Part=r[2].ToInt();s.Original=r[3];s.Alias=r[4];s.Base=r[5].ToInt();
   s.Origin=(r[6].ToDouble(),r[7].ToDouble(),r[8].ToDouble());s.Axis=(r[9].ToDouble(),r[10].ToDouble(),r[11].ToDouble());
   s.Width=r[12].ToDouble();s.Height=r[13].ToDouble();s.NX=r[14].ToInt();s.NY=r[15].ToInt();
   if(!s.Bind()){Console.Printf("ENVIRONMENT_BIND_SKIPPED|%s|%d|%d|%s",level.MapName,s.Kind,s.Index,s.Original);continue;}
   for(int j=0;j<s.NX*s.NY;j++){s.Wet.Push(0);s.Exposed.Push(0);s.Checked.Push(false);s.LastCheck.Push(level.time);}
   Surfaces.Push(s);
  }
 }
 void UpdateSurfaces()
 {
  if(!Surfaces.Size())return;
  if(level.time%35==5 && consoleplayer>=0 && players[consoleplayer].camera)
  {
   NearSurfaces.Clear();Vector2 eye=players[consoleplayer].camera.Pos.XY;
   for(int i=0;i<Surfaces.Size();i++)
   {
    let s=Surfaces[i];Vector2 center=s.Kind==0?s.Origin.XY+(s.Width*.5,s.Height*.5):s.Origin.XY+s.Axis.XY*s.Width*.5;
    if((center-eye).Length()<1536+max(s.Width,s.Height)*.5)NearSurfaces.Push(i);
   }
  }
  let w=UTNTWeatherSystem.Find();
  // A fixed small probe budget; unrelated to particle count or current FPS.
  for(int tries=0;tries<24;tries++)
  {
   if(ProbeCursor>=Surfaces.Size())ProbeCursor=0;
   let s=Surfaces[ProbeCursor++];s.Maintain();s.Update(self,w);
   if(NearSurfaces.Size() && tries<16){if(NearCursor>=NearSurfaces.Size())NearCursor=0;Surfaces[NearSurfaces[NearCursor++]].Update(self,w);}
  }
 }
 void StepMark(Actor mo,Vector3 position,bool snow,double opacity,bool left)
 {
  if(!Option('UTNT_footprints') || !Quality())return;
  int limit=Quality()==3?160:Quality()==2?80:32;if(Marks.Size()>=limit){if(Marks[0])Marks[0].Destroy();Marks.Delete(0);}
  let sec=level.PointInSector(position.XY);
  Probe.Trace(position+(0,0,16),sec,(0,0,-1),40,0,wallMask:0,ignoreAllActors:true);
  if(Probe.Results.HitType!=TRACE_HitFloor)return;
  Vector3 hit=Probe.Results.HitPos;
  if(abs(hit.Z-mo.FloorZ)>2)return;
  // Four corners must have support at the expected plane, also at ledges/3D floors.

  let floorSec=Probe.Results.HitSector;let rover=Probe.Results.ffloor;
  for(int a=0;a<4;a++)
  {
   double angle=mo.Angle+45+a*90;Vector3 q=hit+(cos(angle)*7,sin(angle)*7,16);
   Probe.Trace(q,level.PointInSector(q.XY),(0,0,-1),32,0,wallMask:0,ignoreAllActors:true);
   if(Probe.Results.HitType!=TRACE_HitFloor || abs(Probe.Results.HitPos.Z-hit.Z)>5)return;
  }
  let mark=UTNTFootMark(Actor.Spawn('UTNTFootMark',hit+(0,0,.08)));if(!mark)return;
  mark.Angle=mo.Angle-90;mark.Scale=(.25,.25);mark.Snow=snow;mark.InitialAlpha=opacity;
  mark.Rover=rover;mark.Support=floorSec;mark.HeightOffset=floorSec?hit.Z-floorSec.floorplane.ZatPoint(hit.XY):0;
  mark.PlaneHeight=hit.Z;
  if(snow)mark.SetStateLabel('Snow');
  if(floorSec && abs(mark.HeightOffset)<1)NashGoreStatics.AlignToPlane(mark);
  Marks.Push(mark);Prints++;
 }
 void EmitDust(UTNTMechanismWatch source)
 {
  if(!Option('UTNT_mechanismfx') || Reduced() || !Quality() || consoleplayer<0)return;
  let p=players[consoleplayer].camera;if(!p)return;
  source.Measure();
  Vector2 low=source.Low,high=source.High;
  Vector2 nearest=(clamp(p.Pos.X,low.X,high.X),clamp(p.Pos.Y,low.Y,high.Y));
  double plane=source.CeilingMoving?source.Sec.ceilingplane.ZatPoint(nearest):source.Sec.floorplane.ZatPoint(nearest);
  if((p.Pos-(nearest.X,nearest.Y,plane)).Length()>1200 || source.Area<=0)return;
  // Friction follows contact length: no dust in the middle of a moving plane.
  double contact=source.ContactLength();if(contact<=0)return;
  double rate=min(4,contact/1024.0*.36)*(Quality()==3?1:Quality()==2?.60:.30);
  int count=int(rate);if(source.RandomUnit()<rate-count)count++;
  int emitted=0;
  for(int puff=0;puff<count;puff++)
  {
   bool found;Vector2 point;[found,point]=source.GuidePoint();
   if(!found)continue;
   double phase=source.RandomUnit()*3600;
   double floor=source.Sec.floorplane.ZatPoint(point),ceiling=source.Sec.ceilingplane.ZatPoint(point);
   double z=source.IsDoor?floor+4+source.RandomUnit()*max(0,ceiling-floor-8):source.CeilingMoving?ceiling-18:floor+18;
   if(ceiling-floor<40)continue;
   let d=UTNTEnvironmentDust(level.SpawnClientSideVisualThinker('UTNTEnvironmentDust'));if(!d)continue;
   d.Support=source.Sec;d.Carry=source.IsDoor?0:.22;d.FromCeiling=source.CeilingMoving;d.PlaneZ=source.CeilingMoving?ceiling:floor;d.Pos=(point.X,point.Y,z);d.Prev=d.Pos;
   double size=.34+.22*abs(sin(phase*2.17));
   d.Phase=phase;d.Life=70+int(40*abs(sin(phase*1.93)));
   d.Vel=(cos(phase)*.34,sin(phase)*.34,(source.CeilingMoving?-1:1)*(.18+.28*abs(cos(phase*3.1))));
   int variant=abs(int(phase*31))%4;
   d.Texture=TexMan.CheckForTexture(variant==0?"graphics/environment/mechanism-dust.png":String.Format("graphics/environment/mechanism-dust-%d.png",variant));
   d.Scale=(size,size*(.65+.5*abs(sin(phase*.91))));
   double clearance=18*d.Scale.Y/.4;
   if(ceiling-floor<clearance*2+8){d.Destroy();continue;}
   d.Pos.Z=clamp(d.Pos.Z,floor+clearance,ceiling-clearance);d.Prev=d.Pos;
   if(!d.FitWalls()){d.Destroy();continue;}
   d.Flags=SPF_ROLL|SPF_STRETCHPIXELS;
   d.Roll=d.PrevRoll=(source.CeilingMoving?180:0)+sin(phase*1.3)*16;
   d.bXFlip=sin(phase*2.7)<0;
   d.Alpha=0;d.BaseAlpha=(source.Stone?.42:.20)*(.8+.4*abs(cos(phase*1.7)));
   d.SetRenderStyle(STYLE_Translucent);d.LightLevel=clamp(source.Sec.LightLevel,128,224);emitted++;DustPuffs++;source.EmissionCursor++;
   source.LastBurst=level.time;MechanismBursts++;
  }
 }
 override void RenderOverlay(RenderEvent e)
 {
  PPShader.SetEnabled("UTNTUnderwaterAtmosphere",false);
  if(e.Camera && e.Camera.WaterLevel>=3 && Option('UTNT_underwateratmosphere') && !Reduced())
  {
   if(!Optics)Optics=new("UTNTEnvironmentOptics");Optics.Update(e,"UTNTUnderwaterAtmosphere");
   String medium=Medium(e.Camera);
   Vector3 tint=medium.IndexOf("SLIME")>=0?(.40,.62,.28):medium.IndexOf("QWATERT6")>=0?(.62,.23,.19):(.35,.62,.72);
   PPShader.SetUniform3f("UTNTUnderwaterAtmosphere","waterTint",tint);
   PPShader.SetUniform1f("UTNTUnderwaterAtmosphere","waterDensity",clamp(e.Camera.WaterDepth/1000.0+.06,.06,.22));
   PPShader.SetEnabled("UTNTUnderwaterAtmosphere",true);
  }
  let c=TexMan.GetCanvas('UENVSTATE');if(!c)return;
  c.Clear(0,0,256,256,Color(0,0,0));
  bool wet=Option('UTNT_wetsurfaces') && Quality()>0;
  for(int i=0;i<Surfaces.Size();i++)
  {
   let s=Surfaces[i];
   for(int j=0;j<s.Wet.Size();j++)
   {
    int index=s.Base+j;int value=wet?int(clamp(s.Wet[j],0,1)*255):0;
    // Merge adjacent cells with equal state into one canvas command.
    int end=j;
    while(end+1<s.Wet.Size() && (s.Base+end+1)/256==index/256)
    {
     int next=wet?int(clamp(s.Wet[end+1],0,1)*255):0;
     if(next!=value)break;end++;
    }
    if(value || s.Reflecting)c.Clear(index%256,index/256,(s.Base+end)%256+1,index/256+1,Color(value,s.Reflecting?64:0,0));
    j=end;
   }
  }
 }
 override void NetworkProcess(ConsoleEvent e)
 {
  if(e.Name!="environmentstats")return;
  int exposed=0;double wet=0;for(int i=0;i<Surfaces.Size();i++)for(int j=0;j<Surfaces[i].Wet.Size();j++){if(Surfaces[i].Exposed[j]>0)exposed++;wet+=Surfaces[i].Wet[j];}
  Console.Printf("MECHANISM_QUAKE|noclip=%d|intensity=%.2f|enabled=%d|reduced=%d",(players[consoleplayer].cheats & CF_NOCLIP)!=0,CVar.GetCVar('r_quakeintensity').GetFloat(),Option('UTNT_mechanismfx'),Reduced());
  Console.Printf("ENVIRONMENT|surfaces=%d|checks=%d|exposed=%d|wet=%.3f|prints=%d|mechanisms=%d|bursts=%d|dust=%d",Surfaces.Size(),SurfaceChecks,exposed,wet,Prints,Mechanisms.Size(),MechanismBursts,DustPuffs);
 }
}

class UTNTFootState : Object play
{
 Actor Last;Vector3 Previous;double Distance,WetSole;bool Left;
 void Update(int index,UTNTEnvironment h)
 {
  let playerInfo=players[index];let mo=playeringame[index]?playerInfo.mo:null;
  if(!mo || mo.Health<=0){Last=null;WetSole=Distance=0;return;}
  if(Last!=mo || (mo.Pos-Previous).Length()>128){Last=mo;Previous=mo.Pos;Distance=0;WetSole=0;return;}
  Vector3 movement=mo.Pos-Previous;double travel=movement.XY.Length();Previous=mo.Pos;
  WetSole=max(0,WetSole-1.0/700);
  String liquid=UTNTEnvironment.Medium(mo);
  if(mo.WaterLevel>=1 && UTNTEnvironment.Water(liquid))WetSole=1;
  if(!playerInfo.onground || mo.WaterLevel>1 || travel<.1)return;
  String textureName=TexMan.GetName(mo.CurSector.GetTexture(Sector.floor));
  if(textureName.Left(2)=="EV")textureName=UTNTEnvironmentSurface.SourceName(textureName,h);
  bool snow=UTNTEnvironment.Snow(textureName);
  let weather=UTNTWeatherSystem.Find();
  if(weather && level.MapName~=="TNT02" && level.time%8==0)
  {
   int kind=UTNTVisorState.WeatherAt(mo.Pos+(0,0,4),weather);
   if(kind==1)
   {
    let test=new('UTNTVisorState');if(test.ProbeWeather(mo.Pos+(0,0,4),kind,weather,weather.Intensity)>0)WetSole=max(WetSole,.5);
   }
  }
  Distance+=travel;double stride=36;if(Distance<stride)return;Distance%=stride;Left=!Left;
  if(!snow && (WetSole<.06 || mo.WaterLevel>0 || UTNTEnvironment.Water(textureName)))return;
  double a=mo.Angle+90;Vector3 at=mo.Pos+(cos(a)*(Left?4:-4),sin(a)*(Left?4:-4),0);
  h.StepMark(mo,at,snow,snow?.65:WetSole*.70,Left);if(!snow)WetSole*=.80;
 }
}
class UTNTFootMark : Actor
{
 F3DFloor Rover;Sector Support;double HeightOffset,PlaneHeight,InitialAlpha;int Age;bool Snow;
 Default { +CLIENTSIDEONLY +NOINTERACTION +NOBLOCKMAP +NOGRAVITY +DONTSPLASH +FLATSPRITE RenderStyle "Translucent"; }
 States { Spawn: ENFT A -1; Stop; Snow: ENFT B -1; Stop; }
 override void Tick()
 {
  if(level.isFrozen())return;
  if(!UTNTEnvironment.Option('UTNT_footprints')){Destroy();return;}
  Age++;
  int life=Snow?1050:245;
  let weather=UTNTWeatherSystem.Find();if(Snow && weather && weather.ActiveKind==2 && weather.Intensity>.6 && Age%2==0)Age++;
  if(Age>=life){Destroy();return;}
  if(Support)
  {
   double z=Rover?Rover.top.ZatPoint(Pos.XY):Support.floorplane.ZatPoint(Pos.XY)+HeightOffset;
   SetOrigin((Pos.X,Pos.Y,z+.08),false);
  }
  Alpha=InitialAlpha*clamp((life-Age)/double(life*.4),0,1);
 }
}
class UTNTEnvironmentDust : VisualThinker
{
 int Age,Life;double BaseAlpha,Phase,PlaneZ,Closing,Carry;Sector Support;bool FromCeiling;
 // Circumscribed radius of the 96px sprite, including roll and a small air gap.
 double WallRadius() { return 48*Scale.Length()+4; }
 bool WallBlocks(Line l)
 {
  if(l.FrontSector==l.BackSector)return false;
  let other=l.FrontSector==Support?l.BackSector:l.FrontSector;
  if(!other)return true;
  double f=other.floorplane.ZatPoint(Pos.XY),c=other.ceilingplane.ZatPoint(Pos.XY);
  double ownF=Support.floorplane.ZatPoint(Pos.XY),ownC=Support.ceilingplane.ZatPoint(Pos.XY);
  return (f>ownF+.01 && f>Pos.Z-WallRadius()) || (c<ownC-.01 && c<Pos.Z+WallRadius());
 }
 Vector2 WallDelta(Line l)
 {
  Vector2 edge=l.V2.P-l.V1.P;double length2=edge dot edge;
  double t=length2>0?clamp(((Pos.XY-l.V1.P) dot edge)/length2,0,1):0;
  return Pos.XY-(l.V1.P+edge*t);
 }
 bool FitWalls()
 {
  if(!Support)return true;
  double radius=WallRadius();
  for(int pass=0;pass<4;pass++)
  {
   bool moved=false;
   for(int i=0;i<Support.Lines.Size();i++)
   {
    let l=Support.Lines[i];if(!WallBlocks(l))continue;
    Vector2 delta=WallDelta(l);double distance=delta.Length();
    if(distance>=radius-.001)continue;if(distance<.001)return false;
    Vector2 push=delta*((radius-distance)/distance);
    Vector2 next=Pos.XY+push;if(level.PointInSector(next)!=Support)return false;
    Pos.X+=push.X;Pos.Y+=push.Y;Prev.X+=push.X;Prev.Y+=push.Y;moved=true;
   }
   if(!moved)return true;
  }
  for(int i=0;i<Support.Lines.Size();i++)if(WallBlocks(Support.Lines[i]) && WallDelta(Support.Lines[i]).Length()<radius-.01)return false;
  return true;
 }

 override void Tick()
 {
  if(level.isFrozen())return;
  if(Support)
  {
   double plane=FromCeiling?Support.ceilingplane.ZatPoint(Pos.XY):Support.floorplane.ZatPoint(Pos.XY);
   double shift=(plane-PlaneZ)*Carry;Pos.Z+=shift;Prev.Z+=shift;PlaneZ=plane;
  }
  Vector2 oldXY=Pos.XY,oldScale=Scale;
  Super.Tick();if(++Age>=Life){Destroy();return;}
  if(Support)
  {
   double f=Support.floorplane.ZatPoint(Pos.XY),c=Support.ceilingplane.ZatPoint(Pos.XY);
   // Keep the entire cloud ahead of an approaching solid, not inside it.
   // Door particles retain their height while opening, and yield while closing.
   double margin=18*Scale.Y/.4;
   double low=f+margin,high=c-margin;
   if(high>=low)
   {
    double z=clamp(Pos.Z,low,high);double push=z-Pos.Z;
    Pos.Z=z;Prev.Z+=push;
   }
   // A closing slit consumes smoke gradually while it is still visible.
   double target=clamp((2*margin+24-(c-f))/24.0,0,1);
   Closing=min(1,Closing+max(0,target-Closing)*.12);
  }
  double fadeIn=clamp(Age/6.0,0,1),fadeOut=clamp((Life-Age)/double(Life-6),0,1);
  Alpha=BaseAlpha*fadeIn*fadeIn*(3-2*fadeIn)*fadeOut*fadeOut*(1-Closing)*(1-Closing);
  Vel.X=Vel.X*.98+.008*sin(Phase+Age*2.7);Vel.Y=Vel.Y*.98+.008*cos(Phase*.73+Age*3.1);
  PrevRoll=Roll;Roll+=sin(Phase+Age*1.4)*.13;Scale*=1.007;
  if(!FitWalls())
  {
   // A narrow guide limits expansion; fading continues without clipping or a pop.
   Scale=oldScale;Pos.X=Prev.X=oldXY.X;Pos.Y=Prev.Y=oldXY.Y;Vel.X=Vel.Y=0;
  }
 }
}

class UTNTMechanismQuake : Actor
{
 Default { +NOINTERACTION +NOBLOCKMAP +NOGRAVITY +CLIENTSIDEONLY }
 States { Spawn: TNT1 A 20; Stop; }
}
class UTNTMechanismWatch : Object play
{
 UTNTMechanismQuakeGroup QuakeGroup;
 Sector Sec;Vector2 Point;double Floor,Ceiling,Travel;bool Moving,Stone,CeilingMoving,IsDoor;
 int Group,Still,LastBurst,EmissionCursor,LastQuake,Starts,Stops;
 Vector2 Low,High;double Area;bool Measured;uint DustRandom;
 double RandomUnit()
 {
  // Private cosmetic stream: never consume gameplay random numbers.
  DustRandom=DustRandom*1664525+1013904223;
  return (DustRandom>>8)/16777216.0;
 }
 void Measure()
 {
  if(Measured)return;Measured=true;Low=(1e30,1e30);High=(-1e30,-1e30);
  DustRandom=Sec.Index()+1;
  for(int i=0;i<Sec.Lines.Size();i++)
  {
   let line=Sec.Lines[i];Vector2 a=line.V1.P,b=line.V2.P;
   Low=(min(Low.X,min(a.X,b.X)),min(Low.Y,min(a.Y,b.Y)));
   High=(max(High.X,max(a.X,b.X)),max(High.Y,max(a.Y,b.Y)));
   if(line.FrontSector==Sec)Area+=a.X*b.Y-b.X*a.Y;
   if(line.BackSector==Sec)Area-=a.X*b.Y-b.X*a.Y;
  }
  Area=abs(Area)*.5;
 }
 // Test the actual adjacent vertical opening at each contact edge.
 bool Contact(Line edge)
 {
  if(edge.FrontSector==edge.BackSector)return false;
  let other=edge.FrontSector==Sec?edge.BackSector:edge.FrontSector;
  if(!other)return true;
  Vector2 mid=(edge.V1.P+edge.V2.P)*.5;
  double f=other.floorplane.ZatPoint(mid),c=other.ceilingplane.ZatPoint(mid);
  if(IsDoor)return c<=f+1;
  double plane=CeilingMoving?Sec.ceilingplane.ZatPoint(mid):Sec.floorplane.ZatPoint(mid);
  return plane<f-.01 || plane>c+.01;
 }
 double ContactLength()
 {
  double length=0;
  for(int i=0;i<Sec.Lines.Size();i++)if(Contact(Sec.Lines[i]))length+=(Sec.Lines[i].V2.P-Sec.Lines[i].V1.P).Length();
  return length;
 }
 bool,Vector2 GuidePoint()
 {
  double pick=RandomUnit()*ContactLength();
  for(int i=0;i<Sec.Lines.Size();i++)
  {
   let l=Sec.Lines[i];if(!Contact(l))continue;
   Vector2 edge=l.V2.P-l.V1.P;double length=edge.Length();if(length<.1)continue;
   pick-=length;if(pick>0)continue;
   Vector2 normal=(edge.Y/length,-edge.X/length);if(l.BackSector==Sec)normal=-normal;
   Vector2 point=l.V1.P+edge*(.05+.90*RandomUnit())+normal*(2+RandomUnit()*3);
   return level.PointInSector(point)==Sec,point;
  }
  return false,(0,0);
 }
 Vector3 QuakePoint(Actor camera)
 {
  Measure();Vector2 q=(clamp(camera.Pos.X,Low.X,High.X),clamp(camera.Pos.Y,Low.Y,High.Y));
  return (q.X,q.Y,clamp(camera.Pos.Z,Sec.floorplane.ZatPoint(q),max(Sec.floorplane.ZatPoint(q),Sec.ceilingplane.ZatPoint(q))));
 }
 void Shake(bool impulse,double area)
 {
  if(!UTNTEnvironment.Option('UTNT_mechanismfx') || UTNTEnvironment.Reduced() || !UTNTEnvironment.Quality() || consoleplayer<0)return;
  let camera=players[consoleplayer].camera;if(!camera || camera.player==null || (camera.player.cheats & CF_TOTALLYFROZEN))return;
  double gain=UTNTMechanismQuakeGroup.AreaGain(area);if(gain<=0)return;
  Vector3 pos=QuakePoint(camera);if((pos-camera.Pos).Length()>=768)return;
  double strength=(impulse?.92:.336)*gain;
  let anchor=Actor.Spawn('UTNTMechanismQuake',pos);if(!anchor)return;
  anchor.A_QuakeEx(strength*.55,strength*.45,strength,impulse?12:7,0,768,"none",QF_3D|QF_SHAKEONLY|QF_MAX|(impulse?QF_SCALEDOWN:0),falloff:128,rollIntensity:(impulse?.096:.036)*gain,thrustMultiplier:0);
  LastQuake=level.time;
 }
 void Update(UTNTEnvironment h)
 {
  double f=Sec.floorplane.ZatPoint(Point),c=Sec.ceilingplane.ZatPoint(Point);
  double delta=abs(f-Floor)+abs(c-Ceiling);bool now=delta>.01;
  if(now){CeilingMoving=abs(c-Ceiling)>abs(f-Floor);IsDoor=Sec.ceilingdata is "Door";}
  if(now)
  {
   if(!Moving){Travel=0;if(level.time>20)Starts++;}
   Travel+=delta;Still=0;
   if(level.time>20)h.EmitDust(self);
   Moving=true;
  }
  else if(Moving && ++Still>=3)
  {
   if(Travel>.01 && level.time>20)Stops++;
   Moving=false;Travel=0;
  }
  Floor=f;Ceiling=c;
 }
}
// One quake per connected tagged mover, independent of how its area is subdivided.
class UTNTMechanismQuakeGroup : Object play
{
 Array<UTNTMechanismWatch> Members;
 double TotalArea,ActiveArea,LastArea;bool Moving;int LastQuake,Emissions;
 clearscope static double AreaGain(double area)
 {
  double width=sqrt(max(0,area));
  double t=clamp((width-64)/192,0,1);
  return t*t*(3-2*t)+clamp((width-256)/512,0,.6);
 }
 void Emit(bool impulse,double area,bool activeOnly)
 {
  if(consoleplayer<0 || AreaGain(area)<=0)return;
  let camera=players[consoleplayer].camera;if(!camera)return;
  UTNTMechanismWatch closest;double distance=1e30;
  for(int i=0;i<Members.Size();i++)
  {
   let m=Members[i];if(activeOnly && !m.Moving)continue;
   double d=(m.QuakePoint(camera)-camera.Pos).Length();if(d<distance){distance=d;closest=m;}
  }
  if(closest){closest.Shake(impulse,area);if(closest.LastQuake==level.time)Emissions++;}
 }
 void Update()
 {
  ActiveArea=0;for(int i=0;i<Members.Size();i++)if(Members[i].Moving)ActiveArea+=Members[i].Area;
  bool now=ActiveArea>0;
  if(level.time>20)
  {
   if(now && (!Moving || level.time-LastQuake>=7)){Emit(!Moving,ActiveArea,true);LastQuake=level.time;}
   else if(!now && Moving){Emit(true,LastArea,false);LastQuake=level.time;}
  }
  if(now)LastArea=ActiveArea;Moving=now;
 }
}
class UTNTEnvironmentSurface : Object play
{
 int Kind,Index,Part,Base,NX,NY,Cursor,PreviousTerrain;bool Detached,Reflecting,CanReflect;String Original,Alias;
 Vector3 Origin,Axis;double Width,Height;Array<double> Wet,Exposed;Array<bool> Checked;Array<int> LastCheck;
 bool Bind()
 {
  let tex=TexMan.CheckForTexture(Alias);if(!tex.isValid())return false;
  if(Kind==0)
  {
   if(Index<0 || Index>=level.Sectors.Size())return false;
   let s=level.Sectors[Index];String current=TexMan.GetName(s.GetTexture(Part));if(!(current~==Original) && !(current~==Alias))return false;
   CanReflect=Part==Sector.floor && abs(s.floorplane.normal.Z)>.99999 && s.GetAlpha(Part)==1 && s.GetPlaneReflectivity(Part)==0 && s.GetPortalType(Part)==0 && !s.heightsec && s.Get3DFloorCount()==0;
   PreviousTerrain=s.terrainnum[Part];s.terrainnum[Part]=s.GetTerrain(Part);s.SetTexture(Part,tex);
  }
  else
  {
   if(Index<0 || Index>=level.Sides.Size())return false;
   let s=level.Sides[Index];String current=TexMan.GetName(s.GetTexture(Part));if(!(current~==Original) && !(current~==Alias))return false;
   s.SetTexture(Part,tex);
  }
  return true;
 }
 clearscope static String SourceName(String textureName,UTNTEnvironment h)
 { for(int i=0;i<h.Surfaces.Size();i++)if(h.Surfaces[i].Alias~==textureName)return h.Surfaces[i].Original;return textureName; }
 void Maintain()
 {
  if(Kind!=0 || Detached)return;
  let s=level.Sectors[Index];if(!(TexMan.GetName(s.GetTexture(Part))~==Alias)){s.terrainnum[Part]=PreviousTerrain;Detached=true;}
 }
 void UpdateReflection()
 {
  if(!CanReflect)return;
  Maintain();let sec=level.Sectors[Index];
  // Yield to a later map script changing the native reflectivity.
  double expected=Reflecting?1.0/255:0;
  if(abs(sec.GetPlaneReflectivity(Part)-expected)>.000001 || abs(sec.GetAlpha(Part)-(1-expected))>.000001)
  {
   if(Reflecting && abs(sec.GetPlaneReflectivity(Part)-expected)<.000001)sec.SetPlaneReflectivity(Part,0);
   if(Reflecting && abs(sec.GetAlpha(Part)-(1-expected))<.000001)sec.SetAlpha(Part,1);
   CanReflect=false;Reflecting=false;return;
  }
  bool active=false;
  if(!Detached && UTNTEnvironment.Option('UTNT_wetsurfaces') && UTNTEnvironment.Quality()>0 && CVar.GetCVar('gl_plane_reflection').GetBool())
   for(int i=0;i<Wet.Size();i++)if(Wet[i]>.02){active=true;break;}
  if(Reflecting!=active){sec.SetPlaneReflectivity(Part,active?1.0/255:0);sec.SetAlpha(Part,active?254.0/255:1);Reflecting=active;}
 }
 void Update(UTNTEnvironment h,UTNTWeatherController weather)
 {
  if(Detached)return;
  if(Cursor>=Wet.Size())Cursor=0;int j=Cursor++;
  double x=(j%NX+.5)/NX,y=(j/NX+.5)/NY;
  Vector3 p=Kind==0?Origin+(x*Width,y*Height,0):Origin+Axis*(x*Width)+(0,0,y*Height);
  let sec=level.PointInSector(p.XY);
  if(Kind==0){if(sec!=level.Sectors[Index]){Checked[j]=true;return;}p.Z=sec.floorplane.ZatPoint(p.XY)+1;}
  else {Vector3 normal=(Axis.Y,-Axis.X,0);p+=normal*1.5;sec=level.PointInSector(p.XY);}
  double target=0;
  if(weather && CVar.GetCVar('weatherfx').GetBool() && UTNTVisorState.WeatherAt(p,weather)==1 && weather.OpenPoint(p,sec))
  {
   Vector3 incoming=(-weather.WindX*1.3125,-weather.WindY*1.3125,23*(1+weather.Intensity*.18));incoming=incoming.Unit();
   h.Probe.Trace(p,sec,incoming,8192,TRACE_HitSky,wallMask:0,ignoreAllActors:true);h.SurfaceChecks++;
   if(h.Probe.Results.HitType==TRACE_HasHitSky)
   {
    double facing=Kind==0?1:max(0,incoming.X*Axis.Y-incoming.Y*Axis.X);
    target=(.65+.35*weather.Intensity)*facing;
   }
  }
  Exposed[j]=target;Checked[j]=true;
  double elapsed=clamp((level.time-LastCheck[j])/35.0,0,20);LastCheck[j]=level.time;
  Wet[j]=target>Wet[j]?min(target,Wet[j]+elapsed*.09):max(target,Wet[j]-elapsed*.014);
 }
}
