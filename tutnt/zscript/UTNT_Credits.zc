// Deterministic camera rig: its actor tick preserves normal render interpolation.
class UTNTCreditsCamera : Actor
{
 UTNTCreditsHandler Director;
 Default { +NOBLOCKMAP +NOGRAVITY +NOINTERACTION +NOTONAUTOMAP RenderStyle "None"; CameraHeight 0; }
 States { Spawn: TNT1 A -1; Stop; }
 override void Tick() { Super.Tick(); if(Director)Director.PositionCamera(self); }
}

class UTNTCreditPage : Object
{
 String Layout, Heading;
 bool Remaster;
 int Camera, Duration;
 Array<String> Names, Contributions;
}

class UTNTCreditsHandler : EventHandler
{
 Array<UTNTCreditPage> Pages;
 Actor Cameras[6];
 UTNTCreditsCamera ViewCamera;
 Vector3 Origins[6];
 double Angles[6], Pitches[6];
 Vector3 FlightSamples[321];
 Vector3 SparkFocus;
 bool HasSparkFocus;
 int FlightCount;
 Array<double> FlightLengths, FlightYaws, FlightPitches;
 int Page, PageStart, Phase, LastInput, HintUntil, FinaleStarts;
 int CutStart, PendingPage,LastSparkTic,SparkPulses;
 bool Initialized, Cutting;
 ui bool KeyHeld;
 ui UTNTCreditsUI CardsUI;
 ui UTNTCreditsLook Look;

 static double Ease(double t) { t=clamp(t,0,1);return t*t*(3-2*t); }
 static Vector3 Curve(Vector3 a,Vector3 b,Vector3 c,Vector3 d,double t)
 {
  // Shared Hermite tangents preserve direction across each waypoint.
  Vector3 m=(c-a)*.35,n=(d-b)*.35;
  return b*(2*t*t*t-3*t*t+1)+m*(t*t*t-2*t*t+t)+c*(-2*t*t*t+3*t*t)+n*(t*t*t-t*t);
 }
 static double CurveValue(double a,double b,double c,double d,double t)
 {return b*(2*t*t*t-3*t*t+1)+(c-a)*.35*(t*t*t-2*t*t+t)+c*(-2*t*t*t+3*t*t)+(d-b)*.35*(t*t*t-t*t);}
 void LoadCards(String path,bool remaster=false)
 {
  int lump=Wads.CheckNumForFullName(path);if(lump<0)return;
  String data=Wads.ReadLump(lump);data.Substitute("\r","");Array<String> lines;data.Split(lines,"\n",TOK_SKIPEMPTY);
  UTNTCreditPage current;
  for(int i=0;i<lines.Size();i++)
  {
   Array<String> r;lines[i].Split(r,"|",TOK_KEEPEMPTY);
   if(r[0]=="P" && r.Size()==5)
   {
    current=new("UTNTCreditPage");current.Layout=r[1];current.Remaster=remaster;current.Camera=clamp(r[2].ToInt(),1,5);
    // Decimal seconds preserve exact half durations, including 6.5 / 7.5 / 8.5.
    current.Duration=int(clamp(r[3].ToDouble(),4,60)*35);current.Heading=r[4];Pages.Push(current);
   }
   else if(r[0]=="N" && r.Size()==3 && current && r[1]!="")
   {
    int limit=current.Layout=="group"?8:current.Layout=="dense"?6:current.Layout=="creator"||current.Layout=="thanks"?1:3;
    if(current.Names.Size()>=limit)
    {
     let next=new("UTNTCreditPage");next.Layout=current.Layout;next.Camera=current.Camera;
     next.Remaster=current.Remaster;next.Duration=current.Duration;next.Heading=current.Heading;Pages.Push(next);current=next;
    }
    current.Names.Push(r[1]);current.Contributions.Push(r[2]);
   }
  }
 }
 void BuildFlight()
 {
  Vector3 nodes[11];int count;Array<double> yaw,pitch;
  let sparks=Level.CreateActorIterator(7,"OrangeSpark_Up");Actor spark=sparks.Next();
  if(spark){SparkFocus=spark.Pos;HasSparkFocus=true;}
  // Retain the authored route; omit its 32-unit duplicate start / stop intervals.
  double tilt[]={0,-2,3,6,8,7,4,0,-3,-6,-10};
  for(int id=100;id<=110;id++)
  {
   let it=Level.CreateActorIterator(id);Actor node=it.Next();if(!node)continue;
   // End above the near crater slope, close enough to read the floor discharge.
   Vector3 position=node.Pos;
   if(HasSparkFocus && id>=108)
   {
    if(id==110)position=SparkFocus+(0,-180,220);
    else position.z=max(position.z,SparkFocus.z+(id==108?300:250));
   }
   nodes[count++]=position;
   double a=node.Angle;
   if(yaw.Size())a=yaw[yaw.Size()-1]+Actor.deltaangle(yaw[yaw.Size()-1],a);
   yaw.Push(a);pitch.Push(tilt[id-100]);
  }
  for(int seg=0;seg+1<count;seg++)for(int step=0;step<=32;step++)
  {
   if(seg>0 && step==0)continue;
   int prev=max(0,seg-1),next=min(count-1,seg+2);double t=step/32.0;
   Vector3 point=Curve(nodes[prev],nodes[seg],nodes[seg+1],nodes[next],t);
   double distance=FlightCount?(point-FlightSamples[FlightCount-1]).Length():0;
   FlightLengths.Push(distance+(FlightLengths.Size()?FlightLengths[FlightLengths.Size()-1]:0));
   FlightSamples[FlightCount++]=point;
   FlightYaws.Push(CurveValue(yaw[prev],yaw[seg],yaw[seg+1],yaw[next],t));
   FlightPitches.Push(CurveValue(pitch[prev],pitch[seg],pitch[seg+1],pitch[next],t));
  }
 }
 void Init()
 {
  Initialized=true;LoadCards("credits/original.txt");LoadCards("credits/remaster.txt",true);
  for(int i=Pages.Size()-1;i>=0;i--)if((Pages[i].Remaster || Pages[i].Layout!="opening") && Pages[i].Names.Size()==0)Pages.Delete(i);
  for(int i=0;i<Pages.Size();i++)if(Pages[i].Remaster)
  {
   let title=new("UTNTCreditPage");title.Layout="chapter";title.Heading="Remaster";
   title.Remaster=true;title.Camera=Pages[i].Camera;title.Duration=4*35;
   Pages.Push(title);for(int j=Pages.Size()-1;j>i;j--)Pages[j]=Pages[j-1];Pages[i]=title;break;
  }
  for(int id=1;id<=5;id++)
  {
   let it=Level.CreateActorIterator(id);Cameras[id]=it.Next();
   if(Cameras[id]){Origins[id]=Cameras[id].Pos;Angles[id]=Cameras[id].Angle;Pitches[id]=Cameras[id].Pitch;}
  }
  // Hexen flats have no stored panning: center the 192-unit fracture over TID 7.
  // The central floor and adjacent slopes share one phase, serialized by the engine.
  let fracture=TexMan.CheckForTexture("UECRACK",TexMan.Type_Flat);
  if(fracture.isValid())for(int i=0;i<level.Sectors.Size();i++)
   if(level.Sectors[i].GetTexture(Sector.floor)==fracture)
   {level.Sectors[i].SetXOffset(Sector.floor,4576);level.Sectors[i].SetYOffset(Sector.floor,-352);}
  BuildFlight();
  ViewCamera=UTNTCreditsCamera(Actor.Spawn("UTNTCreditsCamera",Origins[1]));
  if(ViewCamera)ViewCamera.Director=self;
  PageStart=level.time;Page=0;PendingPage=-1;
  if(Pages.Size()==0)BeginFinale();else SetCamera();
 }
 void AttachCamera()
 {
  for(int p=0;p<MAXPLAYERS;p++)if(playeringame[p] && players[p].mo)
  {players[p].cheats|=CF_TOTALLYFROZEN;if(ViewCamera)players[p].camera=ViewCamera;}
 }
 void SetCamera()
 {
  if(ViewCamera){PositionCamera(ViewCamera);ViewCamera.ClearInterpolation();}
  AttachCamera();
 }
 void PositionCamera(Actor camera)
 {
  if(Phase==0 && Page<Pages.Size())
  {
   int id=Pages[Page].Camera;
   double t=Ease(double(level.time-PageStart)/Pages[Page].Duration),s=t-.5;
   double direction=id%2?1:-1;
   Vector3 side=(-sin(Angles[id]),cos(Angles[id]),0),forward=(cos(Angles[id]),sin(Angles[id]),0);
   camera.SetOrigin(Origins[id]+side*(s*24*direction)+forward*(s*12)+(0,0,s*8),true);
   camera.Angle=Angles[id]+s*3*direction;camera.Pitch=Pitches[id]+s*(id%2?2:-2);
   camera.Roll=.35*sin(t*180)*direction;camera.CameraFOV=89-3*t;
  }
  else if(Phase==1 && FlightCount>1)
  {
   // Cruise immediately beneath the fade; smoothly brake over the last 30% of time.
   // Integral of (1 - smoothstep) keeps speed continuous and arrival at 21 seconds.
   double flight=clamp((level.time-PageStart)/735.0,0,1);
   double brake=clamp((flight-.7)/.3,0,1);
   double progress=(min(flight,.7)+.3*(brake-brake*brake*brake+.5*brake*brake*brake*brake))/.85;
   // Retain the authored focus, bank and lightning cue timing.
   double u=clamp((level.time-PageStart-35)/700.0,0,1);
   double target=FlightLengths[FlightLengths.Size()-1]*progress;
   int i=1;while(i+1<FlightLengths.Size() && FlightLengths[i]<target)i++;
   double t=clamp((target-FlightLengths[i-1])/max(.001,FlightLengths[i]-FlightLengths[i-1]),0,1);
   camera.SetOrigin(FlightSamples[i-1]*(1-t)+FlightSamples[i]*t,true);
   camera.Angle=FlightYaws[i-1]*(1-t)+FlightYaws[i]*t;
   camera.Pitch=FlightPitches[i-1]*(1-t)+FlightPitches[i]*t;
   double focus=HasSparkFocus?Ease((u-.55)/.35):0;
   if(focus>0)
   {
    Vector3 toSpark=SparkFocus-camera.Pos;
    double lookYaw=atan2(toSpark.y,toSpark.x);
    double lookPitch=-atan2(toSpark.z,sqrt(toSpark.x*toSpark.x+toSpark.y*toSpark.y));
    camera.Angle+=Actor.deltaangle(camera.Angle,lookYaw)*focus;
    camera.Pitch+=(lookPitch-camera.Pitch)*focus;
   }
   camera.Roll=-2.5*sin(u*180)*sin(u*270)*(1-focus);
   camera.CameraFOV=88-4*progress-20*focus;
  }
 }
 void QueueCut(int next)
 {
  if(Cutting || Phase)return;
  PendingPage=next;CutStart=level.time;Cutting=true;
 }
 void BeginFinale()
 {
  if(Phase)return;
  Phase=1;PageStart=level.time;FinaleStarts++;SetCamera();ACS_Execute(55,0);
 }
 void StartFinale() { if(!Phase)QueueCut(Pages.Size()); }
 static void EndTitle()
 {
  let h=UTNTCreditsHandler(EventHandler.Find('UTNTCreditsHandler'));
  if(h && level.MapName~=="ENDMAP01" && h.Phase==1){h.Phase=2;h.PageStart=level.time;}
 }
 void Advance(int p,int op)
 {
  if(!Initialized || Phase || Cutting || p!=UTNTChapterState.Leader() || level.time<LastInput+10 || level.time<PageStart+35)return;
  LastInput=level.time;HintUntil=level.time+105;
  QueueCut(op==2?Pages.Size():op==1?max(0,Page-1):Page+1);
 }
 override void WorldThingSpawned(WorldEvent e)
 {
  // The authored flare is the actual discharge cue, including repeated activations.
  if(!(level.MapName~=="ENDMAP01") || !Initialized || Phase!=1 || !HasSparkFocus
     || !e.Thing || !(e.Thing is 'SparkFlare_O') || (e.Thing.Pos-SparkFocus).Length()>8)return;
  if(SparkPulses>0 && LastSparkTic==level.time)return;
  LastSparkTic=level.time;SparkPulses++;
  UTNTCreditsSpark.Pulse(SparkFocus);
 }
 override void WorldTick()
 {
  if(!(level.MapName~=="ENDMAP01"))return;
  if(!Initialized){Init();return;}
  if(Phase){AttachCamera();return;}
  if(Cutting && level.time-CutStart>=23)
  {
   Cutting=false;
   if(PendingPage>=Pages.Size())BeginFinale();
   else {Page=PendingPage;PageStart=level.time;SetCamera();}
   PendingPage=-1;
  }
  else if(!Cutting && Page<Pages.Size() && level.time-PageStart>=Pages[Page].Duration-23)QueueCut(Page+1);
  AttachCamera();
 }
 override void NetworkProcess(ConsoleEvent e){if(e.Name=="utnt_credit" && level.MapName~=="ENDMAP01")Advance(e.Player,e.Args[0]);}
 override bool InputProcess(InputEvent e)
 {
  if(!(level.MapName~=="ENDMAP01") || !Initialized || Phase || menuactive || paused || ConsoleState!=0){KeyHeld=false;return false;}
  int op=e.KeyScan==InputEvent.Key_End?2:e.KeyScan==InputEvent.Key_LeftArrow?1:0;
  bool handled=op!=0 || e.KeyScan==InputEvent.Key_Enter || e.KeyScan==InputEvent.Key_Space || e.KeyScan==InputEvent.Key_RightArrow || e.KeyScan==InputEvent.Key_Pad_A;
  if(!handled)return false;
  if(e.Type==InputEvent.Type_KeyUp)KeyHeld=false;
  else if(e.Type==InputEvent.Type_KeyDown && !KeyHeld){KeyHeld=true;EventHandler.SendNetworkEvent("utnt_credit",op);}
  return true;
 }
 override void WorldUnloaded(WorldEvent e) { PPShader.SetEnabled("UTNTEndingLook",false); }
 override void RenderUnderlay(RenderEvent e)
 {
  if(!(level.MapName~=="ENDMAP01") || !Initialized || Phase==2)
  {PPShader.SetEnabled("UTNTEndingLook",false);Look=null;return;}
  if(!Look)Look=new("UTNTCreditsLook");Look.Update(self,e);
 }
 override void RenderOverlay(RenderEvent e)
 {
  if(!(level.MapName~=="ENDMAP01") || !Initialized)return;
  if(!CardsUI)CardsUI=new("UTNTCreditsUI");CardsUI.Draw(self,e.FracTic);
 }
}


// Native counterpart of the approved Quake-Reliquiar mockup (variant 01).
class UTNTCreditsUI ui
{
 double Scale, Width, Left, ContributionSize, LineStep, SpecialHeight, SpecialTop;
 Font Body, Big;
 UTNTCreditPage Cached;
 double CachedWidth;
 String CachedLanguage;
 static String Local(String text) { return StringTable.Localize(text); }
 Array<BrokenLines> Wrapped;
 Array<double> Heights, Tops;

 void Prepare(UTNTCreditPage page)
 {
  Scale=Screen.GetHeight()/720.0;
  Width=min(1280.0,Screen.GetWidth()/Scale);Left=(Screen.GetWidth()-Width*Scale)/2;
  Body=Font.GetFont('SmallFont');if(!Big)Big=Font.GetFont('UCRBIG');
  String locale=CVar.FindCVar('language').GetString();
  if(page==Cached && Width==CachedWidth && locale==CachedLanguage)return;
  CachedLanguage=locale;
  Cached=page;CachedWidth=Width;Wrapped.Clear();Heights.Clear();Tops.Clear();if(!page)return;
  bool dense=page.Layout=="dense";
  ContributionSize=dense?9:10;LineStep=13;
  double w=dense?252:page.Layout=="thanks"?496:294;
  if(page.Layout=="thanks")ContributionSize=12.5;
  for(int i=0;i<page.Contributions.Size();i++)
  {
   Wrapped.Push(Body.BreakLines(Local(page.Contributions[i]),int(w*8/ContributionSize)));
   Array<String> names;page.Names[i].Split(names,"~",TOK_KEEPEMPTY);
   Heights.Push(max(74,ceil(16+names.Size()*18.5+7.5+Wrapped[i].Count()*LineStep+16)));
  }
  SpecialHeight=0;SpecialTop=434;
  if(page.Layout=="creator")
  {
   Array<String> names;page.Names[0].Split(names,"~",TOK_KEEPEMPTY);
   SpecialHeight=max(164,16+names.Size()*33+8+Wrapped[0].Count()*13+16);
   SpecialTop=min(434,672-SpecialHeight);
  }
  else if(page.Layout=="thanks")
  {SpecialHeight=max(140,60+Wrapped[0].Count()*18+18+16+16);SpecialTop=min(500,672-SpecialHeight);}
  else if(page.Layout=="group")
  {SpecialHeight=32+ceil(page.Names.Size()/2.0)*29;SpecialTop=672-SpecialHeight;}
  // Keep the approved 434 / 516 / 598 baseline; grow only for authored long text.
  double top=434;
  for(int row=0;row<3;row++)
  {
   Tops.Push(top);double h=row<Heights.Size()?Heights[row]:74;
   if(dense && row+3<Heights.Size())h=max(h,Heights[row+3]);
   top+=h+8;
  }
  double lift=max(0,top-8-672);
  for(int row=0;row<Tops.Size();row++)Tops[row]-=lift;
 }
 void Dim(int color,double a,double x,double y,double w,double h)
 {Screen.Dim(color,a,int(Left+x*Scale),int(y*Scale),int(ceil(w*Scale)),int(ceil(h*Scale)));}
 void Text(String value,double x,double y,double size=10,int color=0xe2d3bd,double alpha=1,bool center=false,double maxWidth=2000)
 {
  double s=size/8;s=min(s,maxWidth/max(1,Body.StringWidth(value)));
  if(center)x-=Body.StringWidth(value)*s/2;
  Screen.DrawText(Body,Font.CR_WHITE,Left+x*Scale,y*Scale,value,DTA_ScaleX,s*Scale,DTA_ScaleY,s*Scale,DTA_Color,0xff000000|color,DTA_Alpha,alpha);
 }
 void DrawName(String value,double x,double y,double height,double maxWidth,double alpha,bool center=false)
 {
  Font titleFont=Big;
  double s=height/20,w=titleFont.StringWidth(value)*s;
  if(w>maxWidth){s*=maxWidth/w;w=maxWidth;}if(center)x-=w/2;
  Screen.DrawText(titleFont,Font.CR_UNTRANSLATED,Left+x*Scale,y*Scale,value,DTA_ScaleX,s*Scale,DTA_ScaleY,s*Scale,DTA_Alpha,alpha);
 }
 void Frame(double x,double y,double w,double h,String shape,bool remaster,double alpha,double energy=0)
 {
  String texture=(remaster?"UCRRS":"UCRRB")..shape;
  Screen.DrawTexture(TexMan.CheckForTexture(texture),true,Left+x*Scale,y*Scale,
   DTA_DestWidthF,w*Scale,DTA_DestHeightF,h*Scale,DTA_LeftOffset,0,DTA_TopOffset,0,DTA_Alpha,alpha);
  if(energy>0)Dim(remaster?0xd0eef0:0xf5ca86,alpha*energy*.6,x+12,y+1,max(1,(w-24)*energy),1);
 }
 void Badge(UTNTCreditPage p,double y,double alpha)
 {
  String chapter=p.Remaster?Local("$UTNT_CREDITS_REMASTER"):Local("$UTNT_CREDITS_ORIGINAL");
  String category=p.Remaster && (p.Heading=="Remaster" || p.Heading=="$UTNT_CREDITS_TEXT_071" || p.Heading=="$UTNT_CREDITS_REMASTER")?Local("$UTNT_CREDITS_TEXT_001").MakeUpper():Local(p.Heading).MakeUpper();
  double width=p.Layout=="dense"?582:p.Layout=="thanks" || p.Layout=="group"?530:328;
  int accent=p.Remaster?0xc4d9d9:0xd0a675;
  double cw=Body.StringWidth(chapter)*11/8,tw=Body.StringWidth(" / "..category)*9/8;
  if(cw+tw>width)
  {Text(chapter,44+width/2,y-12,11,accent,alpha,true,width);Text(category,44+width/2,y+3,9,0xb9ac9b,alpha,true,width);}
  else
  {double x=44+(width-cw-tw)/2;Text(chapter,x,y,11,accent,alpha);Text(" / "..category,x+cw,y+1,9,0xb9ac9b,alpha);}

 }
 // Same stagger, quadratic slide and opacity envelope as the approved animation.
 double CardOpacity(double entry,int index){return clamp(entry*1.8-index*.18,0,1);}
 double CardOffset(double opacity){return -18*(1-opacity)*(1-opacity);}
 void Block(UTNTCreditPage p,int index,double entry)
 {
  bool dense=p.Layout=="dense";double w=dense?286:328;
  double opacity=CardOpacity(entry,index),alpha=entry*opacity;
  double x=44+(dense && index>=3?296:0)+CardOffset(opacity),y=Tops[dense?index%3:index];
  Frame(x,y,w,Heights[index],dense?"D":"S",p.Remaster,alpha,opacity<1?opacity:0);
  Array<String> names;p.Names[index].Split(names,"~",TOK_KEEPEMPTY);
  for(int row=0;row<names.Size();row++)DrawName(names[row],x+17,y+16+row*18.5,18.5,w-34,alpha);
  double top=y+16+names.Size()*18.5+7.5;
  for(int row=0;row<Wrapped[index].Count();row++)Text(Wrapped[index].StringAt(row),x+17,top+row*LineStep,ContributionSize,0xe2d3bd,alpha,false,w-34);
 }
 void Chapter(UTNTCreditPage p,double alpha)
 {
  double x=Width/2-265,y=85;
  Frame(x,y,530,140,"C",p.Remaster,alpha,alpha<1?alpha:0);
  Text("THE ULTIMATE TORMENT & TORTURE",Width/2,y+26,10,0xbba88b,alpha,true,470);
  DrawName(p.Remaster?Local("$UTNT_CREDITS_REMASTER"):Local("$UTNT_CREDITS_ORIGINAL"),Width/2,y+54,29,470,alpha,true);
  Text(p.Remaster?Local("$UTNT_CREDITS_NEW_CHAPTER"):Local("$UTNT_CREDITS_CREATORS"),Width/2,y+104,9.5,p.Remaster?0xc4d9d9:0xcba574,alpha,true,470);
 }
 void Creator(UTNTCreditPage p,double entry)
 {
  double opacity=CardOpacity(entry,0),alpha=entry*opacity,x=44+CardOffset(opacity),y=SpecialTop;
  Frame(x,y,328,SpecialHeight,"P",p.Remaster,alpha,opacity<1?opacity:0);
  Array<String> names;p.Names[0].Split(names,"~",TOK_KEEPEMPTY);
  for(int i=0;i<names.Size();i++)DrawName(names[i],x+17,y+16+i*33,26.5,294,alpha);
  for(int row=0;row<Wrapped[0].Count();row++)Text(Wrapped[0].StringAt(row),x+17,y+16+names.Size()*33+8+row*13,10,0xe2d3bd,alpha,false,294);
 }
 void Thanks(UTNTCreditPage p,double entry)
 {
  double opacity=CardOpacity(entry,0),alpha=entry*opacity,x=44+CardOffset(opacity),y=SpecialTop;
  Frame(x,y,530,SpecialHeight,"C",p.Remaster,alpha,opacity<1?opacity:0);
  DrawName(p.Names[0],x+17,y+16,29,496,alpha);
  for(int row=0;row<Wrapped[0].Count();row++)Text(Wrapped[0].StringAt(row),x+17,y+60+row*18,12.5,0xe2d3bd,alpha,false,496);
  DrawName(Local("$UTNT_CREDITS_THANKS_CHRIS"),x+17,y+60+Wrapped[0].Count()*18+18,16,496,alpha);
 }
 void Group(UTNTCreditPage p,double entry)
 {
  double opacity=CardOpacity(entry,0),alpha=entry*opacity,x=44+CardOffset(opacity),y=SpecialTop;
  Frame(x,y,530,SpecialHeight,"C",p.Remaster,alpha,opacity<1?opacity:0);
  int rows=int(ceil(p.Names.Size()/2.0));
  for(int i=0;i<p.Names.Size();i++)DrawName(p.Names[i],x+17+(i/rows)*257,y+16+(i%rows)*29,18.5,239,alpha);
 }
 double FadeAmount(UTNTCreditsHandler state,double frac)
 {
  double age=level.time-state.PageStart+frac,fade=0;
  if(state.Phase==0)fade=state.Cutting?clamp((level.time-state.CutStart+frac)/23,0,1):clamp(1-age/28,0,1);
  else if(state.Phase==1)fade=max(clamp(1-age/35,0,1),clamp((age-868)/42,0,1));
  return fade*fade*(3-2*fade);
 }
 void FadeWorld(UTNTCreditsHandler state,double frac)
 {Screen.Dim(0,FadeAmount(state,frac),0,0,Screen.GetWidth(),Screen.GetHeight());}
 void Draw(UTNTCreditsHandler state,double frac)
 {
  UTNTCreditPage page=state.Phase==0 && state.Page<state.Pages.Size()?state.Pages[state.Page]:null;
  Prepare(page);double seconds=(level.time-state.PageStart+frac)/35;
  if(state.Phase==1){FadeWorld(state,frac);return;}
  if(state.Phase==2)
  {
   Screen.Dim(0,1,0,0,Screen.GetWidth(),Screen.GetHeight());double a=clamp((seconds-.35)/2,0,1);
   DrawName(Local("$UTNT_CREDITS_END"),Width/2,302,37,Width*.6,a,true);Dim(0xc68962,a,Width/2-15,363,30,1);
   Text(Local("$UTNT_CREDITS_THANKS_PLAYER"),Width/2,390,12.5,0xbdb5a9,a,true);
   Text("THE ULTIMATE TORMENT & TORTURE",Width/2,443,8.5,0x8d867c,a,true);return;
  }
  if(!page)return;
  // Eight-pixel bars only. The world keeps its authored brightness, including ultrawide edges.
  Screen.Dim(0x070707,1,0,0,Screen.GetWidth(),int(ceil(8*Scale)));
  Screen.Dim(0x070707,1,0,int(712*Scale),Screen.GetWidth(),Screen.GetHeight());
  double duration=page.Duration/35.0;
  bool chapter=page.Layout=="opening" || page.Layout=="chapter";
  double delay=page.Layout=="opening"?1.5:.8;
  double entry=clamp(min((seconds-delay)/(chapter?.55:.65),(duration-seconds)/(chapter?.45:.5)),0,1);
  if(state.Cutting)entry=min(entry,clamp(1-(level.time-state.CutStart+frac)/23,0,1));
  if(chapter)Chapter(page,entry);
  else
  {
   Badge(page,SpecialHeight>0?SpecialTop-33:Tops[0]-33,entry);
   if(page.Layout=="creator")Creator(page,entry);
   else if(page.Layout=="thanks")Thanks(page,entry);
   else if(page.Layout=="group")Group(page,entry);
   else for(int i=0;i<page.Names.Size();i++)Block(page,i,entry);
  }
  if(state.HintUntil>level.time)
  {
   Dim(0x070807,.85,Width/2-250,687,500,19);
   Text(consoleplayer==UTNTChapterState.Leader()?Local("$UTNT_CREDITS_KEYS"):Local("$UTNT_CREDITS_HOST"),Width/2,692,8,0xbdb5a9,1,true,484);
  }
  FadeWorld(state,frac);
 }
}

#include "zscript/UTNT_CreditsLook.zc"

#include "zscript/UTNT_CreditsSpark.zc"
