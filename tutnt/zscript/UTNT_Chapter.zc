// Saved simulation owns chapter progress and travel; UI only requests input.
// Authored sequence data. Rendering and travel consume the same definition.
class UTNTTransitionDefinition : Object
{
    int Destination, FirstFragment, LastFragment, Picture, Voice, VoiceTic, PictureTic;
    static UTNTTransitionDefinition ForEpisode(int episode,int secret=0)
    {
        int destinations[]={2,3,5,5,6,7,8,88,88,0};
        int first[]={60,75,88,88,106,129,142,153,153,175};
        int last[]={74,87,105,105,128,141,152,174,174,195};
        int pictures[]={2,3,4,4,5,6,7,10,10,9};
        int voices[]={36,37,38,38,39,40,41,42,42,43};
        int voiceTics[]={145,145,200,200,170,145,145,250,250,145};
        int pictureTics[]={635,565,865,865,940,635,635,1020,1020,705};
        int i=clamp(episode,1,10)-1;
        let d=new("UTNTTransitionDefinition");
        d.Destination=i==6 && secret==1 ? 9 : destinations[i];
        d.FirstFragment=first[i];d.LastFragment=last[i];d.Picture=pictures[i];
        d.Voice=voices[i];d.VoiceTic=voiceTics[i];d.PictureTic=pictureTics[i];
        return d;
    }
}

class UTNTChapterState : Object
{
    int Episode, Destination, StartTime, Phase;
    UTNTTransitionDefinition Definition;
    int Pages[MAXPLAYERS], PageTimes[MAXPLAYERS], LastInput[MAXPLAYERS];
    bool Revealed[MAXPLAYERS], VoicePlayed;
    int Sections[MAXPLAYERS]; // story, chapter comparison, campaign comparison
    int DetailPages[MAXPLAYERS]; // overview, combat, weapons 1/2, abilities
    bool Ready[MAXPLAYERS];
    UTNTMapResult ChapterResult, CampaignResult;
    int ChapterObjectives, CampaignObjectives;
    bool Intro; // TNT04A uses the same reader over its authored cinematic timeline.

    static int DestinationFor(int episode,int secret)
    {
        return UTNTTransitionDefinition.ForEpisode(episode,secret).Destination;
    }

    static int Leader()
    {
        if(Net_Arbitrator>=0 && Net_Arbitrator<MAXPLAYERS && playeringame[Net_Arbitrator]) return Net_Arbitrator;
        for(int p=0;p<MAXPLAYERS;p++) if(playeringame[p]) return p;
        return -1;
    }

    void Init(int episode,int secret)
    {
        self.Episode=clamp(episode,1,10); Definition=UTNTTransitionDefinition.ForEpisode(self.Episode,secret);
        Destination=Definition.Destination;
        StartTime=level.time; Phase=0;
        for(int p=0;p<MAXPLAYERS;p++) PageTimes[p]=StartTime+110;
    }

    play void CaptureResults()
    {
        let ledger=UTNTCampaignStats.Get();
        if(ledger && ledger.LastCompleted>0)
        {
            ChapterResult=ledger.Summary(Episode,false);
            CampaignResult=ledger.Summary(Episode,true);
            ChapterObjectives=ledger.ObjectiveCount(Episode,false);
            CampaignObjectives=ledger.ObjectiveCount(Episode,true);
        }
    }

    static int VoiceDelay(int episode)
    {
        return UTNTTransitionDefinition.ForEpisode(episode).VoiceTic;
    }

    static int ImageNumber(int episode)
    {
        return UTNTTransitionDefinition.ForEpisode(episode).Picture;
    }

    static int ImageChange(int episode)
    {
        return UTNTTransitionDefinition.ForEpisode(episode).PictureTic;
    }

    void Tick()
    {
        if(!Definition) Definition=UTNTTransitionDefinition.ForEpisode(Episode);
        if(Intro || Phase || VoicePlayed || level.time<StartTime+Definition.VoiceTic) return;
        int number=Definition.Voice;
        S_StartSound(Sound(String.Format("VOC%03d",number)),CHAN_VOICE,0,1,ATTN_NONE);
        VoicePlayed=true;
    }

    bool EveryoneReady()
    {
        for(int p=0;p<MAXPLAYERS;p++) if(playeringame[p] && !Ready[p]) return false;
        return true;
    }

    void Input(int p,int op,int pageCount)
    {
        if(Phase || !(level.MapName ~== (Intro ? "TNT04A" : "INTERMAP")) || p<0 || p>=MAXPLAYERS
            || !playeringame[p] || level.time<StartTime+(Intro ? 15 : 110) || level.time<LastInput[p]+7) return;
        LastInput[p]=level.time;
        pageCount=clamp(pageCount,1,128);
        if(!Intro && (op==6 || op==7) && Sections[p]>0)
        {
            DetailPages[p]=(DetailPages[p]+(op==6 ? 1 : 4))%5;return;
        }
        if(!Intro && op==4)
        {
            Sections[p]=min(2,Sections[p]+1);Ready[p]=false;return;
        }
        if(!Intro && op==5)
        {
            if(Sections[p]!=2) return;
            Ready[p]=true;
            if(p!=Leader() || !EveryoneReady()) return;
            op=3;
        }
        if(!Intro && op==2 && Sections[p]>0)
        {
            Sections[p]--;Ready[p]=false;return;
        }
        if(op==0) Revealed[p]=true;
        else if(op==1 || op==2)
        {
            Pages[p]=clamp(Pages[p]+(op==1?1:-1),0,pageCount-1);
            PageTimes[p]=level.time; Revealed[p]=op==2;
        }
        else if(op==3 && p==Leader() && level.time>=StartTime+(Intro ? 15 : 210))
        {
            if(Intro)
            {
                Phase=1;
                ACS_Terminate(667,0);
                ACS_NamedExecuteWithResult("UTNT_TNT04A_FinishIntro",1);
                return;
            }
            Phase=Episode>=8 ? 2 : 1;
            ACS_Execute(Phase==2 ? 250 : 255,0);
        }
    }
}

class UTNTChapterUI ui
{
    String CachedText, CachedHeading;
    int CachedTitleWidth;
    BrokenLines Lines, Heading;
    int CachedWidth, CachedRows, LayoutBuilds, LastInputTime;
    double BodyX, BodyY, BodyWidth, BodyHeight, PictureX, PictureWidth, Unit;
    int Rows, PageCount;

    static String Local(String key) { return StringTable.Localize("$"..key); }

    static String Story(int episode,bool intro=false)
    {
        let definition=UTNTTransitionDefinition.ForEpisode(episode);
        int first=definition.FirstFragment,last=definition.LastFragment;
        String raw=intro ? Local("UTNT_VOICE_038").."\n\n"..Local("UTNT_VOICE_039") : "";
        for(int n=first;!intro && n<=last;n++)
        {
            raw=raw..Local(String.Format("UTNT_INTERMAP_%03d",n));
            // Paragraph breaks formerly supplied explicitly by embedded ACS.
            if(n==78 || n==84 || n==87 || n==96 || n==103 || n==112 || n==116
                || n==126 || n==132 || n==136 || n==145 || n==148 || n==158
                || n==162 || n==170 || n==183 || n==192) raw=raw.."\n";
            if(n==192) raw=raw.."\n";
        }
        // Remove the old fixed-width line breaks while preserving paragraphs.
        String text;
        for(int i=0;i<int(raw.Length());i++)
        {
            if(raw.CharAt(i)=="\n")
            {
                int count=1;
                while(i+1<int(raw.Length()) && raw.CharAt(i+1)=="\n") { i++;count++; }
                text=text..(count>1 ? "\n\n" : " ");
            }
            else text=text..raw.Mid(i,1);
        }
        return text;
    }

    void Prepare(UTNTChapterState chapter)
    {
        Unit=UTNTUILayout.Scale();
        double margin=UTNTUILayout.Margin();
        double available=min(820*Unit,Screen.GetWidth()-2*margin);
        double left=(Screen.GetWidth()-available)/2;
        // Even 4:3 keeps both original illustrations beside a readable text panel.
        BodyWidth=available*0.62; PictureWidth=available-BodyWidth-UTNTUILayout.Gap();
        BodyX=left; PictureX=left+BodyWidth+UTNTUILayout.Gap();
        String title=Local(chapter.Intro ? "UTNT_CHAPTER_INTRO" : String.Format("UTNT_CHAPTER_%d",chapter.Episode));
        Font font=Font.GetFont('SmallFont');
        int titleWidth=int((available-24*Unit)/(Unit*1.4));
        bool languageChanged=title!=CachedHeading;
        if(!Heading || languageChanged || titleWidth!=CachedTitleWidth)
        {
            Heading=font.BreakLines(title,titleWidth);
            CachedHeading=title;CachedTitleWidth=titleWidth;
        }
        BodyY=margin+(Heading.Count()*(font.GetHeight()+3)*1.4+28)*Unit;
        BodyHeight=max(70*Unit,Screen.GetHeight()-margin-BodyY-48*Unit);
        int width=max(32,int((BodyWidth/Unit-28)/1.3));
        Rows=max(1,int((BodyHeight/Unit-24)/((font.GetHeight()+4)*1.3)));
        String text=!Lines || languageChanged ? Story(chapter.Episode,chapter.Intro) : CachedText;
        if(!Lines || text!=CachedText || width!=CachedWidth || Rows!=CachedRows)
        {
            Lines=font.BreakLines(text,width);
            CachedText=text;CachedWidth=width;CachedRows=Rows;LayoutBuilds++;
        }
        PageCount=max(1,(Lines.Count()+Rows-1)/Rows);
    }

    int VisibleCharacters(UTNTChapterState chapter,int p)
    {
        return chapter.Revealed[p] ? 100000 : max(0,(level.time-chapter.PageTimes[p])/2);
    }

    int PageCharacters(int page)
    {
        int length=0;
        for(int i=page*Rows;i<min(Lines.Count(),(page+1)*Rows);i++) length+=Lines.StringAt(i).Length();
        return length;
    }

    void Advance(UTNTChapterState chapter,bool back=false,bool skip=false)
    {
        if(menuactive || paused || ConsoleState!=0 || chapter.Phase
            || level.time<LastInputTime+7) return;
        Prepare(chapter); LastInputTime=level.time;
        int p=consoleplayer,page=clamp(chapter.Pages[p],0,PageCount-1);
        int op;
        if(skip) op=3;
        else if(!chapter.Intro && chapter.Sections[p]>0)
            op=back ? 2 : chapter.Sections[p]==1 ? 4 : 5;
        else op=back ? 2 : VisibleCharacters(chapter,p)<PageCharacters(page) ? 0
            : page+1<PageCount ? 1 : chapter.Intro ? 3 : 4;
        EventHandler.SendNetworkEvent("utnt_chapter",op,PageCount);
    }

    static void Picture(String name,double x,double y,double w,double h,double alpha)
    {
        TextureID tex=TexMan.CheckForTexture(name);
        Vector2 size=TexMan.GetScaledSize(tex);
        double fit=min(w/max(1,size.X),h/max(1,size.Y));
        Screen.DrawTexture(tex,true,x+(w-size.X*fit)/2,y+(h-size.Y*fit)/2,
            DTA_DestWidthF,size.X*fit,DTA_DestHeightF,size.Y*fit,
            DTA_LeftOffset,0,DTA_TopOffset,0,DTA_Alpha,alpha);
    }

    void Draw(UTNTChapterState chapter,double frac)
    {
        if(chapter.Phase>=2) return; // Authored finale ACS owns its original panoramas.
        Prepare(chapter);
        double alpha=clamp((level.time-chapter.StartTime+frac)/35,0,1);
        Screen.Dim(0x080403,1,0,0,Screen.GetWidth(),Screen.GetHeight());
        Picture(chapter.Intro ? "TNTE4_1" : "INTERPIC",0,0,Screen.GetWidth(),Screen.GetHeight(),alpha*(chapter.Intro ? 0.3 : 1));
        if(!chapter.Intro) Picture("INTERP2",0,0,Screen.GetWidth(),Screen.GetHeight(),alpha*0.75);
        Font font=Font.GetFont('SmallFont');
        for(int row=0;row<Heading.Count() && (chapter.Intro || chapter.Sections[consoleplayer]==0);row++)
        {
            String line=Heading.StringAt(row);
            UTNTExplorationUI.Text(line,(Screen.GetWidth()-font.StringWidth(line)*Unit*1.4)/2,
                UTNTUILayout.Margin()+(row*(font.GetHeight()+3)*1.4+8)*Unit,Unit*1.4,0xddc394,alpha);
        }
        if(!chapter.Intro && chapter.Sections[consoleplayer]>0)
        {
            Screen.Dim(0x080403,.68,0,0,Screen.GetWidth(),Screen.GetHeight());
            double bottom=UTNTTransitionBoard.Draw(chapter,BodyY,BodyHeight,Unit);
            double hintUnit=UTNTTransitionBoard.Unit();
            String key=chapter.Sections[consoleplayer]==1 ? "UTNT_TR_NEXT" :
                chapter.Ready[consoleplayer] ? (consoleplayer==UTNTChapterState.Leader() && chapter.EveryoneReady() ? "UTNT_TR_DEPART" : "UTNT_TR_WAIT") : "UTNT_TR_READY";
            String hint=Local(key);
            if(chapter.Sections[consoleplayer]==2 && !multiplayer) hint=Local("UTNT_TR_SOLO_NEXT");
            if(consoleplayer==UTNTChapterState.Leader()) hint=hint.."  "..Local("UTNT_TR_SKIP");
            hint=hint.."\n"..Local("UTNT_TR_BROWSE");
            let lines=font.BreakLines(hint,int((Screen.GetWidth()-24*hintUnit)/hintUnit));
            for(int i=0;i<lines.Count();i++) UTNTExplorationUI.Text(lines.StringAt(i),
                (Screen.GetWidth()-font.StringWidth(lines.StringAt(i))*hintUnit)/2,
                bottom+(12+i*(font.GetHeight()+3))*hintUnit,hintUnit,0xcbb995,alpha);
            if(chapter.Phase==1) Screen.Dim(0,clamp((level.time-chapter.LastInput[UTNTChapterState.Leader()]+frac)/35,0,1),0,0,Screen.GetWidth(),Screen.GetHeight());
            return;
        }
        UTNTExplorationUI.Frame(BodyX,BodyY,BodyWidth/Unit,BodyHeight/Unit,Unit,alpha*0.96);
        int page=clamp(chapter.Pages[consoleplayer],0,PageCount-1);
        int characters=VisibleCharacters(chapter,consoleplayer);
        for(int i=page*Rows;i<min(Lines.Count(),(page+1)*Rows);i++)
        {
            String line=Lines.StringAt(i);
            Screen.DrawText(font,Font.FindFontColor('UTNTNoticeBody'),BodyX+14*Unit,
                BodyY+(12+(i-page*Rows)*(font.GetHeight()+4)*1.3)*Unit,line,
                DTA_ScaleX,Unit*1.3,DTA_ScaleY,Unit*1.3,DTA_TextLen,max(0,characters),DTA_Alpha,alpha);
            characters-=line.Length();
        }
        int picture=chapter.Definition ? chapter.Definition.Picture : UTNTChapterState.ImageNumber(chapter.Episode);
        double blend=clamp((level.time-chapter.StartTime-(chapter.Intro ? 170 : chapter.Definition ? chapter.Definition.PictureTic : UTNTChapterState.ImageChange(chapter.Episode))+frac)/70,0,1);
        Picture(chapter.Intro ? "TNTE4_1" : String.Format("I_%02dA",picture),PictureX,BodyY,PictureWidth,BodyHeight,alpha*(1-blend));
        Picture(chapter.Intro ? "TNTE4_2" : String.Format("I_%02dB",picture),PictureX,BodyY,PictureWidth,BodyHeight,alpha*blend);
        String hint=Local(characters<0 ? "UTNT_CHAPTER_REVEAL" : page+1<PageCount ? "UTNT_CHAPTER_NEXT"
            : "UTNT_TR_RESULTS");
        if(chapter.Intro) hint=Local(consoleplayer==UTNTChapterState.Leader() ? "UTNT_CHAPTER_INTRO_KEYS" : "UTNT_CHAPTER_INTRO_GUEST");
        if(!chapter.Intro && consoleplayer==UTNTChapterState.Leader()) hint=hint.."  "..Local("UTNT_TR_SKIP");
        String status=String.Format("%d / %d",page+1,PageCount).."   "..hint;
        let hints=font.BreakLines(status,int((Screen.GetWidth()-2*UTNTUILayout.Margin())/Unit));
        for(int i=0;i<hints.Count();i++)
            UTNTExplorationUI.Text(hints.StringAt(i),(Screen.GetWidth()-font.StringWidth(hints.StringAt(i))*Unit)/2,
                BodyY+BodyHeight+(12+i*(font.GetHeight()+3))*Unit,Unit,0xcbb995,alpha);
        if(chapter.Phase==1) Screen.Dim(0,clamp((level.time-chapter.LastInput[UTNTChapterState.Leader()]+frac)/35,0,1),0,0,Screen.GetWidth(),Screen.GetHeight());
    }
}
