// Dark Smoke
class DarkSmokeBase : ParticleBase
{
    Default { +CLIENTSIDE }
	Default
	{
		Height 2;
		Radius 1;
		+CLIENTSIDE
		+DONTSPLASH
		+FORCEXYBILLBOARD
		+MISSILE
		+NOBLOCKMAP
		+NOGRAVITY
		+NOINTERACTION
		+WINDTHRUST
		Alpha 0.7;
		Scale 0.3;
	}

	States
	{
		Spawn:
			"####" A 3 A_FadeOut(0.01, FTF_REMOVE);
			Loop;
		Frames:
			DKSM A 0;
			DKS2 A 0;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		int spr = GetSpriteIndex(String.Format("DKS%c", CRandomPick[utntlegacyfx](77, 50))); // M or 2
		if (spr != -1) { sprite = spr; }		
	}
}

class DarkSmoke1 : DarkSmokeBase
{
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		Thrust(1, CFRandom[utntlegacyfx](0, 22.5));
		vel.z = CFRandom[utntlegacyfx](3, 6) / 4;
	}

}

class DarkSmoke2 : DarkSmokeBase
{
	Default
	{
		Scale 0.6;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		Thrust(CFRandom[utntlegacyfx](1, 2), CFRandom[utntlegacyfx](0, 22.5));
		vel.z = CFRandom[utntlegacyfx](5, 9) / 4;
	}
}

class DarkSmoke3 : DarkSmokeBase
{
	Default
	{
		Scale 1.0;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		Thrust(CFRandom[utntlegacyfx](2, 4), CFRandom[utntlegacyfx](0, 22.5));
		vel.z = CFRandom[utntlegacyfx](9, 15) / 4;
	}
}

class DarkSmokeSpawner : EffectSpawner
{
	int count;

	Default
	{
		//$Category "UTNT Effects"
		//$Title Dark Smoke Spawner
		//$Color 12
		//$Arg0 "Size"
		//$Arg0Type 11
		//$Arg0Enum { 0 = "Small"; 1 = "Medium"; 2 = "Large"; }
		Height 40;
		Radius 30;
		// Map switch/TID remains authoritative.
		+DONTSPLASH
		+NOBLOCKMAP
		+NOCLIP
		+NOGRAVITY
		+NOINTERACTION
		EffectSpawner.Range 1200;
		EffectSpawner.SwitchVar "UTNT_ambientsmoke";
		+EffectSpawner.ALLOWTICKDELAY
	}

	States
	{
		Spawn:
			TNT1 A 0;
		Active:
			TNT1 A 0 A_Jump(256,1,2,3);
			TNT1 A 2 { UTNTVisuals.AmbientSmoke(self, args[0]); }
			TNT1 A 4 { UTNTVisuals.AmbientSmoke(self, args[0]); }
			TNT1 A 6 { UTNTVisuals.AmbientSmoke(self, args[0]); }
			Loop;
	}
}
#include "zscript/UTNT_AmbientWater.zc"
