// Secondary fire: saved weapon state and synchronized projectile simulation.
class UTNTSSGBase : SuperShotgun
{
    int SpentBarrels;
    override bool CheckAmmo(int fireMode, bool autoSwitch, bool requireAmmo, int ammocount)
    {
        if(fireMode==PrimaryFire && SpentBarrels==1 && ammocount<0) ammocount=1;
        return Super.CheckAmmo(fireMode,autoSwitch,requireAmmo,ammocount);
    }
    action State A_UTNTSSGPrimary()
    {
        let w=UTNTSSGBase(invoker);
        if(w.SpentBarrels==1) return w.FindState('AltFire');
        return null;
    }
    action void A_UTNTSSGShot(bool single)
    {
        let w=UTNTSSGBase(invoker);
        if(!w.DepleteAmmo(single)) return;
        if(single)
        {
            if(w.SpentBarrels==0) A_GunFlash('AltFlashLeft');
            else A_GunFlash('AltFlashRight');
        }
        w.SpentBarrels=single?w.SpentBarrels+1:2;
        A_FireBullets(12,6,single?10:20,5,'NewPuff',0);
    }
    action State A_UTNTSSGReloadCheck()
    {
        let w=UTNTSSGBase(invoker);
        if(w.SpentBarrels>=2 || (w.SpentBarrels==1 && !w.CheckAmmo(Weapon.AltFire,false)))
            return w.FindState('Reload');
        return null;
    }
    action void A_UTNTSSGReloaded() { UTNTSSGBase(invoker).SpentBarrels=0; }
}

class UTNTRocketLauncherBase : RocketLauncher
{
    action void A_UTNTGrenade()
    {
        Actor grenade=A_FireProjectile('UTNTGrenade',flags:FPF_NOAUTOAIM);
        if(grenade) grenade.Vel+=(cos(Angle)*sin(Pitch),sin(Angle)*sin(Pitch),cos(Pitch))*(200.0/TICRATE);
    }
}

class UTNTPlasmaRifleBase : PlasmaRifle
{
    int HeavyPhase;
    action void A_UTNTHeavyDelay()
    {
        let w=UTNTPlasmaRifleBase(invoker);
        w.HeavyPhase=(w.HeavyPhase+1)%3;
        // 35 weapon tics / 3 shots, within the same Overdrive-aware sequence.
        player.GetPSprite(PSprite.WEAPON).tics=w.HeavyPhase==0?8:9;
    }
}

// The DECORATE primary and heavy balls share all of the existing plasma artwork.
class UTNTPlasmaBase : PlasmaBall
{
    int SeekAge;
    override void Tick()
    {
        Super.Tick();
        if(!bMissile || !bSeekerMissile) return;
        if(++SeekAge>5*TICRATE) { tracer=null; return; }
        if(!UTNTSecondaryTarget.Valid(tracer,target) || !CheckSight(tracer)) tracer=null;
        if(!tracer && SeekAge%7==1)
            tracer=UTNTSecondaryTarget.Find(self,1024,20);
        if(tracer && SeekAge%2==0) A_SeekerMissile(2,2,SMF_PRECISE);
    }
}

class UTNTSecondaryTarget : Object play
{
    static bool Valid(Actor candidate,Actor shooter)
    {
        return candidate && candidate!=shooter && candidate.bIsMonster && !candidate.player
            && candidate.bShootable && candidate.Health>0 && !candidate.bFriendly
            && !candidate.bDormant && !candidate.bInvulnerable && !candidate.bNoDamage;
    }
    static Actor Find(Actor shot,double range,double cone=180)
    {
        Actor best;
        double nearest=range;
        let it=BlockThingsIterator.Create(shot,range);
        let chain=UTNTBFGChain(shot);
        while(it.Next())
        {
            let m=it.thing;
            if(!Valid(m,shot.target) || (chain && chain.HasVisited(m))) continue;
            double distance=shot.Distance3D(m);
            if(distance>=nearest || abs(Actor.DeltaAngle(shot.Angle,shot.AngleTo(m)))>cone) continue;
            if(!shot.CheckSight(m)) continue;
            nearest=distance; best=m;
        }
        return best;
    }
}

class UTNTGrenade : Actor
{
    int Age;
    double SpinYaw,SpinPitch,SpinRoll;
    override void BeginPlay()
    {
        Super.BeginPlay();
        SpinYaw=Random[utntgrenadespin](0,1)?1.4:-1.4;
        SpinPitch=Random[utntgrenadespin](0,1)?2.2:-2.2;
        SpinRoll=Random[utntgrenadespin](0,1)?1.8:-1.8;
    }
    override int SpecialBounceHit(Actor other,Line wall,readonly<SecPlane> plane,bool is3DFloor)
    {
        // Contact changes angular momentum; the engine still owns the ballistic bounce.
        double impulse=clamp(Vel.Length()/12.,0.35,1.6);
        SpinYaw=-SpinYaw*FRandom[utntgrenadespin](0.65,1.05);
        SpinPitch=FRandom[utntgrenadespin](-3.2,3.2)*impulse;
        SpinRoll=-SpinRoll*FRandom[utntgrenadespin](0.65,1.05);
        return MHIT_DEFAULT;
    }
    Default
    {
        Radius 6; Height 6; Speed 17.142857; Gravity 0.653061;
        Damage 0; Projectile; -NOGRAVITY
        BounceType "Hexen"; -BOUNCEONACTORS
        BounceFactor 0.7; WallBounceFactor 0.6;
        +ROLLSPRITE +INTERPOLATEANGLES
        Scale 0.4;
        BounceSound "weapons/grenadebounce";
        SeeSound "weapons/rocklf";
        DeathSound "weapons/rocklx";
        Obituary "$OB_MPROCKET";
    }
    override void Tick()
    {
        Super.Tick();
        if(!bMissile) return;
        // Orientation only: never rotate the physical velocity or collision hull.
        if(Vel.LengthSquared()>1 && Pos.Z>floorz+0.5)
        {
            Angle+=SpinYaw; Pitch+=SpinPitch; Roll+=SpinRoll;
            int interval=UTNTIndustrialFX.Quality()==1?6:3;
            if(Age%interval==0 && UTNTVisuals.Visible(self,combat:true))
            {
                let puff=UTNTIndustrialFX.Make(Pos-Vel.Unit()*3+(0,0,3),1,
                    2.4,2.4,21,0xff9a9287,
                    (CFRandom[utntcosmetic](-0.08,0.08),CFRandom[utntcosmetic](-0.08,0.08),0.16));
                if(puff)
                {
                    puff.Strength=0.18; puff.Growth=0.65; puff.FadeIn=2;
                    puff.Flags&=~SPF_FULLBRIGHT;
                }
            }
        }
        // Quake's 2.5 seconds rounded to the next Doom simulation tic.
        if(++Age>=88) ExplodeMissile(null,null);
    }
    States
    {
    Spawn:
        UGRN A 1;
        Loop;
    Death:
        TNT1 A 0 A_SpawnItemEx("UTNTRocketExplosion");
        TNT1 A 0 A_Explode(120,160,XF_HURTSOURCE);
        MISL BCD 4 Bright;
        Stop;
    }
}

// One projectile identity for damage attribution, critical rolls and save/load.
class UTNTBFGChain : Actor
{
    Array<Actor> Visited;
    int HitCount, Age, HopAge, RouteIndex, RouteAttempts, RouteCount;
    Vector3 Route[64];
    bool Finished;
    const MAX_HITS=12;
    const HIT_DAMAGE=260; // 3120 total; vanilla ball + full spray averages 3150.
    Default
    {
        Radius 8; Height 8; Speed 21.44; Damage 0;
        Projectile; +SEEKERMISSILE
        BounceType "Hexen"; -BOUNCEONACTORS -ALLOWBOUNCEONACTORS
        RenderStyle "Add"; Alpha 0.9; Scale 0.28;
        Translation "0:255=%[0,0,0]:[0.65,0.81,0.34]";
        DeathSound "weapons/bfgx";
        Obituary "$OB_MPBFG_SPLASH";
    }
    bool HasVisited(Actor victim)
    {
        for(int i=0;i<Visited.Size();i++) if(Visited[i]==victim) return true;
        return false;
    }
    void FinishChain()
    {
        if(Finished) return;
        Finished=true; bMissile=false; Vel=(0,0,0); tracer=null;
        A_StartSound(DeathSound,CHAN_BODY);
        SetStateLabel('Death');
    }
    // Trace the swept hull, including floor/ceiling clearance. Never phase through geometry.
    bool ClearFlight(Vector3 from,Vector3 to)
    {
        Vector3 d=to-from;double length=d.Length();if(length<0.01)return true;
        let ray=new('LineTracer');
        for(int i=0;i<8;i++)
        {
            Vector3 origin=from+((i&1)?7.75:-7.75,(i&2)?7.75:-7.75,(i&4)?7.75:0.25);
            ray.Trace(origin,level.PointInSector(origin.XY),d/length,length,0,
                wallMask:Line.ML_BLOCKING|Line.ML_BLOCKEVERYTHING|Line.ML_BLOCKPROJECTILE,ignoreAllActors:true);
            if(ray.Results.HitType!=TRACE_HitNone)return false;
        }
        return true;
    }
    Vector3 GridPoint(int node,Vector3 origin)
    { return origin+((node%25-12)*32,(node/25-12)*32,0); }
    bool FindRoute()
    {
        RouteCount=0;RouteIndex=0;
        if(++RouteAttempts>8)return false;
        Array<Actor> candidates;let it=BlockThingsIterator.Create(self,384);
        while(it.Next())
        {
            let m=it.thing;
            if(UTNTSecondaryTarget.Valid(m,target) && !HasVisited(m) && Distance3D(m)<=384)
                candidates.Push(m);
        }
        if(candidates.Size()==0)return false;
        // One bounded breadth-first search; the first reachable victim has a short local route.
        int parents[625];Array<int> queue;
        for(int i=0;i<625;i++)parents[i]=-2;
        parents[312]=-1;queue.Push(312);
        Vector3 origin=Pos;
        for(int head=0;head<queue.Size();head++)
        {
            int node=queue[head];Vector3 point=GridPoint(node,origin);
            Actor best;double nearest=1e30;
            for(int i=0;i<candidates.Size();i++)
            {
                let m=candidates[i];Vector3 goal=m.Pos+(0,0,m.Height*.5-Height*.5);
                double distance=(goal-point).Length();
                if(distance<nearest && ClearFlight(point,goal)){best=m;nearest=distance;}
            }
            if(best)
            {
                tracer=best;
                Array<int> reverse;
                for(int n=node;parents[n]>=0;n=parents[n])reverse.Push(n);
                if(reverse.Size()>63)return false;
                for(int n=reverse.Size()-1;n>=0;n--)Route[RouteCount++]=GridPoint(reverse[n],origin);
                Route[RouteCount++]=best.Pos+(0,0,best.Height*.5-Height*.5);
                FollowRoute();return true;
            }
            int offsets[]={1,-1,25,-25};
            for(int i=0;i<4;i++)
            {
                int next=node+offsets[i];
                if(next<0 || next>=625 || (i<2 && next/25!=node/25) || parents[next]!=-2)continue;
                Vector3 dest=GridPoint(next,origin);
                if((dest-origin).LengthSquared()>384*384 || !ClearFlight(point,dest))continue;
                parents[next]=node;queue.Push(next);
            }
        }
        return false;
    }
    void FollowRoute()
    {
        while(RouteIndex<RouteCount && (Route[RouteIndex]-Pos).Length()<1)RouteIndex++;
        if(RouteIndex>=RouteCount){RouteCount=0;return;}
        // Skip redundant grid corners only when the complete missile hull fits.
        for(int i=RouteCount-1;i>RouteIndex;i--)
            if(ClearFlight(Pos,Route[i])){RouteIndex=i;break;}
        Vector3 d=Route[RouteIndex]-Pos;
        Vel=d.Unit()*min(Speed,d.Length());Angle=atan2(Vel.Y,Vel.X);
    }
    override int SpecialBounceHit(Actor other,Line wall,readonly<SecPlane> plane,bool is3DFloor)
    {
        if(!Finished && !FindRoute())FinishChain();
        return 1;
    }
    override void Tick()
    {
        if(RouteCount>0 && !Finished)
        {
            if(!UTNTSecondaryTarget.Valid(tracer,target) || HasVisited(tracer) || Distance3D(tracer)>384)
            { if(!FindRoute())FinishChain(); }
            else FollowRoute();
        }
        Super.Tick();
        if(Finished || !bMissile)return;
        if(++Age>10*TICRATE || ++HopAge>2*TICRATE){FinishChain();return;}
        if(RouteCount>0)return;
        if(!UTNTSecondaryTarget.Valid(tracer,target) || HasVisited(tracer) || !CheckSight(tracer))tracer=null;
        if(!tracer)
        {
            tracer=UTNTSecondaryTarget.Find(self,HitCount?768:1024,HitCount?180:35);
            if(!tracer && HitCount){if(!FindRoute())FinishChain();return;}
        }
        if(tracer)A_SeekerMissile(30,30,SMF_PRECISE);
    }
    override int SpecialMissileHit(Actor victim)
    {
        if(Finished || victim==target || victim.player || victim.bFriendly || HasVisited(victim)) return 1;
        if(!UTNTSecondaryTarget.Valid(victim,target)) return victim.bSolid?0:1;
        Visited.Push(victim); HitCount++; HopAge=0;RouteCount=0;RouteIndex=RouteAttempts=0;
        victim.DamageMobj(self,target,HIT_DAMAGE,'BFGSplash');
        A_SpawnItemEx("BFGExtra",0,0,0);
        if(HitCount>=MAX_HITS) { FinishChain(); return 1; }
        tracer=UTNTSecondaryTarget.Find(self,768);
        if(!tracer) { if(!FindRoute())FinishChain(); }
        else
        {
            // A new hop starts toward its next victim; subsequent steering follows movement.
            Angle=AngleTo(tracer);
            Vector3 direction=Vec3To(tracer)+(0,0,tracer.Height*0.5);
            Vel=direction.Unit()*Speed;
        }
        return 1;
    }
    States
    {
    Spawn:
        X016 ABCDEFGHIJKLMNOPQRSTUVWXY 2 Bright LIGHT("BFGBALL") A_SpawnItemEx("BFG10KBoltTrail");
        Loop;
    Death:
        TNT1 A 0 { Finished=true; bMissile=false; Vel=(0,0,0); }
        BFE2 ABCD 4 Bright;
        Stop;
    }
}


class UTNTPistolBase : Pistol
{
    action State A_UTNTBurstShot()
    {
        let w=Weapon(invoker);
        if(!w.DepleteAmmo(true)) return w.FindState('AltRecover');
        A_GunFlash();
        A_SetBlend("Orange",0.02,5);
        A_SpawnItemEx('PisCaseSpawn',20,0,29);
        A_FireBullets(4,4,1,5,'NewPuff',0);
        return null;
    }
}

class UTNTFlamerBase : Weapon
{
    action void A_UTNTAirBlast()
    {
        if(!invoker.DepleteAmmo(true))return;
        Vector3 forward=(cos(Angle)*cos(Pitch),sin(Angle)*cos(Pitch),-sin(Pitch));
        Vector3 origin=Pos+(0,0,player?player.ViewHeight:Height*.5);
        let wave=UTNTPressureWave(Spawn('UTNTPressureWave',origin));
        wave.target=self;wave.Angle=Angle;wave.Pitch=Pitch;wave.Vel=forward*22;
        A_StartSound("weapons/flamer",CHAN_WEAPON,0,0.7,ATTN_NORM,1.4);
        // Missiles commonly have NOBLOCKMAP: include them explicitly in this one-shot scan.
        let it=ThinkerIterator.Create('Actor',Thinker.STAT_DEFAULT);Actor m;
        while(m=Actor(it.Next()))
        {
            if(!m.bMissile && !m.bIsMonster)continue;
            if(!m || m==self || m.player || m.bFriendly || m.bBoss || m.bDormant)continue;
            Vector3 delta=Vec3To(m)+(0,0,m.Height*.5-(origin.Z-Pos.Z));
            double distance=delta.Length();
            if(distance>320 || distance<1 || (delta.Unit() dot forward)<cos(50) || !CheckSight(m))continue;
            if(m.bMissile)
            {
                // Only small, hostile, ordinary monster missiles; preserve player projectiles.
                if(!m.target || !m.target.bIsMonster || m.target.bFriendly || m.target.bBoss || m.Radius>8 || m.Height>16 || m.Vel.Length()>35)continue;
                double speed=m.Vel.Length();if(speed<1)continue;
                m.target=self;m.tracer=null;
                m.Vel=(forward*.8+delta.Unit()*.2).Unit()*speed;
                m.Angle=atan2(m.Vel.Y,m.Vel.X);
                m.Pitch=-atan2(m.Vel.Z,m.Vel.XY.Length());
            }
            else if(UTNTSecondaryTarget.Valid(m,self) && !m.bDontThrust)
            {
                double force=36*clamp(100./max(1,m.Mass),0.2,1.);
                m.Vel+=forward*force+(0,0,min(6,force*.2));
            }
        }
    }
}

// Saved short-lived world anchor; all particles and refraction are local cosmetics.
class UTNTPressureWave : Actor
{
    int Age;
    Default { +NOINTERACTION +NOGRAVITY +NOBLOCKMAP Radius 1; Height 1; }
    override void Tick()
    {
        Super.Tick();
        if(++Age>=14){Destroy();return;}
        if(Age%3!=1 || !UTNTIndustrialFX.At(Pos))return;
        Vector3 right=(-sin(Angle),cos(Angle),0);
        Vector3 up=(cos(Angle)*sin(Pitch),sin(Angle)*sin(Pitch),cos(Pitch));
        for(int i=0;i<8;i++)
        {
            double a=i*45+Age*4;
            Vector3 dir=right*cos(a)+up*sin(a);
            let puff=UTNTIndustrialFX.Make(Pos+dir*(12+Age*12),1,4,4,10,0xffc6d7db,dir*.4);
            if(puff){puff.Strength=.14;puff.Growth=.7;puff.Flags&=~SPF_FULLBRIGHT;}
        }
    }
    States { Spawn: TNT1 A -1; Stop; }
}

class UTNTPressureView ui
{
    static void Render(RenderEvent e)
    {
        PPShader.SetEnabled('UTNTPressure',false);
        if(!e.Camera || consoleplayer<0)return;
        let p=players[consoleplayer];
        if(!CVar.GetCVar('UTNT_shaderoverlayswitch',p).GetBool() || CVar.GetCVar('UTNT_reducedfx',p).GetBool() || CVar.GetCVar('UTNT_fxquality',p).GetInt()==0)return;
        let it=ThinkerIterator.Create('UTNTPressureWave');UTNTPressureWave wave;
        double best=0;Vector2 focus;double radius=0;
        Vector3 forward=(cos(e.ViewAngle)*cos(e.ViewPitch),sin(e.ViewAngle)*cos(e.ViewPitch),-sin(e.ViewPitch));
        Vector3 right=(sin(e.ViewAngle),-cos(e.ViewAngle),0);
        Vector3 up=(cos(e.ViewAngle)*sin(e.ViewPitch),sin(e.ViewAngle)*sin(e.ViewPitch),cos(e.ViewPitch));
        double aspect=double(Screen.GetWidth())/max(1,Screen.GetHeight());
        double horizontal=tan(clamp(p.FOV,30,150)*.5)*max(1,aspect/(4./3.));
        while(wave=UTNTPressureWave(it.Next()))
        {
            Vector3 d=wave.Pos+wave.Vel*e.FracTic-e.ViewPos;
            double depth=d dot forward;if(depth<=4 || d.Length()>768)continue;
            double x=(d dot right)/(depth*horizontal),y=(d dot up)/(depth*horizontal/aspect);
            double age=wave.Age+e.FracTic;
            double strength=(1-age/14.)*clamp((768-d.Length())/400,0,1);
            if(strength<=best || abs(x)>1.4 || abs(y)>1.4)continue;
            let trace=new('LineTracer');
            trace.Trace(e.ViewPos,e.Camera.CurSector,d.Unit(),max(0,d.Length()-2),0,wallMask:0,ignoreAllActors:true);
            if(trace.Results.HitType!=TRACE_HitNone)continue;
            double rx=x*cos(e.ViewRoll)+y*sin(e.ViewRoll),ry=y*cos(e.ViewRoll)-x*sin(e.ViewRoll);
            focus=(.5+rx*.5,.5+ry*.5);radius=(12+age*12)/(depth*horizontal/aspect)*.5;best=strength;
        }
        if(best<=0)return;
        PPShader.SetUniform2f('UTNTPressure','focus',focus);
        PPShader.SetUniform1f('UTNTPressure','radius',radius);
        PPShader.SetUniform1f('UTNTPressure','strength',best);
        PPShader.SetEnabled('UTNTPressure',true);
    }
}

class UTNTPyroBurn : Inventory
{
    Actor Shooter;
    int Remaining,Clock;
    Default { Inventory.MaxAmount 1; +INVENTORY.UNDROPPABLE +INVENTORY.UNTOSSABLE }
    static void Ignite(Actor victim,Actor shooter)
    {
        if(!victim || victim.Health<=0)return;
        let burn=UTNTPyroBurn(victim.FindInventory('UTNTPyroBurn'));
        if(!burn){burn=UTNTPyroBurn(Spawn('UTNTPyroBurn'));burn.AttachToOwner(victim);}
        burn.Shooter=shooter;burn.Remaining=70;
    }
    override void DoEffect()
    {
        if(!Owner || Owner.Health<=0 || Remaining--<=0){Destroy();return;}
        if(++Clock%7!=0)return;
        if(!UTNTSecondaryTarget.Valid(Owner,Shooter))return;
        Owner.DamageMobj(self,Shooter,6,'Fire');
        if(Owner && Owner.Health>0 && UTNTIndustrialFX.At(Owner.Pos))
        {
            double radius=min(14,Owner.Radius*.6);
            Vector3 pos=Owner.Pos+(CFRandom[utntcosmetic](-radius,radius),CFRandom[utntcosmetic](-radius,radius),Owner.Height*.45);
            let flame=UTNTIndustrialFX.Make(pos,2,10,16,12,0xffffaa60,(0,0,.5));
            if(flame)flame.Strength=.55;
        }
    }
    States { Spawn: TNT1 A -1; Stop; }
}

class UTNTPyroOrb : Actor
{
    int Age;
    Default
    {
        Radius 12;Height 16;Speed 8;Damage 0;Projectile;
        RenderStyle "Add";Alpha .95;Scale .9;DamageType "Fire";
        SeeSound "weapons/hellfi";DeathSound "weapons/hellex";Obituary "$WB_PYROC";
    }
    override int SpecialMissileHit(Actor victim) { return 1; }
    override void Tick()
    {
        Super.Tick();if(!bMissile)return;
        // Silent cleanup in open/sky spaces; only geometry impact detonates.
        if(++Age>14*TICRATE){Destroy();return;}
        if(Age%2==0 && UTNTIndustrialFX.At(Pos))
        {
            let flame=UTNTIndustrialFX.Make(Pos-Vel.Unit()*8,2,14,18,12,0xffffa650,-Vel*.08+(0,0,.15));
            if(flame)flame.Strength=.6;
        }
        if(Age%7!=0)return;
        let it=BlockThingsIterator.Create(self,112);
        while(it.Next())
        {
            let m=it.thing;if(!UTNTSecondaryTarget.Valid(m,target))continue;
            Vector3 d=Vec3To(m)+(0,0,clamp(Pos.Z-m.Pos.Z,0,m.Height));
            if(d.Length()>112 || !CheckSight(m))continue;
            if(m.DamageMobj(self,target,40,'Fire')>0)UTNTPyroBurn.Ignite(m,target);
        }
    }
    States
    {
    Spawn:
        PBAL AAAABBBB 1 Bright LIGHT("PyroShot");
        Loop;
    Death:
        TNT1 A 0 A_SpawnItemEx("UTNTPyroImpactSmoke");
        PYXP C 2 Bright LIGHT("PyroShot_1") A_Explode(192,128,XF_HURTSOURCE);
        PYXP DEFGHIJKLMNOPQRSTU 1 Bright;
        Stop;
    }
}

class UTNTSecondaryInfo : Object
{
    static int Index(Name type)
    {
        if(type=='UTNTPistol')return 1;
        if(type=='UTNTShotgun')return 2;
        if(type=='UTNTSuperShotgun')return 3;
        if(type=='UTNTRocketLauncher')return 4;
        if(type=='UTNTPlasmaRifle')return 5;
        if(type=='UTNTBFG9000')return 6;
        if(type=='UTNTFlamer')return 7;
        if(type=='UTNTPyroCannon')return 8;
        return 0;
    }
    static String HintKey(int mode)
    {
        String keys[]={"PISTOL","SHOTGUN","SSG","GRENADE","PLASMA","BFG","FLAMER","PYRO"};
        return mode>=1 && mode<=8?"UTNT_ALT_"..keys[mode-1]:"";
    }
}

// Like the campaign ledger, this thinker travels and saves with the game.
class UTNTSecondaryHints : Thinker
{
    int Seen[MAXPLAYERS];
    static UTNTSecondaryHints Get(bool create=true)
    {
        let it=ThinkerIterator.Create('UTNTSecondaryHints',STAT_STATIC);
        let h=UTNTSecondaryHints(it.Next());
        if(!h && create){h=new('UTNTSecondaryHints');h.ChangeStatNum(STAT_STATIC);}
        return h;
    }
    static bool Claim(int playerNumber,int mode)
    {
        if(playerNumber<0 || playerNumber>=MAXPLAYERS || mode<1 || mode>8)return false;
        let h=Get();int bit=1<<(mode-1);
        if(h.Seen[playerNumber]&bit)return false;
        h.Seen[playerNumber]|=bit;return true;
    }
}

class UTNTSecondaryHUD ui
{
    static void Badge(double x,double y,double s,int mode,bool firing)
    {
        int ink=firing?0xffd58a:0xbe965e;
        UTNTObjectivePlaque.Rect(x,y,s,0,0,12,9,0x080706,.9);
        UTNTObjectivePlaque.Rect(x,y,s,0,0,12,1,ink,.8);
        UTNTObjectivePlaque.Rect(x,y,s,0,8,12,1,0x58432b,1);
        UTNTObjectivePlaque.Rect(x,y,s,0,0,1,9,0x725639,1);
        UTNTObjectivePlaque.Rect(x,y,s,11,0,1,9,0x725639,1);
        for(int i=0;i<mode;i++)
        {
            int left=mode==1?5:3+i*4;
            UTNTObjectivePlaque.Rect(x,y,s,left,2,2,5,ink,1);
        }
    }
    static void Draw(RenderEvent e)
    {
        if(UTNTTransitionFade.HidesGameplayHUD() || gamestate!=GS_LEVEL || !viewactive
            || automapactive || menuactive || ConsoleState!=0 || CVar.FindCVar('screenblocks').GetInt()>11)return;
        let mo=e.Camera;
        if(!mo || !mo.player || mo.Health<=0 || mo.FindInventory('UTNTHUDHidden'))return;
        let fx=UTNTPlayerEffects(mo.FindBehavior('UTNTPlayerEffects'));
        if(fx && fx.Cutscene || mo.player.cheats&CF_TOTALLYFROZEN)return;
        let w=mo.player.ReadyWeapon;if(!w)return;
        let psp=mo.player.FindPSprite(PSprite.WEAPON);
        bool firing=psp && (mo.InStateSequence(psp.CurState,w.FindState('Fire'))
            || mo.InStateSequence(psp.CurState,w.FindState('Hold'))
            || mo.InStateSequence(psp.CurState,w.FindState('AltFire'))
            || mo.InStateSequence(psp.CurState,w.FindState('AltHold')));
        bool secondary=UTNTSecondaryInfo.Index(w.GetClassName())>0;
        Vector2 scale=StatusBar?StatusBar.GetHUDScale():(2,2);
        double s=max(1,scale.Y),x=Screen.GetWidth()*.5-(secondary?13:6)*s;
        double y=Screen.GetHeight()-43*s;
        Badge(x,y,s,1,firing && !w.bAltFire);
        if(secondary)Badge(x+14*s,y,s,2,firing && w.bAltFire);
    }
}
