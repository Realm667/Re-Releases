// Native menu actions still own class selection, episodes and difficulty.
class UTNTClassMenu : ListMenu
{
    Array<int> Entries;
    override void Init(Menu parent,ListMenuDescriptor desc)
    {
        Super.Init(parent,desc);
        Entries.Clear();
        for(int i=0;i<mDesc.mItems.Size();i++)
        {
            let [menuAction,param]=mDesc.mItems[i].GetAction();
            if(menuAction=='EpisodeMenu') Entries.Push(i);
        }
    }
    double CardScale() { return min(Screen.GetWidth()/780.0,Screen.GetHeight()/590.0); }
    override bool MenuEvent(int key,bool controller)
    {
        if(key==MKEY_Left) key=MKEY_Up;
        if(key==MKEY_Right) key=MKEY_Down;
        return Super.MenuEvent(key,controller);
    }
    override bool MouseEvent(int type,int mx,int my)
    {
        double s=CardScale(),left=(Screen.GetWidth()-740*s)/2,top=(Screen.GetHeight()-490*s)/2;
        for(int i=0;i<min(3,Entries.Size());i++)
            if(mx>=left+i*250*s && mx<=left+(i*250+240)*s && my>=top && my<=top+455*s)
            {
                mDesc.mSelectedItem=Entries[i];
                if(type==MOUSE_Release) Super.MenuEvent(MKEY_Enter,false);
                return true;
            }
        if(Entries.Size()>3 && my>=top+466*s && my<=top+492*s)
        {
            mDesc.mSelectedItem=Entries[3];
            if(type==MOUSE_Release) Super.MenuEvent(MKEY_Enter,false);
            return true;
        }
        return false;
    }
    static void Center(String text,double x,double y,double s,int shade)
    { UTNTExplorationUI.Text(text,x-AlternativeSmallFont.StringWidth(text)*s/2,y,s,shade); }
    static void Sprite(State st,double x,double y,double boxw,double boxh)
    {
        if(!st) return;
        TextureID pic=st.GetSpriteTexture(0);
        if(!pic.IsValid()) return;
        Vector2 size=TexMan.GetScaledSize(pic);
        double scale=min(boxw/max(1,size.X),boxh/max(1,size.Y));
        Screen.DrawTexture(pic,true,x-size.X*scale/2,y-size.Y*scale/2,
            DTA_DestWidth,int(round(size.X*scale)),DTA_DestHeight,int(round(size.Y*scale)),DTA_LeftOffset,0,DTA_TopOffset,0);
    }
    static void Ability(int kind,int slot,double x,double y,double s)
    {
        int color=slot==1?0xe49b55:0x91baa0;
        UTNTAbilityHUD.Icon(kind,slot,x+14*s,y,s,color);
        let [k1,k2]=Bindings.GetKeysForCommand(slot==1?"utnt_offense":"utnt_defense");
        String key=k1?KeyBindings.NameKeys(k1,0,false):"--";
        String title=UTNTAbilityHUD.Title(kind,slot).." ["..key.."]";
        double ts=min(s,184*s/max(1,AlternativeSmallFont.StringWidth(title)));
        UTNTExplorationUI.Text(title,x+38*s,y+4*s,ts,color);
        String keys[]={"RAGE","REGEN","WEAK","CLOAK","OVERDRIVE","BULWARK"};
        let lines=AlternativeSmallFont.BreakLines(UTNTExplorationUI.Local("UTNT_AB_CARD_"..keys[kind*2+slot-1]),210);
        for(int row=0;row<lines.Count();row++)
            UTNTExplorationUI.Text(lines.StringAt(row),x+14*s,y+(25+12*row)*s,s,0xbab3a7);
    }
    override void Drawer()
    {
        double s=CardScale(),left=(Screen.GetWidth()-740*s)/2,top=(Screen.GetHeight()-490*s)/2;
        Center(UTNTExplorationUI.Local("UTNT_CLASS_TITLE"),Screen.GetWidth()/2.0,top-38*s,2*s,0xc9954b);
        String roles[]={"UTNT_CLASS_MARINE","UTNT_CLASS_SCOUT","UTNT_CLASS_COMMANDO"};
        String gear[]={"UTNT_CLASS_SHOTGUN","UTNT_CLASS_PISTOL","UTNT_CLASS_MINIGUN"};
        class<Inventory> weapons[]={'UTNTShotgun','UTNTPistol','UTNTMinigun'};
        for(int i=0;i<min(3,Entries.Size());i++)
        {
            let [menuAction,index]=mDesc.mItems[Entries[i]].GetAction();
            if(index<0 || index>=PlayerClasses.Size()) continue;
            let pawn=GetDefaultByType((class<PlayerPawn>)(PlayerClasses[index].Type));
            bool selected=mDesc.mSelectedItem==Entries[i];
            double x=left+i*250*s,cx=x+120*s;
            UTNTExplorationUI.Frame(x,top,240,455,s,selected?1:0.72);
            if(selected) Screen.Dim(0xc9954b,1,int(x),int(top),int(240*s),max(1,int(2*s)));
            Center(PlayerPawn.GetPrintableDisplayName(PlayerClasses[index].Type),cx,top+19*s,1.7*s,selected?0xe5c487:0xb7ab94);
            Sprite(pawn.SpawnState,cx,top+87*s,72*s,80*s);
            Center(String.Format(UTNTExplorationUI.Local("UTNT_CLASS_HEALTH"),pawn.MaxHealth),cx,top+143*s,1.15*s,0xd6d0c3);
            Center(String.Format(UTNTExplorationUI.Local("UTNT_CLASS_SPEED"),int(pawn.ForwardMove1*100)),cx,top+161*s,1.15*s,0xd6d0c3);
            Sprite(GetDefaultByType(weapons[i]).SpawnState,x+48*s,top+198*s,46*s,26*s);
            UTNTExplorationUI.Text(UTNTExplorationUI.Local(gear[i]),x+85*s,top+195*s,s,0xc9954b);
            let lines=AlternativeSmallFont.BreakLines(UTNTExplorationUI.Local(roles[i]),210);
            for(int row=0;row<lines.Count();row++) Center(lines.StringAt(row),cx,top+(224+12*row)*s,s,0xbab3a7);
            int kind=pawn is 'Scout'?1:pawn is 'Commando'?2:0;
            Ability(kind,1,x,top+258*s,s);
            Ability(kind,2,x,top+330*s,s);
            Screen.Dim(0x77532f,0.7,int(x+14*s),int(top+404*s),int(212*s),max(1,int(s)));
            String timing[]={"UTNT_AB_CARD_TIMING","UTNT_AB_CARD_EXCLUSIVE","UTNT_AB_CARD_LOCK"};
            for(int row=0;row<3;row++) Center(UTNTExplorationUI.Local(timing[row]),cx,top+(414+12*row)*s,s,0x998c76);
        }
        Center(UTNTExplorationUI.Local("UTNT_CLASS_RANDOM"),Screen.GetWidth()/2.0,top+474*s,s,
            Entries.Size()>3 && mDesc.mSelectedItem==Entries[3]?0xe5c487:0xb7ab94);
        Center(UTNTExplorationUI.Local("UTNT_CLASS_HELP"),Screen.GetWidth()/2.0,top+508*s,s,0x998c76);
    }
}

// Invoked only by the menu: protected CVars may be changed here.
class OptionMenuItemUTNTPreset : OptionMenuItemSubmenu
{
    static void Apply(int preset)
    {
        bool quiet=preset==2;
        CVar.FindCVar('UTNT_reducedfx').SetInt(quiet);
        CVar.FindCVar('UTNT_fxquality').SetInt(quiet?1:(preset==0?2:3));
        CVar.FindCVar('UTNT_lod').SetInt(quiet?1024:2048);
        CVar.FindCVar('UTNT_ambientsmoke').SetInt(preset==1);
        CVar.FindCVar('UTNT_heatstrength').SetFloat(preset==1?0.6:(quiet?0:0.25));
        CVar.FindCVar('UTNT_shaderoverlayswitch').SetInt(!quiet);
        CVar.FindCVar('UTNT_uweffectsize').SetFloat(preset==1?0.015:0);
        CVar.FindCVar('motionblur').SetInt(0);
        CVar.FindCVar('UTNT_lowhealthfx').SetInt(preset==1);
        CVar.FindCVar('UTNT_heartbeatvolume').SetFloat(preset==1?0.4:0);
        // Shared weather controls remain in the atmosphere menu, not local presets.
    }
    override bool Activate()
    {
        Apply(mParam);Menu.MenuSound("menu/change");return true;
    }
}
