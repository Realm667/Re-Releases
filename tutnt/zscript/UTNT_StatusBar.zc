// SBARINFO bridge for UTNT's saved cutscene state and scripted camera views.
// No icon/INVBAR flag: this marker never becomes a usable inventory item.
class UTNTHUDHidden : Inventory
{
    Default
    {
        Inventory.MaxAmount 1;
        Inventory.InterHubAmount 0;
        +INVENTORY.UNDROPPABLE
        +INVENTORY.UNTOSSABLE
    }
}
