// Cosmetic effects use their own random stream and never write gameplay state.
#include "zscript/UTNT_Fire.zc"
#include "zscript/UTNT_Steam.zc"

// Lives in the client thinker list: local limits never enter a saved gameplay handler.
class UTNTVisualBudget : Thinker
{
    int EmissionTic, AmbientEmitted, CombatEmitted;
}

class UTNTRocketFlameVisual : VisualThinker
{
    int Age;
    bool SecondAnimation;
    void Initialize() { UpdateSector(); UpdateSpriteInfo(); }
    override void Tick()
    {
        if (IsFrozen()) return;
        Super.Tick();
        Age++;
        if (Age >= (SecondAnimation ? 10 : 16)) { Destroy(); return; }
        Texture=TexMan.CheckForTexture(String.Format("X00%d%c0",SecondAnimation ? 7 : 6,65+Age));
        UpdateSpriteInfo();
    }
}

// Sprite scale and FSpawnParticleParams.size use different renderer units.
// Keep legacy dimensions in sprite space instead of approximating that conversion.
class UTNTLegacySizedVisual : VisualThinker
{
    int Age, Life, Kind;
    double FadeStep;

    static void Emit(FSpawnParticleParams p, Vector2 spriteScale, int kind)
    {
        let v=UTNTLegacySizedVisual(level.SpawnClientSideVisualThinker('UTNTLegacySizedVisual'));
        if (!v) return;
        v.Kind=kind; v.Texture=p.texture; v.Scale=spriteScale;
        v.Pos=p.pos; v.Prev=v.Pos; v.Vel=p.vel;
        v.Alpha=p.startalpha; v.FadeStep=p.fadestep; v.Life=p.lifetime;
        v.Flags=p.flags|SPF_STRETCHPIXELS;
        v.scolor=p.color1|0xff000000; v.SetRenderStyle(p.style);
        v.Roll=p.startroll; v.PrevRoll=v.Roll;
        v.UpdateSector(); v.UpdateSpriteInfo();
    }

    override void Tick()
    {
        if (IsFrozen()) return;
        if (++Age>=Life) { Destroy(); return; }
        Alpha=min(1.0,Alpha-FadeStep);
        if (Alpha<=0) { Destroy(); return; }
        Super.Tick();
    }
}

class UTNTVisuals play
{
    // Independent pools: decorative emissions can never consume combat feedback.
    static int ReserveCount(int count = 1, bool combat = false)
    {
        if (count <= 0) return 0;
        let runtime=UTNTFXRuntime.Get();
        if(!runtime || !runtime.Quality)return 0;
        int quality=runtime.Quality;
        let budget=runtime.VisualBudget;
        if(!budget)budget=runtime.VisualBudget=UTNTVisualBudget(level.CreateClientSideThinker('UTNTVisualBudget',Thinker.STAT_USER+2));
        if(!budget)return 0;
        if (budget.EmissionTic != level.time)
        { budget.EmissionTic=level.time; budget.AmbientEmitted=0; budget.CombatEmitted=0; }
        int limit=combat ? (quality==3 ? 96 : quality==2 ? 48 : 24) : (quality==3 ? 128 : quality==2 ? 64 : 32);
        int granted=min(count,max(0,limit-(combat ? budget.CombatEmitted : budget.AmbientEmitted)));
        if (combat) budget.CombatEmitted+=granted;
        else budget.AmbientEmitted+=granted;
        return granted;
    }

    static bool Reserve(int count = 1) { return ReserveCount(count)==count; }

    static bool Visible(Actor source, int phase = 0, bool combat = false)
    {
        if (!source || !level || source.IsFrozen()) return false;
        let runtime=UTNTFXRuntime.Get();
        if(!runtime || !runtime.Camera || !runtime.Quality || !runtime.Range)return false;
        int quality=runtime.Quality,range=runtime.Range;
        double distance=source.Distance3D(runtime.Camera);
        if(distance>range)return false;
        if (combat) return true; // One-shot impacts must not disappear on a skipped ambient tic.
        int divisor = quality == 1 ? 3 : quality == 2 ? 2 : 1;
        if (distance > range*0.5) divisor*=2;
        return (level.time + phase) % divisor == 0;
    }

    static void Torch(Actor source, int colorIndex, bool shortFlame)
    {
        UTNTFireSystem.Ensure(source,colorIndex,shortFlame ? 1 : 0);
    }

    static void Smoke(Actor source, double x = 0, double y = 0, double z = 0, double size = 8, bool rocket = false)
    {
        if (!Visible(source, combat: true) || !ReserveCount(1,true)) return;
        FSpawnParticleParams p;
        p.texture = TexMan.CheckForTexture('X143J0K0');
        p.color1 = 0xffffff;
        p.style = STYLE_Translucent;
        p.flags = SPF_ROLL;
        p.pos = source.Vec3Offset(x,y,z);
        p.vel = (CFRandom[utntcosmetic](-0.15,0.15), CFRandom[utntcosmetic](-0.15,0.15), CFRandom[utntcosmetic](0.1,0.5));
        p.lifetime = 32; p.size = size; p.sizestep = 0.15;
        p.startalpha = 0.45; p.fadestep = 0.45/32;
        p.startroll = CFRandom[utntcosmetic](0,360);
        if (rocket)
        {
            // Preserve the current smoke image, at the original trail envelope.
            let original=TexMan.GetScaledSize(TexMan.CheckForTexture('X038A0'));
            let textureSize=TexMan.GetScaledSize(p.texture);
            let scale=GetDefaultByType('RockTrailSmoke').Scale;
            UTNTLegacySizedVisual.Emit(p,(original.X*scale.X/textureSize.X,
                original.Y*scale.Y/textureSize.Y),1);
        }
        else level.SpawnParticle(p);
    }

    static void Sparks(Actor source, int count = 10)
    {
        if (!Visible(source, combat: true)) return;
        count=ReserveCount(count,true);
        for (int i=0; i<count; i++)
        {
            FSpawnParticleParams p;
            p.texture = TexMan.CheckForTexture('FX26K0');
            p.color1 = 0xffffff; p.style = STYLE_Add; p.flags = SPF_FULLBRIGHT;
            p.pos = source.Pos;
            p.vel = (CFRandom[utntcosmetic](-1.5,1.5), CFRandom[utntcosmetic](-1.5,1.5), CFRandom[utntcosmetic](0.8,3.5));
            p.accel = (0,0,-0.09);
            p.lifetime = 22; p.size = 3; p.startalpha = 1; p.fadestep = 1.0/22;
            level.SpawnParticle(p);
        }
    }

    static void AmbientSmoke(Actor source, int size)
    {
        UTNTAmbientSmokeSystem.Emit(source,clamp(size,0,2));
    }

    static void RocketFlame(Actor source)
    {
        if (!Visible(source, combat: true)) return;
        int granted=ReserveCount(2,true);
        if (!granted) return;
        let flame=UTNTRocketFlameVisual(level.SpawnClientSideVisualThinker('UTNTRocketFlameVisual'));
        if (!flame) return;
        flame.SecondAnimation=CRandom[utntcosmetic](0,1);
        flame.Texture=TexMan.CheckForTexture(flame.SecondAnimation ? 'X007A0' : 'X006A0');
        flame.Pos=source.Vec3Offset(0,0,4); flame.Prev=flame.Pos;
        flame.Scale=(0.13,0.13); flame.Alpha=1; flame.Flags=SPF_FULLBRIGHT;
        flame.Translation=GetDefaultByType('RocketFireTrail').Translation;
        flame.SetRenderStyle(STYLE_Add);
        flame.Initialize();
        if (granted<2) return;
        FSpawnParticleParams p;
        p.texture=TexMan.CheckForTexture('X037A0'); p.color1=0xffffff; p.style=STYLE_Translucent;
        p.pos=flame.Pos; p.vel=(0,0,CFRandom[utntcosmetic](0.1,0.6));
        p.lifetime=33; p.startalpha=0.1; p.fadestep=-0.05;
        UTNTLegacySizedVisual.Emit(p,GetDefaultByType('RocketSmokeCenter').Scale,2);
    }
}

class UTNTPuffBase : Actor
{
    action void A_UTNTImpact() { UTNTIndustrialFX.Impact(self); }
    action void A_UTNTSparks() { UTNTVisuals.Sparks(self); }
    action void A_UTNTSmoke() { UTNTVisuals.Smoke(self, size: 3); }
}

class UTNTRocketFXBase : Rocket
{
    action void A_UTNTFlightFX() { UTNTIndustrialFX.Rocket(self); }
    action void A_UTNTTrail(double x, double y, double z) { UTNTVisuals.Smoke(self,x,y,z,rocket:true); }
    action void A_UTNTRocketFlame() { UTNTVisuals.RocketFlame(self); }
}

class UTNTEmberBase : SwitchableDecoration
{
    action void A_UTNTEmber(int type, int colorIndex, int size)
    {
        if (!UTNTVisuals.Visible(self) || !UTNTVisuals.Reserve()) return;
        if(type==1 && colorIndex==1)
        {
            UTNTRitualMote.Emit(self,size);
            return;
        }
        FSpawnParticleParams p;
        p.texture = TexMan.CheckForTexture('EMBRA0');
        p.color1 = colorIndex == 1 ? 0xff6030 : colorIndex == 2 ? 0x60ff30 : colorIndex == 3 ? 0xffff50 : colorIndex == 4 ? 0xffbb60 : colorIndex == 5 ? 0x5080ff : 0xffffff;
        p.style = STYLE_Add; p.flags = SPF_FULLBRIGHT;
        p.pos = Vec3Offset(CFRandom[utntcosmetic](-size/2.0,size/2.0),CFRandom[utntcosmetic](-size/2.0,size/2.0),0);
        p.vel = (0,0,CFRandom[utntcosmetic](0.5,2));
        p.lifetime=50; p.startalpha=1; p.fadestep=0.02;
        if (type == 0)
        {
            // EmberShot selected the three legacy scales with equal probability.
            int variant=CRandom[utntcosmetic](0,2);
            Vector2 scale=variant==0 ? GetDefaultByType('LavaEmber1').Scale
                : variant==1 ? GetDefaultByType('LavaEmber2').Scale
                : GetDefaultByType('LavaEmber3').Scale;
            UTNTLegacySizedVisual.Emit(p,scale,0);
            return;
        }
        if (type == 1)
        {
            // Four chipped fragments; one quarter of emissions use a short rising streak.
            // One atlas sprite per particle keeps the existing ambient emission budget.
            bool streak = CRandom[utntcosmetic](0,3) == 0;
            int frame = streak ? CRandom[utntcosmetic](4,5) : CRandom[utntcosmetic](0,3);
            p.texture = TexMan.CheckForTexture(String.Format("UTP%cA0",65+frame));
            p.color1 = colorIndex == 1 ? 0xff3018 : colorIndex == 2 ? 0x70dc48 : colorIndex == 3 ? 0xffd858 : colorIndex == 4 ? 0xff9040 : colorIndex == 5 ? 0x608cff : 0xdce4ec;
            p.flags |= SPF_ROLL | SPF_FADE_IN_HOLD_OUT;
            p.startroll = streak ? CFRandom[utntcosmetic](-9,9) : CFRandom[utntcosmetic](0,360);
            p.rollvel = streak ? 0 : CFRandom[utntcosmetic](-1.2,1.2);
            p.size = streak ? CFRandom[utntcosmetic](8,11) : CRandom[utntcosmetic](0,3) == 0 ? CFRandom[utntcosmetic](6.5,8) : CFRandom[utntcosmetic](4,6);
            p.vel = (CFRandom[utntcosmetic](-0.16,0.16),CFRandom[utntcosmetic](-0.16,0.16),CFRandom[utntcosmetic](streak ? 1.1 : 0.5,2.0));
            p.accel = (CFRandom[utntcosmetic](-0.003,0.003),CFRandom[utntcosmetic](-0.003,0.003),streak ? 0.008 : 0);
            p.lifetime = CRandom[utntcosmetic](44,58);
            p.startalpha = CFRandom[utntcosmetic](0.8,1.0);
            // Hold the luminous core, then extinguish over the final 13-16 tics.
            p.fadestep = 0; p.fadeoutstep = 1.0/16;
        }
        level.SpawnParticle(p);
    }
}

#include "zscript/UTNT_IndustrialFX.zc"
#include "zscript/UTNT_EffectGlow.zc"
