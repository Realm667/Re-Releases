class Marine : DoomPlayer
{
    int OverdrivePhase;
    override void TickPSprites()
    {
        Super.TickPSprites();
        let a=UTNTAbilities.Get(self);
        if(!a || a.ClassKind!=2 || a.ActiveSlot!=1 || Health<=0)
        { OverdrivePhase=0; return; }
        let w=player.ReadyWeapon;
        let psp=player.FindPSprite(PSprite.WEAPON);
        if(!w || !psp || !(InStateSequence(psp.CurState,w.FindState('Fire'))
            || InStateSequence(psp.CurState,w.FindState('AltFire'))
            || InStateSequence(psp.CurState,w.FindState('Hold'))
            || InStateSequence(psp.CurState,w.FindState('AltHold')))) return;
        if(++OverdrivePhase<2) return;
        OverdrivePhase=0;
        // Half an extra weapon tick per game tick: 150%, including one-tic states.
        // No second PlayerThink, inventory tick, regeneration or movement update.
        psp.processPending=true;
        psp.Tick();
        let flash=player.FindPSprite(PSprite.FLASH);
        if(flash) { flash.processPending=true; flash.Tick(); }
    }

	double utntFallbackStep;

    UTNTPickupSnapshot PickupSnapshot;
    override bool CanTouchItem(Inventory item)
    {
        if(!Super.CanTouchItem(item)) return false;
        if(!PickupSnapshot) PickupSnapshot=new("UTNTPickupSnapshot");
        PickupSnapshot.Capture(self,item);
        return true;
    }
    override void HasReceived(Inventory item,class<Inventory> itemcls)
    {
        Super.HasReceived(item,itemcls);
        if(PickupSnapshot) PickupSnapshot.Received(self,itemcls);
    }


    override bool OnGiveSecret(bool printmsg,bool playsound)
    {
        // P_GiveSecret owns both counters. Its level counter increments after this hook.
        if(CheckLocalView())
            EventHandler.SendInterfaceEvent(consoleplayer,"utnt_secret",level.found_secrets+1,
                int(printmsg)|(int(playsound)<<1));
        return false; // The interface replaces the native center message and plays its sound once.
    }

	Default
	{	
		Player.WeaponSlot 1,"UTNTFist","UTNTChainsaw";
		Player.WeaponSlot 2,"UTNTPistol";
		Player.WeaponSlot 3,"UTNTShotgun","UTNTSuperShotgun";
		Player.WeaponSlot 4,"UTNTChaingun","UTNTMinigun";
		Player.WeaponSlot 5,"UTNTRocketLauncher";
		Player.WeaponSlot 6,"UTNTPlasmaRifle","UTNTFlamer";
		Player.WeaponSlot 7,"UTNTBFG9000";
		Player.WeaponSlot 8,"UTNTPyroCannon";
		Player.StartItem "UTNTShotgun";
		Player.StartItem "UTNTFist";
		Player.StartItem "Shell",10;
		Player.MaxHealth 100;
        +PLAYERPAWN.MAKEFOOTSTEPS
	}
	
	States
	{
	Spawn:
		PLA3 A -1;
		Stop;
	See:
		PLA3 ABCD 4;
		Loop;
	Missile:
		"####" E 12;
		"####" E 0 A_Jump(256,"Spawn");
	Melee:
		"####" F 2 BRIGHT LIGHT("ZOMBIEATK");
		"####" F 4 BRIGHT;
		Goto Missile;
	Pain:
		"####" G 4;
		"####" G 4 A_Pain();
		"####" G 0 A_Jump(256,"Spawn");
	Death:
		"####" H 10;
		"####" I 10 A_PlayerScream();
		"####" J 10 A_NoBlocking();
		"####" KLM 10;
		"####" N -1;
		Stop;
	XDeath:
		"####" O 5;
		"####" P 5 A_XScream();
		"####" Q 5 A_NoBlocking();
		"####" RSTUV 5;
		"####" W -1;
		Stop;
	}
	
    // Engine footsteps handle terrain sounds, left/right timing and splashes.
    override void MakeFootsteps()
    {
        if (!player || health <= 0 || WaterLevel > 1 || !player.onground) return;
        let ground=GetFloorTerrain();
        if (ground && ground.StepDistance>0) { Super.MakeFootsteps(); return; }
        double speed=Vel.XY.Length();
        if (speed < 0.1) { utntFallbackStep=85; return; }
        utntFallbackStep+=speed;
        if (utntFallbackStep >= 85)
        {
            utntFallbackStep=0;
            A_StartSound("floor/default", flags: CHANF_OVERLAP, volume: snd_footstepvolume);
        }
    }
}

class Scout : Marine
{
	Default
	{
		Player.ForwardMove 1.25,1.25;
		Player.SideMove 1.25,1.25;
		Player.DisplayName "Scout";
		Player.StartItem "UTNTPistol";
		Player.StartItem "UTNTFist";
		Player.StartItem "Clip",60;
		Player.MaxHealth 75;
        Health 75;
	}
	
	States
	{
	Spawn:
		PLA2 A -1;
		Stop;
	See:
		PLA2 ABCD 4;
		Loop;
	}
}

class Commando : Marine
{
	Default
	{
		Player.ForwardMove 0.85,0.85;
		Player.SideMove 0.85,0.85;
		Player.DisplayName "Commando";
		Player.StartItem "UTNTMinigun";
		Player.StartItem "UTNTFist";
		Player.StartItem "Clip",100;
		Player.MaxHealth 150;
		Health 150;
	}
	
	States
	{
	Spawn:
		PLA4 A -1;
		Stop;
	See:
		PLA4 ABCD 4;
		Loop;
	}
}

class isIntro : Inventory //prevent Motion Blur working over cutscenes if we move mouse, give it to players at start and remove it at level end, or before a cutscene (remove and give again when done)
{
	Default
	{
		Inventory.Amount 1;
		Inventory.MaxAmount 1;
	}
}

