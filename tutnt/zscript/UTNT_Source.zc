// TNT04CN presentation. Gameplay states, attack timings and shield collision
// stay authoritative; all render objects and dynamic lights are client-side.
class UTNTSourceBase : Actor
{
 bool SourceReady, ShieldOpen;
 int AttackKind, AttackStart, OpenStart, HitStart, GuardianSerial, DeathStart;
 Vector3 GuardianPosition, HitPosition;
 Array<int> ShieldLines, BeamSides, BeamKinds;
 int LastBeamState, DefeatAge;
 clearscope Vector3 Center() { return Pos+(0,0,64); }
 void SetupSource()
 {
  let it=level.CreateLineIdIterator(99);int n;
  while((n=it.Next())>=0)ShieldLines.Push(n);
  for(int i=0;i<level.sides.Size();i++)
  {
   let s=level.sides[i];let t=s.GetTexture(Side.mid);int kind=-1;
   if(t==TexMan.CheckForTexture("T4_BM1"))kind=0;
   if(t==TexMan.CheckForTexture("T4_BM2"))kind=1;
   if(t==TexMan.CheckForTexture("T4_BM2B"))kind=2;
   // Saved maps already carry these material names.
   for(int j=0;j<3;j++)for(int k=0;k<29;k++)
    if(t==TexMan.CheckForTexture(String.Format("USB%d%d",j,k)))kind=j;
   if(kind>=0){BeamSides.Push(i);BeamKinds.Push(kind);}
  }
  for(int i=0;i<ShieldLines.Size();i++)
  {
   let l=level.lines[ShieldLines[i]];
   if(l.sidedef[0])l.sidedef[0].SetTexture(Side.mid,TexMan.CheckForTexture("USSHIELD"));
   if(l.sidedef[1])l.sidedef[1].SetTexture(Side.mid,TexMan.CheckForTexture("USSHIELD"));
  }
  LastBeamState=-1;SourceReady=true;HitStart=-100;OpenStart=-100;
 }
 // Keep the invisible original actor as the serialized clock until map exit.
 action void A_SourceDefeat()
 { invoker.SourceDefeat(); }
 void SourceDefeat()
 {
  if(!(level.MapName~=="TNT04CN"))
  {
   sprite=GetSpriteIndex("SOUR");
   if(!DeathStart){DeathStart=level.time;A_Scream();}
   if((level.time-DeathStart)%3==0)A_FadeOut();
  }
 }
 override void Tick()
 {
  Super.Tick();
  if(!(level.MapName~=="TNT04CN"))return;
  if(!SourceReady)SetupSource();
  if(IsFrozen() || level.isFrozen())return;
  // These two map-local scripts only animate the old shield alpha. They run
  // after Actor.Tick and would overwrite the new membrane on alternate frames.
  // Re-terminate because original hit/reclosure scripts may start them again.
  ACS_Terminate(701,0);
  ACS_Terminate(121,0);
  bool opened=ShieldLines.Size()>0 && !(level.lines[ShieldLines[0]].flags & Line.ML_BLOCKEVERYTHING);
  if(opened && !ShieldOpen)OpenStart=level.time;
  ShieldOpen=opened;
  if(Health<=0)
  {
   if(!DeathStart)DeathStart=level.time;
   DefeatAge++;
   bSolid=false;bShootable=false;
   ACS_Terminate(130,0);ACS_Terminate(131,0);ACS_Terminate(132,0);
   ACS_Terminate(134,0);ACS_Terminate(122,0);
  }
  int beamState=ShieldOpen?1:0;
  if(DefeatAge>0)beamState=DefeatAge<35?3:DefeatAge<70?4:DefeatAge<158?5+(DefeatAge-70)*24/88:2;
  if(beamState!=LastBeamState)
  {
   // The retired pulse script also used to select additive blending. Keep
   // that explicit: a translucent black carrier would darken the whole boss.
   TranslucentLine(99,beamState==0?178:0,1);
   for(int i=0;i<BeamSides.Size();i++)
    level.sides[BeamSides[i]].SetTexture(Side.mid,TexMan.CheckForTexture(beamState==2?"-":String.Format("USB%d%d",BeamKinds[i],beamState)));
   // Legacy ACS still writes line alpha during its shutdown fade. Removing
   // only the middle material makes the open silhouette unambiguous from tic 1.
   TextureID shield=TexMan.CheckForTexture(beamState==0?"USSHIELD":"-");
   for(int i=0;i<ShieldLines.Size();i++)
   {
    let l=level.lines[ShieldLines[i]];
    if(l.sidedef[0])l.sidedef[0].SetTexture(Side.mid,shield);
    if(l.sidedef[1])l.sidedef[1].SetTexture(Side.mid,shield);
   }
   LastBeamState=beamState;
  }
  // Suppress the old flat sprite, not its actor, hitbox or death states.
  sprite=GetSpriteIndex("TNT1");
  for(int i=0;i<ShieldLines.Size();i++)
   level.lines[ShieldLines[i]].alpha=ShieldOpen || Health<=0 ? 0 : 0.70;
  UTNTSourceSystem.Ensure(self);
 }
}

class UTNTSourceGuardianBase : Actor
{
 bool SourceAnnounced, SourceDeathAnnounced;
 override void Tick()
 {
  Super.Tick();
  if(!(level.MapName~=="TNT04CN"))return;
  if((!SourceAnnounced && !bDormant) || (Health<=0 && !SourceDeathAnnounced))
  {
   let boss=UTNTSourceSystem.Find();
   if(boss){boss.GuardianPosition=Pos+(0,0,Height*0.5);boss.GuardianSerial++;}
   SourceAnnounced=true;
   if(Health<=0)SourceDeathAnnounced=true;
  }
 }
}

class UTNTSourceSystem play
{
 static UTNTSourceBase Find()
 {
  if(!(level.MapName~=="TNT04CN"))return null;
  return UTNTSourceBase(level.CreateActorIterator(666).Next());
 }
 static int BeginDefeat()
 {
  let s=Find();return s && s.Health<=0;
 }
 static int DefeatFinished()
 {
  let s=Find();return !s || s.DefeatAge>=333;
 }
 static int DefeatSettled()
 {
  let s=Find();return !s || s.DefeatAge>=245;
 }
 static int Attack(int kind)
 {
  let s=Find();if(!s || s.Health<=0)return 0;s.AttackKind=kind;s.AttackStart=level.time;return 1;
 }
 static int ShieldHit(int playernum=-1)
 {
  let s=Find();if(!s)return 0;s.HitStart=level.time;
  s.HitPosition=s.Center()+(0,-480,-140);
  if(playernum>=0 && playernum<MAXPLAYERS && players[playernum].mo)
  {
   let p=players[playernum].mo;
   Vector3 start=p.Pos+(0,0,players[playernum].ViewHeight);
   Vector3 dir=(cos(p.Pitch)*cos(p.Angle),cos(p.Pitch)*sin(p.Angle),-sin(p.Pitch));
   Vector2 offset=start.XY-(128,-320);
   double a=dir.X*dir.X+dir.Y*dir.Y,b=offset.X*dir.X+offset.Y*dir.Y;
   double disc=b*b-a*(offset.LengthSquared()-535*535);
   if(a>0.001 && disc>=0)
   {
    double t=(-b-sqrt(disc))/a;
    if(t<0)t=(-b+sqrt(disc))/a;
    if(t>=0)s.HitPosition=start+dir*t;
   }
  }
  return 1;
 }
 static void Ensure(UTNTSourceBase source)
 {
  let it=ThinkerIterator.Create('UTNTSourceEmitter',Thinker.STAT_USER+12,true);
  UTNTSourceEmitter old;
  while(old=UTNTSourceEmitter(it.Next()))if(old.Source==source)return;
  let emitter=UTNTSourceEmitter(level.CreateClientSideThinker('UTNTSourceEmitter',Thinker.STAT_USER+12));
  if(emitter)emitter.Initialize(source);
 }
}

// One shadowless geometry light, present only while the singularity exists.
class UTNTSourceGravityLight : PointLight
{
 Default
 {
  Alpha 0;
  +CLIENTSIDE
  +DYNAMICLIGHT.SUBTRACTIVE
  +DYNAMICLIGHT.ATTENUATE
  +DYNAMICLIGHT.NOSHADOWMAP
  +DYNAMICLIGHT.DONTLIGHTACTORS
 }
 static double Strength(int age)
 {
  double rise=clamp((age-35)/50.0,0,1),fall=clamp((158-age)/38.0,0,1);
  return rise*rise*(3-2*rise)*fall*fall*(3-2*fall);
 }
}

class UTNTSourceEmitter : Thinker
{
 UTNTSourceBase Source;
 Actor LightAnchor;
 UTNTSourceGravityLight GravityLight;
 Array<Actor> WallLights;
 Array<UTNTSourceCeilingPiece> Ceiling;
 bool SoundStarted;
 Array<UTNTSourceLayer> Layers;
 Vector3 Center, GuardianPosition;
 int GuardianSerial, GuardianAge, DeadAge, Quality;
 bool Opened, Reduced;
 void Initialize(UTNTSourceBase boss)
 {
  Source=boss;Center=boss.Center();GuardianSerial=boss.GuardianSerial;GuardianAge=100;
  for(int i=0;i<72;i++)
  {
   let v=UTNTSourceLayer(level.SpawnClientSideVisualThinker('UTNTSourceLayer'));
   if(v){v.Initialize(self,i);Layers.Push(v);}
  }
  LightAnchor=Actor.SpawnClientSide('UTNTPortalAnchor',Center);
  for(int i=0;i<8;i++)
  {
   let piece=UTNTSourceCeilingPiece(Actor.SpawnClientSide('UTNTSourceCeilingPiece',Center+(0,0,760)));
   if(piece){piece.Owner=self;piece.Index=i;Ceiling.Push(piece);}
   WallLights.Push(Actor.SpawnClientSide('UTNTPortalAnchor',Center));
  }
 }
 override void OnDestroy()
 {
  for(int i=0;i<Layers.Size();i++)if(Layers[i])Layers[i].Destroy();
  for(int i=0;i<Ceiling.Size();i++)if(Ceiling[i])Ceiling[i].Destroy();
  for(int i=0;i<WallLights.Size();i++)if(WallLights[i])WallLights[i].Destroy();
  if(GravityLight)GravityLight.Destroy();
  if(LightAnchor)LightAnchor.Destroy();Super.OnDestroy();
 }
 override void Tick()
 {
  if(level.isFrozen() || (Source && Source.IsFrozen()))return;
  let p=players[consoleplayer];
  Quality=p?clamp(CVar.GetCVar('UTNT_fxquality',p).GetInt(),0,3):0;
  Reduced=!p || CVar.GetCVar('UTNT_reducedfx',p).GetBool();
  if(Reduced)Quality=min(Quality,1);
  if(Source)
  {
   Center=Source.Center();Opened=Source.ShieldOpen;
   if(GuardianSerial!=Source.GuardianSerial)
   {GuardianSerial=Source.GuardianSerial;GuardianPosition=Source.GuardianPosition;GuardianAge=0;}
  }
  GuardianAge++;
  if(!Source){Destroy();return;}
  DeadAge=Source.DefeatAge;
  if(Quality>0 && DeadAge>=35 && DeadAge<158)
  {
   if(!GravityLight)
   {
    GravityLight=UTNTSourceGravityLight(Actor.SpawnClientSide('UTNTSourceGravityLight',Center));
    if(GravityLight)
    {
     GravityLight.Args[0]=255;GravityLight.Args[1]=255;GravityLight.Args[2]=255;
     GravityLight.Args[3]=700;
    }
   }
   if(GravityLight)
   {
    GravityLight.SetOrigin(Center,false);
    GravityLight.Alpha=UTNTSourceGravityLight.Strength(DeadAge)*(Reduced?.30:.85);
   }
  }
  else if(GravityLight){GravityLight.Destroy();GravityLight=null;}
  if(DeadAge && !SoundStarted && LightAnchor)
  {
   SoundStarted=true;
   if(DeadAge<245)LightAnchor.A_StartSound("utnt/source/finale",CHAN_BODY,0,0.95,ATTN_NONE,1.0,(DeadAge-1)/35.0);
  }
  // These broad, rapidly changing defeat glows do not need per-light shadow maps.
  double flash=Flash();
  for(int i=0;i<WallLights.Size();i++)if(WallLights[i])
  {
   double angle=i*45+22.5;
   double age=level.time-Source.OpenStart;
   double wave=!DeadAge && Opened && age<70?1-abs(age-24-i*3)/18.0:0;
   double strength=max(max(flash,Flicker(i)),max(0,wave)*0.65);
   Vector3 pos=Center+(cos(angle)*1120,sin(angle)*1120,DeadAge?400:850-age*13);
   WallLights[i].SetOrigin(pos,false);
   if(Quality>0 && strength>0.01)
    WallLights[i].A_AttachLight('sourcewall',DynamicLight.PointLight,DeadAge?ImpactColor(i):0xffbf68,
     (320+strength*600)*(DeadAge?sqrt(strength):1),0,DynamicLight.LF_ATTENUATE|(DeadAge?DynamicLight.LF_NOSHADOWMAP:0));
   else WallLights[i].A_RemoveLight('sourcewall');
  }
  if(LightAnchor)
  {
   LightAnchor.SetOrigin(Center,false);
   if(Quality>0 && !DeadAge)
    LightAnchor.A_AttachLight('source',DynamicLight.PointLight,Opened?0xffb348:0xff7018,Opened?400:520,0,DynamicLight.LF_ATTENUATE);
   else if(Quality>0 && max(flash,Flicker(8))>0.01)
    LightAnchor.A_AttachLight('source',DynamicLight.PointLight,ImpactColor(8),
     1100*sqrt(max(flash,Flicker(8))),0,DynamicLight.LF_ATTENUATE|DynamicLight.LF_NOSHADOWMAP);
   else LightAnchor.A_RemoveLight('source');
  }
 }
 // A bounded, clock-derived electrical flicker: no gameplay RNG or new lights.
 double Flicker(int index)
 {
  if(DeadAge<60 || DeadAge>=180 || Quality==0)return 0;
  double envelope=clamp((DeadAge-60)/35.0,0,1)*clamp((180-DeadAge)/35.0,0,1);
  if(Reduced)return envelope*0.055;
  double beat=max(0,sin(DeadAge*31+index*79)*sin(DeadAge*13+index*43));
  return envelope*(0.09+0.51*beat*beat);
 }
 int ImpactColor(int index)
 {
  // Reduced effects hold a quiet amber tone instead of switching colours.
  return Reduced?0xff7020:((DeadAge/7+index)%2?0xff3410:0xff8a18);
 }
 // One collapse, synchronized to the combined Near/Far impact at tic 158.
 double Flash()
 {
  double f=DeadAge>=158?max(0,1-(DeadAge-158)/11.0):0;
  return f*(Reduced?0.10:1.0);
 }
 Vector3 CeilingPoint(int index)
 {
  double angle=index*45+22.5;
  double sink=DeadAge>193?40*clamp((DeadAge-193)/52.0,0.0,1.0):0;
  return Center+(cos(angle)*370,sin(angle)*370,760-sink);
 }
}

// Real horizontal world surfaces, not camera-facing ceiling billboards.
class UTNTSourceCeilingPiece : Actor
{
 UTNTSourceEmitter Owner;
 int Index, Appearance;
 Default
 {
  +CLIENTSIDE +NOINTERACTION +NOBLOCKMAP +NOGRAVITY +DONTSPLASH +FLATSPRITE
  RenderStyle "Translucent";
  Scale 1.8;
 }
 States
 {
  Spawn: USCS A -1 Bright; Stop;
  Charged: USCT A -1 Bright; Stop;
  Spent: USCU A -1 Bright; Stop;
 }
 override void Tick()
 {
  Super.Tick();
  if(!Owner){Destroy();return;}
  if(IsFrozen() || level.isFrozen())return;
  Alpha=.999; // Keep shader-cut stone in the translucent pass, including old saves.
  let e=Owner;int d=e.DeadAge;
  double angle=Index*45+22.5;
  double sink=d>193?40*clamp((d-193)/52.0,0.0,1.0):0;
  double lift=d>=35 && d<193?sin((d-35)/158.0*180)*18:0;
  SetOrigin(e.Center+(cos(angle)*24,sin(angle)*24,760+lift-sink+sin(Index*79)*14),false);
  self.Angle=angle;
  // Tiny alternating cant makes the separated slabs readable from below.
  Pitch=(Index%2?3:-3)+(!e.Reduced && d>35 && d<193?sin(d*1.5+Index*45)*2:0);
  int age=e.Source?level.time-e.Source.AttackStart:10000;
  bool lit=e.Source && e.Source.AttackKind>0 && age>=Index*5 && age<70;
  if(e.Source && e.Opened)
  {
   int pulseAge=level.time-e.Source.OpenStart-Index*3;
   if(pulseAge>=0 && pulseAge<18)lit=true;
  }
  if(d>0)lit=d>=90+Index*5 && d<160+Index*4;
  int look=d>=193?2:lit?1:0;
  if(look!=Appearance)
  {
   if(look==2)SetStateLabel("Spent");
   else if(look==1)SetStateLabel("Charged");
   else SetStateLabel("Spawn");
   Appearance=look;
  }
 }
}

class UTNTSourceLayer : VisualThinker
{
 UTNTSourceEmitter Owner;
 int Kind;
 Vector2 BoltScale;
 void SetBolt(Vector3 a,Vector3 b)
 {
  Pos=(a+b)*0.5;Vector3 delta=b-a;
  let cam=players[consoleplayer].camera;
  double facing=cam?atan2(cam.Pos.Y-Pos.Y,cam.Pos.X-Pos.X):270;
  double across=-sin(facing)*delta.X+cos(facing)*delta.Y;
  Roll=atan2(delta.Z,across);
  BoltScale=(max(1,sqrt(across*across+delta.Z*delta.Z))/512.0,100.0/512.0);
  Texture=TexMan.CheckForTexture("USLTA0");
 }
 void Initialize(UTNTSourceEmitter e,int kind)
 {
  Owner=e;self.Kind=kind;Flags=SPF_FULLBRIGHT|SPF_ROLL|SPF_ROLLCENTER|SPF_ALLOWSHADERS;
  SetRenderStyle(STYLE_Add);Texture=TexMan.CheckForTexture("USC0A0");
  Pos=e.Center;Prev=Pos;UpdateSector();UpdateSpriteInfo();
 }
 override void Tick()
 {
  if(!Owner){Destroy();return;}
  if(IsFrozen() || level.isFrozen())return;
  let e=Owner;
  if((!e.DeadAge && Kind>=12) || e.DeadAge>=245)
  {Alpha=0;Prev=Pos;PrevRoll=Roll;return;}
  let s=e.Source;Prev=Pos;PrevRoll=Roll;
  Pos=e.Center;Alpha=0;Roll=0;double diameter=650;
  int elapsed=s?level.time-s.AttackStart:10000;
  bool damaged=s && s.Health<7500;
  double open=e.Opened?1:0;
  // Six arcs separate on the open-state material; the skull stays upright.
  if(Kind==0)
  {
   Texture=TexMan.CheckForTexture(damaged?"USC1A0":"USC0A0");Alpha=0.90;diameter=650;
  }
  if(Kind==1)
  {
   Texture=TexMan.CheckForTexture(e.Opened?"USROA0":damaged?"USREA0":"USRCA0");
   diameter=740+open*60;Alpha=0.95;
   Roll=e.Reduced?0:sin(level.time*0.17)*3;
   if(e.Opened && s && level.time-s.OpenStart>230)
    diameter-=min(60,(level.time-s.OpenStart-230)*0.9);
  }
  if(Kind==2)
  {
   Texture=TexMan.CheckForTexture("USHEA0");
   diameter=175+(e.Reduced?0:18*sin(level.time*(e.Opened?12:5)));
   Alpha=e.Opened?0.95:0.38;
   if(s && s.AttackKind==3 && elapsed<140)
   {diameter=90+100*min(1.0,double(elapsed)/70);Alpha=0.95;}
  }
  if(Kind>=3 && Kind<=5)
  {
   int orb=Kind-3;double a=145-orb*55;
   let cam=players[consoleplayer].camera;
   double facing=cam?atan2(cam.Pos.Y-e.Center.Y,cam.Pos.X-e.Center.X):270;
   Vector3 right=(-sin(facing),cos(facing),0);
   Pos=e.Center+right*cos(a)*355+(0,0,sin(a)*355);
   Texture=TexMan.CheckForTexture("USORA0");diameter=110;
   if(s && s.AttackKind==2 && elapsed<390)
   {
    double charge=clamp((elapsed-orb*18)/32.0,0.0,1.0);
    Alpha=0.18+0.72*charge;
    if(elapsed>70)Alpha*=0.65+0.35*sin((elapsed-orb*8)*8);
   }
   Roll=e.Reduced?0:level.time*(orb%2?0.4:-0.4);
  }
  if(Kind==6)
  {
   Texture=TexMan.CheckForTexture("USRIPA0");diameter=70;
   Pos=e.GuardianPosition+(e.Center-e.GuardianPosition)*clamp(e.GuardianAge/28.0,0.0,1.0);
   if(e.GuardianAge<35)Alpha=1-e.GuardianAge/35.0;
  }
  if(Kind==7)
  {
   Texture=TexMan.CheckForTexture("USRIPA0");
   diameter=s?max(1,(level.time-s.HitStart)*10):1;
   Pos=s?s.HitPosition:e.Center;
   Alpha=s && !e.Opened?max(0,1-(level.time-s.HitStart)/22.0):0;
  }
  if(Kind==8)
  {
   Texture=TexMan.CheckForTexture("USSTA0");
   if(s && s.AttackKind==1 && elapsed<305)
   {
    Pos=e.Center+(0,0,470+min(200,elapsed*2));diameter=320;
    Alpha=0.7;Roll=e.Reduced?0:level.time*0.6;
   }
  }
  if(Kind==9)
  {
   Texture=TexMan.CheckForTexture("USLNA0");
   Vector3 delta=e.Center-e.GuardianPosition;
   Pos=(e.Center+e.GuardianPosition)*0.5;
   let cam=players[consoleplayer].camera;
   double facing=cam?atan2(cam.Pos.Y-Pos.Y,cam.Pos.X-Pos.X):270;
   double across=-sin(facing)*delta.X+cos(facing)*delta.Y;
   Roll=atan2(delta.Z,across);
   diameter=sqrt(across*across+delta.Z*delta.Z);
   if(e.GuardianAge<35)Alpha=(1-e.GuardianAge/35.0)*0.8;
  }
  if(Kind==10)
  {
   Texture=TexMan.CheckForTexture("USDFA0");diameter=850;
   if(e.Opened)Alpha=0.65;
   Roll=e.Reduced?0:sin(level.time*0.6)*8;
  }
  if(Kind==11)
  {
   Texture=TexMan.CheckForTexture("USGLA0");diameter=1100;
   Alpha=e.Opened?0.72:0.60;
   if(!e.Reduced)Alpha+=0.025*sin(level.time*1.8);
  }
  if(e.DeadAge)
  {
   int d=e.DeadAge;
   double pull=clamp((d-70)/88.0,0.0,1.0);
   double fall=pull*pull;
   let cam=players[consoleplayer].camera;
   double facing=cam?atan2(cam.Pos.Y-e.Center.Y,cam.Pos.X-e.Center.X):270;
   Vector3 right=(-sin(facing),cos(facing),0);
   Vector3 eye=cam?cam.Pos-e.Center:(0,-1,0);
   Vector3 front=eye/max(1,eye.Length());
   if(Kind==0)
   {
    diameter=650*(1-fall);Roll=fall*95;
    Texture=TexMan.CheckForTexture("USC1A0");Alpha=d<158?0.9:0;
   }
   if(Kind==1)Alpha=d<35?0.95:0;
   if(Kind==2){diameter=110;Alpha=d<45?0.35:0;}
   if(Kind>=3 && Kind<=10)Alpha=0;
   if(Kind==11)
   {
    diameter=d<158?1200*(1-fall*.88):1200;
    Alpha=d<158?0.20*(1-fall):e.Flash()*.75;
    // Reuse the existing halo: a continuous amber swell, then a clear dark core.
    double rise=clamp((d-1)/13.0,0,1),fade=clamp((d-49)/91.0,0,1);
    double glow=rise*rise*(3-2*rise)*(1-fade*fade*(3-2*fade));
    diameter+=glow*500;Alpha+=glow*(e.Reduced?0.15:0.75);
   }
   if(Kind>=12 && Kind<=17)
   {
    int arc=Kind-12;double angle=arc*60+fall*130;
    Texture=TexMan.CheckForTexture("USARA0");diameter=800*(1-fall);Roll=angle;
    Pos=e.Center+right*(cos(angle)*65*(1-fall))+(0,0,sin(angle)*65*(1-fall));
    Alpha=d>=35 && d<158?max(0,1-pull*1.35):0;
   }
   if(Kind>=18 && Kind<=23)
   {
    int arc=Kind-18;double angle=arc*60+12+fall*150;
    Vector3 end=e.Center+right*(cos(angle)*420*(1-fall))+(0,0,sin(angle)*420*(1-fall));
    SetBolt(e.Center,end);
    Alpha=d>=35+arc*4 && d<158?(e.Reduced?0.14:0.8)*(1-fall*.8):0;
   }
   if(Kind>=24 && Kind<=31)
   {
    int segment=Kind-24;
    Vector3 end=e.CeilingPoint(segment);
    // Long connections retract towards the singularity rather than fading out.
    SetBolt(e.Center,e.Center+(end-e.Center)*(1-fall));
    Alpha=d>=65+segment*3 && d<158?(e.Reduced?0.08:0.75):0;
   }
   if(Kind>=32 && Kind<=43)
   {
    int seed=Kind-32;double t=clamp((d-183-seed*2)/(53.0-seed*2),0,1);
    double angle=seed*137.5+t*150;
    Texture=TexMan.CheckForTexture("USHEA0");diameter=4+(seed%3)*2;
    Pos=e.Center+right*cos(angle)*200*(1-t)*(1-t)+(0,0,sin(angle)*200*(1-t)*(1-t));
    Alpha=d>=183+seed*2 && d<236?(1-t)*0.4:0;
    if(e.Quality==0 || (e.Reduced && seed%3))Alpha=0;
   }
   if(Kind>=44 && Kind<=67)
   {
    int seed=Kind-44;double begin=60+(seed%6)*4;
    double t=clamp((d-begin)/(158-begin),0,1);
    double angle=seed*137.5+t*t*290;
    double orbit=(410+(seed%3)*65)*(1-t*t);
    Pos=e.Center+right*cos(angle)*orbit+(0,0,sin(angle)*orbit)+front*24;
    if(seed<12)
    {Texture=TexMan.CheckForTexture(String.Format("USG%dA0",seed%4));diameter=65*(1-t*.65);Roll=angle+90;}
    else
    {Texture=TexMan.CheckForTexture("USLNA0");diameter=70+140*t;Roll=angle+85;}
    Alpha=d>=begin && d<158?min(1,t*6)*(1-t*.4):0;
    if(e.Quality==0 || (e.Quality==1 && seed%2) || (e.Reduced && seed%4))Alpha=0;
    if(e.Reduced)Alpha*=0.4;
   }
   double grow=clamp((d-35)/85.0,0,1);
   double collapse=clamp((d-120)/38.0,0,1);
   double coreSize=(90+650*grow)*(1-collapse*collapse);
   if(Kind==68)
   {
    Texture=TexMan.CheckForTexture("USVDA0");SetRenderStyle(STYLE_Translucent);
    Pos=e.Center+front*32;diameter=max(2,coreSize);
    Alpha=d>=35 && d<158?min(1,(d-35)/12.0):0;
   }
   if(Kind==69)
   {
    Texture=TexMan.CheckForTexture("USVRA0");diameter=coreSize*1.65;
    Pos=e.Center+front*34;Roll=d*(e.Reduced?0.4:2.3);
    Alpha=d>=40 && d<158?(e.Reduced?0.3:0.8):0;
   }
   if(Kind==70)
   {
    Texture=TexMan.CheckForTexture("USFSA0");diameter=270;
    Pos=e.Center+front*36;Alpha=e.Flash();
   }
   if(Kind==71)
   {
    Texture=TexMan.CheckForTexture("USRIPA0");diameter=70+max(0,d-158)*35;
    Pos=e.Center+front*36;Alpha=d>=158 && d<193?(1-(d-158)/35.0)*(e.Reduced?0.12:0.75):0;
   }
   if(d>=245)Alpha=0;
  }
  Scale=(diameter/512.0,diameter/512.0);
  if(Kind==9)Scale.Y=12.0/512.0;
  if(Kind>=56 && Kind<=67)Scale.Y*=0.07;
  if(Kind==69)Scale.Y*=0.48;
  if(e.DeadAge && Kind>=18 && Kind<=31)Scale=BoltScale;
  UpdateSector();UpdateSpriteInfo();
 }
}

// Client camera projection only; the authoritative saved clock owns every pulse.
class UTNTSourceImpactView ui
{
 static double Ending(double age){return clamp((age-245)/84.0,0,1);}
 static double Render(RenderEvent e)
 {
  PPShader.SetEnabled("UTNTSourceImpact",false);
  if(!(level.MapName~=="TNT04CN") || consoleplayer<0 || !e.Camera)return 0;
  PPShader.SetUniform1f("UTNTSourceImpact","ending",0);
  if(CVar.GetCVar('vid_rendermode').GetInt()!=4)return 0;
  let s=UTNTSourceBase(level.CreateActorIterator(666).Next());
  if(!s || s.Health>0)return 0;
  double age=s.DefeatAge+e.FracTic;
  // The quiet map transition covers the whole room, including views away from the boss.
  // Finish at tic 329 and hold black for four tics before the authoritative exit.
  double ending=Ending(age);
  if(ending>0)
  {
   PPShader.SetUniform1f("UTNTSourceImpact","ending",ending);
   PPShader.SetEnabled("UTNTSourceImpact",true);
   return 0;
  }
  let p=players[consoleplayer];
  if(!CVar.GetCVar('UTNT_shaderoverlayswitch',p).GetBool()
   || CVar.GetCVar('UTNT_reducedfx',p).GetBool()
   || CVar.GetCVar('UTNT_fxquality',p).GetInt()==0)return 0;
  if(age<1 || age>=193)return 0;
  double progress=(age-35)/175.0;
  Vector3 delta=s.Center()-e.ViewPos;
  Vector3 forward=(cos(e.ViewAngle)*cos(e.ViewPitch),sin(e.ViewAngle)*cos(e.ViewPitch),-sin(e.ViewPitch));
  Vector3 right=(sin(e.ViewAngle),-cos(e.ViewAngle),0);
  Vector3 up=(cos(e.ViewAngle)*sin(e.ViewPitch),sin(e.ViewAngle)*sin(e.ViewPitch),cos(e.ViewPitch));
  double depth=delta dot forward;
  if(depth<=1)return 0;
  double aspect=double(Screen.GetWidth())/max(1,Screen.GetHeight());
  double horizontal=tan(clamp(p.FOV,30,150)*0.5)*max(1,aspect/(4.0/3.0));
  double x=(delta dot right)/(depth*horizontal), y=(delta dot up)/(depth*horizontal/aspect);
  double amount=clamp((1.2-abs(x))/.35,0,1)*clamp((1.2-abs(y))/.35,0,1)
   *clamp((3200-delta.Length())/1200,0,1);
  if(amount<=0.001)return 0;
  let trace=new('LineTracer');
  double distance=delta.Length();
  trace.Trace(e.ViewPos,e.Camera.CurSector,delta/distance,max(0,distance-2),0,wallMask:0,ignoreAllActors:true);
  if(trace.Results.HitType!=TRACE_HitNone)return 0;
  double rx=x*cos(e.ViewRoll)+y*sin(e.ViewRoll), ry=y*cos(e.ViewRoll)-x*sin(e.ViewRoll);
  PPShader.SetUniform2f("UTNTSourceImpact","focus",(0.5+rx*.5,0.5+ry*.5));
  PPShader.SetUniform1f("UTNTSourceImpact","amount",amount);
  PPShader.SetUniform1f("UTNTSourceImpact","progress",progress);
  PPShader.SetUniform1f("UTNTSourceImpact","radius",clamp(650*aspect/(2*depth*horizontal),.08,.75));
  PPShader.SetEnabled("UTNTSourceImpact",true);
  return amount;
 }
}
