//===========================================================================
//
// Actors with minimal ticking. Useful for completely non-interactive stuff
//
//===========================================================================

class UTNTDietActor : Actor
{
    Default { +CLIENTSIDE }
	bool ticked;

	//===========================================================================
	//
	//
	//
	//===========================================================================

	override void Tick()
	{
		if (!ticked)
		{
			Super.Tick();
			ticked = true;
			return;
		}

		if (!bNoTimeFreeze && isFrozen()) return;
		if (tics != -1)
		{
			if (--tics <= 0)
			{
				if (!SetState(curstate.NextState)) return;
			}
		}
	}
}

class UTNTDietActorWithVel : UTNTDietActor
{
	override void Tick(void)
	{
		SetXYZ(Vec3Offset(Vel.X, Vel.Y, Vel.Z));
		Super.Tick();
	}
}

//===========================================================================
//
// Common code for fire effects
//
//===========================================================================

mixin class UTNTFireMixin
{
	bool fadedIn;

	//===========================================================================
	//
	//
	//
	//===========================================================================

	Default
	{
		RenderStyle "Add";
		Alpha 0;
		+ROLLSPRITE
		+ROLLCENTER
		+BRIGHT
		+FORCEXYBILLBOARD
        +INTERPOLATESCALE
        +INTERPOLATEALPHA
		+NOINTERACTION
	}

	//===========================================================================
	//
	//
	//
	//===========================================================================

	States
	{
	SpawnLoop:
		"####" "#" 0
		{
			bSpriteFlip = CRandomPick[utntlegacyfx](false, true);
			A_SetRoll(CFRandom[utntlegacyfx](0.0, 360.0));
		}
		"####" "#" 1
		{
			int rollDir = bSpriteFlip ? -1 : 1;
			double rollSpeed = 2.33 * rollDir;
			A_SetRoll(Roll + rollSpeed, SPF_INTERPOLATE);

			if (!fadedIn)
			{
				if (Alpha < 0.5)
				{
					A_FadeIn(0.1);
				}
				else
				{
					fadedIn = true;
				}
			}

			if (fadedIn)
			{
				A_SetScale(Scale.X * 0.98);
				A_FadeOut(0.025);
			}
		}
		Goto SpawnLoop + 1;
	}
}

class UTNTTorch : RedTorch replaces RedTorch
{
	Default
	{
		Radius 10;
		Height 67;
		ProjectilePassHeight -16;
		+SOLID
	}

	States
	{
	Spawn:
		TBLX A 0 NoDelay;
		TBLX A 1 Light("UTNTFireOrangeTallBody") { UTNTVisuals.Torch(self, 0, false); }
		Goto Spawn + 1;
	}
}

class UTNTTorchFlame : UTNTDietActorWithVel
{
	mixin UTNTFireMixin;

	Default
	{
		DistanceCheck "UTNT_lod";
		Scale 0.3;
	}

	States
	{
	Spawn:
		AFNO A 0;
		Goto SpawnLoop;
	}
}

class UTNTTallTorchLensFlare : UTNTDietActor
{
	Default
	{
		DistanceCheck "UTNT_lod";
		RenderStyle "Add";
		Alpha 0.12;
		Scale 0.13;
		+NOINTERACTION
	}

	States
	{
	Spawn:
		FLRE A -1 Bright Light("UTNTFireOrangeTall");
		Stop;
	}
}

