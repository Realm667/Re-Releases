// Decorative particles use only the cosmetic stream and the existing local budget.
class UTNTAmbientSmokeSource : SwitchableDecoration
{
    action void A_UTNTAmbientSmoke() { UTNTAmbientSmokeSystem.Emit(self, -1); }
}

class UTNTAmbientSmokeMemory : Thinker
{
    Actor Source;
    int LastVariant, LastTic;
    double Phase;
    override void Tick()
    {
        if (!Source || level.time-LastTic>35) Destroy();
    }
}

class UTNTAmbientSmokeSystem play
{
    static void Emit(Actor source, int profile)
    {
        if (!UTNTVisuals.Visible(source) || !CVar.GetCVar('UTNT_ambientsmoke',players[consoleplayer]).GetBool()) return;
        if (profile<0 && level.time%4!=0) return;
        if (!UTNTVisuals.Reserve()) return;
        let it=ThinkerIterator.Create('UTNTAmbientSmokeMemory',Thinker.STAT_USER+8,true);
        UTNTAmbientSmokeMemory m;
        while (m=UTNTAmbientSmokeMemory(it.Next())) if (m.Source==source) break;
        if (!m)
        {
            m=UTNTAmbientSmokeMemory(level.CreateClientSideThinker('UTNTAmbientSmokeMemory',Thinker.STAT_USER+8));
            m.Source=source; m.Phase=CFRandom[utntcosmetic](0,360);
            m.LastVariant=CRandom[utntcosmetic](0,3);
        }
        m.LastTic=level.time;
        m.LastVariant=(m.LastVariant+CRandom[utntcosmetic](1,3))%4;
        let p=UTNTAmbientSmokePuff(level.SpawnClientSideVisualThinker('UTNTAmbientSmokePuff'));
        if (p) p.Initialize(source,profile,m.LastVariant,m.Phase);
    }
}

class UTNTAmbientSmokePuff : VisualThinker
{
    Actor Source;
    int Age, Life, Profile;
    double Width, Height, Strength, Spin, Phase, FlowX, FlowY;
    void Initialize(Actor source, int profile, int variant, double breeze)
    {
        self.Source=source; self.Profile=profile;
        Texture=TexMan.CheckForTexture(String.Format("UASM%c0",65+variant));
        Flags=SPF_ALLOWSHADERS|SPF_ROLL|SPF_STRETCHPIXELS;
        SetRenderStyle(STYLE_Translucent);
        bXFlip=CRandom[utntcosmetic](0,1);
        double envelope=profile<0 ? 64 : profile==0 ? 115.2 : profile==1 ? 230.4 : 384;
        Width=envelope*CFRandom[utntcosmetic](0.64,0.88);
        Height=envelope*CFRandom[utntcosmetic](0.65,1.0);
        Life=profile<0 ? CRandom[utntcosmetic](48,70) : CRandom[utntcosmetic](120,185);
        Strength=profile<0 ? CFRandom[utntcosmetic](0.65,0.78) : CFRandom[utntcosmetic](0.82,0.96);
        Phase=CFRandom[utntcosmetic](0,360);
        double wind=breeze+18*sin(level.time*0.35+breeze);
        double speed=profile<0 ? 0.28 : profile==0 ? 0.55 : profile==1 ? 1.0 : 1.8;
        FlowX=cos(wind)*speed; FlowY=sin(wind)*speed;
        Pos=source.Vec3Offset(CFRandom[utntcosmetic](-2,2),CFRandom[utntcosmetic](-2,2),Height*0.10);
        Vel=(FlowX,FlowY,CFRandom[utntcosmetic](0.75,1.35)*(profile<0 ? 1.0 : profile==0 ? 1 : profile==1 ? 1.5 : 2.5));
        Roll=CFRandom[utntcosmetic](-180,180);
        Spin=CFRandom[utntcosmetic](0.12,0.48)*(CRandom[utntcosmetic](0,1) ? 1 : -1);
        Animate(); Prev=Pos; PrevRoll=Roll; UpdateSector(); UpdateSpriteInfo();
    }
    void Animate()
    {
        double t=double(Age)/Life;
        double growth=0.35+0.65*sin(t*90);
        Scale=(Width*growth/627,Height*growth*(1+0.06*sin(Phase+Age*2))/627);
        Alpha=Strength*min(1.0,(Age+1)/8.0)*min(1.0,(1-t)/0.52);
    }
    override void Tick()
    {
        if (IsFrozen()) return;
        if (!Source || ++Age>=Life || !UTNTVisuals.Visible(Source,combat:true) || !CVar.GetCVar('UTNT_ambientsmoke',players[consoleplayer]).GetBool()) { Destroy(); return; }
        Super.Tick();
        Vel.X=FlowX+0.16*sin(Phase+Age*3.1); Vel.Y=FlowY+0.16*cos(Phase+Age*2.7);
        Roll+=Spin; Animate();
    }
}

class UTNTWaterSystem play
{
    static void MotionTrail(Vector3 origin,Vector3 velocity,double width,bool combat=false,double floor=-32768)
    {
        if (origin.Z<floor || velocity.Length()<0.35 || !UTNTVisuals.ReserveCount(1,combat)) return;
        let p=UTNTWaterTrail(level.SpawnClientSideVisualThinker('UTNTWaterTrail'));
        if (p) p.Initialize(origin,velocity,width,floor);
    }
    static void Impact(Actor source,double strength=1,bool liquid=true,bool bodyImpact=false)
    {
        if (!UTNTVisuals.Visible(source,combat:true)) return;
        // Terrain impacts retain their reserved feedback budget.
        bool combat=true;
        int granted=UTNTVisuals.ReserveCount(bodyImpact ? 10 : liquid ? 5 : 3,combat);
        if (!granted) return;
        Vector3 origin=source.Pos; origin.Z+=0.9;
        let p=UTNTWaterVisual(level.SpawnClientSideVisualThinker('UTNTWaterVisual'));
        if (p) p.Initialize(origin,2,CFRandom[utntcosmetic](bodyImpact ? 34 : 9,bodyImpact ? 42 : 13)*strength,
            CFRandom[utntcosmetic](bodyImpact ? 32 : 12,bodyImpact ? 40 : 16)*strength,bodyImpact ? 22 : 16);
        if (liquid && granted>1)
        {
            let ring=UTNTWaterRing(Actor.Spawn('UTNTWaterRing',origin));
            if (ring) { ring.VisualSize=strength*(bodyImpact ? 1.65 : 0.6); ring.Angle=CFRandom[utntcosmetic](0,360); }
        }
        // One compact crown. Rebound drops supply the motion, without a large outward skirt.
        for (int i=liquid ? 2 : 1;i<granted;i++)
        {
            p=UTNTWaterVisual(level.SpawnClientSideVisualThinker('UTNTWaterVisual'));
            if (!p) continue;
            double a=CFRandom[utntcosmetic](0,360);
            double v=CFRandom[utntcosmetic](bodyImpact ? 0.65 : 0.25,bodyImpact ? 1.35 : 0.7)*strength;
            Vector3 birth=origin+(cos(a)*(bodyImpact ? 12 : 0),sin(a)*(bodyImpact ? 12 : 0),0);
            p.Initialize(birth,1,CFRandom[utntcosmetic](bodyImpact ? 3.5 : 3,bodyImpact ? 5.5 : 5)*strength,
                CFRandom[utntcosmetic](bodyImpact ? 5 : 4,bodyImpact ? 8 : 6)*strength,CRandom[utntcosmetic](bodyImpact ? 22 : 12,bodyImpact ? 30 : 19));
            p.Vel=(cos(a)*v,sin(a)*v,CFRandom[utntcosmetic](bodyImpact ? 2.2 : 0.65,bodyImpact ? 3.3 : 1.3)*strength);
            p.Accel=(0,0,bodyImpact ? -0.22 : -0.12); p.Floor=origin.Z; p.CombatTrail=combat;
        }
    }
}

// A short stationary trace records the actual local trajectory. Successive traces
// overlap and fade; they never follow a missile through its apex or impact.
class UTNTWaterTrail : VisualThinker
{
    Vector3 Direction;
    int Age, Life;
    double Width, Length, Floor;
    void Initialize(Vector3 origin,Vector3 velocity,double width,double floor)
    {
        self.Width=width*CFRandom[utntcosmetic](1.0,1.3);
        Length=clamp(velocity.Length()*3.4,1.2,18);
        Direction=velocity.Unit(); self.Floor=floor;
        if (Direction.Z>0.01) Length=min(Length,max(0.2,(origin.Z-floor)/Direction.Z));
        Life=6;
        Texture=TexMan.CheckForTexture('UWATA0');
        Flags=SPF_ALLOWSHADERS|SPF_STRETCHPIXELS|SPF_ROLL;
        SetRenderStyle(STYLE_Translucent);
        Pos=origin; Prev=Pos; Alpha=0.60;
        // The atlas anchor sits at the head; positive roll +180 points it forward.
        Orient(); PrevRoll=Roll; UpdateSector(); UpdateSpriteInfo();
    }
    void Orient()
    {
        let camera=players[consoleplayer].camera;
        if (!camera) return;
        double side=Direction.X*sin(camera.Angle)-Direction.Y*cos(camera.Angle);
        double projected=sqrt(side*side+Direction.Z*Direction.Z);
        Roll=180+atan2(side,Direction.Z);
        Scale=(Width/418,Length*max(0.12,projected)/290);
    }
    override void Tick()
    {
        if (IsFrozen()) return;
        if (++Age>=Life || Pos.Z<Floor) { Destroy(); return; }
        Super.Tick();
        Alpha=0.60*((1-double(Age)/Life)**1.5);
        Orient();
    }
}

class UTNTWaterVisual : VisualThinker
{
    Vector3 Accel;
    int Age, Life, Kind, AnimationFrame;
    bool CombatTrail;
    double Width, Height, Floor;
    void Initialize(Vector3 origin,int kind,double width,double height,int life)
    {
        CombatTrail=true; self.Kind=kind; self.Width=width; self.Height=height; self.Life=life; Floor=-32768;
        Texture=TexMan.CheckForTexture(kind==2 ? 'UWSCA0' : 'UWATB0');
        Flags=SPF_ALLOWSHADERS|SPF_STRETCHPIXELS|SPF_ROLL;
        SetRenderStyle(STYLE_Translucent); bXFlip=CRandom[utntcosmetic](0,1);
        Pos=origin; Prev=Pos; Alpha=0.65;
        Scale=(width/418,height/418);
        UpdateSector(); UpdateSpriteInfo();
    }
    override void Tick()
    {
        if (IsFrozen()) return;
        if (++Age>=Life || Pos.Z<Floor) { Destroy(); return; }
        Super.Tick();
        Vel+=Accel;
        double t=double(Age)/Life;
        Alpha=0.65*(1-t*t);
        if (Kind==2)
        {
            // Six registered shapes: rise, peak, break-up and flattening at the waterline.
            AnimationFrame=min(5,int(t*6));
            Texture=TexMan.CheckForTexture(String.Format("UWSC%c0",65+AnimationFrame));
            Scale=(Width*(1+0.18*t)/418,Height/418);
            UpdateSpriteInfo();
        }
        else if (players[consoleplayer].camera)
        {
            double a=players[consoleplayer].camera.Angle;
            Roll=180+atan2(Vel.X*sin(a)-Vel.Y*cos(a),Vel.Z);
            if (Age%2==0 && Pos.Z>=Floor) UTNTWaterSystem.MotionTrail(Pos,Vel,Width,CombatTrail,Floor);
        }
    }
}

class UTNTWaterRing : Actor
{
    int Age;
    double VisualSize;
    Default
    {
        +CLIENTSIDE +NOINTERACTION +NOBLOCKMAP +NOGRAVITY +DONTSPLASH +FLATSPRITE
        RenderStyle "Translucent"; Alpha 0.3; Scale 0.01;
    }
    States { Spawn: UWAT D -1; Stop; }
    override void Tick()
    {
        Super.Tick();
        if (++Age>=28) { Destroy(); return; }
        double s=(8+Age*0.9)*max(0.1,VisualSize)/418;
        Scale=(s,s); Alpha=0.30*((1-Age/28.0)**1.5);
    }
}
