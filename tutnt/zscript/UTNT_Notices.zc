// Local, transient presentation only. Gameplay and recipient selection stay in ACS/the engine.
class UTNTNoticeFeed ui
{
    Array<int> IDs, Values, Expires;
    int ActiveExpires;
    double LastTop, LastBottom;
    String CachedText;
    int CachedWidth, LayoutBuilds;
    BrokenLines CachedLines;
    Array<String> CachedShadows;
    double CachedWidest;
    int ActiveID, ActiveValue, Age, Hold;
    int Shown;

    static String Text(int id,int value=-1)
    {
        if(id==9001) return UTNTExplorationUI.Local("UTNT_SECRET_FOUND").." "
            ..String.Format(UTNTExplorationUI.Local("UTNT_SECRET_COUNT"),value,level.total_secrets);
        String text=StringTable.Localize(String.Format("$UTNT_NOTICE_%d",id));
        int at=text.IndexOf("{n}");
        if(at>=0) text=text.Left(at)..String.Format("%d",value)..text.Mid(at+3);
        return text;
    }

    static String Plain(String text)
    {
        String result;
        for(int i=0;i<int(text.Length());i++)
        {
            if(text.CharAt(i)=="\x1c")
            {
                i++;
                if(text.CharAt(i)=="[")
                    while(i<int(text.Length()) && text.CharAt(i)!="]") i++;
            }
            else result=result..text.Mid(i,1);
        }
        return result;
    }

    static int Group(int id)
    {
        if(id==225 || id==226) return 225;
        if(id>=231 && id<=237) return 231;
        if(id>=352 && id<=357) return 352;
        if(id==308 || id==309) return 308;
        if(id==312 || id==313) return 312;
        if(id==315 || id==316) return 315;
        return id;
    }

    static int Priority(int id)
    {
        if(id>=1000 && id<9000) return 3; // Immediate interaction failure.
        if(id==9001 || id==57) return 2; // Discoveries and checkpoints persist.
        return 1;
    }

    static int Deadline(int id)
    {
        if(Priority(id)==2) return 0;
        return level.time+(Priority(id)==3 ? 105 : 700);
    }

    void Start(int id,int value,int expiry=0)
    {
        ActiveID=id; ActiveValue=value; ActiveExpires=expiry; Age=0;
        Hold=clamp(75+Plain(Text(id,value)).Length(),105,350);
        Shown++;
    }

    void RemoveQueued(int i) { IDs.Delete(i); Values.Delete(i); Expires.Delete(i); }

    void Prune()
    {
        for(int i=IDs.Size()-1;i>=0;i--)
            if(Expires[i] && level.time>=Expires[i]) RemoveQueued(i);
    }

    void Queue(int id,int value,int expiry)
    {
        // Only disposable hints are bounded. Important discoveries coalesce by ID.
        if(IDs.Size()>=32 && Priority(id)==1)
        {
            for(int i=0;i<IDs.Size();i++)
                if(Priority(IDs[i])==1) { RemoveQueued(i); break; }
            if(IDs.Size()>=32) return;
        }
        IDs.Push(id); Values.Push(value); Expires.Push(expiry);
    }

    void Add(int id,int value=-1)
    {
        if(id<=0) return;
        String text=Text(id,value);
        if(text.IndexOf("UTNT_NOTICE_")>=0) return;
        Prune();
        if(ActiveID && Text(ActiveID,ActiveValue)==text) return;
        if(ActiveID && Group(ActiveID)==Group(id)) { Start(id,value,Deadline(id)); return; }
        for(int i=0;i<IDs.Size();i++)
        {
            if(Text(IDs[i],Values[i])==text) return;
            if(Group(IDs[i])==Group(id)) { IDs[i]=id; Values[i]=value; Expires[i]=Deadline(id); return; }
        }
        if(!ActiveID) Start(id,value,Deadline(id));
        else if(Priority(id)>Priority(ActiveID))
        {
            if(!ActiveExpires || level.time<ActiveExpires) Queue(ActiveID,ActiveValue,ActiveExpires);
            Start(id,value,Deadline(id));
        }
        else Queue(id,value,Deadline(id));
    }

    void ExpireHidden()
    {
        Prune();
        if(ActiveExpires && level.time>=ActiveExpires) ActiveID=0;
    }

    void Tick()
    {
        Prune();
        if(ActiveID && ++Age<7+Hold+11) return;
        ActiveID=0;
        if(IDs.Size())
        {
            int best=0;
            for(int i=1;i<IDs.Size();i++)
                if(Priority(IDs[i])>Priority(IDs[best])) best=i;
            Start(IDs[best],Values[best],Expires[best]); RemoveQueued(best);
        }
    }

    double Opacity(double frac=0)
    {
        return ActiveID ? clamp(min((Age+frac)/7.0,(7+Hold+11-Age-frac)/11.0),0,1) : 0;
    }

    static BrokenLines, double Layout(String text,double maxWidth)
    {
        Font font=Font.GetFont('SmallFont');
        return font.BreakLines(text,max(32,int(maxWidth))),1.0;
    }

    void Prepare(String text,int width)
    {
        if(CachedLines && text==CachedText && width==CachedWidth) return;
        CachedText=text; CachedWidth=width; CachedWidest=0; CachedShadows.Clear();
        CachedLines=Font.GetFont('SmallFont').BreakLines(text,max(32,width));
        for(int i=0;i<CachedLines.Count();i++)
        {
            String line=CachedLines.StringAt(i);
            CachedWidest=max(CachedWidest,Font.GetFont('SmallFont').StringWidth(line));
            CachedShadows.Push(Plain(line));
        }
        LayoutBuilds++;
    }

    // Lock IDs retain card/skull distinctions. Alternatives are shown together.
    static bool DrawKeys(int id,double cx,double cy,double scale,double alpha)
    {
        if(id<1000 || id>=9000) return false;
        int lock=(id-1000)/2;
        if(!UTNTNoticeLocks.Known(lock)) return false;
        String names[]={"RedCard","BlueCard","YellowCard","RedSkull","BlueSkull","YellowSkull"};
        Array<int> keys;
        if(lock>=1 && lock<=6) keys.Push(lock-1);
        else if(lock>=129 && lock<=134) { int color=(lock-129)%3;keys.Push(color);keys.Push(color+3); }
        else for(int i=0;i<6;i++) keys.Push(i);
        int columns=keys.Size()==6?3:1,rows=(keys.Size()+columns-1)/columns;
        double cellW=18.0/columns,cellH=18.0/rows;
        for(int i=0;i<keys.Size();i++)
        {
            class<Inventory> kind=names[keys[i]];
            let def=GetDefaultByType(kind);
            TextureID icon=def.Icon;if(!icon.IsValid() && def.SpawnState)icon=def.SpawnState.GetSpriteTexture(0);
            if(!icon.IsValid())continue;
            Vector2 size=TexMan.GetScaledSize(icon);
            double zoom=min(cellW/max(1,size.X),cellH/max(1,size.Y))*scale*0.5;
            double x=cx+((i%columns+.5)*cellW-9)*scale-size.X*zoom/2;
            double y=cy+((i/columns+.5)*cellH-9)*scale-size.Y*zoom/2;
            Screen.DrawTexture(icon,true,x,y,DTA_DestWidthF,size.X*zoom,DTA_DestHeightF,size.Y*zoom,
                DTA_LeftOffset,0,DTA_TopOffset,0,DTA_Alpha,alpha);
        }
        return true;
    }

    void DrawCoins(double alpha,double bottomLimit,double topLimit)
    {
        // A crisp arcade panel uses the Easter egg's own coin sprite.
        Font font=ConFont;
        double scale=UTNTUILayout.Scale();
        String text=Plain(Text(ActiveID,ActiveValue)).MakeUpper();
        let lines=font.BreakLines(text,int(UTNTUILayout.Width(360)-44));
        double widest=0;
        for(int i=0;i<lines.Count();i++)widest=max(widest,font.StringWidth(lines.StringAt(i)));
        double width=max(144,widest+44),lineHeight=font.GetHeight()+3;
        double height=max(32,lines.Count()*lineHeight+16);
        double bottom=bottomLimit<0?UTNTUILayout.Bottom():bottomLimit;
        double minimum=topLimit<0?UTNTUILayout.Top():max(UTNTUILayout.Top(),topLimit);
        double top=clamp(Screen.GetHeight()*.40-height*scale/2,minimum,max(minimum,bottom-height*scale));
        LastTop=top;LastBottom=top+height*scale;
        double left=(Screen.GetWidth()-width*scale)/2;
        UTNTObjectivePlaque.Rect(left,top,scale,2,3,width,height,0x191327,alpha*.8);
        UTNTObjectivePlaque.Rect(left,top,scale,0,0,width,height,0x713515,alpha);
        UTNTObjectivePlaque.Rect(left,top,scale,2,2,width-4,height-4,0xffc13a,alpha);
        UTNTObjectivePlaque.Rect(left,top,scale,4,4,width-8,height-8,0x194b91,alpha*.96);
        for(int i=0;i<2;i++)for(int j=0;j<2;j++)
            UTNTObjectivePlaque.Rect(left,top,scale,i?width-7:5,j?height-7:5,2,2,0xffed9a,alpha);
        int frame=(Age/5)%4;
        TextureID coin=TexMan.CheckForTexture(String.Format("SM_O%c0",65+frame));
        if(coin.IsValid())Screen.DrawTexture(coin,true,left+10*scale,top+(height-20)*scale/2,
            DTA_DestWidthF,16*scale,DTA_DestHeightF,20*scale,DTA_LeftOffset,0,DTA_TopOffset,0,DTA_Alpha,alpha);
        double y=top+(height-lines.Count()*lineHeight+3)*scale/2;
        for(int i=0;i<lines.Count();i++) {
            Screen.DrawText(font,Font.CR_UNTRANSLATED,left+33*scale,y+i*lineHeight*scale+scale,lines.StringAt(i),
                DTA_ScaleX,scale,DTA_ScaleY,scale,DTA_Color,0xff102443,DTA_Alpha,alpha);
            Screen.DrawText(font,Font.CR_UNTRANSLATED,left+32*scale,y+i*lineHeight*scale,lines.StringAt(i),
                DTA_ScaleX,scale,DTA_ScaleY,scale,DTA_Color,ActiveID==225?0xffffdc51:0xffffffff,DTA_Alpha,alpha);
        }
    }

    void Draw(double frac,double bottomLimit=-1,double topLimit=-1)
    {
        double alpha=Opacity(frac);
        if(alpha<=0) return;
        if(ActiveID==225 || ActiveID==226) { DrawCoins(alpha,bottomLimit,topLimit); return; }
        if(ActiveID==9001) { UTNTExplorationUI.DrawSecret(ActiveValue,alpha,bottomLimit,topLimit); return; }
        Font font=Font.GetFont('SmallFont');
        double scale=UTNTUILayout.Scale();
        Prepare(Text(ActiveID,ActiveValue),int(UTNTUILayout.Width(360)-36));
        let lines=CachedLines; double size=1;
        double widest=CachedWidest;
        double width=max(120,widest+36),lineHeight=(font.GetHeight()+3)*size;
        double height=max(23,lines.Count()*lineHeight+12);
        int l=int(round((Screen.GetWidth()-width*scale)/2));
        int r=int(round((Screen.GetWidth()+width*scale)/2));
        double bottom=bottomLimit<0 ? UTNTUILayout.Bottom() : bottomLimit;
        double minimum=topLimit<0 ? UTNTUILayout.Top() : max(UTNTUILayout.Top(),topLimit);
        double top=clamp(Screen.GetHeight()*0.40-height*scale/2,minimum,max(minimum,bottom-height*scale));
        LastTop=top;LastBottom=top+height*scale;
        int t=int(round(top));
        int b=int(round(top+height*scale));
        int edge=max(1,int(round(scale)));
        // A single translucent center and disjoint thin edges keep the frame quiet and gap-free.
        Screen.DrawTexture(TexMan.CheckForTexture('UTOCBG'),true,l+edge,t+edge,
            DTA_DestWidth,r-l-2*edge,DTA_DestHeight,b-t-2*edge,
            DTA_LeftOffset,0,DTA_TopOffset,0,DTA_Alpha,alpha*0.78);
        Screen.Dim(0x675139,alpha*0.70,l,t,r-l,edge);
        Screen.Dim(0x4a3926,alpha*0.70,l,b-edge,r-l,edge);
        Screen.Dim(0x997044,alpha*0.75,l,t+edge,edge,b-t-2*edge);
        Screen.Dim(0x352b20,alpha*0.65,r-edge,t+edge,edge,b-t-2*edge);
        double cx=l+13*scale,cy=(t+b)/2.0;
        if(!DrawKeys(ActiveID,cx,cy,scale,alpha))
            for(int row=-4;row<=4;row++)
                UTNTObjectivePlaque.Rect(cx,cy,scale,-(4-abs(row)),row,2*(4-abs(row))+1,1,
                    row<0?0xa17745:0x74522d,alpha*0.9);
        // UTNT SmallFont has six visible capital rows; its font cell includes
        // extra shadow/descender space. Count line spacing only between rows.
        double textHeight=(lines.Count()-1)*lineHeight+6*size;
        double y=(t+b-textHeight*scale)/2.0;
        for(int i=0;i<lines.Count();i++)
        {
            String line=lines.StringAt(i);
            Screen.DrawText(font,Font.CR_WHITE,l+26*scale+size*scale,y+i*lineHeight*scale+size*scale,CachedShadows[i],
                DTA_ScaleX,size*scale,DTA_ScaleY,size*scale,DTA_Color,0xff070605,DTA_Alpha,alpha*0.8);
            // Native color escapes remain intact, including key-card/skull colors.
            Screen.DrawText(font,Font.FindFontColor('UTNTNoticeBody'),l+26*scale,y+i*lineHeight*scale,line,
                DTA_ScaleX,size*scale,DTA_ScaleY,size*scale,DTA_Alpha,alpha);
        }
    }
}

// Only handles denied, recognized Doom locks; every positive check follows the native path.
class UTNTNoticeLocks
{
    static bool Known(int lock)
    {
        return lock>=1 && lock<=6 || lock>=129 && lock<=134
            || lock==100 || lock==101 || lock==228 || lock==229;
    }

    static int Lock(Line line)
    {
        if(line.locknumber>0) return line.locknumber;
        if(line.special==13 || line.special==14) return line.args[3];
        if(line.special==83 || line.special==85 || line.special==202) return line.args[4];
        return 0;
    }

    static bool Remote(Line line)
    {
        if(line.locknumber>0)
            return line.special!=7 && line.special!=8 && (line.special<11 || line.special>14);
        if(line.special==83) return true;
        if(line.special==85) return false;
        if(line.special==202) return !(line.args[2]&128) && line.args[0]!=0;
        return line.args[0]!=0;
    }
}
