// A single portal can be an arch made from several adjacent sidedefs.
class UTNTPortalSlice : Object
{
    int SideIndex;
    bool Fitted;
    Vector2 A, B, Direction;
    double Bottom, Top;
}

class UTNTPortalMaterials : EventHandler
{
    ui double SuctionAmount;
    override void RenderOverlay(RenderEvent e) { SuctionAmount=UTNTPortalSuction.Render(e); }
    override void WorldUnloaded(WorldEvent e) { PPShader.SetEnabled("UTNTPortalSuction",false); }
    int FittedSurfaces, FittedOpenings, AutomaticSources;
    Array<UTNTPortalSlice> Openings;
    Array<UTNTRitualPadState> RitualPads;
    override void WorldTick()
    {
        // Geometry is saved; native client actors are not. Reconcile at most
        // once a second, including saves restored without WorldLoaded.
        if(level.time%35) return;
        UTNTRitualPads.Refresh(self);
        for(int i=0;i<Openings.Size();i++)
        {
            let p=Openings[i];
            AddSource(p.A,p.Direction,(p.B-p.A).Length(),p.Bottom,p.Top);
        }
    }
    static double Projection(Vector2 a, Vector2 b) { return a.X*b.X+a.Y*b.Y; }
    static bool Joins(UTNTPortalSlice a, UTNTPortalSlice b)
    {
        // Opposite faces and nearby parallel walls are separate openings.
        if(Projection(a.Direction,b.Direction)<0.99999) return false;
        if(abs((b.A.X-a.A.X)*a.Direction.Y-(b.A.Y-a.A.Y)*a.Direction.X)>0.1) return false;
        if(min(a.Top,b.Top)<=max(a.Bottom,b.Bottom)) return false;
        return (a.A-b.B).Length()<0.1 || (a.B-b.A).Length()<0.1;
    }
    bool HasDecoration(Vector2 start, Vector2 direction, double width, double bottom, double top)
    {
        let it=ThinkerIterator.Create('UTNTPortalDecorationBase');
        UTNTPortalDecorationBase source;
        while(source=UTNTPortalDecorationBase(it.Next()))
        {
            if(source is 'UTNTPortalAutoSource') continue;
            // A nearby decoration covers only its own face, never the reverse.
            if(cos(source.Angle)*direction.Y-sin(source.Angle)*direction.X<0.999) continue;
            Vector2 delta=source.Pos.XY-start;
            double along=Projection(delta,direction);
            double away=abs(delta.X*direction.Y-delta.Y*direction.X);
            if(away<=32 && along>=-16 && along<=width+16 && source.Pos.Z>=bottom-8 && source.Pos.Z<=top+8)
            {
                // The wall is already a visible portal. Legacy dormant starts
                // were an area-culling optimization, not a gameplay lock.
                source.SurfaceManaged=true;
                if(source.PortalWidth==0) source.PortalWidth=int(width);
                return true;
            }
        }
        return false;
    }
    void AddSource(Vector2 start, Vector2 direction, double width, double bottom, double top)
    {
        if(HasDecoration(start,direction,width,bottom,top)) return;
        Vector2 axis=(direction.Y,-direction.X);
        Vector2 center=start+direction*width*0.5+axis*8;
        let existing=ThinkerIterator.Create('UTNTPortalAutoSource',Thinker.MAX_STATNUM+1,true);
        UTNTPortalAutoSource old;
        while(old=UTNTPortalAutoSource(existing.Next()))
            if((old.Pos.XY-center).Length()<1 && abs(old.Pos.Z-bottom)<1
                && cos(old.Angle)*axis.X+sin(old.Angle)*axis.Y>0.999) return;
        let source=UTNTPortalAutoSource(Actor.SpawnClientSide('UTNTPortalAutoSource',(center.X,center.Y,bottom)));
        if(!source) return;
        source.Angle=atan2(axis.Y,axis.X);
        source.PortalWidth=int(width);
        source.PortalHeight=top-bottom;
        AutomaticSources++;
    }
    override void WorldLoaded(WorldEvent e)
    {
        FittedSurfaces=FittedOpenings=AutomaticSources=0;
        Openings.Clear();
        TextureID oldA=TexMan.CheckForTexture('QTELEPT');
        TextureID oldB=TexMan.CheckForTexture('QTELEPOR');
        TextureID portal=TexMan.CheckForTexture('UPORTAL');
        // Traversable portal sheets can have a blank reverse sidedef. Give
        // that face the same material before fitting each orientation. Keep
        // authored non-portal reverse textures and all collision flags intact.
        for(int i=0;i<level.lines.Size();i++)
        {
            let line=level.lines[i];
            if(!line.sidedef[0] || !line.sidedef[1]) continue;
            for(int face=0;face<2;face++)
            {
                let side=line.sidedef[face]; let other=line.sidedef[1-face];
                TextureID tex=side.GetTexture(Side.mid);
                if(tex!=oldA && tex!=oldB && tex!=portal) continue;
                if(other.GetTexture(Side.mid).isValid()) continue;
                Vector2 center=(line.v1.p+line.v2.p)*0.5;
                double bottom=max(side.sector.floorplane.ZatPoint(center),other.sector.floorplane.ZatPoint(center));
                double top=min(side.sector.ceilingplane.ZatPoint(center),other.sector.ceilingplane.ZatPoint(center));
                if(top-bottom>=48) other.SetTexture(Side.mid,tex);
            }
        }
        Array<UTNTPortalSlice> parts;
        for(int i=0;i<level.sides.Size();i++)
        {
            let side=level.sides[i];
            TextureID tex=side.GetTexture(Side.mid);
            // UPORTAL also participates after loading a save or returning to a hub.
            if(tex!=oldA && tex!=oldB && tex!=portal) continue;
            Vector2 a=side.V1().p, b=side.V2().p, center=(a+b)*0.5;
            double width=(b-a).Length();
            if(width<0.1) continue;
            double top=side.sector.ceilingplane.ZatPoint(center);
            double bottom=side.sector.floorplane.ZatPoint(center);
            let line=side.linedef;
            let other=line.frontsector==side.sector ? line.backsector : line.frontsector;
            if(other)
            {
                top=min(top,other.ceilingplane.ZatPoint(center));
                bottom=max(bottom,other.floorplane.ZatPoint(center));
            }
            if(top-bottom<48) continue;
            let part=new('UTNTPortalSlice');
            part.SideIndex=i;part.A=a;part.B=b;part.Direction=(b-a)/width;
            part.Top=top;part.Bottom=bottom;parts.Push(part);
        }
        for(int i=0;i<parts.Size();i++)
        {
            if(parts[i].Fitted) continue;
            Array<int> group;
            group.Push(i);parts[i].Fitted=true;
            for(int j=0;j<group.Size();j++)
                for(int k=0;k<parts.Size();k++)
                    if(!parts[k].Fitted && Joins(parts[group[j]],parts[k]))
                    { group.Push(k);parts[k].Fitted=true; }
            Vector2 origin=parts[i].A, direction=parts[i].Direction;
            double left=0,right=0,bottom=parts[i].Bottom,top=parts[i].Top;
            for(int j=0;j<group.Size();j++)
            {
                let part=parts[group[j]];
                left=min(left,Projection(part.A-origin,direction));
                right=max(right,Projection(part.B-origin,direction));
                bottom=min(bottom,part.Bottom);top=max(top,part.Top);
            }
            double width=right-left,height=top-bottom;
            if(width<48) continue;
            Vector2 start=origin+direction*left;
            for(int j=0;j<group.Size();j++)
            {
                let part=parts[group[j]];
                let side=level.sides[part.SideIndex];
                double anchor=(side.linedef.flags & Line.ML_DONTPEGBOTTOM) ? part.Bottom+height : part.Top;
                side.SetTexture(Side.mid,portal);
                side.SetTextureXScale(Side.mid,256.0/width);
                side.SetTextureYScale(Side.mid,256.0/height);
                side.SetTextureXOffset(Side.mid,Projection(part.A-start,direction)*256.0/width);
                side.SetTextureYOffset(Side.mid,(top-anchor)*256.0/height);
                FittedSurfaces++;
            }
            FittedOpenings++;
            let pending=new('UTNTPortalSlice');
            pending.A=start;pending.B=start+direction*width;pending.Direction=direction;
            pending.Bottom=bottom;pending.Top=top;Openings.Push(pending);
        }
    }
}

class UTNTPortalDecorationBase : SwitchableDecoration
{
    int PortalWidth; double PortalHeight;
    bool PortalActive;
    bool SurfaceManaged, ExplicitOff, LifecycleReady;
    clearscope bool EffectsEnabled()
    {
        return !ExplicitOff && (SurfaceManaged || (PortalActive && !bDormant));
    }
    override void Tick()
    {
        Super.Tick();
        LifecycleReady=true;
        if(SurfaceManaged) UTNTPortalSystem.Ensure(self);
    }
    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        if(bDormant || SpawnFlags & MTF_DORMANT)
        {
            // Initial dormancy is not an explicit runtime shutdown.
            PortalActive=false;
            Super.Deactivate(null);
        }
    }
    // SwitchableDecoration only changes states. Our emitter also checks
    // bDormant, so a map-placed dormant source must clear it on activation.
    override void Activate(Actor activator)
    {
        ExplicitOff=false; bDormant=false;
        Super.Activate(activator);
    }
    override void Deactivate(Actor activator)
    {
        // The engine also invokes Deactivate for a dormant map spawn.
        ExplicitOff=LifecycleReady; PortalActive=false; bDormant=true;
        Super.Deactivate(activator);
    }
    action void A_UTNTPortal(int width)
    {
        let source=UTNTPortalDecorationBase(self);
        source.PortalWidth=width; source.PortalActive=true;
        UTNTPortalSystem.Ensure(source);
    }
    action void A_UTNTPortalOff() { UTNTPortalDecorationBase(self).PortalActive=false; }
}

class UTNTPortalSystem play
{
    // ACS 176 predates local LOD and only tracks which side of a room trigger
    // players crossed. Acknowledge that hint without overriding manual switches.
    static int UseLocalVisibility(int tid)
    {
        let it=ActorIterator.Create(tid); Actor actor; int count=0;
        while(actor=it.Next())
        {
            let source=UTNTPortalDecorationBase(actor);
            if(!source) continue;
            source.SurfaceManaged=true; count++;
        }
        return count;
    }
    static bool LocalVisible(UTNTPortalDecorationBase source)
    {
        if(!UTNTVisuals.Visible(source,combat:true)) return false;
        if(!source.SurfaceManaged) return true;
        Vector2 delta=players[consoleplayer].camera.Pos.XY-source.Pos.XY;
        return delta.X*cos(source.Angle)+delta.Y*sin(source.Angle)>-4;
    }
    static void Ensure(UTNTPortalDecorationBase source)
    {
        if(!source || source.PortalWidth<=0 || !source.EffectsEnabled() || !LocalVisible(source)) return;
        // At most 32 emitters per local client; no gameplay random stream.
        let runtime=UTNTFXRuntime.Get();
        if(runtime.Lookup(source,3) || runtime.Count(3)>=32)return;
        UTNTPortalEmitter emitter;
        emitter=UTNTPortalEmitter(level.CreateClientSideThinker('UTNTPortalEmitter',Thinker.STAT_USER+8));
        if(emitter) { emitter.Initialize(source);runtime.Register(source,3,emitter); }
    }
}

// Map-independent local decoration for portal surfaces without a placed actor.
// Both faces can exist, but only the face towards the local camera emits.
class UTNTPortalAutoSource : UTNTPortalDecorationBase
{
    Default { +CLIENTSIDE +NOINTERACTION +NOGRAVITY +NOBLOCKMAP +NOCLIP +INVISIBLE }
    States { Spawn: TNT1 A -1; Stop; }
    override void Tick()
    {
        Super.Tick();
        let player=players[consoleplayer];
        PortalActive=false;
        if(!player || !player.camera) return;
        Vector2 delta=player.camera.Pos.XY-Pos.XY;
        PortalActive=delta.X*cos(Angle)+delta.Y*sin(Angle)>-4;
        if(PortalActive) UTNTPortalSystem.Ensure(self);
    }
}

class UTNTPortalAnchor : Actor
{
    Default { +CLIENTSIDE +NOINTERACTION +NOGRAVITY +NOBLOCKMAP +NOCLIP +INVISIBLE }
}

class UTNTPortalEmitter : Thinker
{
    UTNTPortalDecorationBase Source;
    Actor LightAnchor;
    Vector3 Center, Axis, SideAxis;
    double Width, Height;
    uint Seed;
    int Age;
    double Noise(double low,double high)
    {
        Seed=Seed*1664525+1013904223;
        return low+(high-low)*double((Seed>>8)&0xffffff)/16777216.0;
    }
    void Initialize(UTNTPortalDecorationBase source)
    {
        self.Source=source; Width=source.PortalWidth;
        double floor=source.GetZAt(0,0,0,GZF_NO3DFLOOR);
        double ceiling=source.GetZAt(0,0,0,GZF_CEILING|GZF_NO3DFLOOR);
        Height=source.PortalHeight>0 ? source.PortalHeight : max(32,ceiling-floor);
        Axis=(cos(source.Angle),sin(source.Angle),0);
        SideAxis=(-Axis.Y,Axis.X,0);
        Center=(source.Pos.X,source.Pos.Y,source.PortalHeight>0 ? source.Pos.Z+Height*0.5 : (floor+ceiling)*0.5);
        Seed=uint(int(source.Pos.X)*73856093)^uint(int(source.Pos.Y)*19349663)^uint(level.time+667);
        LightAnchor=Actor.SpawnClientSide('UTNTPortalAnchor',Center+Axis*10);
    }
    override void OnDestroy()
    {
        if(LightAnchor) { LightAnchor.A_StopSound(CHAN_BODY); LightAnchor.Destroy(); }
        Super.OnDestroy();
    }
    override void Tick()
    {
        if(!Source || !Source.EffectsEnabled()) { Destroy(); return; }
        if(Source.IsFrozen() || level.isFrozen()) return;
        if(!UTNTPortalSystem.LocalVisible(Source)) { Destroy(); return; }
        Age++;
        let player=players[consoleplayer];
        int quality=clamp(CVar.GetCVar('UTNT_fxquality',player).GetInt(),1,3);
        if(CVar.GetCVar('UTNT_reducedfx',player).GetBool() || Source.Distance3D(player.camera)>640) quality=1;
        double pulse=max(0, sin(level.time*360.0/245.0));
        pulse=pulse*pulse; double fourth=pulse*pulse; pulse=fourth*fourth*pulse;
        if(LightAnchor && Age%4==1)
        {
            int radius=int((quality==1 ? 80 : 108)+pulse*(quality==1 ? 8 : 28));
            LightAnchor.A_AttachLight('portal',DynamicLight.PointLight,0xff8c14,radius,0,DynamicLight.LF_ATTENUATE,
                quality==1 ? (0,0,0) : SideAxis*Width*0.42);
            if(quality>1)
                LightAnchor.A_AttachLight('portal2',DynamicLight.PointLight,0xff8c14,radius,0,DynamicLight.LF_ATTENUATE,-SideAxis*Width*0.42);
            else LightAnchor.A_RemoveLight('portal2');
            if(!LightAnchor.IsActorPlayingSound(CHAN_BODY))
                LightAnchor.A_StartSound("utnt/portal/hum",CHAN_BODY,CHANF_LOOP,0.32,1.8);
        }
        int interval=quality==1 ? 14 : quality==2 ? 8 : 4;
        if(Age%interval || !UTNTVisuals.Reserve()) return;
        let mote=UTNTPortalMote(level.SpawnClientSideVisualThinker('UTNTPortalMote'));
        if(mote) mote.Initialize(self,Age%5==0 && quality>1);
    }
}

class UTNTPortalMote : UTNTRuneMote
{
    UTNTPortalDecorationBase Source;
    Vector3 Target, Start, Bend;
    int Age, Life;
    double Diameter, Strength, Spin;
    bool Wisp;
    void Initialize(UTNTPortalEmitter emitter,bool wisp)
    {
        Source=emitter.Source; Wisp=wisp;
        Life=int(emitter.Noise(64,116));
        Target=emitter.Center+emitter.SideAxis*emitter.Noise(-emitter.Width*0.26,emitter.Width*0.26);
        Target.Z+=emitter.Noise(-emitter.Height*0.32,emitter.Height*0.32);
        // A broad intake volume in front of the opening, converging on the
        // smaller destination above. Scale from the portal, not each target.
        double reach=clamp(emitter.Width/192.0,0.75,1.5);
        Start=emitter.Center+emitter.Axis*emitter.Noise(128,320)*reach;
        Start+=emitter.SideAxis*emitter.Noise(-emitter.Width*0.8,emitter.Width*0.8);
        Start.Z+=emitter.Noise(-emitter.Height*0.48,emitter.Height*0.48);
        Bend=emitter.SideAxis*emitter.Noise(-emitter.Width*0.2,emitter.Width*0.2)
            +(0,0,emitter.Noise(-emitter.Height*0.12,emitter.Height*0.12));
        Diameter=wisp ? emitter.Noise(17,23) : emitter.Noise(10,16);
        Strength=emitter.Noise(0.85,1.0);
        Texture=TexMan.CheckForTexture(String.Format("UTR%cA0",65+int(emitter.Noise(0,4))));
        Flags=SPF_FULLBRIGHT|SPF_ROLL|SPF_ALLOWSHADERS; SetRenderStyle(STYLE_Add);
        Roll=emitter.Noise(0,360); Spin=emitter.Noise(-1.5,1.5);
        Pos=Start; Prev=Pos; PrevRoll=Roll;
        UpdateSector(); UpdateSpriteInfo(); Animate(); InitializeTrail();
    }
    void Animate()
    {
        double t=double(Age)/Life;
        let size=TexMan.GetScaledSize(Texture);
        double d=Diameter*(1-0.6*t);
        Scale=(d/size.X,d/size.Y);
        Alpha=Strength*SoftFade(Age,Life,24,12);
    }
    override void Tick()
    {
        if(!Source || !Source.EffectsEnabled()) { Destroy(); return; }
        if(IsFrozen() || Source.IsFrozen() || level.isFrozen()) return;
        if(++Age>=Life || !UTNTPortalSystem.LocalVisible(Source)) { Destroy(); return; }
        Prev=Pos; PrevRoll=Roll;
        double t=double(Age)/Life;
        double travel=t*t;
        Pos=Start+(Target-Start)*travel+Bend*sin(t*180);
        Roll+=Spin; UpdateSector(); Animate(); UpdateTrail();
    }
}

// Render-time values belong to this client's camera, never to saved world mapping.
class UTNTPortalSuction ui
{
    static double Proximity(Vector3 eye, Vector3 center, Vector3 axis, Vector3 sideAxis, double width, double height)
    {
        Vector3 delta=eye-center;
        double front=delta.X*axis.X+delta.Y*axis.Y;
        if(front<=0) return 0;
        double along=delta.X*sideAxis.X+delta.Y*sideAxis.Y;
        double outside=max(0,abs(along)-width*0.5);
        double above=max(0,abs(delta.Z)-height*0.5);
        double distance=sqrt(front*front+outside*outside+above*above);
        // Smoothly ramp from 384 map units to full strength at the portal plane.
        double strength=clamp(1-distance/384.0,0,1);
        return strength*strength*(3-2*strength);
    }
    static double Render(RenderEvent e)
    {
        PPShader.SetEnabled("UTNTPortalSuction",false);
        if(consoleplayer<0 || !e.Camera) return 0;
        let p=players[consoleplayer];
        if(!CVar.GetCVar('UTNT_shaderoverlayswitch',p).GetBool()
            || CVar.GetCVar('UTNT_reducedfx',p).GetBool()
            || CVar.GetCVar('UTNT_fxquality',p).GetInt()==0
            || CVar.GetCVar('UTNT_lod',p).GetInt()==0) return 0;
        Vector3 forward=(cos(e.ViewAngle)*cos(e.ViewPitch),sin(e.ViewAngle)*cos(e.ViewPitch),-sin(e.ViewPitch));
        Vector3 right=(sin(e.ViewAngle),-cos(e.ViewAngle),0);
        Vector3 up=(cos(e.ViewAngle)*sin(e.ViewPitch),sin(e.ViewAngle)*sin(e.ViewPitch),cos(e.ViewPitch));
        double aspect=double(Screen.GetWidth())/max(1,Screen.GetHeight());
        // Doom's FOV is specified at 4:3; wider screens extend horizontally.
        double horizontal=tan(clamp(p.FOV,30,150)*0.5)*max(1,aspect/(4.0/3.0));
        double best=0; Vector2 focus=(0.5,0.5);
        let it=ThinkerIterator.Create('UTNTPortalEmitter',Thinker.STAT_USER+8,true);
        UTNTPortalEmitter em;
        while(em=UTNTPortalEmitter(it.Next()))
        {
            if(!em.Source || !em.Source.EffectsEnabled()) continue;
            double strength=Proximity(e.ViewPos,em.Center,em.Axis,em.SideAxis,em.Width,em.Height);
            if(strength<=best) continue;
            Vector3 target=em.Center;
            target.Z=clamp(e.ViewPos.Z,em.Center.Z-em.Height*.30,em.Center.Z+em.Height*.30);
            Vector3 delta=target-e.ViewPos;
            double depth=delta.X*forward.X+delta.Y*forward.Y+delta.Z*forward.Z;
            if(depth<=1) continue;
            double x=(delta.X*right.X+delta.Y*right.Y)/(depth*horizontal);
            double y=(delta.X*up.X+delta.Y*up.Y+delta.Z*up.Z)/(depth*horizontal/aspect);
            // Smoothly leave the view; no effect when looking away.
            strength*=clamp((1.15-abs(x))/.3,0,1)*clamp((1.15-abs(y))/.3,0,1);
            if(strength<=best) continue;
            let trace=new('LineTracer');
            double distance=delta.Length();
            // Zero flag mask ignores invisible two-sided trigger boundaries;
            // solid walls, closed sectors and 3D floors still occlude the trace.
            trace.Trace(e.ViewPos,e.Camera.CurSector,delta/distance,max(0,distance-2),0,wallMask:0,ignoreAllActors:true);
            if(trace.Results.HitType!=TRACE_HitNone) continue;
            // Account for camera roll without moving the focal point off the portal.
            double rx=x*cos(e.ViewRoll)+y*sin(e.ViewRoll);
            double ry=y*cos(e.ViewRoll)-x*sin(e.ViewRoll);
            focus=(0.5+rx*.5,0.5+ry*.5); best=strength;
        }
        if(best<=0.001) return 0;
        PPShader.SetUniform1f("UTNTPortalSuction","amount",best);
        PPShader.SetUniform1f("UTNTPortalSuction","phase",(level.time+e.FracTic)/35.0);
        PPShader.SetUniform2f("UTNTPortalSuction","focus",focus);
        PPShader.SetEnabled("UTNTPortalSuction",true);
        return best;
    }
}

// Pad geometry is deterministic world mapping. Cosmetic thinkers stay client-local.
class UTNTRitualPadState : Object
{
    int Index;
    double XScale,YScale,XOffset,YOffset,Angle;
    Vector2 FitScale,FitOffset;
    play void Restore(Sector sec)
    {
        // Respect UV edits explicitly made by a script while the seal was active.
        if(abs(sec.GetXScale(Sector.floor)-FitScale.X)<.0001)sec.SetXScale(Sector.floor,XScale);
        if(abs(sec.GetYScale(Sector.floor)-FitScale.Y)<.0001)sec.SetYScale(Sector.floor,YScale);
        if(abs(sec.GetXOffset(Sector.floor)-FitOffset.X)<.0001)sec.SetXOffset(Sector.floor,XOffset);
        if(abs(sec.GetYOffset(Sector.floor)-FitOffset.Y)<.0001)sec.SetYOffset(Sector.floor,YOffset);
        if(abs(sec.GetAngle(Sector.floor))<.0001)sec.SetAngle(Sector.floor,Angle);
    }
}

class UTNTRitualPads play
{
    static void Refresh(UTNTPortalMaterials handler)
    {
        TextureID seal=TexMan.CheckForTexture('UTPSEAL');
        // Saved alongside the sector: texture switches and save/load keep the
        // original floor mapping, instead of leaving an enlarged ordinary flat.
        for(int i=handler.RitualPads.Size()-1;i>=0;i--)
        {
            let old=handler.RitualPads[i];
            let sec=level.sectors[old.Index];
            if(sec.GetTexture(Sector.floor)==seal)continue;
            old.Restore(sec);handler.RitualPads.Delete(i);
        }
        for(int i=0;i<level.sectors.Size();i++)
        {
            let sec=level.sectors[i];
            String name=TexMan.GetName(sec.GetTexture(Sector.floor));
            bool pad=false;
            for(int j=1;j<=7;j++)
                if(name==String.Format("QSLIP%d",j)||name==String.Format("QSLIPP%d",j))pad=true;
            if(!pad)continue;
            Vector2 lo=(1e9,1e9),hi=(-1e9,-1e9);
            for(int j=0;j<sec.lines.Size();j++)
            {
                let l=sec.lines[j];
                lo.X=min(lo.X,min(l.v1.p.X,l.v2.p.X));lo.Y=min(lo.Y,min(l.v1.p.Y,l.v2.p.Y));
                hi.X=max(hi.X,max(l.v1.p.X,l.v2.p.X));hi.Y=max(hi.Y,max(l.v1.p.Y,l.v2.p.Y));
            }
            Vector2 size=hi-lo;
            if(size.X<32||size.Y<32||size.X>512||size.Y>512)continue;
            let mapping=new('UTNTRitualPadState');mapping.Index=i;
            mapping.XScale=sec.GetXScale(Sector.floor);mapping.YScale=sec.GetYScale(Sector.floor);
            mapping.XOffset=sec.GetXOffset(Sector.floor);mapping.YOffset=sec.GetYOffset(Sector.floor);
            mapping.Angle=sec.GetAngle(Sector.floor);
            mapping.FitScale=(512.0/size.X,512.0/size.Y);mapping.FitOffset=(-lo.X,hi.Y);
            handler.RitualPads.Push(mapping);
            sec.SetTexture(Sector.floor,seal);
            sec.SetAngle(Sector.floor,0);
            sec.SetXScale(Sector.floor,512.0/size.X);sec.SetYScale(Sector.floor,512.0/size.Y);
            sec.SetXOffset(Sector.floor,-lo.X);sec.SetYOffset(Sector.floor,hi.Y);
        }
    }
}

class UTNTRitualMote : UTNTRuneMote
{
    Actor Source;
    int Age,Life;
    double Angle,Radius,Size;
    Vector3 Origin;
    static void Emit(Actor source,int size)
    {
        // Keep the pad glow steady even when thinning the slower rune emissions.
        UTNTRitualGlow.Touch(source);
        if(CRandom[utntritual](0,7)>=3)return;
        let mote=UTNTRitualMote(level.SpawnClientSideVisualThinker('UTNTRitualMote'));
        if(!mote)return;
        mote.Source=source;mote.Origin=source.Pos;
        mote.Life=CRandom[utntritual](88,116);
        mote.Angle=CFRandom[utntritual](0,360);mote.Radius=CFRandom[utntritual](size*.15,size*.45);
        mote.Size=CFRandom[utntritual](7,12);
        mote.Texture=TexMan.CheckForTexture(String.Format("UTR%cA0",65+CRandom[utntritual](0,3)));
        mote.Flags=SPF_FULLBRIGHT|SPF_ROLL|SPF_ALLOWSHADERS;mote.SetRenderStyle(STYLE_Add);
        mote.Pos=source.Pos;mote.Prev=mote.Pos;mote.Roll=CFRandom[utntritual](-30,30);
        mote.PrevRoll=mote.Roll;mote.Animate();mote.Prev=mote.Pos;
        mote.UpdateSector();mote.UpdateSpriteInfo();mote.InitializeTrail();
    }
    void Animate()
    {
        double t=double(Age)/Life;
        Pos=Origin+(cos(Angle+t*160)*Radius,sin(Angle+t*160)*Radius,4+t*72);
        let sz=TexMan.GetScaledSize(Texture);Scale=(Size/sz.X,Size/sz.Y);
        Alpha=SoftFade(Age,Life,24,18);
    }
    override void Tick()
    {
        if(!Source||!UTNTVisuals.Visible(Source,combat:true)){Destroy();return;}
        if(IsFrozen()||Source.IsFrozen()||level.isFrozen())return;
        if(++Age>=Life){Destroy();return;}
        Prev=Pos;PrevRoll=Roll;Roll+=.2;Animate();UpdateSector();UpdateTrail();
    }
}

class UTNTRitualGlow : Thinker
{
    Actor Source,Anchor;
    int LastEmission;
    static void Touch(Actor source)
    {
        let it=ThinkerIterator.Create('UTNTRitualGlow',Thinker.STAT_USER+8,true);
        UTNTRitualGlow g;
        while(g=UTNTRitualGlow(it.Next()))if(g.Source==source){g.LastEmission=level.time;return;}
        g=UTNTRitualGlow(level.CreateClientSideThinker('UTNTRitualGlow',Thinker.STAT_USER+8));
        if(!g)return;
        g.Source=source;g.LastEmission=level.time;
        g.Anchor=Actor.SpawnClientSide('UTNTPortalAnchor',source.Pos+(0,0,20));
        if(g.Anchor)g.Anchor.A_AttachLight('ritual',DynamicLight.PointLight,0xff8c14,72,0,DynamicLight.LF_ATTENUATE);
    }
    override void Tick()
    {
        if(!Source||!UTNTVisuals.Visible(Source,combat:true)||level.time-LastEmission>16){Destroy();return;}
    }
    override void OnDestroy(){if(Anchor)Anchor.Destroy();Super.OnDestroy();}
}

// Fixed-size per-rune history keeps curved trails bounded at every quality level.
class UTNTRuneMote : VisualThinker
{
    Vector3 TrailHistory[10];
    Array<UTNTRuneStreak> Trail;
    static double SoftFade(int age,int life,double fadeIn,double fadeOut)
    {
        double a=clamp((age+1)/fadeIn,0,1),b=clamp((life-age)/fadeOut,0,1);
        return a*a*(3-2*a)*b*b*(3-2*b);
    }
    void InitializeTrail()
    {
        for(int i=0;i<10;i++)TrailHistory[i]=Pos;
        for(int i=0;i<3;i++)
        {
            let streak=UTNTRuneStreak(level.SpawnClientSideVisualThinker('UTNTRuneStreak'));
            if(!streak)continue;
            streak.Texture=TexMan.CheckForTexture('UTRTA0');
            streak.Flags=SPF_FULLBRIGHT|SPF_ROLL|SPF_ALLOWSHADERS;
            streak.SetRenderStyle(STYLE_Add);streak.Alpha=0;
            streak.Pos=Pos;streak.Prev=Pos;streak.UpdateSector();streak.UpdateSpriteInfo();
            Trail.Push(streak);
        }
    }
    void UpdateTrail()
    {
        for(int i=9;i>0;i--)TrailHistory[i]=TrailHistory[i-1];
        TrailHistory[0]=Pos;
        let sz=TexMan.GetScaledSize(Texture);
        double width=clamp(Scale.X*sz.X*.32,1.5,5.0);
        for(int i=0;i<Trail.Size();i++)if(Trail[i])
            Trail[i].Follow(TrailHistory[i*3],TrailHistory[i*3+3],width,Alpha*(i==0 ? .20 : i==1 ? .11 : .05));
    }
    override void OnDestroy()
    {
        for(int i=0;i<Trail.Size();i++)if(Trail[i])Trail[i].Destroy();
        Super.OnDestroy();
    }
}

class UTNTRuneStreak : VisualThinker
{
    // The owner updates each segment once per tic; no independent lifetime or RNG.
    override void Tick() {}
    void Follow(Vector3 head,Vector3 tail,double width,double opacity)
    {
        Prev=Pos;PrevRoll=Roll;Pos=(head+tail)*.5;UpdateSector();
        Alpha=0;let camera=players[consoleplayer].camera;if(!camera)return;
        double yaw=camera.Angle;
        double pitch=(CVar.GetCVar('gl_billboard_particles').GetBool() || CVar.GetCVar('gl_billboard_mode').GetInt()==1) ? camera.Pitch : 0;
        double eyeZ=camera.player ? camera.player.viewz : camera.Pos.Z;
        Vector3 h=head-(camera.Pos.X,camera.Pos.Y,eyeZ),t=tail-(camera.Pos.X,camera.Pos.Y,eyeZ);
        double ha=h.X*cos(yaw)+h.Y*sin(yaw),ta=t.X*cos(yaw)+t.Y*sin(yaw);
        double hd=ha*cos(pitch)-h.Z*level.pixelstretch*sin(pitch);
        double td=ta*cos(pitch)-t.Z*level.pixelstretch*sin(pitch);
        if(hd<=1 || td<=1)return;
        double depth=(hd+td)*.5;
        double right=((h.X*sin(yaw)-h.Y*cos(yaw))/hd-(t.X*sin(yaw)-t.Y*cos(yaw))/td)*depth;
        double up=((h.Z*level.pixelstretch*cos(pitch)+ha*sin(pitch))/hd-(t.Z*level.pixelstretch*cos(pitch)+ta*sin(pitch))/td)*depth;
        double length=sqrt(right*right+up*up);
        if(length<.05)return;
        double target=-atan2(right,up);
        while(target-Roll>180)target-=360;
        while(target-Roll< -180)target+=360;
        Roll=target;
        let sz=TexMan.GetScaledSize(Texture);
        Scale=(width/sz.X,(length+width*.35)/(sz.Y*level.pixelstretch));
        Alpha=opacity*min(1.0,length/width);
    }
}
