// Native pixel glyphs in a stone frame composed from the original STBAR artwork.
class UTNTAbilityHUD ui
{
    static void Icon(int kind,int slot,double x,double y,double s,int color)
    {
        for(int row=0;row<17;row++) for(int col=0;col<17;col++)
        {
            int dx=col-8,dy=row-8;
            bool ink=false;
            if(kind==2 && slot==1) // Three advancing chevrons: Overdrive.
                ink=abs(dy)<6 && (col==4+abs(dy)/2 || col==8+abs(dy)/2 || col==12+abs(dy)/2);
            else if(kind==2) // Riveted shield: Bollwerk.
                ink=(row==2 && col>=3 && col<=13) || (row>=3 && row<=9 && (col==3 || col==13))
                    || (row>=10 && row<=15 && abs(dx)==(15-row)) || (col==8 && row>=5 && row<=11);
            else if(kind==0 && slot==2) // Medical cross: Regeneration.
                ink=(abs(dx)<=2 && abs(dy)<=6) || (abs(dy)<=2 && abs(dx)<=6);
            else if(kind==0) // Split lightning bolt: Rage.
                ink=(row>=1 && row<=8 && col>=8-row/2 && col<=11-row/2)
                    || (row>=8 && row<=15 && col>=12-row/2 && col<=15-row/2);
            else if(slot==1) // Reticle with marked weak point.
                ink=(abs(dx)==6 && abs(dy)<=3) || (abs(dy)==6 && abs(dx)<=3)
                    || (abs(dx)<=1 && abs(dy)<=1) || (dx==0 && abs(dy)>=4) || (dy==0 && abs(dx)>=4);
            else // Slashed eye: Cloak.
                ink=(abs(dx)<=7 && abs(dy)==(7-abs(dx))/2) || (dx==dy && abs(dx)<7);
            if(ink)
            {
                UTNTObjectivePlaque.Rect(x,y,s,col+1,row+1,1,1,0x080604,1);
                UTNTObjectivePlaque.Rect(x,y,s,col,row,1,1,color,1);
            }
        }
    }

    static int SignalColor(int kind,int slot)
    {
        int colors[]={0xb90606,0x91baa0,0x014682,0x999999,0xff8b05,0x93553e};
        return colors[clamp(kind*2+slot-1,0,5)];
    }

    static String Title(int kind,int slot)
    {
        String keys[]={"RAGE","REGEN","WEAK","CLOAK","OVERDRIVE","BULWARK"};
        return UTNTExplorationUI.Local("UTNT_AB_"..keys[kind*2+slot-1]);
    }

    static void Card(UTNTAbilities a,int slot,double x,double y,double s)
    {
        bool active=a.ActiveSlot==slot;
        int remaining=a.Cooldown[slot-1];
        bool locked=a.ActiveSlot!=0 && !active || a.LockRemaining>0;
        bool ready=!active && !remaining && !locked;
        int color=active?SignalColor(a.ClassKind,slot):ready?0xbababa:0x888888;
        // Indexed STBAR stone and bevels follow the same PLAYPAL as the status bar.
        Screen.DrawTexture(TexMan.CheckForTexture('UABFRAME'),true,x,y,
            DTA_DestWidth,int(round(156*s)),DTA_DestHeight,int(round(39*s)),DTA_LeftOffset,0,DTA_TopOffset,0);
        UTNTObjectivePlaque.Rect(x,y,s,6,6,25,26,0x080808,0.72);
        Icon(a.ClassKind,slot,x+10*s,y+10*s,s,color);
        String title=Title(a.ClassKind,slot);
        Font font=Font.GetFont('SmallFont');
        double ts=min(s,112*s/max(1,font.StringWidth(title)));
        UTNTExplorationUI.Text(title,x+37*s,y+6*s,ts,0xc4c4c4);
        String status;
        double progress=1;
        if(active)
        {
            status=String.Format("%s %02d",UTNTExplorationUI.Local("UTNT_AB_ACTIVE"),(a.Remaining+34)/35);
            progress=double(a.Remaining)/UTNTAbilities.DURATION;
        }
        else if(remaining)
        {
            int seconds=(remaining+34)/35;
            status=String.Format("%d:%02d",seconds/60,seconds%60);
            progress=1-double(remaining)/UTNTAbilities.COOLDOWN_TICS;
        }
        else if(locked) { status=UTNTExplorationUI.Local("UTNT_AB_LOCKED"); progress=0; }
        else status=UTNTExplorationUI.Local("UTNT_AB_READY");
        UTNTExplorationUI.Text(status,x+37*s,y+18*s,s,active?color:0xbababa);
        let [k1,k2]=Bindings.GetKeysForCommand(slot==1?"utnt_offense":"utnt_defense");
        String key=k1?KeyBindings.NameKeys(k1,0,false):"--";
        double ks=min(s,36*s/max(1,font.StringWidth(key)));
        UTNTExplorationUI.Text(key,x+148*s-font.StringWidth(key)*ks,y+18*s,ks,0x999999);
        UTNTObjectivePlaque.Rect(x,y,s,37,30,111,1,0x111111,1);
        UTNTObjectivePlaque.Rect(x,y,s,37,31,111,3,0x080808,1);
        UTNTObjectivePlaque.Rect(x,y,s,37,34,111,1,0x555555,1);
        UTNTObjectivePlaque.Rect(x,y,s,38,32,109*clamp(progress,0,1),1,ready?0xb90606:color,1);
    }

    static void Draw(RenderEvent e)
    {
        if(gamestate!=GS_LEVEL || !viewactive || automapactive || menuactive || ConsoleState!=0
            || CVar.FindCVar('screenblocks').GetInt()>=12) return;
        let mo=e.Camera;
        if(!mo || !mo.player || mo.Health<=0 || mo.FindInventory('UTNTHUDHidden')) return;
        let fx=UTNTPlayerEffects(mo.FindBehavior('UTNTPlayerEffects'));
        if(fx && fx.Cutscene || mo.player.cheats & CF_TOTALLYFROZEN) return;
        let world=UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if(world && world.Chapter && world.Chapter.Phase!=3) return;
        let a=UTNTAbilities.Get(mo); if(!a) return;
        double s=UTNTUILayout.AbilityScale();
        double y=UTNTUILayout.AbilityTop();
        double margin=UTNTUILayout.AbilityMargin();
        Card(a,1,margin,y,s);
        Card(a,2,Screen.GetWidth()-margin-156*s,y,s);
    }
}

#include "zscript/UTNT_AbilityEdges.zc"
