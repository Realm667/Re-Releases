// TNT03A2 presentation only. The map retains all collision, tags and scripts.
class UTNTCavernScenery : Actor
{
    Default
    {
        +NOGRAVITY +NOINTERACTION +NOBLOCKMAP +DONTSPLASH
        +DONTTHRUST +NOTONAUTOMAP +CLIENTSIDE
        Radius 1; Height 1;
    }
    States { Spawn: SKED A -1; Stop; }
    override void Tick() {}
}
#include "zscript/cavern-generated.zc"

class UTNTCavernLight : Actor
{
    Default { +CLIENTSIDE +NOINTERACTION +NOBLOCKMAP +NOGRAVITY +DONTTHRUST }
    States { Spawn: TNT1 A -1; Stop; }
}

class UTNTCavernCloud : Actor
{
    int Age, Life;
    double Strength, Phase;
    bool Falling;
    Default
    {
        +NOGRAVITY +NOINTERACTION +NOBLOCKMAP +DONTSPLASH
        +DONTTHRUST +NOTONAUTOMAP +CLIENTSIDE +FORCEXYBILLBOARD
        Radius 1; Height 1; RenderStyle "Translucent"; Alpha 0;
    }
    States { Spawn: DKSM A -1; Stop; }
    override void Tick()
    {
        if(++Age>=Life){Destroy();return;}
        double t=Age/double(Life);
        Alpha=Strength*sin(t*180)*sin(t*180);
        Vector3 next=Pos+(sin(Phase+Age*2)*.12,cos(Phase*.7+Age*1.4)*.10,Falling?-.65:.85);
        let s=level.PointInSector(next.XY);
        if(!s || next.Z<s.floorplane.ZatPoint(next.XY)+12 || next.Z>s.ceilingplane.ZatPoint(next.XY)-12){Destroy();return;}
        SetOrigin(next,true);Scale*=1.004;
    }
}

// VisualThinkers use the renderer's smooth-alpha path even with opaque carriers.
class UTNTCavernHaze : VisualThinker
{
    void Initialize(Vector3 origin, double radius)
    {
        Pos=origin;Prev=Pos;Texture=TexMan.CheckForTexture('UCHZA0');
        Flags=SPF_FULLBRIGHT|SPF_ALLOWSHADERS|SPF_STRETCHPIXELS|SPF_NO_XY_BILLBOARD;
        SetRenderStyle(STYLE_Add);scolor=0xffffffff;Alpha=0;
        Scale=(radius*2/64.,320./128.);UpdateSector();UpdateSpriteInfo();
    }
    override void Tick() {}
}

class UTNTCavernMist : VisualThinker
{
    int Age, Life;
    double Strength, Phase, Base;
    bool OverLava;
    void Initialize(Vector3 origin, bool lava, int salt)
    {
        Pos=origin;Prev=Pos;Texture=TexMan.CheckForTexture('UCVSA0');
        Flags=SPF_FULLBRIGHT|SPF_ALLOWSHADERS|SPF_STRETCHPIXELS|SPF_NO_XY_BILLBOARD;
        SetRenderStyle(STYLE_Translucent);scolor=0xffffffff;Alpha=0;
        OverLava=lava;Life=lava?240:300;Phase=(salt*137)%360;
        Strength=lava?.23:.14;Scale=lava?(4.,1.25):(6.,2.2);
        UpdateSector();UpdateSpriteInfo();
    }
    override void Tick()
    {
        if(IsFrozen())return;
        if(++Age>=Life){Destroy();return;}
        double t=Age/double(Life);Alpha=Strength*sin(t*180)*sin(t*180);
        Vector3 p=Pos+(sin(Phase+Age*.3)*.22,cos(Phase+Age*.4)*.16,OverLava?.6:-.08);
        let s=level.PointInSector(p.XY);
        if(!s || p.Z<s.floorplane.ZatPoint(p.XY)+16 || p.Z>s.ceilingplane.ZatPoint(p.XY)-48){Destroy();return;}
        for(int i=0;i<s.Get3DFloorCount();i++)
        {
            let f=s.Get3DFloor(i);
            if((f.flags&F3DFloor.FF_EXISTS) && (f.flags&F3DFloor.FF_SOLID)
                && p.Z>=f.bottom.ZatPoint(p.XY) && p.Z<=f.top.ZatPoint(p.XY)){Destroy();return;}
        }
        Prev=Pos;Pos=p;UpdateSector();
    }
}

#include "zscript/UTNT_CavernAtmosphere.zc"

class UTNTCavernController : Thinker
{
    bool Ready;
    int Emissions;
    Array<UTNTCavernScenery> Scenery;
    Array<UTNTCavernLight> Lamps;
    Array<UTNTCavernHaze> Haze;
    void Install()
    {
        Ready=true;
        level.CreateClientSideThinker('UTNTCavernAtmosphere',Thinker.STAT_USER+29);
        int lump=Wads.CheckNumForFullName("cavern/scenery.txt");if(lump<0)return;
        Array<String> rows;Wads.ReadLump(lump).Split(rows,"\n",TOK_SKIPEMPTY);
        for(int i=0;i<rows.Size();i++)
        {
            Array<String> r;rows[i].Split(r,"|",TOK_KEEPEMPTY);if(r.Size()!=6)continue;
            Vector3 p=(r[1].ToDouble(),r[2].ToDouble(),r[3].ToDouble());
            let sec=level.PointInSector(p.XY);if(!sec || sec.Index()!=r[4].ToInt())continue;
            Class<Actor> cls=r[0];if(!cls)continue;
            let a=UTNTCavernScenery(Actor.Spawn(cls,p));if(!a)continue;
            a.Angle=0;Scenery.Push(a);
        }
        for(int i=0;i<3;i++)
        {
            let l=UTNTCavernLight(Actor.Spawn('UTNTCavernLight',(5375,-4040,-340-i*470)));
            if(!l)continue;
            l.A_AttachLight('cavern',DynamicLight.PointLight,0xff7628,320,0,DynamicLight.LF_ATTENUATE);
            Lamps.Push(l);
        }
        lump=Wads.CheckNumForFullName("cavern/haze.txt");if(lump<0)return;
        rows.Clear();Wads.ReadLump(lump).Split(rows,"\n",TOK_SKIPEMPTY);
        for(int i=0;i<rows.Size();i++)
        {
            Array<String> r;rows[i].Split(r,"|",TOK_KEEPEMPTY);if(r.Size()!=5)continue;
            Vector3 p=(r[0].ToDouble(),r[1].ToDouble(),r[2].ToDouble());
            let sec=level.PointInSector(p.XY);
            if(!sec || sec.Index()!=r[4].ToInt() || abs(sec.floorplane.ZatPoint(p.XY)-(p.Z-2))>.1)continue;
            let h=UTNTCavernHaze(level.SpawnClientSideVisualThinker('UTNTCavernHaze'));if(!h)continue;
            h.Initialize(p,r[3].ToDouble());Haze.Push(h);
        }
    }
    void Mist(UTNTCavernHaze h, bool lava, int salt)
    {
        Vector3 p=h.Pos+(0,0,lava?80:850+(salt%3)*180);
        let s=level.PointInSector(p.XY);if(!s || p.Z>s.ceilingplane.ZatPoint(p.XY)-160)return;
        let a=UTNTCavernMist(level.SpawnClientSideVisualThinker('UTNTCavernMist'));if(!a)return;
        a.Initialize(p,lava,salt);a.Base=h.Pos.Z;
    }
    void Cloud(Vector3 source, bool falling, int salt)
    {
        double phase=(Emissions*137+salt*73)%360;
        Vector3 p=source+(sin(phase)*22,cos(phase*1.7)*18,0);
        let a=UTNTCavernCloud(Actor.Spawn('UTNTCavernCloud',p));if(!a)return;
        a.Life=falling?110:180;a.Falling=falling;a.Phase=phase;
        a.Strength=falling?.10:.16;a.Scale=falling?(.55,.7):(1.35,1.65);
    }
    override void Tick()
    {
        if(!Ready)Install();
        let runtime=UTNTFXRuntime.Get();let camera=runtime.Camera;
        if(level.time%4==0)for(int i=0;i<Haze.Size();i++)
        {
            let h=Haze[i];if(!h)continue;
            double distance=camera?(camera.Pos-h.Pos).Length():1e9;
            double target=runtime.Quality>0?.34*clamp((3200-distance)/650.,0.,1.):0;
            h.Alpha+=(target-h.Alpha)*.25;
        }
        if(level.isFrozen() || level.time%10!=0)return;
        if(!camera || runtime.Quality<=0)return;
        Emissions++;
        if((camera.Pos-(5400,-4040,-1250)).Length()<2600)Cloud((5400,-4040,-1370),false,0);
        if(Emissions%3==0 && (camera.Pos-(5160,-3790,250)).Length()<1800)Cloud((5160,-3790,300),true,1);
        if(Emissions%4==0 && (camera.Pos-(4590,-6340,230)).Length()<1800)Cloud((4590,-6340,240),true,2);
        if(Emissions%3==0 && Haze.Size()>0)
        {
            // Fixed scan/step avoids touching gameplay RNG and bounds emission.
            int start=(Emissions*17)%Haze.Size(),made=0;
            UTNTCavernHaze nearDust;
            for(int j=0;j<Haze.Size() && made<2;j++)
            {
                let h=Haze[(start+j)%Haze.Size()];if(!h || (h.Pos-camera.Pos).Length()>2200)continue;
                if(!nearDust)nearDust=h;
                Mist(h,true,Emissions+j);made++;
            }
            if(runtime.Quality>=2 && nearDust)Mist(nearDust,false,Emissions);
        }
    }
}

class UTNTCavern : EventHandler
{
    transient UTNTCavernController Controller;
    int Applied, Rejected;
    bool PlatformsApplied;
    bool RefreshPending;
    void ApplyLighting()
    {
        int lump=Wads.CheckNumForFullName("cavern/sectors.txt");if(lump<0)return;
        Array<String> rows;Wads.ReadLump(lump).Split(rows,"\n",TOK_SKIPEMPTY);
        for(int i=0;i<rows.Size();i++)
        {
            rows[i].StripRight();
            Array<String> r;rows[i].Split(r,"|",TOK_KEEPEMPTY);if(r.Size()!=8){Rejected++;continue;}
            int index=r[0].ToInt();if(index<0 || index>=level.Sectors.Size()){Rejected++;continue;}
            int lineIndex=r[1].ToInt(),face=r[2].ToInt();
            if(lineIndex<0 || lineIndex>=level.Lines.Size() || face<0 || face>1){Rejected++;continue;}
            let s=level.Sectors[index];let line=level.Lines[lineIndex];let side=line.sidedef[face];
            Vector2 a=(r[3].ToDouble(),r[4].ToDouble()),b=(r[5].ToDouble(),r[6].ToDouble());
            let v1=face==0?line.v1:line.v2;let v2=face==0?line.v2:line.v1;
            // Boundary identity also works for thin/merged BSP subsectors and
            // after AreaTextures has replaced the authored material names.
            if(!side || side.sector!=s || (v1.p-a).Length()>.01 || (v2.p-b).Length()>.01){Rejected++;continue;}
            // Save/hub state already contains these properties; do not accumulate
            // relative offsets or overwrite later authored gameplay lighting.
            if(s.ColorMap.FadeColor!=0x62411d)continue;
            if(s.LightLevel==150 || s.LightLevel==134)
            {
                s.SetLightLevel(s.LightLevel-6);
                s.SetPlaneLight(Sector.floor,32);s.SetPlaneLight(Sector.ceiling,-16);
            }
            // SetFade rebuilds cached 3D-floor light lists; density must be set
            // first so those lists receive the explicit density too.
            s.SetFogDensity(22);s.SetFade(0x363029);
            Applied++;
        }
        if(PlatformsApplied)return;
        lump=Wads.CheckNumForFullName("cavern/platforms.txt");if(lump<0)return;
        rows.Clear();Wads.ReadLump(lump).Split(rows,"\n",TOK_SKIPEMPTY);
        for(int i=0;i<rows.Size();i++)
        {
            Array<String> r;rows[i].Split(r,"|",TOK_KEEPEMPTY);if(r.Size()!=3){Rejected++;continue;}
            int si=r[0].ToInt(),li=r[1].ToInt();
            if(si<0 || si>=level.Sectors.Size() || li<0 || li>=level.Lines.Size()){Rejected++;continue;}
            let line=level.Lines[li];let s=level.Sectors[si];
            if(!line.sidedef[0] || line.sidedef[0].sector!=s){Rejected++;continue;}
            // The 3D platform top is its control sector's ceiling plane.
            // Brighten that face only; keep movers and light below unchanged.
            s.SetPlaneLight(Sector.ceiling,36);
        }
        PlatformsApplied=true;
    }
    override void WorldLoaded(WorldEvent e)
    {
        Controller=null;
        if(!(level.MapName~=="TNT03A2"))return;
        for(int pool=0;pool<2;pool++)
        {
            let it=ThinkerIterator.Create('UTNTCavernScenery',Thinker.MAX_STATNUM+1,pool!=0);
            Thinker a;while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernLight',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernCloud',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernHaze',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernMist',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernAir',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernFall',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernAtmosphere',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
            it=ThinkerIterator.Create('UTNTCavernController',Thinker.MAX_STATNUM+1,pool!=0);while(a=it.Next())a.Destroy();
        }
        ApplyLighting();
        RefreshPending=true;
    }
    override void WorldTick()
    {
        if(RefreshPending && level.time>=6)
        {
            RefreshPending=false;
            // Finish after OPEN/map setup and rebuild attached 3D-floor lists.
            for(int i=0;i<level.Sectors.Size();i++)
            {
                let s=level.Sectors[i];
                if((int(s.ColorMap.FadeColor)&0xffffff)==0x363029)s.SetFade(s.ColorMap.FadeColor);
            }
        }
        if(level.MapName~=="TNT03A2" && !Controller && level.time>=6 && consoleplayer>=0)
            Controller=UTNTCavernController(level.CreateClientSideThinker('UTNTCavernController',Thinker.STAT_USER+29));
    }
}
