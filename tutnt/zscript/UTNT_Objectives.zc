// UTNT mission plaque. Artwork is text-free; every visible word is localized.
// Coordinates below describe a 520-unit panel; only the middle artwork stretches.
class UTNTObjectivePlaque ui
{
    static int Count(int episode)
    {
        return episode==2 || episode==3 || episode==5 ? 3 : 2;
    }

    static String Text(int episode, int row, bool title)
    {
        return StringTable.Localize(String.Format("$UTNT_OBJ_%d_%d_%s",
            episode,row,title ? "TITLE" : "TEXT"));
    }

    static void Rect(double x,double y,double scale,double left,double top,
        double width,double height,Color color,double alpha)
    {
        int x1=int(x+left*scale), y1=int(y+top*scale);
        Screen.Dim(color,alpha,x1,y1,max(1,int(x+(left+width)*scale)-x1),
            max(1,int(y+(top+height)*scale)-y1));
    }

    // Drawing clips provide true transparency without rebuilding the bitmap
    // for each sliced cap. The original art is decoded/uploaded once per cap.
    static void ClipArt(String name,double x,double y,double width,double height,
        double sx,double sy,double sw,double sh,double sourceHeight,double alpha)
    {
        Screen.DrawTexture(TexMan.CheckForTexture(name),true,x,y,
            DTA_DestWidthF,width,DTA_DestHeightF,height,
            DTA_LeftOffset,0,DTA_TopOffset,0,DTA_Alpha,alpha,
            DTA_ClipLeft,int(x+sx*width/1672),DTA_ClipRight,int(x+(sx+sw)*width/1672),
            DTA_ClipTop,int(y+sy*height/sourceHeight),DTA_ClipBottom,int(y+(sy+sh)*height/sourceHeight));
    }

    static void Art(String name,double x,double y,double width,double height,double alpha)
    {
        if (name=="UTOTOP")
        {
            ClipArt(name,x,y,width,height,8,18,1656,175,193,alpha);
            ClipArt(name,x,y,width,height,757,4,157,1,193,alpha);
            ClipArt(name,x,y,width,height,756,5,159,4,193,alpha);
            ClipArt(name,x,y,width,height,757,9,158,1,193,alpha);
            ClipArt(name,x,y,width,height,763,10,151,1,193,alpha);
            ClipArt(name,x,y,width,height,762,11,146,1,193,alpha);
            ClipArt(name,x,y,width,height,762,12,147,1,193,alpha);
            ClipArt(name,x,y,width,height,755,13,162,1,193,alpha);
            ClipArt(name,x,y,width,height,754,14,163,2,193,alpha);
            ClipArt(name,x,y,width,height,30,15,29,1,193,alpha);
            ClipArt(name,x,y,width,height,1613,15,31,1,193,alpha);
            ClipArt(name,x,y,width,height,30,16,30,1,193,alpha);
            ClipArt(name,x,y,width,height,754,16,161,2,193,alpha);
            ClipArt(name,x,y,width,height,1616,16,28,1,193,alpha);
            ClipArt(name,x,y,width,height,15,17,44,1,193,alpha);
            ClipArt(name,x,y,width,height,1608,17,52,1,193,alpha);
        }
        else if (name=="UTOMID") ClipArt(name,x,y,width,height,8,0,1656,697,697,alpha);
        else ClipArt(name,x,y,width,height,8,0,1656,40,51,alpha);
    }

    static void DrawArtwork(double x,double y,double scale,double height,double alpha)
    {
        // Round shared edges once, then derive each destination size from them.
        // Fractional quad edges and integer clipping otherwise disagree by a
        // pixel. No overlap: the seven-tic fades must blend each pixel once.
        int left=int(round(x)), right=int(round(x+520*scale));
        int top=int(round(y)), upperJoin=int(round(y+60*scale));
        int lowerJoin=int(round(y+(height-16)*scale)), bottom=int(round(y+height*scale));
        Art("UTOTOP",left,top,right-left,upperJoin-top,alpha);
        Art("UTOMID",left,upperJoin,right-left,lowerJoin-upperJoin,alpha);
        Art("UTOBOT",left,lowerJoin,right-left,bottom-lowerJoin,alpha);
    }

    static void Lettering(Font font,String text,double x,double y,double size,
        Color color,double alpha)
    {
        // A one-pixel dark relief separates lettering from the mottled metal.
        Screen.DrawText(font,Font.CR_WHITE,x+size,y+size,text,
            DTA_ScaleX,size,DTA_ScaleY,size,DTA_Color,0xff090705,DTA_Alpha,alpha*0.85);
        Screen.DrawText(font,Font.CR_WHITE,x,y,text,
            DTA_ScaleX,size,DTA_ScaleY,size,DTA_Color,color,DTA_Alpha,alpha);
    }

    static void Badge(int number,double x,double y,double scale,double alpha)
    {
        Rect(x,y,scale,0,0,44,44,0x080705,alpha);
        Rect(x,y,scale,1,1,42,42,0x59452a,alpha);
        Rect(x,y,scale,3,3,38,38,0x17130d,alpha);
        Rect(x,y,scale,4,4,36,1,0x8d7041,alpha);
        Rect(x,y,scale,4,5,1,34,0x6e5735,alpha);
        Rect(x,y,scale,5,39,35,1,0x090806,alpha);
        for (int row=0;row<2;row++)
            for (int col=0;col<2;col++)
            {
                Rect(x,y,scale,2+col*37,2+row*37,3,3,0x0b0906,alpha);
                Rect(x,y,scale,2+col*37,2+row*37,2,1,0xa88a54,alpha);
            }
        Font font=Font.GetFont('DBIGFONT');
        String digits=String.Format("%02d",number);
        double size=min(24.0/font.GetHeight(),32.0/font.StringWidth(digits))*scale;
        Lettering(font,digits,x+(44*scale-font.StringWidth(digits)*size)/2,
            y+(44*scale-font.GetHeight()*size)/2,size,0xffd8c292,alpha);
    }

    // Available for manual reading even before the map's automatic briefing.
    static int CurrentEpisode()
    {
        if (level.MapName ~== "TNT01") return 1;
        if (level.MapName ~== "TNT02") return 2;
        if (level.MapName ~== "TNT03A1" || level.MapName ~== "TNT03A2") return 3;
        if (level.MapName ~== "TNT03B") return 4;
        if (level.MapName ~== "TNT04A") return 5;
        if (level.MapName ~== "TNT04B") return 6;
        if (level.MapName ~== "TNT04CN") return 7;
        if (level.MapName ~== "TNT04C") return 8;
        if (level.MapName ~== "TNTLE") return 9;
        return 0;
    }

    static double DrawCompact(int episode,int startTime,int endTime,double fracTic)
    {
        // Clamp old savegame timers too: the automatic overview lasts four seconds.
        endTime=min(endTime,startTime+140);
        if (episode<1 || episode>9 || level.time>=endTime) return 0;
        double now=level.time+fracTic;
        double alpha=clamp(min((now-startTime+1)/10.0,(endTime-now)/14.0),0,1);
        Font font=AlternativeSmallFont;
        double scale=UTNTUILayout.Scale(),width=UTNTUILayout.Width(300),padding=9;
        Array<BrokenLines> rows; double height=padding*2;
        for(int row=0;row<Count(episode);row++)
        {
            let lines=font.BreakLines(Text(episode,row+1,true),int(width-40));
            rows.Push(lines); height+=lines.Count()*(font.GetHeight()+3)+7;
        }
        // Inter-line and inter-objective spacing belongs only between rows.
        height-=3+7;
        double x=UTNTUILayout.Margin(), y=UTNTUILayout.CornerTop(width*scale);
        Rect(x,y,scale,0,0,width,height,0x090806,alpha*0.74);
        Rect(x,y,scale,0,0,width,1,0x80613a,alpha);
        Rect(x,y,scale,0,height-1,width,1,0x443721,alpha);
        double rowY=padding;
        for(int row=0;row<Count(episode);row++)
        {
            Lettering(font,String.Format("%02d",row+1),x+padding*scale,y+rowY*scale,scale,0xffc49351,alpha);
            for(int line=0;line<rows[row].Count();line++)
                Lettering(font,rows[row].StringAt(line),x+30*scale,y+(rowY+line*(font.GetHeight()+3))*scale,scale,0xffe2d2af,alpha);
            rowY+=rows[row].Count()*(font.GetHeight()+3)+7;
        }
        return y+height*scale;
    }

    static int Progress(int episode)
    {
        let h=UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        return h && episode>=1 && episode<=9 ? h.ObjectiveFlags[episode] : 0;
    }

    static int CompletedCount(int mask)
    {
        return (mask&1)+((mask>>1)&1)+((mask>>2)&1);
    }

    // Engraved brass seal shared by the toast and the completed objective row.
    static void Seal(double cx,double cy,double scale,double alpha,double glint=0)
    {
        for(int row=-10;row<=10;row++)
        {
            double half=sqrt(100.0-row*row);
            Rect(cx,cy,scale,-half,row,half*2,1,0x181005,alpha);
        }
        for(int i=0;i<32;i++)
        {
            double a=i*360.0/32,b=(i+1)*360.0/32;
            for(int r=8;r<=10;r++)
                Screen.DrawLine(cx+cos(a)*r*scale,cy+sin(a)*r*scale,
                    cx+cos(b)*r*scale,cy+sin(b)*r*scale,r==9?0xb8812d:0x694715,int(alpha*255));
            if(i%4==0) Rect(cx,cy,scale,cos(a)*11-1,sin(a)*11-1,2,2,0xc18b38,alpha);
        }
        for(int j=0;j<2;j++)
        {
            Screen.DrawLine(cx-5*scale,cy+j*scale,cx-1*scale,cy+(4+j)*scale,0xe1b04d,int(alpha*255));
            Screen.DrawLine(cx-1*scale,cy+(4+j)*scale,cx+6*scale,cy+(-5+j)*scale,0xe1b04d,int(alpha*255));
        }
        if(glint>0)
        {
            Rect(cx,cy,scale,7,6,7,1,0xffdf87,alpha*glint);
            Rect(cx,cy,scale,10,3,1,7,0xffdf87,alpha*glint);
        }
    }

    static void Tile(String name,int left,int top,int right,int bottom,double alpha,bool flipX=false,bool flipY=false)
    {
        Screen.DrawTexture(TexMan.CheckForTexture(name),true,left,top,
            DTA_DestWidth,right-left,DTA_DestHeight,bottom-top,DTA_LeftOffset,0,DTA_TopOffset,0,
            DTA_FlipX,flipX,DTA_FlipY,flipY,DTA_Alpha,alpha);
    }

    static void CompletionFrame(double x,double y,double scale,double width,double height,double alpha)
    {
        int l=int(round(x)),r=int(round(x+width*scale));
        int t=int(round(y)),b=int(round(y+height*scale));
        int il=int(round(x+8*scale)),ir=int(round(x+(width-8)*scale));
        int it=int(round(y+8*scale)),ib=int(round(y+(height-8)*scale));
        Rect(x,y,scale,1,3,width,height,0x000000,alpha*0.14);
        // Nine disjoint rectangles avoid seams and double alpha at the borders.
        Tile("UTOCBG",il,it,ir,ib,alpha);
        Tile("UTOEDGE",il,t,ir,it,alpha,false,true);
        Tile("UTOEDGE",il,ib,ir,b,alpha);
        Tile("UTOSIDE",l,it,il,ib,alpha);
        Tile("UTOSIDE",ir,it,r,ib,alpha,true);
        Tile("UTOCOR",l,t,il,it,alpha,false,true);
        Tile("UTOCOR",ir,t,r,it,alpha,true,true);
        Tile("UTOCOR",l,ib,il,b,alpha);
        Tile("UTOCOR",ir,ib,r,b,alpha,true);
        Rect(x,y,scale,18,6,width-36,1,0xbc4c11,alpha*0.85);
    }

    static double DrawCompletion(int code,int startTime,int endTime,double frac,bool reduced)
    {
        int episode=code>>8,row=code&15,mask=(code>>4)&7;
        if(episode<1 || episode>9 || row<1 || row>Count(episode)) return 0;
        double now=level.time+frac;
        double alpha=clamp(min((now-startTime)/7.0,(endTime-now)/7.0),0,1);
        if(alpha<=0) return 0;
        double scale=UTNTUILayout.Scale(),width=UTNTUILayout.Width(300);
        double x=UTNTUILayout.Margin(),y=UTNTUILayout.CornerTop(width*scale);
        Font font=AlternativeSmallFont;
        String heading=StringTable.Localize(CompletedCount(mask)==Count(episode) ? "$UTNT_OBJ_ALL_DONE" : "$UTNT_OBJ_DONE_HEADING");
        String consequence=episode==5 && row==2 ? StringTable.Localize("$UTNT_OBJ_PILLARS") : "";
        let headings=font.BreakLines(heading,int(width-92));
        let titles=font.BreakLines(Text(episode,row,true),int(width-92));
        let consequences=font.BreakLines(consequence,int(width-92));
        double lineHeight=font.GetHeight()+4;
        double height=max(80,36+(headings.Count()+titles.Count()+consequences.Count())*lineHeight);
        CompletionFrame(x,y,scale,width,height,alpha);
        Badge(row,x+20*scale,y+19*scale,scale*0.85,alpha);
        double age=now-startTime-7;
        double glint=reduced ? 0 : clamp(1-abs(age-5)/5,0,1);
        Seal(x+20*scale,y+55*scale,scale*0.85,alpha,glint);
        double cursor=20;
        for(int i=0;i<headings.Count();i++)
        { Lettering(font,headings.StringAt(i),x+72*scale,y+cursor*scale,scale,0xffc99942,alpha);cursor+=lineHeight; }
        cursor+=5;
        for(int i=0;i<titles.Count();i++)
        { Lettering(font,titles.StringAt(i),x+72*scale,y+cursor*scale,scale,0xffe2d2af,alpha);cursor+=lineHeight; }
        if(consequence.Length()) for(int i=0;i<consequences.Count();i++)
        { Lettering(font,consequences.StringAt(i),x+72*scale,y+cursor*scale,scale,0xffc6b996,alpha);cursor+=lineHeight; }
        return y+height*scale;
    }

    // At small viewports or alongside subtitles, trade ornament space for readable type.
    static void DrawReadable(int episode,double alpha,double bottom)
    {
        Font font=AlternativeSmallFont;
        double s=UTNTUILayout.Scale();
        double width=UTNTUILayout.Width(500),lineHeight=font.GetHeight()+3;
        Array<String> rows;Array<int> shades;
        let episodeLines=font.BreakLines(StringTable.Localize(String.Format("$UTNT_INTRO_%03d",episode)),int(width-28));
        for(int i=0;i<episodeLines.Count();i++) {rows.Push(episodeLines.StringAt(i));shades.Push(0xcbb995);}
        rows.Push(StringTable.Localize("$UTNT_OBJ_HEADING"));shades.Push(0xc9954b);
        int mask=Progress(episode);
        for(int i=1;i<=Count(episode);i++)
        {
            rows.Push("");shades.Push(0);
            let title=font.BreakLines(String.Format("%02d  ",i)..Text(episode,i,true),int(width-28));
            for(int j=0;j<title.Count();j++) {rows.Push(title.StringAt(j));shades.Push(0xc9954b);}
            let body=font.BreakLines(Text(episode,i,false),int(width-28));
            for(int j=0;j<body.Count();j++) {rows.Push(body.StringAt(j));shades.Push(0xdfd0ae);}
            if(mask&(1<<(i-1))) {rows.Push(StringTable.Localize("$UTNT_OBJ_DONE"));shades.Push(0xc99942);}
        }
        rows.Push("");shades.Push(0);
        let footer=font.BreakLines(String.Format("%d / %d  %s",CompletedCount(mask),Count(episode),StringTable.Localize("$UTNT_OBJ_PROGRESS")),int(width-28));
        for(int i=0;i<footer.Count();i++) {rows.Push(footer.StringAt(i));shades.Push(0xcbb995);}
        double height=24+rows.Size()*lineHeight;
        // Native pixel text is the lower bound, never compressed below one pixel.
        s=max(1,min(s,(bottom-UTNTUILayout.Top())/height));
        double x=(Screen.GetWidth()-width*s)/2;
        double y=max(UTNTUILayout.Top(),(bottom+UTNTUILayout.Top()-height*s)/2);
        UTNTExplorationUI.Frame(x,y,width,height,s,alpha);
        for(int i=0;i<rows.Size();i++)
            UTNTExplorationUI.Text(rows[i],x+14*s,y+(12+i*lineHeight)*s,s,shades[i],alpha);
    }

    static void Draw(int episode,double alpha=1,double bottomLimit=-1)
    {
        if (episode<1 || episode>9 || alpha<=0) return;
        alpha=clamp(alpha,0,1);
        Font small=AlternativeSmallFont, big=Font.GetFont('DBIGFONT');
        String heading=StringTable.Localize('$UTNT_OBJ_HEADING');
        String episodeName=StringTable.Localize(String.Format("$UTNT_INTRO_%03d",episode));
        int count=Count(episode),mask=Progress(episode);
        Array<BrokenLines> descriptions;
        Array<double> rowHeights;
        double textSize=1.6;
        double lineHeight=(small.GetHeight()+3)*textSize;
        double height=170;
        for (int i=0;i<count;i++)
        {
            let lines=small.BreakLines(Text(episode,i+1,false),int(390/textSize));
            descriptions.Push(lines);
            double rowHeight=max(94,30+lines.Count()*lineHeight+35);
            rowHeights.Push(rowHeight);
            height+=rowHeight;
        }
        double scale=max(1.0/textSize,UTNTUILayout.Scale()*0.8);
        double bottom=bottomLimit<0 ? UTNTUILayout.Bottom() : bottomLimit;
        scale=min(scale,min((Screen.GetWidth()-2*UTNTUILayout.Margin())/520,(bottom-UTNTUILayout.Top())/height));
        if(textSize*scale<1) { DrawReadable(episode,alpha,bottom);return; }
        double x=floor((Screen.GetWidth()-520*scale)/2);
        double y=floor(clamp(Screen.GetHeight()*0.48-height*scale/2,UTNTUILayout.Top(),bottom-height*scale));
        // Two translucent silhouette expansions make a real soft outside shadow.
        // They sit behind the opaque metal, never replace dark interior pixels.
        Rect(x,y,scale,0,4,520,height-6,0x000000,alpha*0.10);
        Rect(x,y,scale,1,5,518,height-8,0x000000,alpha*0.16);
        // Fixed cap proportions keep the emblem, rivets and bevels undistorted.
        DrawArtwork(x,y,scale,height,alpha);

        double eyebrow=min(1.6,450.0/max(1,small.StringWidth(episodeName)))*scale;
        Lettering(small,episodeName,x+(520*scale-small.StringWidth(episodeName)*eyebrow)/2,
            y+43*scale,eyebrow,0xffcebc98,alpha);
        double titleSize=min(40.0/big.GetHeight(),360.0/max(1,big.StringWidth(heading)))*scale;
        Lettering(big,heading,x+(520*scale-big.StringWidth(heading)*titleSize)/2,
            y+64*scale,titleSize,0xffef7628,alpha);
        Rect(x,y,scale,38,103,444,1,0x98713f,alpha);
        Rect(x,y,scale,38,104,444,1,0x24180e,alpha);

        double rowY=124;
        for (int i=0;i<count;i++)
        {
            bool done=(mask & (1<<i))!=0;
            Badge(i+1,x+38*scale,y+rowY*scale,scale,alpha);
            String label=Text(episode,i+1,true);
            double labelSize=min(21.0/big.GetHeight(),390.0/max(1,big.StringWidth(label)))*scale;
            Lettering(big,label,x+94*scale,y+rowY*scale,labelSize,done ? 0xffbaaf96 : 0xffe2d2af,alpha);
            for (int line=0;line<descriptions[i].Count();line++)
                Lettering(small,descriptions[i].StringAt(line),x+94*scale,
                    y+(rowY+30+line*lineHeight)*scale,textSize*scale,done ? 0xffb5a98f : 0xffdfd0ae,alpha);
            if(done)
            {
                Seal(x+38*scale,y+(rowY+44)*scale,scale,alpha);
                Lettering(small,StringTable.Localize("$UTNT_OBJ_DONE"),x+94*scale,
                    y+(rowY+30+descriptions[i].Count()*lineHeight+2)*scale,1.15*scale,0xffc99942,alpha);
            }
            rowY+=rowHeights[i];
            if (i<count-1)
                Rect(x,y,scale,38,rowY-13,444,0.7,0x64573c,alpha*0.65);
        }
        Rect(x,y,scale,38,height-42,444,1,0x64573c,alpha*0.8);
        String footer=String.Format("%d / %d  %s",CompletedCount(mask),count,StringTable.Localize("$UTNT_OBJ_PROGRESS"));
        double fs=min(1.3,444.0/max(1,small.StringWidth(footer)))*scale;
        Lettering(small,footer,x+(520*scale-small.StringWidth(footer)*fs)/2,y+(height-30)*scale,fs,0xffc9b175,alpha);
    }
}
