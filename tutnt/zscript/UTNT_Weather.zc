// Weather markers retain their editor numbers/TIDs. Particle thinkers remain
// client-local; saved visor/cycle state never consumes gameplay random numbers.
class UTNTWeatherAnchor : Actor
{
    virtual int WeatherKind() { return 1; }
    Default { Radius 1; Height 1; +NOINTERACTION +NOGRAVITY +SPAWNCEILING }
    States { Spawn: TNT1 A -1; Stop; }
}
class UTNTRainAnchor : UTNTWeatherAnchor {}
class UTNTSnowAnchor : UTNTWeatherAnchor { override int WeatherKind() { return 2; } }

class UTNTWeatherCell : Object
{
    Vector2 Center;
    int Kind;
    double Height;
    int Live, Target;
}

class UTNTWeatherSystem play
{
    static UTNTWeatherController Find()
    {
        let it=ThinkerIterator.Create('UTNTWeatherController',Thinker.STAT_USER+4,true);
        return UTNTWeatherController(it.Next());
    }
    static void Ensure()
    {
        if (consoleplayer<0 || !players[consoleplayer].camera) return;
        if (Find()) return;
        let c=UTNTWeatherController(level.CreateClientSideThinker('UTNTWeatherController',Thinker.STAT_USER+4));
        if (c) c.Initialize();
    }
}

// This map-local EventHandler is serialized. Its clock advances on all peers,
// independently of local quality/weather visibility, without consuming RNG.
class UTNTWeatherHandler : EventHandler
{
    Array<int> FogSectors, OriginalDensity, AppliedDensity;
    bool FogEnabled;
    int WeatherTics, CycleNumber;
    Array<UTNTVisorState> Visors;
    override void RenderOverlay(RenderEvent e)
    {
        UTNTVisorRenderer.Draw(e,consoleplayer>=0 && consoleplayer<Visors.Size() ? Visors[consoleplayer] : null);
    }
    override void WorldUnloaded(WorldEvent e)
    {
        if(consoleplayer>=0)
        {
            Shader.SetEnabled(players[consoleplayer],"utnt_visor",false);
            Shader.SetEnabled(players[consoleplayer],"utnt_visor_detail",false);
        }
    }

    static double Ease(double x) { x=clamp(x,0,1); return x*x*(3-2*x); }
    static double Strength(int ticks)
    {
        double seconds=(ticks%10500)/35.0;
        return seconds<105 ? 0.5*Ease((seconds-45)/60) :
            seconds<165 ? 0.5+0.5*Ease((seconds-105)/60) :
            seconds<225 ? 1 : 1-Ease((seconds-225)/65);
    }
    override void WorldTick()
    {
        if(!level.isFrozen())
        {
            WeatherTics++;
            if(WeatherTics>=10500) { WeatherTics=0; CycleNumber++; }
        }
        UTNTWeatherSystem.Ensure();
        let weather=UTNTWeatherSystem.Find();
        if(Visors.Size()!=MAXPLAYERS) Visors.Resize(MAXPLAYERS);
        for(int p=0;p<MAXPLAYERS;p++)
        {
            if(!playeringame[p]) { Visors[p]=null; continue; }
            if(!Visors[p]) Visors[p]=new('UTNTVisorState');
            Visors[p].TickPlayer(p,weather,Strength(WeatherTics));
        }
        bool enabled=CVar.GetCVar('weatherfx').GetBool()
            && (level.MapName~=="TNT03A1" || level.MapName~=="TNT03A2");
        if(level.time<3) return;
        if(enabled && !FogEnabled)
        {
            for(int i=0;i<level.Sectors.Size();i++)
            {
                let sec=level.Sectors[i]; Color f=sec.ColorMap.FadeColor;
                if(f==0 || f.r!=f.g || f.g!=f.b || sec.ColorMap.FogDensity!=0) continue;
                FogSectors.Push(i); OriginalDensity.Push(sec.ColorMap.FogDensity);
                AppliedDensity.Push(32); sec.SetFogDensity(32);
            }
        }
        if(!enabled && FogEnabled)
        {
            for(int i=0;i<FogSectors.Size();i++)
            {
                let sec=level.Sectors[FogSectors[i]];
                int last=i<AppliedDensity.Size() ? AppliedDensity[i] : 32;
                if(sec.ColorMap.FogDensity==last) sec.SetFogDensity(OriginalDensity[i]);
            }
            FogSectors.Clear(); OriginalDensity.Clear(); AppliedDensity.Clear();
        }
        FogEnabled=enabled;
        if(enabled && level.time%8==0)
        {
            double strength=Strength(WeatherTics);
            int density=32+int(strength*10+Ease((strength-0.5)*2)*12);
            for(int i=0;i<FogSectors.Size();i++)
            {
                let sec=level.Sectors[FogSectors[i]];
                // Older saves have no AppliedDensity array. Preserve other owners.
                if(i>=AppliedDensity.Size()) AppliedDensity.Push(32);
                if(sec.ColorMap.FogDensity==AppliedDensity[i])
                { sec.SetFogDensity(density); AppliedDensity[i]=density; }
            }
        }
    }
}

class UTNTWeatherController : Thinker
{
    Array<UTNTWeatherCell> Cells;
    Array<int> Nearby;
    LineTracer Probe;
    Actor Camera, SkyCamera;
    Array<Actor> SkyCameras;
    int SkyCursor;
    int SkyLive, ActiveKind, TrailLive;
    int Live, DetailLive, Quality, Limit, ParticleLimit, DetailLimit, TraceBudget;
    int Traces, PeakTraces, PeakLive, BudgetRetired;
    int SpawnedRain, SpawnedSnow, Impacts, RejectedRoof, RejectedWall;
    bool Enabled;
    uint Seed;
    double Range, SpawnRange, WindX, WindY, Gust, Exposure;
    Vector2 Ahead, LastScan;
    int Warmup, VeilLive, PeakVeils, VeilLimit, TrailLimit;
    double Intensity, StormBoost;
    void Cycle()
    {
        let climate=UTNTWeatherHandler(EventHandler.Find('UTNTWeatherHandler'));
        Intensity=climate ? UTNTWeatherHandler.Strength(climate.WeatherTics) : 0;
        StormBoost=UTNTWeatherHandler.Ease((Intensity-0.5)*2);
    }

    void Initialize()
    {
        Seed=0x66701+uint(consoleplayer+1)*7919;
        Probe=new('LineTracer');
        let skies=ThinkerIterator.Create('SkyViewpoint'); Actor sky;
        while(sky=Actor(skies.Next()))
        {
            SkyCameras.Push(sky);
            if(!SkyCamera || sky.tid==0) SkyCamera=sky;
        }
        let it=ThinkerIterator.Create('UTNTWeatherAnchor'); UTNTWeatherAnchor a;
        while (a=UTNTWeatherAnchor(it.Next()))
        {
            Vector2 center=(floor(a.Pos.X/128)*128+64,floor(a.Pos.Y/128)*128+64);
            int kind=a.WeatherKind(); bool exists=false;
            for(int i=0;i<Cells.Size();i++)
                if (Cells[i].Center==center && Cells[i].Kind==kind && abs(Cells[i].Height-a.Pos.Z)<128)
                { exists=true; break; }
            if (exists) continue;
            let cell=new('UTNTWeatherCell'); cell.Center=center; cell.Kind=kind; cell.Height=a.Pos.Z;
            Cells.Push(cell);
        }
    }

    // Client thinker callbacks do not advance the saved gameplay RNG. Keep a
    // private generator so consecutive frames never repeat emission columns.
    uint NextRandom()
    {
        Seed^=Seed<<13; Seed^=Seed>>17; Seed^=Seed<<5; return Seed&0x7fffffff;
    }
    int Pick(int low, int high) { return low+int(NextRandom()%uint(high-low+1)); }
    double Sample(double low, double high) { return low+(high-low)*(NextRandom()/2147483648.0); }

    bool ReserveTrace()
    {
        if(Traces>=TraceBudget) return false;
        Traces++; PeakTraces=max(PeakTraces,Traces); return true;
    }

    bool OpenPoint(Vector3 pos, Sector sec)
    {
        if(!sec || pos.Z<=sec.floorplane.ZatPoint(pos.XY) || pos.Z>=sec.ceilingplane.ZatPoint(pos.XY)) return false;
        for(int i=0;i<sec.Get3DFloorCount();i++)
        {
            let f=sec.Get3DFloor(i);
            if(!(f.flags&F3DFloor.FF_EXISTS) || !(f.flags&(F3DFloor.FF_SOLID|F3DFloor.FF_SWIMMABLE))) continue;
            if(pos.Z>=f.bottom.ZatPoint(pos.XY) && pos.Z<=f.top.ZatPoint(pos.XY)) return false;
        }
        let water=sec.GetHeightSec();
        return !water || pos.Z>water.floorplane.ZatPoint(pos.XY);
    }

    override void Tick()
    {
        Traces=0; Cycle();
        let player=players[consoleplayer];
        Camera=player ? player.camera : null;
        Quality=player ? clamp(CVar.GetCVar('UTNT_fxquality',player).GetInt(),0,3) : 0;
        if (Quality && CVar.GetCVar('UTNT_reducedfx',player).GetBool()) Quality=1;
        ParticleLimit=Quality==3 ? 20000 : Quality==2 ? 7000 : 2000;
        DetailLimit=Quality==3 ? 1400 : Quality==2 ? 420 : 80;
        Limit=ParticleLimit+DetailLimit;
        VeilLimit=Quality==3 ? (ActiveKind==2 ? 160 : 96) : Quality==2 ? (ActiveKind==2 ? 56 : 32) : 0;
        TrailLimit=Quality==3 ? 800 : Quality==2 ? 300 : 0;
        TraceBudget=Quality==3 ? 18000 : Quality==2 ? 6500 : 2200;
        Range=player ? min(2048,max(0,CVar.GetCVar('UTNT_lod',player).GetInt())) : 0;
        Enabled=Camera && Quality>0 && Range>0 && CVar.GetCVar('weatherfx').GetBool();
        if (!Enabled || level.isFrozen() || Camera.IsFrozen()) return;
        SpawnRange=Range+min(640,Range*0.35);
        Vector2 lead=Camera.Vel.XY*24;
        if(lead.Length()>768) lead=lead.Unit()*768;
        Ahead=Camera.Pos.XY+lead;
        let climate=UTNTWeatherHandler(EventHandler.Find('UTNTWeatherHandler'));
        double t=level.time+(climate ? (climate.CycleNumber%360)*71 : 0);
        Gust=0.60+0.23*sin(t*0.19)+0.17*sin(t*0.071);
        WindX=(0.55+Gust*1.2)*(1+Intensity*5.5);
        WindY=(0.25+0.35*sin(t*0.047))*(1+Intensity*3);
        if (level.time%4==0 || Nearby.Size()==0 || (Camera.Pos.XY-LastScan).Length()>64)
        {
            LastScan=Camera.Pos.XY;
            Nearby.Clear();
            for(int i=0;i<Cells.Size();i++)
            {
                let cell=Cells[i]; cell.Target=0;
                double here=(cell.Center-Camera.Pos.XY).Length();
                if(here>SpawnRange+128 || abs(cell.Height-Camera.Pos.Z)>=4096) continue;
                double distance=min(here,(cell.Center-Ahead).Length()+192);
                double weight=clamp((1664-distance)/1280,0,1);
                double density=cell.Kind==2 ? 14+82*weight*weight : 3+11*weight*weight;
                double densityScale=1+Intensity*(cell.Kind==2 ? 1.4 : 2.0)+StormBoost*(cell.Kind==2 ? 2.4 : 3.0);
                // Preserve full storm density nearby and keep the mature outer
                // field. Subpixel distant flakes need less additional density.
                if(cell.Kind==2) densityScale=1+(densityScale-1)*(0.20+0.80*weight*weight);
                density*=densityScale;
                cell.Target=max(1,int(density*(Quality==3 ? 1.0 : Quality==2 ? 0.35 : 0.10)));
                Nearby.Push(i);
            }
        }
        if (Nearby.Size()==0) return;
        double nearest=1e20;
        for(int i=0;i<Nearby.Size();i++)
        {
            int n=Nearby[i]; double d=(Cells[n].Center-Camera.Pos.XY).Length();
            if(d<nearest) { nearest=d; ActiveKind=Cells[n].Kind; }
        }
        if (level.time%35==0) UpdateAudio();
        int attempts=Quality==3 ? 840 : Quality==2 ? 300 : 100;
        if(Warmup++<20) attempts*=2;
        int skyLimit=int((Quality==3 ? 512 : Quality==2 ? 180 : 50)*(1+Intensity*1.4+StormBoost*2.4));
        // Reserve emission time before the dense world field consumes its budget.
        if(SkyCameras.Size()>0 && SkyLive<skyLimit && Live-DetailLive<ParticleLimit)
            for(int i=0;i<(Warmup<20 ? 160 : 48) && SkyLive<skyLimit && Live-DetailLive<ParticleLimit;i++) EmitSky();
        for(int i=0;i<attempts && Live-DetailLive<ParticleLimit;i++) Emit();
        if(Intensity>0.3 && (StormBoost>0.2 || level.time%3==0) && DetailLive<DetailLimit)
            for(int n=0;n<(ActiveKind==2 && StormBoost>0.2 ? 3 : 1) && DetailLive<DetailLimit;n++) EmitVeil();
        PeakLive=max(PeakLive,Live);
    }

    void EmitVeil()
    {
        if(Quality<2 || VeilLive>=VeilLimit) return;
        int index=Nearby[Pick(0,Nearby.Size()-1)];
        // Ground detail has a shorter radius than precipitation. Prefer nearby cells.
        for(int attempt=0;attempt<5;attempt++)
        {
            int n=Nearby[Pick(0,Nearby.Size()-1)];
            if((Cells[n].Center-Camera.Pos.XY).Length()<(Cells[index].Center-Camera.Pos.XY).Length()) index=n;
        }
        let cell=Cells[index];
        Vector2 xy=cell.Center+(Sample(-64,64),Sample(-64,64));
        double distance=(xy-Camera.Pos.XY).Length();
        if(distance<96 || distance>850) return;
        let sec=level.PointInSector(xy); if(!sec) return;
        bool air=cell.Kind==2 && Pick(0,4)==0;
        double floorZ=sec.floorplane.ZatPoint(xy);
        Vector3 pos=(xy.X,xy.Y,floorZ+(air ? Sample(35,110) : Sample(5,12)));
        if(!OpenPoint(pos,sec) || !ReserveTrace()) return;
        Probe.Trace(pos,sec,(0,0,1),8192,TRACE_HitSky,ignoreAllActors:true);
        if(Probe.Results.HitType!=TRACE_HasHitSky) return;
        let v=UTNTWeatherVisual(level.SpawnClientSideVisualThinker('UTNTWeatherVisual'));
        if(!v) return;
        v.Owner=self; v.Kind=8; v.Pos=pos; v.Prev=pos;
        v.Width=air ? Sample(100,180) : Sample(55,120);
        v.Height=air ? Sample(25,50) : Sample(5,12);
        if(cell.Kind==2) { v.Width*=1.25; v.Height*=1.18; v.SnowVeil=true; }
        v.BaseAlpha=cell.Kind==2 ? (air ? 0.10+StormBoost*0.14 : 0.17+StormBoost*0.23) : 0.065+StormBoost*0.075;
        v.Texture=TexMan.CheckForTexture(cell.Kind==2 ? 'UTNTSnowVeil' : 'UTNTRainVeil');
        // Keep the whole soft billboard clear of nearby walls and ceilings.
        double clearance=v.Width*0.5;
        for(int side=0;side<8;side++)
        {
            if(!ReserveTrace()) { v.Destroy(); return; }
            Vector3 direction=(cos(side*45),sin(side*45),0);
            Probe.Trace(pos,sec,direction,clearance+4,0,
                wallMask:Line.ML_BLOCKING|Line.ML_BLOCKEVERYTHING,ignoreAllActors:true);
            if(Probe.Results.HitType!=TRACE_HitNone) clearance=min(clearance,max(0,Probe.Results.Distance-4));
        }
        if(clearance<12) { v.Destroy(); return; }
        v.Width=min(v.Width,clearance*2);
        v.Height=min(v.Height,(sec.ceilingplane.ZatPoint(xy)-floorZ)*0.25);
        if(!air) { v.Pos.Z=floorZ+v.Height*0.5+1; v.Prev=v.Pos; }
        if(!OpenPoint(v.Pos+(0,0,v.Height*0.5),sec) || !OpenPoint(v.Pos-(0,0,v.Height*0.5),sec)) { v.Destroy(); return; }
        v.Lifetime=cell.Kind==2 ? Pick(80,130) : Pick(65,115); v.Phase=Sample(0,360); v.LightLevel=210;
        v.Flags=SPF_ALLOWSHADERS | SPF_STRETCHPIXELS;
        v.Start(); Live++; DetailLive++; VeilLive++; PeakVeils=max(PeakVeils,VeilLive);
    }

    void EmitSky()
    {
        // The original low sky ceilings hide distant world flakes. Render a
        // second genuine 3D field inside the authored skybox, clipped by its
        // mountains and by the main world's sky openings (never a HUD overlay).
        Actor sky=SkyCameras[SkyCursor++%SkyCameras.Size()]; if(!sky) return;
        double azimuth=Sample(0,360), vertical=Sample(-0.35,1.0);
        double horizontal=sqrt(1-vertical*vertical);
        Vector3 direction=(cos(azimuth)*horizontal,sin(azimuth)*horizontal,vertical);
        if(!ReserveTrace()) return;
        Probe.Trace(sky.Pos,sky.CurSector,direction,192,0,
            wallMask:Line.ML_BLOCKING|Line.ML_BLOCKEVERYTHING,ignoreAllActors:true);
        double reach=Probe.Results.HitType==TRACE_HitNone ? 192 : min(192,Probe.Results.Distance-3);
        if(reach<12) return;
        Vector3 pos=sky.Pos+direction*Sample(8,reach);
        let sec=level.PointInSector(pos.XY);
        if(!OpenPoint(pos,sec)) return;
        let v=UTNTWeatherVisual(level.SpawnClientSideVisualThinker('UTNTWeatherVisual'));
        if(!v) return;
        v.Owner=self; v.SkyLayer=true; v.SkyOrigin=sky; v.Kind=ActiveKind; v.Pos=pos; v.Prev=pos;
        v.Phase=Sample(0,360); v.Lifetime=ActiveKind==2 ? Pick(180,260) : 80;
        // Match the world field at 1:8, including fall and horizontal wind.
        v.Width=ActiveKind==2 ? Sample(0.125,0.30) : Sample(0.10625,0.175);
        v.Height=ActiveKind==2 ? v.Width : Sample(1.25,2.125);
        v.BaseAlpha=ActiveKind==2 ? Sample(0.45,0.7) : Sample(0.35,0.55);
        v.FallSpeed=ActiveKind==2 ? Sample(0.06,0.1375) : Sample(2.375,3.375);
        v.Texture=TexMan.CheckForTexture(ActiveKind==2 ? "UTNTSnowGrey0" : "UTNTRainGrey");
        v.Flags=SPF_ROLL; v.LightLevel=160; v.Start();
        v.Age=Pick(12,35); Live++; SkyLive++;
    }

    void UpdateAudio()
    {
        if (!ReserveTrace()) return;
        Vector3 eye=Camera.Pos+(0,0,Camera.Height*0.75);
        Probe.Trace(eye,Camera.CurSector,(0,0,1),8192,TRACE_HitSky,ignoreAllActors:true);
        bool outside=Probe.Results.HitType==TRACE_HasHitSky;
        double nearest=1e20; int kind=1;
        for(int i=0;i<Nearby.Size();i++)
        {
            int n=Nearby[i]; double d=(Cells[n].Center-Camera.Pos.XY).Length();
            if(d<nearest) { nearest=d; kind=Cells[n].Kind; }
        }
        // At a window the audible field remains outside. Deep indoors it fades.
        double target=outside ? 1.0 : clamp(1.0-nearest/512,0,1)*0.22;
        Exposure=target;
        if(target<0.01) return;
        S_StartSound(kind==2 ? "UTNTWeather/Wind" : outside ? "UTNTWeather/Rain" : "UTNTWeather/Shelter",
            CHAN_AUTO,0,(kind==2 ? 0.16*(1+Intensity*2+StormBoost) : 0.24*(1+Intensity*1.5+StormBoost*0.8))*target,ATTN_NONE);
        if(kind==1 && Intensity>0.15)
            S_StartSound("UTNTWeather/Wind",CHAN_AUTO,0,0.12*Intensity*target,ATTN_NONE);
        if(!outside && kind==1 && Pick(0,3)==0)
            S_StartSound("UTNTWeather/Drip",CHAN_AUTO,0,0.07*target,ATTN_NONE);
    }

    void Emit()
    {
        int index=Nearby[Pick(0,Nearby.Size()-1)];
        // Fill under-populated cells first, including the preloaded outer field.
        // A filled near cell cannot starve the next area during a sprint.
        for(int choice=0;choice<7;choice++)
        {
            int candidate=Nearby[Pick(0,Nearby.Size()-1)];
            if(double(Cells[candidate].Live)/max(1,Cells[candidate].Target)<double(Cells[index].Live)/max(1,Cells[index].Target)) index=candidate;
        }
        UTNTWeatherCell cell=Cells[index];
        if(cell.Live>=cell.Target) return;
        Vector2 xy=cell.Center+(Sample(-64,64),Sample(-64,64));
        double distance=(xy-Camera.Pos.XY).Length();
        if(distance>SpawnRange || distance<28) return;
        let sec=level.PointInSector(xy); if(!sec) return;
        double floorZ=sec.floorplane.ZatPoint(xy), ceilingZ=sec.ceilingplane.ZatPoint(xy);
        if(ceilingZ-floorZ<24) return;
        double bottom=max(floorZ+8,Camera.Pos.Z-96);
        double top=min(ceilingZ-4,Camera.Pos.Z+384);
        if(top<=bottom) return;
        Vector3 pos=(xy.X,xy.Y,Sample(bottom,top));
        if(!OpenPoint(pos,sec)) { RejectedRoof++; return; }
        if(!ReserveTrace()) return;
        Probe.Trace(pos,sec,(0,0,1),8192,TRACE_HitSky,ignoreAllActors:true);
        if(Probe.Results.HitType!=TRACE_HasHitSky) { RejectedRoof++; return; }
        // Screen-independent world positions; distance taper hides radius edges.
        let v=UTNTWeatherVisual(level.SpawnClientSideVisualThinker('UTNTWeatherVisual'));
        if(!v) return;
        v.Owner=self; v.Kind=cell.Kind; v.CellIndex=index; v.Pos=pos; v.Prev=pos;
        v.Phase=Sample(0,360);
        v.Lifetime=cell.Kind==1 ? 100 : Pick(180,280);
        v.BaseAlpha=cell.Kind==1 ? Sample(0.5,0.72) : Sample(0.50,0.76);
        v.Width=cell.Kind==1 ? Sample(0.85,1.4) : (Pick(0,15)==0 ? Sample(1.8,2.4) : Sample(1.0,2.1));
        v.Height=cell.Kind==1 ? Sample(10,17) : v.Width;
        v.FallSpeed=cell.Kind==1 ? Sample(19,27) : Sample(0.48,1.1);
        v.Texture=TexMan.CheckForTexture(cell.Kind==1 ? "UTNTRainGrey" :
            String.Format("UTNTSnowGrey%d",Pick(0,2)));
        v.Flags=SPF_ROLL;
        v.LightLevel=224;
        v.Start(); Live++; cell.Live++;
        if(cell.Kind==1) SpawnedRain++; else SpawnedSnow++;
    }
}

class UTNTWeatherVisual : VisualThinker
{
    UTNTWeatherController Owner;
    LineTracer Probe;
    UTNTSnowTrail Trail;
    int Kind, Age, Lifetime, SegmentLeft, CellIndex;
    double Phase, BaseAlpha, Width, Height, FallSpeed, HitAfter;
    double RainLength, RainSpeed, SnowSize;
    bool WillHit, FloorHit, WaterHit, Retired, SkyLayer, SnowVeil;
    Actor SkyOrigin;

    void Start()
    {
        // Apply the requested relative changes once, including the sky field.
        RainLength=1; RainSpeed=1; SnowSize=1;
        if(Kind==1)
        {
            RainLength=Owner.Sample(1.30,1.50);
            RainSpeed=Owner.Sample(0.85,0.90);
            Height*=RainLength; FallSpeed*=RainSpeed;
        }
        if(Kind==1 || Kind==6 || Kind==7) BaseAlpha*=0.70;
        if(Kind==2)
        {
            SnowSize=Owner.Sample(1.10,1.20);
            Width*=SnowSize; Height=Width;
        }
        SetRenderStyle(STYLE_Translucent);
        let size=TexMan.GetScaledSize(Texture);
        Scale=(Width/size.X,Height/size.Y);
        Alpha=0; HitAfter=100000;
        Probe=new('LineTracer');
        UpdateSector(); UpdateSpriteInfo();
    }

    void Retire()
    {
        if(Trail) Trail.Retire();
        if(!Retired && Owner)
        {
            Owner.Live--; if(Kind==8) Owner.VeilLive--; if(Kind>=3) Owner.DetailLive--; if(SkyLayer) Owner.SkyLive--;
            if(!SkyLayer && Kind<=2 && CellIndex>=0 && CellIndex<Owner.Cells.Size()) Owner.Cells[CellIndex].Live--;
        }
        Retired=true; Destroy();
    }

    override void Tick()
    {
        if(!Owner || !Owner.Enabled || !Texture.IsValid() || (SkyLayer && Owner.ActiveKind!=Kind)) { Retire(); return; }
        if(level.isFrozen() || IsFrozen()) return;
        if(Owner.Live>Owner.Limit || (Kind<3 && Owner.Live-Owner.DetailLive>Owner.ParticleLimit) || (Kind>=3 && Owner.DetailLive>Owner.DetailLimit) || ++Age>=Lifetime) { Retire(); return; }
        if(SkyLayer && !SkyOrigin) { Retire(); return; }
        double distance=(Pos-(SkyLayer ? SkyOrigin.Pos : Owner.Camera.Pos)).Length();
        if(distance>(SkyLayer ? 256 : Owner.SpawnRange+160)) { Retire(); return; }
        if(!SkyLayer && Kind<=2 && Age>18 && level.time%4==0 && Owner.Cells[CellIndex].Live>Owner.Cells[CellIndex].Target+2)
        { Lifetime=min(Lifetime,Age+18); }
        if(Kind==8)
        {
            if(Owner.VeilLive>Owner.VeilLimit) { Retire(); return; }
            Vel=(Owner.WindX*0.4,Owner.WindY*0.4,0);
            let sec=level.PointInSector(Pos.XY);
            if(!Owner.OpenPoint(Pos,sec) || !Owner.ReserveTrace()) { Retire(); return; }
            Vector3 motion=Vel;
            Probe.Trace(Pos,sec,motion.Unit(),motion.Length()+Width*0.5,0,
                wallMask:Line.ML_BLOCKING|Line.ML_BLOCKEVERYTHING,ignoreAllActors:true);
            if(Probe.Results.HitType!=TRACE_HitNone) { Lifetime=min(Lifetime,Age+12); Vel*=0.1; }
            Super.Tick();
            Alpha=BaseAlpha*Owner.Intensity*min(1.0,double(Age)/25)*min(1.0,double(Lifetime-Age)/25)
                *clamp((distance-60)/150,0,1);
            let size=TexMan.GetScaledSize(Texture);
            Scale=(Width*(SnowVeil ? 1.0 : 1+Age*0.003)/size.X,Height/size.Y);
            return;
        }
        if(Kind==6)
        {
            Super.Tick();
            Alpha=BaseAlpha*(1.0-double(Age)/Lifetime);
            Scale*=1.055;
            return;
        }
        if(Kind==7)
        {
            Vel.Z-=0.12;
            Vector3 motion=Vel;
            let sec=level.PointInSector(Pos.XY);
            if(!Owner.OpenPoint(Pos,sec)) { Retire(); return; }
            if(!Owner.ReserveTrace()) { Owner.BudgetRetired++; Retire(); return; }
            double speed=motion.Length();
            Probe.Trace(Pos,sec,motion/speed,speed,0,
                wallMask:Line.ML_BLOCKING|Line.ML_BLOCKEVERYTHING,ignoreAllActors:true);
            if(Probe.Results.HitType!=TRACE_HitNone || Probe.Results.CrossedWater || Probe.Results.Crossed3DWater)
            { Retire(); return; }
            Super.Tick();
            Alpha=BaseAlpha*min(1.0,double(Lifetime-Age)/4);
            return;
        }
        if(SegmentLeft<=0)
        {
            // Snow forecasts two tics between wind updates. Rain forecasts a short straight
            // segment. Emergency retirement never leaves a particle hanging.
            if(!Owner.ReserveTrace()) { Owner.BudgetRetired++; Retire(); return; }
            if(Kind==1) Vel=(Owner.WindX*1.5*RainSpeed,Owner.WindY*1.5*RainSpeed,-FallSpeed*(1+Owner.Intensity*0.18));
            else if(Kind==2)
            {
                double t=level.time;
                double wx=0.25+0.6*sin(t*0.30+Pos.Y*0.14)+0.25*sin(t*0.77+Phase);
                double wy=0.15+0.38*cos(t*0.23+Pos.X*0.12)+0.22*cos(t*0.61+Phase);
                double storm=Owner.Intensity;
                wx+=storm*(1.8+Owner.Gust*1.9)+Owner.StormBoost*(1.2+Owner.Gust); wy+=storm*(0.5+0.45*sin(t*0.13));
                if(SkyLayer) { wx*=0.125; wy*=0.125; }
                Vel=(Vel.X+(wx-Vel.X)*0.1536,Vel.Y+(wy-Vel.Y)*0.1536,
                    -FallSpeed*(1+storm*1.8+Owner.StormBoost*0.6)*(0.9+0.10*sin(t*0.8+Phase)));
            }
            else Vel=(Owner.WindX*0.55,Owner.WindY*0.55,0);
            if(SkyLayer && Kind==1) { Vel.X*=0.125; Vel.Y*=0.125; }
            double speed=Vel.Length();
            Vector3 direction=Vel;
            int segment=Kind==2 ? 2 : 8;
            Probe.Trace(Pos,level.PointInSector(Pos.XY),direction/speed,speed*segment,0,
                wallMask:Line.ML_BLOCKING|Line.ML_BLOCKEVERYTHING,ignoreAllActors:true);
            WillHit=Probe.Results.HitType!=TRACE_HitNone;
            HitAfter=WillHit ? max(0,Probe.Results.Distance/speed) : 100000;
            FloorHit=Probe.Results.HitType==TRACE_HitFloor;
            WaterHit=false;
            if(FloorHit && Probe.Results.HitSector)
            {
                let terrain=Probe.Results.HitSector.GetFloorTerrain(Sector.floor);
                WaterHit=terrain && terrain.IsLiquid && terrain.TerrainName=='UTNT_Water';
            }
            // Transfer_Heights and 3D-water surfaces can precede the solid floor.
            if(Probe.Results.CrossedWater || Probe.Results.Crossed3DWater)
            {
                Vector3 water=Probe.Results.CrossedWater ? Probe.Results.CrossedWaterPos : Probe.Results.Crossed3DWaterPos;
                double wd=(water-Pos).Length()/speed;
                if(wd<HitAfter) { HitAfter=wd; WillHit=true; FloorHit=true; WaterHit=true; }
            }
            SegmentLeft=segment;
        }
        if(WillHit && HitAfter<=1)
        {
            Vector3 stepVelocity=Vel;
            Pos+=stepVelocity*max(0,HitAfter-0.01);
            if(Kind==1 && FloorHit && Owner.DetailLive<Owner.DetailLimit && Owner.Live<Owner.Limit
                && (Pos-Owner.Camera.Pos).Length()<640 && !SkyLayer) Impact();
            if(!FloorHit) Owner.RejectedWall++;
            Retire(); return;
        }
        // Verify the endpoint every tic as well as forecasting the segment.
        // This closes rare fast diagonal crossings at solid 3D-floor edges.
        Vector3 nextPos=Pos+Vel;
        if(!Owner.OpenPoint(nextPos,level.PointInSector(nextPos.XY)))
        { Owner.RejectedWall++; Retire(); return; }
        Super.Tick(); SegmentLeft--; HitAfter--;
        double fadeIn=min(1.0,double(Age)/(Kind==1 ? 3 : Kind>=3 ? 18 : 12));
        double fadeOut=min(1.0,double(Lifetime-Age)/(Kind>=3 ? 24 : 18));
        Alpha=BaseAlpha*fadeIn*fadeOut*(SkyLayer ? clamp((256-distance)/64,0,1)*clamp((distance-3)/9,0,1)
            : clamp((Owner.Range+64-distance)/512,0,1)*clamp((distance-20)/48,0,1));
        if(Kind==1)
        {
            let size=TexMan.GetScaledSize(Texture);
            Scale.Y=min(Height,distance*0.028*RainLength)*(1+Owner.Intensity*0.6+Owner.StormBoost*0.8)/size.Y;
            double side=Vel.X*-sin(Owner.Camera.Angle)+Vel.Y*cos(Owner.Camera.Angle);
            Roll=atan2(side,-Vel.Z);
        }
        else if(Kind==2)
        {
            double width=min(Width,distance*0.008*SnowSize);
            let size=TexMan.GetScaledSize(Texture); Scale=(width/size.X,width/size.Y);
            double side=Vel.X*-sin(Owner.Camera.Angle)+Vel.Y*cos(Owner.Camera.Angle);
            Scale.Y*=1+Owner.Intensity*0.7+Owner.StormBoost*0.7;
            Roll=Owner.Intensity>0.15 ? atan2(side,-Vel.Z) : Phase+12*sin(Age*1.2+Phase);
            // One faint overlapping afterimage along an already traced segment.
            // No extra collision probes or multi-flake textures are needed.
            int trailLimit=Owner.TrailLimit;
            // Distant/sky flakes already carry the stretched motion shape. Reserve
            // the extra overlapping afterimage for readable nearby world flakes.
            bool trailVisible=!SkyLayer && distance<450 && Alpha>0.02 && trailLimit>0;
            if(Trail && (!trailVisible || Owner.TrailLive>trailLimit)) Trail.Retire();
            if(!Trail && trailVisible && Owner.TrailLive<trailLimit)
            {
                Trail=UTNTSnowTrail(level.SpawnClientSideVisualThinker('UTNTSnowTrail'));
                if(Trail) { Trail.Source=self; Trail.Owner=Owner; Trail.Pos=Pos; Trail.Prev=Pos; Trail.Start(); Owner.TrailLive++; }
            }
        }
    }

    void Impact()
    {
        if(WaterHit && Owner.DetailLive-Owner.VeilLive<Owner.DetailLimit-Owner.VeilLimit && Owner.Live<Owner.Limit)
        {
            let ring=UTNTWeatherVisual(level.SpawnClientSideVisualThinker('UTNTWeatherVisual'));
            if(ring)
            {
                ring.Owner=Owner; ring.Kind=6; ring.Pos=Pos+(0,0,1.3); ring.Prev=ring.Pos;
                ring.Texture=TexMan.CheckForTexture('UTNTRippleGrey');
                ring.Width=5; ring.Height=1.2; ring.BaseAlpha=0.25; ring.Lifetime=12; ring.LightLevel=-1;
                ring.Start(); Owner.Live++; Owner.DetailLive++; Owner.PeakLive=max(Owner.PeakLive,Owner.Live);
            }
        }
        int count=Owner.Quality==1 ? 2 : Owner.Pick(3,5);
        for(int i=0;i<count && Owner.Live<Owner.Limit && Owner.DetailLive-Owner.VeilLive<Owner.DetailLimit-Owner.VeilLimit;i++)
        {
            let v=UTNTWeatherVisual(level.SpawnClientSideVisualThinker('UTNTWeatherVisual'));
            if(!v) return;
            double angle=Owner.Sample(0,360), speed=Owner.Sample(0.22,0.65);
            v.Owner=Owner; v.Kind=7; v.Pos=Pos+(0,0,0.35); v.Prev=v.Pos;
            v.Texture=TexMan.CheckForTexture('UTNTRainDropGrey');
            v.Width=Owner.Sample(0.65,1.0); v.Height=v.Width;
            v.BaseAlpha=Owner.Sample(0.70,0.9); v.Lifetime=Owner.Pick(14,20); v.LightLevel=240;
            v.Vel=(cos(angle)*speed,sin(angle)*speed,Owner.Sample(0.70,1.1));
            v.Start(); Owner.Live++; Owner.DetailLive++; Owner.PeakLive=max(Owner.PeakLive,Owner.Live);
        }
        Owner.Impacts++;
    }
}

// A short overlapping blur of the same flake, never a chain of separate flakes.
class UTNTSnowTrail : VisualThinker
{
    UTNTWeatherVisual Source;
    UTNTWeatherController Owner;
    bool Retired;
    void Start()
    {
        Texture=Source.Texture; Scale=Source.Scale*0.92;
        Alpha=Source.Alpha*(0.14+Owner.Intensity*0.07+Owner.StormBoost*0.04); LightLevel=Source.LightLevel; Flags=Source.Flags;
        Roll=Source.Roll; SetRenderStyle(STYLE_Translucent);
        UpdateSector(); UpdateSpriteInfo();
    }

    void Retire()
    {
        if(Retired) return;
        Retired=true;
        if(Source && Source.Trail==self) Source.Trail=null;
        if(Owner) Owner.TrailLive--;
        Destroy();
    }
    override void Tick()
    {
        if(!Source || Source.Retired || !Owner || !Owner.Enabled) { Retire(); return; }
        if(level.isFrozen() || IsFrozen()) return;
        Super.Tick();
        Texture=Source.Texture;
        let size=TexMan.GetScaledSize(Texture);
        Vector3 step=Source.Pos-Source.Prev;
        double length=step.Length();
        double offset=min(length*(0.65+Owner.Intensity*0.5),Source.Scale.X*size.X*(0.30+Owner.Intensity*0.65+Owner.StormBoost*0.4));
        Pos=Source.Pos-(length>0.0001 ? step/length*offset : (0,0,0));
        Scale=Source.Scale*0.92; Roll=Source.Roll;
        Alpha=Source.Alpha*(0.14+Owner.Intensity*0.07+Owner.StormBoost*0.04);
        LightLevel=Source.LightLevel; Flags=Source.Flags;
        SetRenderStyle(STYLE_Translucent);
        UpdateSector(); UpdateSpriteInfo();
    }
}

#include "zscript/UTNT_WeatherVisor.zc"
