// Serialized map-local clock: identical pulse, sky and world-light state on
// every peer, across save/load and hub travel. No gameplay RNG is consumed.
class UTNTThunderHandler : EventHandler
{
    Array<int> Outside, BaseLight;
    bool Initialized;
    int Clock, NextFlash, Sequence, PulseAge, Direction, AppliedState;
    double Flash, ThunderVolume;
    int WeatherSeed, Profile, PeakStep, ThunderDelay, ThunderDue;
    int ThunderCount, LastThunderClock, FlashClock, NearCooldown;

    // Small private serialized generator; products remain within signed int32.
    int WeatherRandom(int limit)
    {
        WeatherSeed=(WeatherSeed*25173+13849)%65521;
        return WeatherSeed%limit;
    }

    void Initialize()
    {
        Initialized=true; NextFlash=315; PulseAge=-1; AppliedState=-1;
        WeatherSeed=667; ThunderDue=-1; LastThunderClock=-1;
        TextureID sky=TexMan.CheckForTexture("F_SKY1");
        let box=level.PointInSector((28000,-28000));
        for(int i=0;i<level.Sectors.Size();i++)
        {
            let s=level.Sectors[i];
            if(s==box || s.GetTexture(Sector.ceiling)!=sky)continue;
            Outside.Push(i); BaseLight.Push(s.GetLightLevel());
        }
        Apply(0);
    }
    static int Pulse(int age)
    {
        // About 0.45 s: fast primary pulse, brief gap, weaker echo and decay.
        if(age==0)return 2;
        if(age==1)return 6;
        if(age==2)return 8;
        if(age==3)return 5;
        if(age==4)return 3;
        if(age==5)return 1;
        if(age==8)return 3;
        if(age==9)return 5;
        if(age==10)return 3;
        if(age==11)return 2;
        if(age==12 || age==13)return 1;
        return 0;
    }
    void StartPulse(int forcedProfile=-1)
    {
        int roll=WeatherRandom(100);
        Profile=forcedProfile>=0 ? clamp(forcedProfile,0,2) : (roll<62 ? 0 : roll<92 || NearCooldown>0 ? 1 : 2);
        if(NearCooldown>0)NearCooldown--;
        if(Profile==2)NearCooldown=3;
        Direction=WeatherRandom(3); Sequence++; PulseAge=0; FlashClock=Clock;
        if(Profile==0)
        {
            PeakStep=2+WeatherRandom(2);
            ThunderDelay=105+WeatherRandom(106); // 3..6 s, distant storm.
            ThunderVolume=.12+WeatherRandom(9)*.01;
        }
        else if(Profile==1)
        {
            PeakStep=4+WeatherRandom(3);
            ThunderDelay=21+WeatherRandom(43); // 0.6..1.8 s.
            ThunderVolume=.40+WeatherRandom(21)*.01;
        }
        else
        {
            PeakStep=8; ThunderDelay=0;
            ThunderVolume=.95+WeatherRandom(6)*.01;
        }
        ThunderDue=Clock+ThunderDelay;
        NextFlash=Clock+315+WeatherRandom(386); // 9..20 s.
    }
    void PlayThunder()
    {
        // One ambient sound, avoiding stacked TID-666 emitters whose distance
        // used to obscure the chosen thunder strength at different locations.
        S_StartSound(Sequence%2 ? "amb1" : "amb3",CHAN_AUTO,0,ThunderVolume,ATTN_NONE,
            Profile==0 ? .80 : Profile==1 ? .92 : 1.0);
        ThunderCount++; LastThunderClock=Clock; ThunderDue=-1;
    }
    void Apply(int step)
    {
        step=clamp(step,0,8);
        int state=step==0 ? 0 : 1+Direction*8+step-1;
        Flash=(step/8.0)*(step/8.0);
        if(state==AppliedState)return;
        AppliedState=state;
        TextureID sky=TexMan.CheckForTexture(String.Format("UGT%d",state));
        level.ChangeSky(sky,sky);
        for(int i=0;i<Outside.Size();i++)
        {
            let s=level.Sectors[Outside[i]];
            s.SetLightLevel(BaseLight[i]+int(max(0,255-BaseLight[i])*Flash));
            // Almost neutral charcoal ambience; the rare close peak reaches white.
            s.SetColor(Color(int(208+Flash*47),int(209+Flash*46),int(212+Flash*43)),int(31-Flash*20));
        }
    }
    override void WorldTick()
    {
        if(!(level.MapName~=="TNT02"))return;
        if(!Initialized)Initialize();
        UTNTThunderView.Ensure();
        if(level.isFrozen())return;
        Clock++;
        if(Clock>=NextFlash && PulseAge<0)StartPulse();
        if(PulseAge>=0)
        {
            int pulse=Pulse(PulseAge);
            // Immediate near peak, then the same brief echo/decay envelope.
            if(Profile==2 && PulseAge<2)pulse=8;
            Apply(int(pulse*PeakStep/8.0+.5));
            PulseAge++;
            if(PulseAge>24)PulseAge=-1;
        }
        // Independent of the short light pulse: distant thunder may arrive 6 s later.
        if(ThunderDue>=0 && Clock>=ThunderDue)PlayThunder();
    }
    override void WorldLoaded(WorldEvent e) { PPShader.SetEnabled("UTNTThunderExposure",false); }
    override void WorldUnloaded(WorldEvent e) { PPShader.SetEnabled("UTNTThunderExposure",false); }
}

// Entirely client-local view state, so split views/remote cameras/coop never
// affect the synchronized weather clock or world-light state.
class UTNTThunderView : Thinker
{
    LineTracer Probe;
    double Exposure;
    bool OpenSky;
    static void Ensure()
    {
        if(consoleplayer<0 || !players[consoleplayer].camera)return;
        let it=ThinkerIterator.Create('UTNTThunderView',Thinker.STAT_USER+7,true);
        if(it.Next())return;
        level.CreateClientSideThinker('UTNTThunderView',Thinker.STAT_USER+7);
    }
    override void Tick()
    {
        if(consoleplayer<0)return;
        let p=players[consoleplayer]; let camera=p.camera;
        let h=UTNTThunderHandler(EventHandler.Find('UTNTThunderHandler'));
        if(!camera || !h || !(level.MapName~=="TNT02"))
        { PPShader.SetEnabled("UTNTThunderExposure",false);return; }
        if(!Probe)Probe=new('LineTracer');
        Vector3 eye=camera.Pos+(0,0,camera.Height*.75);
        Probe.Trace(eye,camera.CurSector,(0,0,1),8192,TRACE_HitSky,ignoreAllActors:true);
        OpenSky=Probe.Results.HitType==TRACE_HasHitSky;
        Exposure+=clamp((OpenSky?1.0:0.0)-Exposure,-.18,.18);
        double amount=h.Flash*Exposure;
        bool enabled=amount>.001 && camera.WaterLevel<3
            && !CVar.GetCVar('UTNT_reducedfx',p).GetBool()
            && CVar.GetCVar('UTNT_shaderoverlayswitch',p).GetBool();
        PPShader.SetUniform1f("UTNTThunderExposure","amount",amount);
        PPShader.SetEnabled("UTNTThunderExposure",enabled);
    }
}
