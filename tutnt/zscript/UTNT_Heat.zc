// Map-placed sources are simulation objects; their appearance is local.
class EffectSpawner : SwitchableDecoration
{
    int range;
    String switchvar;
    int flags;
    FlagDef AllowTickDelay: flags, 0;
    FlagDef DoActivation: flags, 1;
    Property Range: range;
    Property SwitchVar: switchvar;
    Default { +EffectSpawner.DoActivation }
    States { Spawn: Inactive: TNT1 A -1; Wait; }
    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        if (bDoActivation)
        {
            if (bDormant || SpawnFlags & MTF_DORMANT) Deactivate(null);
            else Activate(null);
        }
    }
    override void Activate(Actor activator) { bDormant=false; SetStateLabel("Active"); }
    override void Deactivate(Actor activator) { bDormant=true; SetStateLabel("Inactive"); }
}

class EffectGiver : EffectSpawner
{
    Default
    {
        Radius 128;
        +NOINTERACTION
        +NOGRAVITY
        +INVISIBLE
    }
    States { Spawn: MDLS A 1; Active: TNT1 A -1; Wait; }
}

class HeatEffectGiver : EffectGiver {}

// Compatibility adapter for external/map GiveInventory calls.
class ShaderControl : Inventory
{
    String ShaderToControl;
    Property Shader: ShaderToControl;
    Default { Inventory.MaxAmount 2147483647; }
}
class HeatShaderControl : ShaderControl
{
    Default { ShaderControl.Shader "heatshader"; Inventory.MaxAmount 70; }
    override void DoEffect()
    {
        if (!Owner || Amount <= 1) return;
        let effects=UTNTPlayerEffects(Owner.AddBehavior('UTNTPlayerEffects'));
        effects.ExternalHeat=clamp((Amount-1)/69.0,0,1);
        effects.ExternalHeatUntil=level.time+Amount;
        effects.Heat=max(effects.Heat,effects.ExternalHeat);
        Amount=1;
    }
}
