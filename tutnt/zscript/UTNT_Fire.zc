// Local emitters assemble fire from independently moving, finite-lived sheets.
// No whole-flame sprite or gameplay projectile participates in the effect.
class UTNTFireEmitter : Thinker
{
    Actor Source;
    int Kind, ColorIndex, Age, NextSheet, NextBase, LastVariant, LastSmokeVariant;
    UTNTFireGlow Glow;
    double Phase, Anchor, EffectScale;
    bool FloorFire;

    void Initialize(Actor owner, int color, int kind)
    {
        Source=owner; Kind=kind; ColorIndex=color;
        Phase=FRandom[utntcosmetic](0,360);
        Age=Random[utntcosmetic](0,100);
        Anchor=kind==2 ? 19 : kind==1 ? 31 : 61;
        if (owner is 'UTNTLegacyRedFireBase' || owner is 'UTNTLegacyGreenFireBase' || owner is 'UTNTLegacyBlueFireBase') Anchor=57;
        if (owner is 'UTNTLegacyShortRedFireBase' || owner is 'UTNTLegacyShortGreenFireBase' || owner is 'UTNTLegacyShortBlueFireBase') Anchor=28;
    }

    int NextSmokeVariant()
    {
        LastSmokeVariant=LastSmokeVariant==0 ? Random[utntcosmetic](1,4)
            : 1+(LastSmokeVariant-1+Random[utntcosmetic](1,3))%4;
        return LastSmokeVariant;
    }

    int NextVariant()
    {
        // Consecutive rising sheets always use different source shapes.
        LastVariant=LastVariant==0 ? Random[utntcosmetic](1,3)
            : 1+(LastVariant-1+Random[utntcosmetic](1,2))%3;
        return LastVariant;
    }

    override void Tick()
    {
        if (!Source) { Destroy(); return; }
        if (FloorFire && !UTNTFireSpawnerBase(Source).UTNTFireActive) { Destroy(); return; }
        if (Source.IsFrozen()) return;
        if (!UTNTVisuals.Visible(Source,combat:true)) { Destroy(); return; }
        Age++;
        if (!Glow)
        {
            Glow=UTNTFireGlow(level.SpawnClientSideVisualThinker('UTNTFireGlow'));
            if (Glow) Glow.Initialize(self);
        }
        let player=players[consoleplayer];
        int quality=clamp(CVar.GetCVar('UTNT_fxquality',player).GetInt(),1,3);
        if (CVar.GetCVar('UTNT_reducedfx',player).GetBool()) quality=1;
        if (Source.Distance3D(player.camera)>640) quality=1;
        if (Age>=NextSheet)
        {
            NextSheet=Age+1; // Retry a denied birth without a catch-up burst.
            if (UTNTVisuals.Reserve())
            {
                let p=UTNTFireFragment(level.SpawnClientSideVisualThinker('UTNTFireFragment'));
                if (p) p.Initialize(self,quality,false);
                int gap=quality==1 ? Random[utntcosmetic](4,5)
                    : Kind==2 ? (quality==3 ? Random[utntcosmetic](1,2) : Random[utntcosmetic](2,3))
                    : quality==3 ? Random[utntcosmetic](2,4) : Random[utntcosmetic](3,5);
                NextSheet=Age+gap;
            }
        }
        if (Age>=NextBase && UTNTVisuals.Reserve())
        {
            let p=UTNTFireFragment(level.SpawnClientSideVisualThinker('UTNTFireFragment'));
            if (p) p.Initialize(self,quality,true);
            NextBase=Age+(quality==1 ? Random[utntcosmetic](4,6) : Random[utntcosmetic](3,5));
        }
        // Larger embers and smoke have separate lifetimes and remain optional.
        if (quality<2) return;
        int emberInterval=Kind==2 ? 5 : Kind==1 ? 16 : 10;
        if (ColorIndex!=0) emberInterval*=2;
        if (Age%emberInterval==0 && UTNTVisuals.Reserve())
        {
            let p=UTNTFireDetail(level.SpawnClientSideVisualThinker('UTNTFireDetail'));
            if (p) p.Initialize(self,false);
        }
        int smokeInterval=Kind==2 ? 7 : 12;
        if (quality==2) smokeInterval*=2;
        if (ColorIndex==1) smokeInterval*=3;
        if (ColorIndex!=2 && Age%smokeInterval==0 && UTNTVisuals.Reserve())
        {
            let p=UTNTFireDetail(level.SpawnClientSideVisualThinker('UTNTFireDetail'));
            if (p) p.Initialize(self,true);
        }
    }
}

class UTNTFireFragment : VisualThinker
{
    Actor Source;
    int Age, Life, Variant;
    double Width, Height, Phase, Strength, DriftX, DriftY;
    double RotationSpeed, SizePhase, SizeRate;

    void Initialize(UTNTFireEmitter fire, int quality, bool base)
    {
        Source=fire.Source;
        Variant=base ? 0 : fire.NextVariant();
        string prefix=fire.ColorIndex==1 ? 'UFOG' : fire.ColorIndex==2 ? 'UFOB' : 'UFOR';
        string frame=Variant==0 ? 'A0' : Variant==1 ? 'B0' : Variant==2 ? 'C0' : 'D0';
        Texture=TexMan.CheckForTexture(prefix..frame);
        // VisualThinker roll is ignored by the renderer unless SPF_ROLL is set.
        // Keep native sprite proportions when enabling rotation.
        Flags=SPF_FULLBRIGHT | SPF_ALLOWSHADERS | SPF_ROLL | SPF_STRETCHPIXELS;
        SetRenderStyle(STYLE_Translucent);
        bXFlip=Random[utntcosmetic](0,1);
        double small=fire.FloorFire ? fire.EffectScale : fire.Kind==1 ? 0.62 : 1;
        double radius=fire.Kind==2 ? 8.5 : 2.2*small;
        double angle=FRandom[utntcosmetic](0,360);
        double spread=sqrt(FRandom[utntcosmetic](0,1))*radius;
        Pos=Source.Vec3Offset(cos(angle)*spread,sin(angle)*spread,fire.Anchor-3*small);
        Life=Random[utntcosmetic](16,26);
        Width=FRandom[utntcosmetic](15,34)*small*(quality==1 ? 1.25 : 1);
        Height=FRandom[utntcosmetic](18,36)*small;
        // Avoid the very tall, narrow sheets that merge into smooth ribbons.
        Height=min(Height,Width*1.65);
        if (base)
        {
            Height=FRandom[utntcosmetic](13,21)*small;
            Width=(fire.Kind==2 ? 33 : 25)*FRandom[utntcosmetic](0.80,1.20)*small;
            Life=10;
        }
        if (fire.ColorIndex==2) Width*=0.80;
        Phase=FRandom[utntcosmetic](0,360);
        // A gentle common flow remains; each sheet has independent turbulence.
        double flow=sin(fire.Age*5+fire.Phase);
        DriftX=flow*(fire.ColorIndex==1 ? 0.36 : 0.28);
        DriftY=cos(fire.Age*4+fire.Phase)*0.10;
        Vel=(DriftX+FRandom[utntcosmetic](-0.24,0.24),DriftY+FRandom[utntcosmetic](-0.24,0.24),(base ? 0.12 : FRandom[utntcosmetic](0.45,1.15))*small);
        if(fire.FloorFire)
        {
            // Floor fires keep the broad footprint of the original spawner.
            Width*=1.65; Height*=0.80; Vel.Z*=0.80;
        }
        Strength=base ? 0.92 : quality==1 ? 0.82 : quality==2 ? 0.65 : 0.50;
        Roll=FRandom[utntcosmetic](base ? -8 : -22,base ? 8 : 22);
        RotationSpeed=FRandom[utntcosmetic](base ? 0.20 : 0.40,base ? 0.55 : 1.05);
        if (Random[utntcosmetic](0,1)) RotationSpeed=-RotationSpeed;
        SizePhase=FRandom[utntcosmetic](0,360);
        SizeRate=FRandom[utntcosmetic](7,15);
        Animate(); Prev=Pos; PrevRoll=Roll;
        UpdateSector(); UpdateSpriteInfo();
    }

    void Animate()
    {
        double t=double(Age)/Life;
        let size=TexMan.GetScaledSize(Texture);
        // Young sheets fill the fuel bed; older sheets stretch, narrow and die.
        Scale=(Width*(1+0.20*sin(t*180)-0.45*t*t)*(1+0.07*sin(Age*SizeRate+SizePhase))/size.X,
               Height*(0.85+0.40*t)*(1+0.09*sin(Age*SizeRate*0.73+SizePhase+90))/size.Y);
        Alpha=Strength*min(1.0,(Age+1)/3.0)*min(1.0,(Life-Age)/8.0);
    }

    override void Tick()
    {
        if (!Source) { Destroy(); return; }
        if (IsFrozen() || Source.IsFrozen()) return;
        if (++Age>=Life || !UTNTVisuals.Visible(Source,combat:true)) { Destroy(); return; }
        Super.Tick();
        Vel.X+=0.012*sin(Age*15+Phase);
        Vel.Y+=0.009*cos(Age*13+Phase);
        Vel.Z+=0.012;
        Roll+=RotationSpeed+0.10*sin(Age*9+SizePhase);
        Animate();
    }
}

// One persistent client-side halo per fire; independent of fragment births.
class UTNTFireGlow : VisualThinker
{
    Actor Source;
    int Age, ColorIndex;
    double Anchor, Width, Height, Phase;

    void Initialize(UTNTFireEmitter fire)
    {
        Source=fire.Source; ColorIndex=fire.ColorIndex; Phase=fire.Phase;
        int sourceKind=fire.FloorFire ? 0 : fire.Anchor<24 ? 2 : fire.Anchor<40 ? 1 : 0;
        double small=fire.FloorFire ? fire.EffectScale : sourceKind==1 ? 0.62 : 1;
        Anchor=fire.Anchor+9*small;
        Width=(sourceKind==2 ? 70 : 56)*small;
        Height=(sourceKind==2 ? 54 : 52)*small;
        Texture=TexMan.CheckForTexture(ColorIndex==1 ? 'UFHGA0' : ColorIndex==2 ? 'UFHBA0' : 'UFHRA0');
        Flags=SPF_FULLBRIGHT | SPF_ALLOWSHADERS | SPF_STRETCHPIXELS;
        SetRenderStyle(STYLE_Add);
        Pos=Source.Vec3Offset(0,0,Anchor);
        Animate(); Prev=Pos;
        UpdateSector(); UpdateSpriteInfo();
    }

    void Animate()
    {
        double pulse=1+0.045*sin(Age*11+Phase)+0.025*sin(Age*23+Phase*1.7);
        let size=TexMan.GetScaledSize(Texture);
        Scale=(Width*pulse/size.X,Height*(2-pulse)/size.Y);
        Alpha=0.84+0.055*sin(Age*13+Phase)+0.035*sin(Age*29+Phase*0.7);
    }

    override void Tick()
    {
        if (!Source) { Destroy(); return; }
        if (Source is 'UTNTFireSpawnerBase' && !UTNTFireSpawnerBase(Source).UTNTFireActive) { Destroy(); return; }
        if (IsFrozen() || Source.IsFrozen()) return;
        if (!UTNTVisuals.Visible(Source,combat:true)) { Destroy(); return; }
        Super.Tick(); Age++;
        Pos=Source.Vec3Offset(0,0,Anchor+0.5*sin(Age*7+Phase));
        UpdateSector(); Animate();
    }
}

class UTNTFireDetail : VisualThinker
{
    Actor Source;
    bool Smoke;
    int Age, Life, SmokeVariant;
    double Width, Height, Strength, Phase, SmokeSpin;

    void Initialize(UTNTFireEmitter fire, bool smoke)
    {
        Source=fire.Source; self.Smoke=smoke; Phase=fire.Phase;
        double small=fire.FloorFire ? fire.EffectScale : fire.Kind==1 ? 0.65 : 1;
        double radius=fire.Kind==2 ? 8 : (smoke ? 3 : 5)*small;
        double startZ=(smoke ? 28 : 13)*small;
        // Spread embers within the flame volume, including height. Smoke keeps
        // its existing transition from the upper part of the fire.
        if (!smoke) startZ+=FRandom[utntcosmetic](-4,6)*small;
        Pos=Source.Vec3Offset(FRandom[utntcosmetic](-radius,radius),FRandom[utntcosmetic](-radius,radius),fire.Anchor+startZ);
        Flags=SPF_ALLOWSHADERS;
        bXFlip=Random[utntcosmetic](0,1);
        if (smoke)
        {
            SmokeVariant=fire.NextSmokeVariant();
            string frame=SmokeVariant==1 ? 'A0' : SmokeVariant==2 ? 'B0' : SmokeVariant==3 ? 'C0' : 'D0';
            Texture=TexMan.CheckForTexture('UFSM'..frame);
            Flags|=SPF_ROLL | SPF_STRETCHPIXELS;
            SetRenderStyle(STYLE_Translucent);
            Width=(fire.Kind==2 ? 27 : 20)*small*FRandom[utntcosmetic](0.85,1.45);
            Height=Width*FRandom[utntcosmetic](0.70,1.55);
            Life=Random[utntcosmetic](48,65);
            Strength=(fire.ColorIndex==1 ? 0.20 : fire.Kind==2 ? 0.57 : 0.48)*FRandom[utntcosmetic](0.70,1.15);
            // Fullbright tint makes wisps readable even against unlit masonry.
            Flags|=SPF_FULLBRIGHT; scolor=0xffa3988b;
            // Neighboring wisps follow one gentle breeze with individual spread.
            double windAngle=fire.Phase+12*sin(fire.Age*1.5)+FRandom[utntcosmetic](-25,25);
            double windSpeed=FRandom[utntcosmetic](0.16,0.28)*small;
            Vel=(cos(windAngle)*windSpeed,sin(windAngle)*windSpeed,FRandom[utntcosmetic](0.26,0.48)*small);
            Phase=FRandom[utntcosmetic](0,360);
            Roll=FRandom[utntcosmetic](-180,180);
            SmokeSpin=FRandom[utntcosmetic](0.18,0.50);
            if (Random[utntcosmetic](0,1)) SmokeSpin=-SmokeSpin;
        }
        else
        {
            ConfigureEmber(fire.ColorIndex,small);
        }
        Animate(); Prev=Pos; PrevRoll=Roll;
        UpdateSector(); UpdateSpriteInfo();
    }

    // Shared spark material, motion and lifetime for torches and floor fires.
    void ConfigureEmber(int colorIndex, double small)
    {
        Texture=TexMan.CheckForTexture(colorIndex==1 ? 'UFEGA0' : colorIndex==2 ? 'UFECA0' : 'UFEBA0');
        SetRenderStyle(STYLE_Add); Flags|=SPF_FULLBRIGHT;
        Width=FRandom[utntcosmetic](2.8,4.5)*small;
        Height=Width*FRandom[utntcosmetic](1.0,1.35);
        Life=Random[utntcosmetic](28,46); Strength=0.95;
        // Color is supplied by the matching material, including fullbright rendering.
        scolor=0xffffffff;
        Vel=(FRandom[utntcosmetic](-0.23,0.23),FRandom[utntcosmetic](-0.23,0.23),FRandom[utntcosmetic](0.8,1.35)*small);
        Roll=FRandom[utntcosmetic](-35,35);
    }

    void Animate()
    {
        double t=double(Age)/Life;
        double growth=Smoke ? 1+1.25*t : 1-0.45*t;
        let size=TexMan.GetScaledSize(Texture);
        Scale=(Width*growth/size.X,Height*growth/size.Y);
        Alpha=Strength*min(1.0,(Age+1)/(Smoke ? 12.0 : 2.0))*min(1.0,(Life-Age)/(Smoke ? 24.0 : 14.0));
    }

    override void Tick()
    {
        if (!Source) { Destroy(); return; }
        if (IsFrozen() || Source.IsFrozen()) return;
        if (++Age>=Life || !UTNTVisuals.Visible(Source,combat:true)) { Destroy(); return; }
        Super.Tick();
        Vel.X+=0.006*sin(Age*9+Phase);
        if (Smoke) Vel.Y+=0.005*cos(Age*8+Phase);
        Roll+=Smoke ? SmokeSpin : 0.35;
        Animate();
    }
}

class UTNTFireSystem play
{
    static void EnsureSpawner(UTNTFireSpawnerBase source, int tier)
    {
        if (!source || !source.UTNTFireActive || !UTNTVisuals.Visible(source,combat:true)) return;
        int phase=(int(source.Pos.X)*3+int(source.Pos.Y)*5+int(source.Pos.Z))&15;
        if ((level.time+phase)%16!=0) return;
        let iter=ThinkerIterator.Create('UTNTFireEmitter',Thinker.STAT_USER+5,true);
        UTNTFireEmitter fire;
        while(fire=UTNTFireEmitter(iter.Next())) if(fire.Source==source) return;
        fire=UTNTFireEmitter(level.CreateClientSideThinker('UTNTFireEmitter',Thinker.STAT_USER+5));
        if(!fire) return;
        fire.Initialize(source,0,0);
        fire.FloorFire=true; fire.Anchor=0;
        // Original Flame1/4/7 scales are 0.35/0.70/1.40: preserve 1:2:4.
        fire.EffectScale=1.2*(tier==0 ? 1 : tier==1 ? 2 : 4);
    }

    static void Ensure(Actor source, int color, int kind)
    {
        if (!source) return;
        int phase=(int(source.Pos.X)*3+int(source.Pos.Y)*5+int(source.Pos.Z))&15;
        if ((level.time+phase)%16!=0 || !UTNTVisuals.Visible(source,combat:true)) return;
        let iter=ThinkerIterator.Create('UTNTFireEmitter',Thinker.STAT_USER+5,true);
        UTNTFireEmitter fire;
        while (fire=UTNTFireEmitter(iter.Next())) if (fire.Source==source) return;
        fire=UTNTFireEmitter(level.CreateClientSideThinker('UTNTFireEmitter',Thinker.STAT_USER+5));
        if (fire) fire.Initialize(source,clamp(color,0,2),clamp(kind,0,2));
    }
}

class UTNTBurningBarrelBase : BurningBarrel
{
    action void A_UTNTBarrelFire() { UTNTFireSystem.Ensure(self,0,2); }
}

// DECORATE's historical replacement classes are still the map-facing types.
// Keep their native parents' gameplay defaults and their original body sprites.
mixin class UTNTFireAction
{
    action void A_UTNTAmbientFire(int color, int kind) { UTNTFireSystem.Ensure(self,color,kind); }
}
class UTNTLegacyRedFireBase : RedTorch { mixin UTNTFireAction; }
class UTNTLegacyGreenFireBase : GreenTorch { mixin UTNTFireAction; }
class UTNTLegacyBlueFireBase : BlueTorch { mixin UTNTFireAction; }
class UTNTLegacyShortRedFireBase : ShortRedTorch { mixin UTNTFireAction; }
class UTNTLegacyShortGreenFireBase : ShortGreenTorch { mixin UTNTFireAction; }
class UTNTLegacyShortBlueFireBase : ShortBlueTorch { mixin UTNTFireAction; }

// Keep DECORATE's map ID, arguments, switch states, sound and light actors.
class UTNTFireSpawnerBase : SwitchableDecoration
{
    bool UTNTFireActive;
    action void A_UTNTSpawnerFire(int tier)
    {
        let source=UTNTFireSpawnerBase(self);
        if(!source) return;
        source.UTNTFireActive=true;
        UTNTFireSystem.EnsureSpawner(source,clamp(tier,0,2));
    }
    action void A_UTNTSpawnerStop()
    {
        let source=UTNTFireSpawnerBase(self);
        if(source) source.UTNTFireActive=false;
    }
}

// Palette-native flame chips: separate from the soft, shader-lit torch embers.
class UTNTLostSoulEmber : VisualThinker
{
    Actor Source;
    int Age, Life;
    Vector2 InitialScale;

    void Initialize(Actor owner)
    {
        Source=owner;
        Texture=TexMan.CheckForTexture(String.Format("ULSE%c0",65+Random[utntcosmetic](0,2)));
        Flags=SPF_FULLBRIGHT;
        SetRenderStyle(STYLE_Translucent);
        scolor=0xffffffff;
        bXFlip=Random[utntcosmetic](0,1);
        double rear=owner.Radius*FRandom[utntcosmetic](0.55,0.85);
        double side=owner.Radius*FRandom[utntcosmetic](-0.50,0.50);
        double facing=owner.Angle;
        // Births sit inside the rear flame, below the top of the original sprite.
        Pos=owner.Vec3Offset(-cos(facing)*rear-sin(facing)*side,
            -sin(facing)*rear+cos(facing)*side,owner.Height*FRandom[utntcosmetic](0.48,0.68));
        double drift=FRandom[utntcosmetic](0.20,0.45);
        Vel=(-cos(facing)*drift+FRandom[utntcosmetic](-0.12,0.12),
            -sin(facing)*drift+FRandom[utntcosmetic](-0.12,0.12),FRandom[utntcosmetic](0.16,0.38));
        Vel+=owner.Vel*0.10;
        Life=Random[utntcosmetic](16,24);
        double size=FRandom[utntcosmetic](0.55,0.85);
        InitialScale=(size,size); Scale=InitialScale; Alpha=1;
        Prev=Pos;
        UpdateSector(); UpdateSpriteInfo();
    }

    override void Tick()
    {
        if(!Source) { Destroy(); return; }
        if(IsFrozen() || Source.IsFrozen()) return;
        if(++Age>=Life || !UTNTVisuals.Visible(Source,combat:true)) { Destroy(); return; }
        Super.Tick();
        // Brief, opaque pixel flecks dissolve without becoming a tall dotted plume.
        Scale=InitialScale*(1-0.25*double(Age)/Life);
        Alpha=min(1.0,(Life-Age)/6.0);
    }
}

// DECORATE keeps every original AI state and timing; this base only emits visuals.
class UTNTLostSoulFXBase : LostSoul
{
    override void Tick()
    {
        Super.Tick();
        // Terror inherits UTNTLostSoul but has its own non-flaming sprite set.
        if (Health<=0 || sprite!=GetSpriteIndex("SKUL") || level.time%2!=0
            || !UTNTVisuals.Visible(self) || !UTNTVisuals.Reserve()) return;
        let spark=UTNTLostSoulEmber(level.SpawnClientSideVisualThinker('UTNTLostSoulEmber'));
        if (spark) spark.Initialize(self);
    }
}
