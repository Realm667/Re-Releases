// UTNT presentation effects. Simulation state is saved; interpolation is local.
class UTNTPlayerEffects : Behavior
{
    double Heat;
    int ExternalHeatUntil;
    double ExternalHeat;
    bool Cutscene;

    void SyncStatusBar()
    {
        if (!Owner || !Owner.player) return;
        bool hidden = Cutscene || (Owner.player.cheats & CF_TOTALLYFROZEN)
            || (Owner.player.camera && !Owner.player.camera.player)
            || level.MapName ~== "INTERMAP" || level.MapName ~== "ENDMAP01";
        let marker = Owner.FindInventory('UTNTHUDHidden');
        if (hidden && !marker) Owner.GiveInventory('UTNTHUDHidden', 1);
        else if (!hidden && marker) marker.Destroy();
    }

    override void Tick()
    {
        if (!Owner.player) return;
        SyncStatusBar();
        let handler = UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        double targetHeat = 0;
        if (handler && level.time % 5 == 0)
        {
            for (int i = 0; i < handler.HeatSources.Size(); i++)
            {
                let source = handler.HeatSources[i];
                if (!source || source.bDormant) continue;
                double radius = source.Default.Radius * source.Scale.X;
                if (radius <= 0 || Owner.Pos.Z > source.CeilingZ || (Owner.Pos.Z + Owner.Height) < source.FloorZ) continue;
                targetHeat = max(targetHeat, clamp(1.0 - source.Distance2D(Owner) / radius, 0.0, 1.0));
            }
            if (level.time < ExternalHeatUntil) targetHeat = max(targetHeat, ExternalHeat);
            Heat = max(targetHeat, Heat - 0.15);
        }
    }
}

class UTNTWorldHandler : EventHandler
{
    Array<EffectGiver> HeatSources;
    int BossKind, BossHP, BossMaxHP, BossFirstTID, BossLastTID, BossEndTime;
    bool AtmosphereApplied;
    Array<int> AtmosphereSectors;
    Array<Color> AtmosphereOriginalFades;
    String VoiceKey;
    int VoiceStartTime, VoiceEndTime;
    Array<String> VoiceQueueKeys, VoiceQueueSounds;
    Array<int> VoiceQueueDurations;

    static void BeginVoice(String key, int seconds, String soundName = "", int durationTics = 0)
    {
        let handler=UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if (!handler || key.Length()==0) return;
        // Prevent duplicate triggers from queuing the same line repeatedly in coop.
        if (handler.VoiceKey==key && level.time<handler.VoiceEndTime) return;
        for (int i=0; i<handler.VoiceQueueKeys.Size(); i++)
            if (handler.VoiceQueueKeys[i]==key) return;
        handler.VoiceQueueKeys.Push(key);
        handler.VoiceQueueSounds.Push(soundName);
        handler.VoiceQueueDurations.Push(max(max(1,seconds)*35,durationTics));
    }

    void TickVoice()
    {
        if (level.time<VoiceEndTime+18 || !VoiceQueueKeys.Size()) return;
        VoiceKey=VoiceQueueKeys[0];
        String soundName=VoiceQueueSounds[0];
        VoiceStartTime=level.time;
        int duration=VoiceQueueDurations[0];
        if (soundName.Length()>0)
        {
            S_StartSound(Sound(soundName),CHAN_VOICE,0,1.0,ATTN_NONE); // Original ACS volume: 127 / 127.
        }
        VoiceEndTime=level.time+duration;
        VoiceQueueKeys.Delete(0); VoiceQueueSounds.Delete(0); VoiceQueueDurations.Delete(0);
    }

    static bool SafeCheckpointMove(Actor pawn, Vector3 point)
    {
        if (!pawn) return false;
        // TeleportMove ignores non-shootable solids. CheckPosition also permits
        // existing player overlaps for unsticking, so reject occupied volumes first.
        let actors=BlockThingsIterator.CreateFromPos(point.X,point.Y,point.Z,pawn.Height,pawn.Radius,false);
        while (actors.Next())
        {
            let other=actors.thing;
            if (other==pawn || !other.bSolid) continue;
            double radius=pawn.Radius+other.Radius;
            Vector3 relative=actors.position;
            if (abs(other.Pos.X-relative.X)<radius && abs(other.Pos.Y-relative.Y)<radius
                && relative.Z<other.Pos.Z+other.Height && relative.Z+pawn.Height>other.Pos.Z)
                return false;
        }
        Vector3 previous=pawn.Pos;
        bool pickup=pawn.bPickup;
        pawn.bPickup=false;
        pawn.SetOrigin(point,false);
        FCheckPosition check;
        bool fits=pawn.CheckPosition(point.XY,false,check)
            && point.Z>=check.floorz && point.Z+pawn.Height<=check.ceilingz;
        pawn.SetOrigin(previous,false);
        pawn.bPickup=pickup;
        return fits && pawn.TeleportMove(point,false);
    }

    static bool RespawnAtCheckpoint(int playerNumber, int checkpoint)
    {
        if (playerNumber<0 || playerNumber>=MAXPLAYERS || checkpoint<1 || checkpoint>3) return false;
        let pawn=players[playerNumber].mo;
        if (!pawn || pawn.Health<=0) return false;
        // Prefer the player's map-authored destination, then other authored slots.
        for (int slot=0; slot<8; slot++)
        {
            int destination=1000+checkpoint*100+(playerNumber+slot)%8;
            let it=ActorIterator.Create(destination);
            Actor spot;
            while (spot=it.Next())
            {
                if (SafeCheckpointMove(pawn,spot.Pos))
                { pawn.Angle=spot.Angle; pawn.Vel=(0,0,0); return true; }
                // Collision-checked ring; walls, actors and low ceilings remain solid.
                double spacing=max(64,pawn.Radius*2+8);
                for (int ring=1; ring<=2; ring++)
                    for (int step=0; step<8; step++)
                    {
                        double angle=(step+playerNumber)*45;
                        Vector3 point=spot.Pos+(cos(angle)*spacing*ring,sin(angle)*spacing*ring,0);
                        if (SafeCheckpointMove(pawn,point))
                        { pawn.Angle=spot.Angle; pawn.Vel=(0,0,0); return true; }
                    }
            }
        }
        return false; // Keep the valid engine spawn if no checkpoint position is safe.
    }

    override void WorldTick()
    {
        TickVoice();
        // A shared opt-in because distant visibility must agree in cooperative play.
        bool enabled = CVar.GetCVar('UTNT_atmosphere').GetBool()
            && (level.MapName ~== "TNT03A1" || level.MapName ~== "TNT03A2" || level.MapName ~== "TNTLE");
        if (enabled == AtmosphereApplied) return;
        // Per-map profiles retain existing sector colors and nearby combat contrast.
        double distance=level.MapName ~== "TNT03A1" ? 10240 : level.MapName ~== "TNT03A2" ? 8192 : 12288;
        double density=level.MapName ~== "TNTLE" ? 1.05 : 1.12;
        double mistScale=level.MapName ~== "TNT03A2" ? 0.8 : level.MapName ~== "TNTLE" ? 1.25 : 1.0;
        level.ChangeSkyMist(TexMan.CheckForTexture('SKYMISTA'),enabled,mistScale);
        level.SetThickFog(enabled ? distance : -1,enabled ? density : 30);
        if (enabled)
        {
            TextureID sky=TexMan.CheckForTexture('F_SKY1');
            Color tint=level.MapName ~== "TNTLE" ? 0x21160f : level.MapName ~== "TNT03A2" ? 0x131923 : 0x101823;
            for (int i=0;i<level.Sectors.Size();i++)
            {
                let sector=level.Sectors[i];
                if (sector.GetTexture(Sector.ceiling)!=sky || sector.ColorMap.FadeColor!=0) continue;
                AtmosphereSectors.Push(i); AtmosphereOriginalFades.Push(sector.ColorMap.FadeColor);
                sector.SetFade(tint);
            }
        }
        else
        {
            Color tint=level.MapName ~== "TNTLE" ? 0x21160f : level.MapName ~== "TNT03A2" ? 0x131923 : 0x101823;
            for(int i=0;i<AtmosphereSectors.Size();i++)
            {
                let sector=level.Sectors[AtmosphereSectors[i]];
                // A map script may take ownership while this option is enabled.
                // Preserve that newer authored state instead of restoring stale color.
                if(sector.ColorMap.FadeColor==tint) sector.SetFade(AtmosphereOriginalFades[i]);
            }
            AtmosphereSectors.Clear(); AtmosphereOriginalFades.Clear();
        }
        AtmosphereApplied = enabled;
    }

    override void WorldLoaded(WorldEvent e)
    {
        HeatSources.Clear();
        let iter = ThinkerIterator.Create('EffectGiver');
        EffectGiver source;
        while (source = EffectGiver(iter.Next())) HeatSources.Push(source);
        for (int i = 0; i < MAXPLAYERS; i++)
            if (playeringame[i] && players[i].mo) players[i].mo.AddBehavior('UTNTPlayerEffects');
    }

    override void WorldThingSpawned(WorldEvent e)
    {
        if (e.Thing is 'EffectGiver') HeatSources.Push(EffectGiver(e.Thing));
        if (e.Thing is 'Marine') e.Thing.AddBehavior('UTNTPlayerEffects');
    }

    override void WorldThingDestroyed(WorldEvent e)
    {
        if (!(e.Thing is 'EffectGiver')) return;
        for (int i = HeatSources.Size() - 1; i >= 0; i--)
            if (!HeatSources[i] || HeatSources[i] == e.Thing) HeatSources.Delete(i);
    }

    // ACS adapters preserve map script names, numbers, TIDs and completion actions.
    static void SetCutscene(Actor player, bool active)
    {
        if (!player || !player.player) return;
        let effects = UTNTPlayerEffects(player.AddBehavior('UTNTPlayerEffects'));
        effects.Cutscene = active;
        effects.SyncStatusBar();
    }

    static void CutsceneForTID(int tid, bool active)
    {
        for (int i=0; i<MAXPLAYERS; i++)
            if (playeringame[i] && players[i].mo && (tid == -1 || players[i].mo.TID == tid))
                SetCutscene(players[i].mo, active);
    }

    static void BeginBoss(int firstTID, int lastTID, int kind, int maxHP)
    {
        let handler = UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if (!handler || kind < 1 || kind > 5 || maxHP <= 0 || firstTID <= 0 || lastTID < firstTID || lastTID-firstTID > 128) return;
        handler.BossKind = kind;
        handler.BossFirstTID = firstTID;
        handler.BossLastTID = lastTID;
        handler.BossMaxHP = maxHP;
        handler.BossHP = maxHP;
        handler.BossEndTime = 0;
    }

    static void UpdateBoss(int hp)
    {
        let handler = UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if (!handler) return;
        handler.BossHP = max(0, hp);
        if (hp <= 0 && !handler.BossEndTime) handler.BossEndTime = level.time + 70;
    }
}

class UTNTPresentation : StaticEventHandler
{
    ui double DisplayHP, DamageHP, PreviousBossHP;
    ui int DamageHold, BossWorldGeneration;
    ui int LastBossKind;
    ui Actor LastCamera;
    ui double LastAngle, LastPitch, BlurX, BlurY, LastFrameTime;
    ui Vector3 LastPosition;
    ui bool HaveView;
    int WorldGeneration;
    ui int LastWorldGeneration;
    ui String CachedVoiceText;
    ui BrokenLines CachedVoiceLines;
    ui int CachedVoiceWidth, CachedVoiceWidest;
    ui Array<int> CachedVoiceLineWidths;

    override void WorldLoaded(WorldEvent e)
    {
        WorldGeneration++;
    }

    override void UiTick()
    {
        let handler = UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if (handler && handler.BossMaxHP > 0)
        {
            double hp = clamp(double(handler.BossHP) / handler.BossMaxHP, 0.0, 1.0);
            bool reduced=CVar.GetCVar('UTNT_reducedfx',players[consoleplayer]).GetBool();
            if (LastBossKind != handler.BossKind || BossWorldGeneration != WorldGeneration || reduced)
            { DisplayHP=DamageHP=hp; DamageHold=0; }
            else
            {
                if (hp<PreviousBossHP) { DamageHP=max(DamageHP,DisplayHP); DamageHold=8; }
                DisplayHP+=(hp-DisplayHP)*0.5;
                if (DamageHold>0) DamageHold--;
                else DamageHP+=(hp-DamageHP)*0.15;
                DamageHP=max(DamageHP,DisplayHP);
            }
            PreviousBossHP=hp;
            BossWorldGeneration=WorldGeneration;
            LastBossKind=handler.BossKind;
        }
        else { DisplayHP=DamageHP=PreviousBossHP=0; DamageHold=0; LastBossKind=0; }
    }

    ui void DrawVoice(PlayerInfo player)
    {
        let handler=UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if (!handler || handler.VoiceKey.Length()==0 || level.time>=handler.VoiceEndTime+18
            || !CVar.GetCVar('UTNT_subtitles',player).GetBool()) return;
        double scale=max(0.5,min(Screen.GetWidth()/640.0,Screen.GetHeight()/480.0))
            *clamp(CVar.GetCVar('UTNT_subtitlescale',player).GetFloat(),0.75,1.5);
        Font font=Font.GetFont('SmallFont');
        String text=StringTable.Localize("$"..handler.VoiceKey);
        if (CVar.GetCVar('UTNT_subtitlespeaker',player).GetBool())
            text=StringTable.Localize('$UTNT_VOICE_SPEAKER')..": "..text;
        int wrapWidth=max(40,int(Screen.GetWidth()*0.85/scale));
        if (!CachedVoiceLines || text!=CachedVoiceText || wrapWidth!=CachedVoiceWidth)
        {
            CachedVoiceText=text; CachedVoiceWidth=wrapWidth;
            CachedVoiceLines=font.BreakLines(text,wrapWidth);
            CachedVoiceLineWidths.Clear(); CachedVoiceWidest=0;
            for(int i=0;i<CachedVoiceLines.Count();i++)
            {
                int width=font.StringWidth(CachedVoiceLines.StringAt(i));
                CachedVoiceLineWidths.Push(width);
                CachedVoiceWidest=max(CachedVoiceWidest,width);
            }
        }
        double alpha=clamp(min((level.time-handler.VoiceStartTime+1)/18.0,(handler.VoiceEndTime+18-level.time)/18.0),0,1);
        int count=CachedVoiceLines.Count();
        double lineHeight=(font.GetHeight()+2)*scale;
        double y=Screen.GetHeight()*0.80-count*lineHeight;
        int widest=CachedVoiceWidest;
        if (CVar.GetCVar('UTNT_subtitlebackground',player).GetBool())
            Screen.Dim(0x080808,alpha*0.7,int((Screen.GetWidth()-widest*scale)/2-6*scale),int(y-4*scale),int((widest+12)*scale),int(count*lineHeight+8*scale));
        for (int i=0; i<count; i++)
        {
            String line=CachedVoiceLines.StringAt(i);
            Screen.DrawText(font,Font.CR_UNTRANSLATED,(Screen.GetWidth()-CachedVoiceLineWidths[i]*scale)/2,y+i*lineHeight,line,
                DTA_ScaleX,scale,DTA_ScaleY,scale,DTA_Alpha,alpha);
        }
    }

    override void RenderOverlay(RenderEvent e)
    {
        if (LastWorldGeneration != WorldGeneration)
        {
            HaveView=false; LastCamera=null; BlurX=0; BlurY=0; LastBossKind=0;
            LastWorldGeneration=WorldGeneration;
        }
        let player = players[consoleplayer];
        if (!player) return;
        let camera = e.Camera;
        bool reduced = CVar.GetCVar('UTNT_reducedfx', player).GetBool();
        let effects = camera ? UTNTPlayerEffects(camera.FindBehavior('UTNTPlayerEffects')) : null;
        bool cutscene = effects && effects.Cutscene;
        if (player.cheats & CF_TOTALLYFROZEN) cutscene = true;

        bool heatOn = camera && !reduced && CVar.GetCVar('UTNT_shaderoverlayswitch', player).GetBool()
                      && CVar.GetCVar('UTNT_heatstrength', player).GetFloat() > 0 && effects && effects.Heat > 0.001;
        Shader.SetEnabled(player, 'heatshader', heatOn);
        if (heatOn) Shader.SetUniform1f(player, 'heatshader', 'amount', effects.Heat * 69 * clamp(CVar.GetCVar('UTNT_heatstrength', player).GetFloat(), 0, 1));
        double waterSize = clamp(CVar.GetCVar('UTNT_uweffectsize', player).GetFloat(), 0, 0.08);
        bool underwater = camera && !reduced && camera.WaterLevel >= 3 && waterSize > 0;
        Shader.SetEnabled(player, 'watershader', underwater);
        if (underwater) Shader.SetUniform1f(player, 'watershader', 'waterFactor', waterSize);

        bool blurOn = camera && player.mo && player.health > 0 && !cutscene && !reduced
                      && !LevelLocals.WorldPaused() && CVar.GetCVar('motionblur', player).GetBool();
        double frameTime = (level.time + e.FracTic) / 35.0;
        double dt = frameTime - LastFrameTime;
        bool reset = !HaveView || camera != LastCamera || (e.ViewPos - LastPosition).Length() > 128 || dt <= 0 || dt > 0.25;
        if (!blurOn || reset) { BlurX = 0; BlurY = 0; }
        else
        {
            double yaw = Actor.DeltaAngle(LastAngle, e.ViewAngle);
            double pitch = e.ViewPitch - LastPitch;
            // Normalize angular velocity to one game tic; decay is time based.
            double x = yaw / (dt * 35.0), y = pitch / (dt * 35.0);
            double decay = (1-clamp(CVar.GetCVar('motionblur_recovery', player).GetFloat(), 1, 100)/100) ** (dt*35);
            BlurX = BlurX*decay + clamp(x/180, -0.04, 0.04)*(1-decay);
            BlurY = BlurY*decay + clamp(y/120, -0.04, 0.04)*(1-decay);
            if (CVar.GetCVar('motionblur_autostop', player).GetBool())
            {
                double threshold = clamp(CVar.GetCVar('motionblur_threshold', player).GetFloat(), 0, 100)*30*180/32768;
                double stopDecay = (1-clamp(CVar.GetCVar('motionblur_recovery2', player).GetFloat(), 0, 100)/100) ** (dt*35);
                if (abs(x)<threshold) BlurX*=stopDecay;
                if (abs(y)<threshold) BlurY*=stopDecay;
            }
        }
        LastFrameTime = frameTime;
        LastCamera = camera;
        LastAngle = e.ViewAngle; LastPitch = e.ViewPitch; LastPosition = e.ViewPos; HaveView = camera != null;
        double strength = clamp(CVar.GetCVar('motionblur_strength', player).GetFloat(), 0, 100) / 64.0;
        int copies = clamp(CVar.GetCVar('motionblur_samples', player).GetInt(), 1, 12) + 1;
        Shader.SetEnabled(player, 'motionblur', blurOn && !reset && abs(BlurX) + abs(BlurY) > 0.00001);
        Shader.SetUniform2f(player, 'motionblur', 'steps', (BlurX, BlurY) * strength / copies);
        Shader.SetUniform1i(player, 'motionblur', 'samples', copies);
        Shader.SetUniform1f(player, 'motionblur', 'increment', 1.0 / copies);
        Shader.SetUniform1i(player, 'motionblur', 'blendmode', clamp(CVar.GetCVar('motionblur_blendmode', player).GetInt(), 0, 1));
        DrawVoice(player);

        let handler = UTNTWorldHandler(EventHandler.Find('UTNTWorldHandler'));
        if (!handler || !handler.BossKind || handler.BossMaxHP <= 0 || !camera || cutscene || !CVar.GetCVar('UTNT_bosshud', player).GetBool()) return;
        if (handler.BossEndTime && level.time >= handler.BossEndTime) return;
        double alpha=handler.BossEndTime ? clamp((handler.BossEndTime-level.time)/35.0,0,1) : 1;
        bool shielded = false;
        if (handler.BossKind == 5)
        {
            let bossIter = ActorIterator.Create(handler.BossFirstTID);
            let boss = bossIter.Next();
            shielded = boss && boss.bInvulnerable;
        }
        UTNTBossPlaque.Draw(handler.BossKind,double(handler.BossHP)/handler.BossMaxHP,
            DisplayHP,DamageHP,shielded,CVar.GetCVar('UTNT_bosspercent',player).GetBool(),alpha);
    }
}
