MN_OPNORM = "Normal";
UTNT_COMMON_054 = "Torment And Torture";
UTNT_COMMON_055 = "\cGZiele:\n";
UTNT_COMMON_056 = "\cR...verdammt, das ist eine teuflische Maschine!";
UTNT_COMMON_057 = "\cCCoop-\cGCheckpoint \cCerreicht";
UTNT_COMMON_058 = "\cCZiel erfüllt:\n\cGDu hast die Portalwächter getötet.";
UTNT_INTRO_001 = "Episode 1: Der offene Abgrund";
UTNT_INTRO_002 = "Episode 2: Die Waffenkammer der Qual";
UTNT_INTRO_003 = "Episode 3, Teil 1: Der verfluchte Gipfel";
UTNT_INTRO_004 = "Episode 3, Teil 2: Das böse Herz";
UTNT_INTRO_005 = "Episode 4, Teil 1: In die Dunkelheit";
UTNT_INTRO_006 = "Episode 4, Teil 2: Jenseits des dunklen Portals";
UTNT_INTRO_007 = "Episode 4, Teil 3: Anfang und Ende (Director's Cut)";
UTNT_INTRO_008 = "Episode 4, Teil 3: Anfang und Ende";
UTNT_INTRO_009 = "Verlorene Episode: Die Wut des Feuers";
UTNT_INTRO_010 = "Kämpfe dich zum Technikzentrum vor.\nPassiere den Kerker und verlasse den ersten Verteidigungsring.";
UTNT_INTRO_011 = "Finde den Kontrollraum von Anlage A.\nBetritt die verlassene Anlage B.\nFinde den Weg zum verfluchten Gipfel und verlasse die Waffenkammer.";
UTNT_INTRO_012 = "Kämpfe dich zum Lagerbereich vor.\nFinde die Bergbauanlage.\nVerlasse die Anlage im Süden in Richtung Festung.";
UTNT_INTRO_013 = "Töte die Portalwächter.\nZerstöre das dunkle Portal.";
UTNT_INTRO_014 = "Finde das Plasmagewehr beim Uhrturm.\nTöte die Spider Masterminds, um die Säulen abzusenken.\nBetritt das dunkle Portal.";
UTNT_INTRO_015 = "Finde einen Weg zum Rand des Chaos.\nFinde die BFG9000.";
UTNT_INTRO_016 = "Kämpfe dich zur ewigen Höhle vor.\nZerstöre die Quelle und ihre Wächter.";
UTNT_INTRO_017 = "Kämpfe dich zum Gipfel vor.\nZerstöre die Quelle und ihre Wächter.";
UTNT_INTRO_018 = "Kämpfe dich aus den Höhlen nach oben.\nFinde das Herz des Portalkerns.";
UTNT_VOICE_019 = "Na dann, suchen wir uns etwas Frischfleisch!";
UTNT_VOICE_020 = "Was zum...!";
UTNT_VOICE_021 = "Hmm... hier riecht es nach Tod und Gefahr. Könnte auch mein Rasierwasser sein!";
UTNT_VOICE_022 = "Oh oh!";
UTNT_VOICE_023 = "Hmhmhm... das war fast zu einfach!";
UTNT_VOICE_024 = "Nächstes Mal halte ich lieber die Klappe!";
UTNT_VOICE_025 = "Das Wetter auf Tei Tenga war viel besser... ich hätte dort bleiben sollen!";
UTNT_VOICE_026 = "[Unverständlicher Fluch] ...dich selbst!";
UTNT_VOICE_027 = "Die Totgeweihten grüßen dich!";
UTNT_VOICE_028 = "Ist das schon alles?!";
UTNT_VOICE_029 = "Oh oh!";
UTNT_VOICE_030 = "Tritt vor deinen Schöpfer!";
UTNT_VOICE_031 = "Die Waffenkammer gefiel mir irgendwie besser. Diese wohlige Wärme von verarbeitetem Stahl und explodierenden Dämonenleibern.";
UTNT_VOICE_032 = "In den Tiefen der Welt gibt es ältere und abscheulichere Dinge als Imps.";
UTNT_VOICE_033 = "Oh ja, da wird einem richtig warm ums Herz.";
UTNT_VOICE_034 = "Zeit, den Grill anzuwerfen!";
UTNT_VOICE_035 = "Hm... komm raus, komm raus, wo immer du bist...";
UTNT_VOICE_036 = "Ich hasse Spinnen!";
UTNT_VOICE_037 = "Jetzt gibt es kein Zurück mehr... Zeit zu zeigen, was in mir steckt!";
UTNT_VOICE_038 = "Ich kann sie spüren... die böse Macht hinter diesem dunklen Portal... die Quelle des Bösen. Sie bringt Hunderte Dämonen hervor, die Jagd auf die Menschheit machen. Diesmal auf unserer Heimatwelt, der Erde selbst. Ich spüre beinahe die kalte Hand des Todes auf meiner Haut...";
UTNT_VOICE_039 = "...wie sie nach meiner Seele greift. Ich weiß, dass diese letzte Mission mein Leben fordern wird. Es ist meine Bestimmung, mein Schicksal, in diesem Krieg zu sterben. Die einzige Chance, die zu retten, die ich liebe. Aber was, wenn hinter all dem noch viel mehr liegt, als ich spüren kann?";
UTNT_VOICE_040 = "Oh ja, jetzt geht es richtig los, Jungs!";
UTNT_VOICE_041 = "Erwischt! Zeit, diesen gottverlassenen Ort zu verlassen!";
UTNT_VOICE_042 = "Wow... ein Déjà-vu!";
UTNT_VOICE_043 = "Nun, ich glaube kaum, dass er das noch braucht.";
UTNT_VOICE_044 = "Mein Gott... das ist die Hölle!";
UTNT_VOICE_045 = "Ist das alles? Her mit dem Rest!";
UTNT_VOICE_046 = "Hier fängt es wohl erst richtig an... und hier endet es. Jetzt!";
UTNT_VOICE_047 = "Du hältst mich nicht auf!";
UTNT_VOICE_048 = "Hoppla!";
UTNT_VOICE_049 = "Jetzt stecke ich wirklich in Schwierigkeiten... na dann, Sieg Heil!";
UTNT_VOICE_050 = "Eine massive Wand. Da passiert wahrscheinlich nichts, wenn ich dagegen drücke!";
UTNT_VOICE_051 = "Ja, Baby! Durchladen und los!";
UTNT_VOICE_052 = "Ich schwöre, diesen Ort habe ich schon einmal gesehen.";
UTNT_VOICE_053 = "Ich habe ein ganz mieses Gefühl... was auch immer das getan hat, muss sehr mächtig gewesen sein...";

UTNT_NO = "Nein";
UTNT_YES = "Ja";
UTNT_OFF = "Aus";
UTNT_ON = "An";

