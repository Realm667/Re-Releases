UTNT_HUD_BERSERK = "Berserker-Anzeige";
UTNT_HUD_INTERPOLATE = "Lebens- und Rüstungswerte glätten";
UTNT_HUD_TRANS = "Transparente Vollbildleiste";
UTNT_HUD_PERCENT = "Prozent";
UTNT_HUD_PERCENT_TIME = "Prozent und Zeit";
UTNT_HUD_REMAINING = "Verbleibend";
UTNT_HUD_REMAINING_TIME = "Verbleibend und Zeit";
UTNT_HUD_TOPLEFT = "Oben links";
UTNT_HUD_TOPRIGHT = "Oben rechts";
UTNT_HUD_BOTTOMLEFT = "Unten links";
UTNT_HUD_BOTTOMRIGHT = "Unten rechts";
UTNT_HUD_GAS = "GAS";

