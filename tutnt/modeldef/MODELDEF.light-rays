// A radial volume for ordinary downlights. Wall sprites retain their authored
// plane: several existing maps use negative scale or a rolled wide light sheet.
Model LightRay_Regular
{
 Path "models/light-rays/"
 Model 0 "shaft.obj"
 Skin 0 "URAYVOL"
 Scale 1 1 1.2
 DontCullBackfaces
 FrameIndex VOLT A 0 0
}
Model LightRay_RegularNL
{
 Path "models/light-rays/"
 Model 0 "shaft.obj"
 Skin 0 "URAYVOL"
 Scale 1 1 1.2
 DontCullBackfaces
 FrameIndex VOLT A 0 0
}
