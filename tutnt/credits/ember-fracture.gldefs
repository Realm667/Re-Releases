// Approved ending fracture. All data maps share the diffuse UVs, including POM.
Material Flat "UECRACK"
{
 Shader "shaders/credits/ember-fracture.fp"
 Define ORGANIC_DEPTH = "4.0"
 Define ORGANIC_TRACE_TOP = "-0.16"
 Define ORGANIC_TRACE_BOTTOM = "1.0"
 Define ORGANIC_BASE_HEIGHT = "0.65"
 Define ORGANIC_SHADE = "0.30"
 Normal "materials/credits/fracture/normal.png"
 Brightmap "materials/credits/fracture/brightmap.png"
 Specular "materials/organic/black.png"
 Texture organicHeight "materials/credits/fracture/height.png"
 Texture rockUnderlay "ROCKF7"
}
