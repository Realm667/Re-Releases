// Scene pass excludes all 2D credit cards, text and black fades.
HardwareShader PostProcess scene
{
 Name "UTNTEndingLook"
 Shader "shaders/credits/ash-ember.fp" 330
 Uniform vec4 sparkAccent
 // 15 aligned vec4s = 240 bytes; avoid scalar padding exceeding Vulkan push constants.
 Uniform vec4 lookParams
 Uniform vec4 viewport
 Uniform vec4 blur0
 Uniform vec4 blur1
 Uniform vec4 blur2
 Uniform vec4 blur3
 Uniform vec4 blur4
 Uniform vec4 blur5
 Uniform vec4 blur6
 Uniform vec4 blur7
 Uniform vec4 blur8
 Uniform vec4 blur9
 Uniform vec4 blur10
 Uniform vec4 blur11
}

#include "credits/ember-fracture.gldefs"
