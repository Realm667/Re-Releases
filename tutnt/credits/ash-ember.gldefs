// Scene pass excludes all 2D credit cards, text and black fades.
HardwareShader PostProcess scene
{
 Name "UTNTEndingLook"
 Shader "shaders/credits/ash-ember.fp" 330
 Uniform vec4 viewport
 Uniform float focusDistance
 Uniform float aperture
 Uniform float strength
 Uniform float grainTime
 Uniform vec4 depth0
 Uniform vec4 depth1
 Uniform vec4 depth2
 Uniform vec4 depth3
 Uniform vec4 depth4
 Uniform vec4 depth5
 Uniform vec4 depth6
 Uniform vec4 depth7
 Uniform vec4 depth8
}
