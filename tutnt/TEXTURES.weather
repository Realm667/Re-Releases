// Replace RGB only; preserve the source alpha and the existing weather opacity.
Graphic UTNTRainGrey, 8, 64
{
    Patch "graphics/utnt-weather/rain.png", 0, 0 { Blend "80 80 80", 1.0 }
}
Graphic UTNTRainDropGrey, 16, 16
{
    Patch "graphics/utnt-weather/snow0.png", 0, 0 { Blend "80 80 80", 1.0 }
}
Graphic UTNTRippleGrey, 48, 24
{
    Patch "graphics/utnt-weather/ripple.png", 0, 0 { Blend "80 80 80", 1.0 }
}

Graphic UTNTSnowGrey0, 16, 16
{
    Patch "graphics/utnt-weather/snow0.png", 0, 0 { Blend "CC CC CC", 1.0 }
}

Graphic UTNTSnowGrey1, 16, 16
{
    Patch "graphics/utnt-weather/snow1.png", 0, 0 { Blend "CC CC CC", 1.0 }
}

Graphic UTNTSnowGrey2, 16, 16
{
    Patch "graphics/utnt-weather/snow2.png", 0, 0 { Blend "CC CC CC", 1.0 }
}

Graphic UTNTSnowVeil, 627, 627
{
    Patch "graphics/utnt-fire/smoke-atlas.png", 0, 0
}

Graphic UTNTRainVeil, 627, 627
{
    Patch "graphics/utnt-fire/smoke-atlas.png", 0, 0
}
