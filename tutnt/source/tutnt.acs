int position; //this variable logs your progress through the map. 0 means you're at the start still,and restart at the player starts.
#define UTNT_MAX_PLAYERS 64
#define UTNT_MAX_PORTALS 64
int PortalTIDs[UTNT_MAX_PORTALS];
int PortalOn[UTNT_MAX_PORTALS];
int PlayerSeesPortal[UTNT_MAX_PORTALS][UTNT_MAX_PLAYERS];
int BossStarted[5];

function void UpdatePortal(int slot)
{
    int seen=0;
    for (int p=0;p<UTNT_MAX_PLAYERS;p++)
        if (PlayerInGame(p) && PlayerSeesPortal[slot][p]) seen=1;
    if (seen != PortalOn[slot])
    {
        if (seen) Thing_Activate(PortalTIDs[slot]);
        else Thing_Deactivate(PortalTIDs[slot]);
        PortalOn[slot]=seen;
    }
}
function void ClearPortalPlayer(int p)
{
    if(p<0 || p>=UTNT_MAX_PLAYERS) return;
    for(int slot=0;slot<UTNT_MAX_PORTALS;slot++)
        if(PortalTIDs[slot]) { PlayerSeesPortal[slot][p]=0; UpdatePortal(slot); }
}

