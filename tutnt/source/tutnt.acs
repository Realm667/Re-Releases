//Intro Text - should be exported to language --ozy81
script "IntroText" OPEN
{
	int mapnum=GetLevelInfo(LEVELINFO_LEVELNUM);
	if(mapnum==99||mapnum==4||GameType()==GAME_TITLE_MAP)
		terminate;
	if(mapnum!=7 && mapnum!=8 && mapnum!=10)
		sector_setcolor(28,255,69,0);
	SetHudSize(640,480,0);
	Setfont("dbigfont");
	Hudmessage(l:"UTNT_COMMON_054"; HUDMSG_FADEINOUT,0,CR_WHITE,320.4,190.0,3.0,1.0,1.0);
	Setfont("smallfont");
	if(mapnum==1)
	{
		mapname="UTNT_INTRO_001";
		objectives="UTNT_INTRO_010";
	}
	else if(mapnum==2)
	{
		mapname="UTNT_INTRO_002";
		objectives="UTNT_INTRO_011";
	}
	else if(mapnum==3)
	{
		mapname="UTNT_INTRO_003";
		objectives="UTNT_INTRO_012";
	}
	else if(mapnum==5)
	{
		mapname="UTNT_INTRO_004";
		objectives="UTNT_INTRO_013";
	}
	else if(mapnum==6)
	{
		delay(1860);
		mapname="UTNT_INTRO_005";
		objectives="UTNT_INTRO_014";
	}
	else if(mapnum==7)
	{
		mapname="UTNT_INTRO_006";
		objectives="UTNT_INTRO_015";
	}
	else if(mapnum==8)
	{
		mapname="UTNT_INTRO_007";
		objectives="UTNT_INTRO_016";
	}
	else if(mapnum==9)
	{
		mapname="UTNT_INTRO_008";
		objectives="UTNT_INTRO_017";
	}
	else if(mapnum==10)
	{
		mapname="UTNT_INTRO_009";
		objectives="UTNT_INTRO_018";
	}
	Hudmessage(l:mapname; HUDMSG_FADEINOUT,0,CR_RED,320.4,205.0,3.0,1.0,1.0);
	delay(175);
	// Objectives are displayed only by the graphical HUD, without console messages.
	ScriptCall("UTNTWorldHandler", "BeginObjectives", mapnum);
}

