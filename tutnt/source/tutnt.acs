script 444 (int type,int color,int size) // Legacy external-call adapter; emitters use ZScript.
{
	if(type<0 || type>1 || color<0 || color>5 || size<0 || size>32767) terminate;
	size = size / 2 << 16;
	Spawn(p_spawner[type][color],GetActorX (0) + random (-size,size),
		GetActorY (0) + random (-size,size),GetActorZ (0),0,0);
}

//Healthbars - warning! related to maps -  to be replaced possibly --ozy81
script "BOSSHP"(int firstid,int lastid,int boss)
{
    if(boss<1 || boss>5 || firstid<=0 || lastid<firstid || lastid-firstid>128) terminate;
    if(BossStarted[boss-1]) terminate;
    int currenthp=0, hp;
    for(int i=firstid;i<=lastid;i++) { hp=GetActorProperty(i,APROP_HEALTH); if(hp>0) currenthp+=hp; }
    if(currenthp<=0) terminate;
    BossStarted[boss-1]=1;
    ScriptCall("UTNTWorldHandler","BeginBoss",firstid,lastid,boss,currenthp);
    while(currenthp>0)
    {
        delay(10);
        currenthp=0;
        for(i=firstid;i<=lastid;i++) { hp=GetActorProperty(i,APROP_HEALTH); if(hp>0) currenthp+=hp; }
        ScriptCall("UTNTWorldHandler","UpdateBoss",currenthp);
    }
	if(boss==1)
	{
		SetMusic("*");
		door_open(17,20);
		delay(35);
		ACS_NamedExecuteAlways("PlayerVoice",0,6);
	}
	if(boss==2)
	{
		SetMusic("");
		ceiling_raisebyvalue(57,20,32);
		door_open(58,20);
		delay(70);
		ACS_NamedExecuteAlways("PlayerVoice",0,12);
	}
	if(boss==3)
	{
		SetFont("NORMAL");
		printbold(l:"UTNT_COMMON_058");
		ambientsound("dudud",255);
		delay(105);
		setmusic("*");
		door_open(7,20);
		floor_lowertonearest(6,20);
	}
	if(boss==4)
	{
		SetMusic("");
		ACS_Terminate(40,0);
		Radius_Quake(6,140,0,10,41);
		delay(140);
		Teleport_NewMap(99,0);
	}
	if(boss==5)
	{
		SetMusic("");
		thing_deactivate(52);
		//Lines Normal
		SetLineBlocking(99,BLOCK_NOTHING);
		SetLineSpecial(99,0,0,0,0,0,0);
		acs_terminate(701,0);
		acs_terminate(134,0);
		thing_destroy(667);
		Radius_Quake(5,16*20,0,20,120);
		light_fade(17,112,16*20);
		light_fade(13,112,16*20);
		light_fade(14,112,16*20);
		for (int k = 250; k > 0; k -= 10)
		{
			TranslucentLine(88,k,1);
			TranslucentLine(99,k,1);
			TranslucentLine(96,k,1);
			Delay(16);
		}
		delay(140);
		Teleport_NewMap(99,0);
	}
}
script "UTNTCheckpoint"(int pos)
{ if(pos>=1 && pos<=3) checkpoint(pos); }

// TNTLE map statistics: one OPEN loop per map, not one ENTER loop per player.
// Reserved for SBARINFO; map-wide totals deliberately agree for all coop players.
global int 51:UTNT_KillPercent;
global int 52:UTNT_ItemPercent;
global int 53:UTNT_SecretPercent;
global int 54:UTNT_KillsLeft;
global int 55:UTNT_ItemsLeft;
global int 56:UTNT_SecretsLeft;

function int UTNT_StatPercent(int found, int total)
{
    if (total <= 0 || found >= total) return 100;
    if (found <= 0) return 0;
    return found * 100 / total;
}
function int UTNT_StatRemaining(int found, int total)
{
    if (found >= total) return 0;
    return total - found;
}
script "UTNT_HUDStats" OPEN
{
    while (TRUE)
    {
        int monsters = GetLevelInfo(LEVELINFO_TOTAL_MONSTERS);
        int kills = GetLevelInfo(LEVELINFO_KILLED_MONSTERS);
        int items = GetLevelInfo(LEVELINFO_TOTAL_ITEMS);
        int found = GetLevelInfo(LEVELINFO_FOUND_ITEMS);
        int secrets = GetLevelInfo(LEVELINFO_TOTAL_SECRETS);
        int discovered = GetLevelInfo(LEVELINFO_FOUND_SECRETS);
        UTNT_KillPercent = UTNT_StatPercent(kills, monsters);
        UTNT_ItemPercent = UTNT_StatPercent(found, items);
        UTNT_SecretPercent = UTNT_StatPercent(discovered, secrets);
        UTNT_KillsLeft = UTNT_StatRemaining(kills, monsters);
        UTNT_ItemsLeft = UTNT_StatRemaining(found, items);
        UTNT_SecretsLeft = UTNT_StatRemaining(discovered, secrets);
        Delay(8); // Four updates per second, independent of player count and HUD mode.
    }
}
