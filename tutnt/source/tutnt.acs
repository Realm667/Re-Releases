{
	{"EmberShot","EmberShot","EmberShot","EmberShot","EmberShot","EmberShot"},
	{"SparkleShot_W","SparkleShot_R","SparkleShot_G","SparkleShot_Y","SparkleShot_O","SparkleShot_B"},
