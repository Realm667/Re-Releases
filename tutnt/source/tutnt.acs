script "PlayerVoice"(int clip)
{
    if(clip<1 || clip>35) terminate;
	int holdtime=2.0;
	SetHudSize(640,480,0);
	SetFont("SmallFont");

	if(clip==2||clip==4||clip==11||clip==20||clip==21)
		holdtime=1.0;
	else if(clip==6||clip==7||clip==8||clip==26||clip==34)
		holdtime=3.0;
	else if(clip==3||clip==14||clip==19||clip==27||clip==32)
		holdtime=4.0;
	else if(clip==13)
		holdtime=7.0;
    ScriptCall("UTNTWorldHandler","BeginVoice",voicetext[clip-1],holdtime>>16,voiceclip[clip-1],voiceDuration[clip-1]);
    if(clip==2)
    {
        delay(210);
        ScriptCall("UTNTWorldHandler","BeginVoice","UTNT_COMMON_056",2);
    }
}

