skybox UGT24 { UGT24N UGT24E UGT24S UGT24W UGT24U UGT24D }
material texture UGT24N { shader "shaders/thunder/sky-N.fp" texture cloudmap "graphics/thunder/clouds.png" texture mountainmap "graphics/thunder/mountains.png" }
material texture UGT24E { shader "shaders/thunder/sky-E.fp" texture cloudmap "graphics/thunder/clouds.png" texture mountainmap "graphics/thunder/mountains.png" }
material texture UGT24S { shader "shaders/thunder/sky-S.fp" texture cloudmap "graphics/thunder/clouds.png" texture mountainmap "graphics/thunder/mountains.png" }
material texture UGT24W { shader "shaders/thunder/sky-W.fp" texture cloudmap "graphics/thunder/clouds.png" texture mountainmap "graphics/thunder/mountains.png" }
material texture UGT24U { shader "shaders/thunder/sky-U.fp" texture cloudmap "graphics/thunder/clouds.png" texture mountainmap "graphics/thunder/mountains.png" }
material texture UGT24D { shader "shaders/thunder/sky-D.fp" texture cloudmap "graphics/thunder/clouds.png" texture mountainmap "graphics/thunder/mountains.png" }
