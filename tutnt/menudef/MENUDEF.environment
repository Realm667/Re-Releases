OptionMenu "UTNTEnvironmentOptions"
{
    Title "$UTNT_ENV_TITLE"
    Option "$UTNT_ENV_WET", "UTNT_wetsurfaces", "UTNTYesNo"
    Option "$UTNT_ENV_PRINTS", "UTNT_footprints", "UTNTYesNo"
    Option "$UTNT_ENV_MECHANISMS", "UTNT_mechanismfx", "UTNTYesNo"
    StaticText ""
    Option "$UTNT_CRT_DISPLAY", "UTNT_crt", "UTNTYesNo"
    Option "$UTNT_CRT_REFLECTIONS", "UTNT_crtreflections", "UTNTYesNo"
    Option "$UTNT_CRT_MOTION", "UTNT_crtmotion", "UTNTYesNo"
    StaticText ""
    Option "$UTNT_ENV_WATER", "UTNT_underwateratmosphere", "UTNTYesNo"
    Slider "$UTNT_OPT_WATER", "UTNT_uweffectsize", 0, 0.04, 0.005, 3
}
