LISTMENU "MainMenu"
{
	StaticPatch 16,8,"M_DOOM"
	Position 97,72
	Font "DBIGFONT","DarkBrown"
	TextItem "$UTNT_MENU_NEW","n","PlayerclassMenu"
	TextItem "$UTNT_MENU_OPTIONS","o","OptionsMenu"
	TextItem "$UTNT_MENU_LOAD","l","LoadGameMenu"
	TextItem "$UTNT_MENU_SAVE","s","SaveGameMenu"
	TextItem "$UTNT_MENU_QUIT","q","QuitMenu"
}

ListMenu "EpisodeMenu"
{
	NetgameMessage "$NEWGAME"
	Position 48,63
	StaticPatch 54,38,"M_EPISOD"
	Font "DBIGFONT","DarkGray"
}

ListMenu "SkillMenu"
{
	StaticPatch 96, 14, "M_NEWG"
	StaticPatch 54, 38, "M_SKILL"
	Position 48, 63
	Font "DBIGFONT","DarkBrown"
}

// Extend both native menus at their actual submenu actions.
AddOptionMenu "OptionsMenuSimple" after "MiscOptionsSimple"
{
    Submenu "$UTNT_OPTIONS_TITLE", "UTNTOptions"
}
AddOptionMenu "OptionsMenu" after "MiscOptions"
{
    Submenu "$UTNT_OPTIONS_TITLE", "UTNTOptions"
}

OptionValue "UTNTQuality"
{
	0, "$MN_OPNONE"
	1, "$UTNT_QUALITY_LOW"
	2, "$UTNT_QUALITY_MEDIUM"
	3, "$UTNT_QUALITY_HIGH"
}

OptionValue "UTNTDist"
{
	0, "$MN_OPNONE"
	1024, "$MN_OPNEAR"
	2048, "$MN_OPNORM"
	4096, "$MN_OPFAR1"
	8192, "$MN_OPFAR2"
}

OptionValue "UTNTYesNo"
{
    0, "$UTNT_NO"
    1, "$UTNT_YES"
}
OptionValue "UTNTOnOff"
{
    0, "$UTNT_OFF"
    1, "$UTNT_ON"
}

OptionMenu "UTNTHUDOptions"
{
    Title "$UTNT_HUD_TITLE"
    StaticText "$UTNT_BUILD_INFO"
    Option "$UTNT_HUD_STATS", "fullhud_stats", "UTNTHUDStats"
    Option "$UTNT_HUD_POSITION", "fullhud_statspos", "UTNTHUDPosition"
    Option "$UTNT_HUD_ITEMS", "fullhud_fullstats", "UTNTYesNo"
    Option "$UTNT_HUD_FACE", "fullhud_mugswitch", "UTNTYesNo"
    Option "$UTNT_HUD_BERSERK", "fullhud_berserk", "UTNTYesNo"
    Option "$UTNT_HUD_INTERPOLATE", "fullhud_interpolate", "UTNTYesNo"
    Option "$UTNT_HUD_TRANS", "UTNT_hudtranslucent", "UTNTYesNo"
}
OptionValue "UTNTHUDStats"
{
    0, "$UTNT_OFF"
    1, "$UTNT_HUD_PERCENT"
    2, "$UTNT_HUD_PERCENT_TIME"
    3, "$UTNT_HUD_REMAINING"
    4, "$UTNT_HUD_REMAINING_TIME"
}
OptionValue "UTNTHUDPosition"
{
    0, "$UTNT_HUD_TOPLEFT"
    1, "$UTNT_HUD_TOPRIGHT"
    2, "$UTNT_HUD_BOTTOMLEFT"
    3, "$UTNT_HUD_BOTTOMRIGHT"
}
