// One authoritative definition per UTNT menu; native menu behavior is retained.
ListMenu "PlayerclassMenu"
{
    Class "UTNTClassMenu"
    NetgameMessage "$NEWGAME"
    Position 48,63
    Font "SmallFont", "UTNTNoticeBody"
}

OptionMenu "UTNTOptions"
{
    Title "$UTNT_OPTIONS_TITLE"
    Submenu "$UTNT_GROUP_CONTROLS", "UTNTControlsOptions"
    Submenu "$UTNT_GROUP_HUD", "UTNTFeedbackOptions"
    Submenu "$UTNT_GROUP_WORLD", "UTNTWorldOptions"
    Submenu "$UTNT_GROUP_VOICE", "UTNTVoiceOptions"
    Submenu "$UTNT_GROUP_COMFORT", "UTNTComfortOptions"
    Submenu "$UTNT_GROUP_DISPLAY", "UTNTDisplayOptions"
}

OptionMenu "UTNTControlsOptions"
{
    Title "$UTNT_GROUP_CONTROLS"
    Control "$UTNT_OBJ_KEY", "+utnt_objectives"
    Control "$UTNT_AB_OFFENSE", "utnt_offense"
    Tooltip "$UTNT_AB_OFFENSE_TIP"
    Control "$UTNT_AB_DEFENSE", "utnt_defense"
    Tooltip "$UTNT_AB_DEFENSE_TIP"
}

OptionMenu "UTNTFeedbackOptions"
{
    Title "$UTNT_GROUP_HUD"
    Slider "$UTNT_UI_SCALE", "UTNT_uiscale", 0.75, 1.5, 0.05, 2
    Tooltip "$UTNT_UI_SCALE_TIP"
    Submenu "$UTNT_HUD_TITLE", "UTNTHUDOptions"
    StaticText ""
    Option "$UTNT_PICKUP_OPTION", "UTNT_pickupfeedback", "UTNTYesNo"
    Option "$UTNT_OPT_BOSS", "UTNT_bosshud", "UTNTYesNo"
    Option "$UTNT_OPT_PERCENT", "UTNT_bosspercent", "UTNTYesNo"
}

OptionMenu "UTNTWorldOptions"
{
    Title "$UTNT_GROUP_WORLD"
    Submenu "$UTNT_GROUP_ATMOSPHERE", "UTNTAtmosphereOptions"
    Submenu "$UTNT_ENV_TITLE", "UTNTEnvironmentOptions"
    Submenu "$UTNT_GROUP_COMBAT", "UTNTCombatOptions"
}

OptionMenu "UTNTAtmosphereOptions"
{
    Title "$UTNT_GROUP_ATMOSPHERE"
    Option "$UTNT_OPT_SMOKE", "UTNT_ambientsmoke", "UTNTYesNo"
    StaticText ""
    StaticText "$UTNT_OPT_SHARED", 1
    Option "$UTNT_OPT_WEATHER", "weatherfx", "UTNTOnOff"
    Option "$UTNT_OPT_ATMOSPHERE", "UTNT_atmosphere", "UTNTOnOff"
    Tooltip "$UTNT_TIP_ATMOSPHERE"
}

OptionMenu "UTNTCombatOptions"
{
    Title "$UTNT_GROUP_COMBAT"
    Option "$UTNT_OPT_GLOW", "UTNT_effectglow", "UTNTYesNo"
    Tooltip "$UTNT_TIP_GLOW"
    Slider "$UTNT_OPT_GLOW_STRENGTH", "UTNT_glowstrength", 0, 1, 0.05, 2
    Slider "$UTNT_OPT_GLOW_SIZE", "UTNT_glowsize", 0.5, 1.75, 0.05, 2
}

OptionMenu "UTNTVoiceOptions"
{
    Title "$UTNT_GROUP_VOICE"
    StaticText "$SNDMNU_TITLE", 1
    Slider "$UTNT_OPT_STEPS", "snd_footstepvolume", 0, 1, 0.1, 1
    Slider "$UTNT_OPT_HEARTBEAT", "UTNT_heartbeatvolume", 0, 1, 0.1, 1
    StaticText ""
    StaticText "$UTNT_OPT_SUBTITLE_ENABLED", 1
    Option "$UTNT_OPT_SUBTITLE_ENABLED", "UTNT_subtitles", "UTNTYesNo"
    Option "$UTNT_OPT_SUBTITLE_BG", "UTNT_subtitlebackground", "UTNTYesNo"
    Option "$UTNT_OPT_SUBTITLE_SPEAKER", "UTNT_subtitlespeaker", "UTNTYesNo"
    Slider "$UTNT_OPT_SUBTITLES", "UTNT_subtitlescale", 0.75, 1.5, 0.05, 2
}

OptionMenu "UTNTComfortOptions"
{
    Title "$UTNT_GROUP_COMFORT"
    Option "$UTNT_OPT_INJURY", "UTNT_lowhealthfx", "UTNTYesNo"
    StaticText ""
    Option "$UTNT_OPT_HEAT_ENABLED", "UTNT_shaderoverlayswitch", "UTNTYesNo"
    Slider "$UTNT_OPT_HEAT", "UTNT_heatstrength", 0, 1, 0.1, 1
    StaticText ""
    Option "$MN_OPBLUR", "motionblur", "UTNTYesNo"
    Slider "$UTNT_OPT_BLUR", "motionblur_strength", 0, 100, 5, 0
    Slider "$UTNT_OPT_SAMPLES", "motionblur_samples", 1, 12, 1, 0
}

OptionMenu "UTNTDisplayOptions"
{
    Title "$UTNT_GROUP_DISPLAY"
    Option "$UTNT_OPT_QUALITY", "UTNT_fxquality", "UTNTQuality"
    Tooltip "$UTNT_TIP_QUALITY"
    Option "$MN_OPDIST", "UTNT_lod", "UTNTDist"
    Option "$UTNT_OPT_REDUCED", "UTNT_reducedfx", "UTNTYesNo"
    Tooltip "$UTNT_TIP_REDUCED"
    StaticText ""
    StaticText "$UTNT_PRESET_TITLE", 1
    UTNTPreset "$UTNT_PRESET_CLASSIC", "none", 0
    UTNTPreset "$UTNT_PRESET_ATMOSPHERIC", "none", 1
    UTNTPreset "$UTNT_PRESET_REDUCED", "none", 2
    StaticText "$UTNT_PRESET_HELP"
}
