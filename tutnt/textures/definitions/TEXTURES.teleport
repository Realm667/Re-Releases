{
    Offset 160, 160
    Patch "graphics/utnt-teleport/fragment-atlas.png", -96, -128
}
Sprite UTPBA0, 320, 320
{
    Offset 160, 160
    Patch "graphics/utnt-teleport/fragment-atlas.png", -608, -128
}
Sprite UTPCA0, 320, 320
{
    Offset 160, 160
    Patch "graphics/utnt-teleport/fragment-atlas.png", -1120, -128
}
Sprite UTPDA0, 320, 320
{
    Offset 160, 160
    Patch "graphics/utnt-teleport/fragment-atlas.png", -96, -608
}
Sprite UTPEA0, 320, 320
{
    Offset 160, 160
    Patch "graphics/utnt-teleport/fragment-atlas.png", -608, -608
}
Sprite UTPFA0, 320, 320
{
    Offset 160, 160
    Patch "graphics/utnt-teleport/fragment-atlas.png", -1120, -608
}

// Shared original TNT03B glyphs. Preserve their native silhouettes.
Texture UTRUNES, 32, 128 { Patch "graphics/utnt-runes/QRUNT63-mask.png", 0, 0 }
Texture UTPSEAL, 512, 512 { Patch "SOURA0", 0, 0 }
Sprite UTRAA0, 32, 32 { Offset 16, 16 Patch "QRUNT63", 0, 0 }
Sprite UTRBA0, 32, 32 { Offset 16, 16 Patch "QRUNT63", 0, -32 }
Sprite UTRCA0, 32, 32 { Offset 16, 16 Patch "QRUNT63", 0, -64 }
Sprite UTRDA0, 32, 32 { Offset 16, 16 Patch "QRUNT63", 0, -96 }

// Procedural movement ribbon; the shader supplies its soft mask.
Sprite UTRTA0, 32, 128 { Offset 16, 64 Patch "QRUNT63", 0, 0 }
