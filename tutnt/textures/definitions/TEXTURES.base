// End of texture definitions

// Remaster status bar, composed from UTNT artwork.
// Clip the original top so the lower STARMS frame can move down seven pixels.
// This adds space for weapon slot 8 without stretching the border or its palette.
Graphic "UTNHATOP", 40, 17
{
    Patch "STARMS", 0, 0
}

// Reuse the original stone and miniature ammo icons without RGB conversion.
// These clipped textures retain the STBAR palette indices, including PLAYPAL effects.
Graphic "UTNHATIL", 30, 24
{
    Patch "STBAR", -228, -4
}

Graphic "UTNHABG", 96, 24
{
    Patch "UTNHATIL", 0, 0
    Patch "UTNHATIL", 30, 0
    Patch "UTNHATIL", 60, 0
    Patch "UTNHATIL", 90, 0
    Patch "UTNHADIV", 12, 0
    Patch "UTNHADIV", 55, 0
}

Graphic "UTNHACL", 9, 6
{
    Patch "STBAR", -290, -5
}
Graphic "UTNHASH", 9, 6
{
    Patch "STBAR", -290, -11
}
Graphic "UTNHARK", 9, 6
{
    Patch "STBAR", -290, -17
}
Graphic "UTNHACE", 9, 6
{
    Patch "STBAR", -290, -23
}

// Three-pixel stepped corner radius, clipped directly from the indexed STBAR.
// Disjoint strips leave the outer corners transparent without filtering artwork.
Graphic "UTNHRMID", 320, 28 { Patch "STBAR", 0, -2 }
Graphic "UTNHRT0", 316, 1 { Patch "STBAR", -2, 0 }
Graphic "UTNHRT1", 318, 1 { Patch "STBAR", -1, -1 }
Graphic "UTNHRB0", 316, 1 { Patch "STBAR", -2, -31 }
Graphic "UTNHRB1", 318, 1 { Patch "STBAR", -1, -30 }
Graphic "UTNHRBAR", 320, 32
{
    Patch "UTNHRMID", 0, 2
    Patch "UTNHRT0", 2, 0
    Patch "UTNHRT1", 1, 1
    Patch "UTNHRB0", 2, 31
    Patch "UTNHRB1", 1, 30
}

Graphic "UTNTHSP", 320, 32
{
    Patch "UTNHRBAR", 0, 0
    Patch "UTNHABG", 222, 4
    Patch "STARMS", 104, 7
    Patch "UTNHATOP", 104, 0
}

Graphic "UTNTHMP", 320, 32
{
    Patch "UTNHRBAR", 0, 0
    Patch "UTNHABG", 222, 4
    Patch "STARMS", 104, 7
    Patch "UTNHATOP", 104, 0
    Patch "STFBANY", 143, 1
}

Graphic "UTNTHDM", 320, 32
{
    Patch "UTNHRBAR", 0, 0
    Patch "UTNHABG", 222, 4
    Patch "STFBANY", 143, 1
}


// Eight-pixel berserk pickup icon; no dependency on the missing upstream BERSERK.
Graphic "UTNTHBS", 32, 32
{
    XScale 4
    YScale 4
    Patch "PSTRA0", 2, 6
}

// Reduced-view surround uses a power-of-two flat for the engine's border tiler.
// Mirrored 16-pixel STBAR crops meet seamlessly and preserve palette indices.
// Keep GRNROCK unchanged because maps can also use it as a world texture.
Graphic "UTNHFTIL", 16, 16 { Patch "STBAR", -228, -5 }
Flat "UTNHFILL", 64, 64
{
    Patch "UTNHFTIL", 0, 0
    Patch "UTNHFTIL", 16, 0 { FlipX }
    Patch "UTNHFTIL", 32, 0
    Patch "UTNHFTIL", 48, 0 { FlipX }
    Patch "UTNHFTIL", 0, 16 { FlipY }
    Patch "UTNHFTIL", 16, 16 { FlipX FlipY }
    Patch "UTNHFTIL", 32, 16 { FlipY }
    Patch "UTNHFTIL", 48, 16 { FlipX FlipY }
    Patch "UTNHFTIL", 0, 32
    Patch "UTNHFTIL", 16, 32 { FlipX }
    Patch "UTNHFTIL", 32, 32
    Patch "UTNHFTIL", 48, 32 { FlipX }
    Patch "UTNHFTIL", 0, 48 { FlipY }
    Patch "UTNHFTIL", 16, 48 { FlipX FlipY }
    Patch "UTNHFTIL", 32, 48 { FlipY }
    Patch "UTNHFTIL", 48, 48 { FlipX FlipY }
}

// Four-pixel bevels surround the reduced viewport on all sides.
Graphic "UTNHBT", 4, 4 { Patch "STBAR", -8, 0 }
Graphic "UTNHBL", 4, 4 { Patch "UTNHBT", 0, 0 { Rotate 270 } }
Graphic "UTNHBR", 4, 4 { Patch "UTNHBT", 0, 0 { Rotate 90 } }
Graphic "UTNHBTL", 4, 4 { Patch "STBAR", 0, 0 }
Graphic "UTNHBTR", 4, 4 { Patch "STBAR", -316, 0 }
Graphic "UTNHBB", 4, 4 { Patch "UTNHBT", 0, 0 { FlipY } }
Graphic "UTNHBBL", 4, 4 { Patch "UTNHBTL", 0, 0 { FlipY } }
Graphic "UTNHBBR", 4, 4 { Patch "UTNHBTR", 0, 0 { FlipY } }

