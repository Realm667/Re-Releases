skybox UCHSKY { UCHN UCHE UCHS UCHW UCHU UCHD }
material texture UCHN { shader "shaders/caldera/sky-N.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UCHE { shader "shaders/caldera/sky-E.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UCHS { shader "shaders/caldera/sky-S.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UCHW { shader "shaders/caldera/sky-W.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UCHU { shader "shaders/caldera/sky-U.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UCHD { shader "shaders/caldera/sky-D.fp" texture cloudmap "graphics/caldera/panorama.png" }
