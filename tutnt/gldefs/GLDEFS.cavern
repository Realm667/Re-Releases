Material Texture "UCAVFALL"
{
    Shader "shaders/lava-fall.fp"
    Speed 1.0
}
Material Sprite UCHZA0 { Shader "shaders/cavern-haze.fp" }
Material Sprite UCVSA0 { Shader "shaders/cavern-haze.fp" Define CAVERN_SMOKE }
Material Sprite UCDGA0 { Shader "shaders/cavern-haze.fp" Define CAVERN_GRAIN }

Material Flat "UCAVSLAV"
{
    Shader "shaders/cavern-lava.fp"
    Texture crustHeight "materials/lava/crust-height.png"
    Speed 1.0
}
