skybox UACSKY { UACN UACE UACS UACW UACU UACD }
material texture UACN { shader "shaders/alternate/sky-N.fp" texture nebulamap "graphics/alternate/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture platformmap "graphics/alternate/platforms-key.png" texture surroundmap "graphics/alternate/clouds.png" texture viewmap "UACVIEW" }
material texture UACE { shader "shaders/alternate/sky-E.fp" texture nebulamap "graphics/alternate/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture platformmap "graphics/alternate/platforms-key.png" texture surroundmap "graphics/alternate/clouds.png" texture viewmap "UACVIEW" }
