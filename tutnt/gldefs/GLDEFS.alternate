material texture UACW { shader "shaders/alternate/sky-W.fp" texture nebulamap "graphics/alternate/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture platformmap "graphics/alternate/platforms-key.png" texture surroundmap "graphics/alternate/clouds.png" texture viewmap "UACVIEW" }
