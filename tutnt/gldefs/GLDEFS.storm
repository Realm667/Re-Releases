skybox USTSKY { USTN USTE USTS USTW USTU USTD }
material texture USTN { shader "shaders/storm/sky-N.fp" texture cloudmap "graphics/storm/clouds.png" texture mountainmap "graphics/storm/mountains-key.png" }
material texture USTE { shader "shaders/storm/sky-E.fp" texture cloudmap "graphics/storm/clouds.png" texture mountainmap "graphics/storm/mountains-key.png" }
material texture USTS { shader "shaders/storm/sky-S.fp" texture cloudmap "graphics/storm/clouds.png" texture mountainmap "graphics/storm/mountains-key.png" }
material texture USTW { shader "shaders/storm/sky-W.fp" texture cloudmap "graphics/storm/clouds.png" texture mountainmap "graphics/storm/mountains-key.png" }
material texture USTU { shader "shaders/storm/sky-U.fp" texture cloudmap "graphics/storm/clouds.png" texture mountainmap "graphics/storm/mountains-key.png" }
material texture USTD { shader "shaders/storm/sky-D.fp" texture cloudmap "graphics/storm/clouds.png" texture mountainmap "graphics/storm/mountains-key.png" }
