HardwareShader Sprite ENFTA0 { Shader "shaders/environment/footprint.fp" }
HardwareShader Sprite ENFTB0 { Shader "shaders/environment/footprint.fp" Define SNOWPRINT }
HardwareShader PostProcess scene
{
 Name "UTNTUnderwaterAtmosphere"
 Shader "shaders/environment/underwater.fp" 330
 Uniform vec3 waterTint
 Uniform float waterDensity
 Uniform vec3 rayForward
 Uniform vec3 rayRight
 Uniform vec3 rayUp
 Uniform vec4 viewRect
 Uniform vec4 depthA
 Uniform vec4 depthB
}
#include "environment/materials.gldefs"

#include "environment/local-heat.gldefs"

HardwareShader PostProcess beforebloom
{
 Name "UTNTDistanceDepth0"
 Shader "shaders/environment/distance-depth.fp" 330
 Uniform vec4 depth0
 Uniform vec4 depth1
 Uniform vec4 depth2
 Uniform vec4 depth3
 Uniform vec4 depth4
 Uniform vec4 depth5
 Uniform vec4 viewRect
 Uniform vec4 settings
}

