skybox UWRSKY { UWRN UWRE UWRS UWRW UWRU UWRD }
material texture UWRN { shader "shaders/caldera-war/sky-N.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UWRE { shader "shaders/caldera-war/sky-E.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UWRS { shader "shaders/caldera-war/sky-S.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UWRW { shader "shaders/caldera-war/sky-W.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UWRU { shader "shaders/caldera-war/sky-U.fp" texture cloudmap "graphics/caldera/panorama.png" }
material texture UWRD { shader "shaders/caldera-war/sky-D.fp" texture cloudmap "graphics/caldera/panorama.png" }
