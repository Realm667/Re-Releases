UTNT_NOTICE_318 = "\c[UTNTNoticeAccent]Bouncy\c[UTNTNoticeBody] - N'a pas rebondi assez vite ; attrapé par un crâne agité dans la forêt.";
UTNT_NOTICE_319 = "\c[UTNTNoticeAccent]Cutman\c[UTNTNoticeBody] - Disparu en enquêtant sur les meurtres de Bouncy et d'autres chasseurs de primes.";
UTNT_NOTICE_320 = "\c[UTNTNoticeAccent]DoomDude\c[UTNTNoticeBody] - Mort seul, en luttant pour garder NewDoom en vie.";
UTNT_NOTICE_321 = "\c[UTNTNoticeAccent]Enjay\c[UTNTNoticeBody] - Sa future demeure s'il continue à nous tenter avec ses captures d'Aspects.";
UTNT_NOTICE_322 = "\c[UTNTNoticeAccent]Eriance\c[UTNTNoticeBody] - Dévoré par ses dernières créations monstrueuses.";
UTNT_NOTICE_323 = "\c[UTNTNoticeAccent]Hirogen2\c[UTNTNoticeBody] - Découpé pour avoir été équitable une fois de trop.";
UTNT_NOTICE_324 = "\c[UTNTNoticeAccent]Keksdose\c[UTNTNoticeBody] - Aveuglé et brûlé par ses propres créations maléfiques.";
UTNT_NOTICE_325 = "\c[UTNTNoticeAccent]Phobus\c[UTNTNoticeBody] - Tué par l'épée de la faction bannie : la mort d'un modérateur ZDoom.";
UTNT_NOTICE_326 = "\c[UTNTNoticeAccent]Randy\c[UTNTNoticeBody] - Tombé au combat dans les champs d'Azeroth. Que la lumière soit avec lui.";
UTNT_NOTICE_327 = "\c[UTNTNoticeAccent]Scuba Steve\c[UTNTNoticeBody] - Pris en embuscade par des fanatiques d'action réclamant des suites.";
UTNT_NOTICE_328 = "\c[UTNTNoticeAccent]Solarsnowfall\c[UTNTNoticeBody] - Condamné pour sorcellerie après avoir recréé des phénomènes naturels à la main.";
UTNT_NOTICE_329 = "\c[UTNTNoticeAccent]TheDarkArchon\c[UTNTNoticeBody] - Mort de peur à cause de YureiodfuoidguosdfiuogiARGH !!!";
UTNT_NOTICE_330 = "\c[UTNTNoticeAccent]Vader\c[UTNTNoticeBody] - Disparu après avoir mis plus de détails dans ses cartes que Tormentor667.";
UTNT_NOTICE_331 = "\c[UTNTNoticeAccent]Graf Zahl\c[UTNTNoticeBody] - Voulait arrêter de travailler sur GZDoom. Plus jamais entendu parler de lui...";
UTNT_NOTICE_332 = "\c[UTNTNoticeAccent]Champ de force\c[UTNTNoticeBody] - À désactiver ailleurs";
UTNT_NOTICE_334 = "\c[UTNTNoticeAccent]Spam publicitaire\c[UTNTNoticeBody] - Oh mon Dieu !";
UTNT_NOTICE_335 = "\c[UTNTNoticeAccent]Champ de force\c[UTNTNoticeBody] - Tirez sur le noyau d'énergie principal pour le désactiver";
UTNT_NOTICE_336 = "\c[UTNTNoticeAccent]Adolf\c[UTNTNoticeBody] - Vaincu";
UTNT_NOTICE_337 = "\c[UTNTNoticeAccent]Noyau d'énergie hors ligne\c[UTNTNoticeBody] - Le champ de force devrait être désactivé";
UTNT_NOTICE_344 = "\c[UTNTNoticeAccent]DopeFish\c[UTNTNoticeBody] - Antre de terreur et de mort !";
UTNT_NOTICE_345 = "\c[UTNTNoticeAccent]Porte secrète\c[UTNTNoticeBody] - L'utiliser ne l'ouvrira pas";
UTNT_NOTICE_346 = "\c[UTNTNoticeAccent]Cet endroit\c[UTNTNoticeBody] - Je jurerais être déjà venu ici...";
UTNT_NOTICE_349 = "\c[UTNTNoticeAccent]Interrupteur\c[UTNTNoticeBody] - Quelque chose me dit de ne pas y toucher...";
UTNT_NOTICE_350 = "\c[UTNTNoticeAccent]On dirait que j'en ai fini ici !";
UTNT_NOTICE_351 = "\c[UTNTNoticeAccent]Mur plein\c[UTNTNoticeBody] - Le toucher ne fera probablement rien";
UTNT_NOTICE_358 = "\c[UTNTNoticeAccent]Téléporteur\c[UTNTNoticeBody] - Accessible";
UTNT_NOTICE_57 = "\c[UTNTNoticeAccent]Point de contrôle coop\c[UTNTNoticeBody] - Atteint";
