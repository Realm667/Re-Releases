UTNT_INTERMAP_059 = "\cCAppuyez sur \cG<utiliser> \cCpour passer l'intermède";
UTNT_INTERMAP_060 = "Lentement, vous sortez\n";
UTNT_INTERMAP_061 = "des catacombes\n";
UTNT_INTERMAP_062 = "et les laissez derrière vous.\n\n";
UTNT_INTERMAP_063 = "Vos mains sont rouge sang,\n";
UTNT_INTERMAP_064 = "comme le ciel au-dessus de vous.\n\n";
UTNT_INTERMAP_065 = "Vous avez franchi\n";
UTNT_INTERMAP_066 = "la ligne de défense extérieure\n";
UTNT_INTERMAP_067 = "de cette installation infernale\n";
UTNT_INTERMAP_068 = "et vous voici plus près\n";
UTNT_INTERMAP_069 = "du portail obscur...\n\n";
UTNT_INTERMAP_070 = "Vous sentez déjà\n";
UTNT_INTERMAP_071 = "la puanteur de l'acier\n";
UTNT_INTERMAP_072 = "en fusion et des chairs\n";
UTNT_INTERMAP_073 = "calcinées...\n\n";
UTNT_INTERMAP_074 = "Ce n'est que le début...";
UTNT_INTERMAP_075 = "L'odeur âcre de l'acier\n";
UTNT_INTERMAP_076 = "usiné flotte encore\n";
UTNT_INTERMAP_077 = "dans l'air, mais des tempêtes glacées\n";
UTNT_INTERMAP_078 = "troublent vos sens.\n";
UTNT_INTERMAP_079 = "Devant vous se dresse\n";
UTNT_INTERMAP_080 = "le sommet gelé d'une autre\n";
UTNT_INTERMAP_081 = "montagne maudite. Le seul\n";
UTNT_INTERMAP_082 = "chemin vous mène plus loin,\n";
UTNT_INTERMAP_083 = "vers la Forteresse de la\n";
UTNT_INTERMAP_084 = "Damnation...\n";
UTNT_INTERMAP_085 = "Alors gardez vos armes chaudes\n";
UTNT_INTERMAP_086 = "et prêtes à transpercer\n";
UTNT_INTERMAP_087 = "les âmes maudites !\n";
UTNT_INTERMAP_088 = "En regardant par-dessus\n";
UTNT_INTERMAP_089 = "votre épaule, vous voyez encore\n";
UTNT_INTERMAP_090 = "la silhouette sombre\n";
UTNT_INTERMAP_091 = "des installations dévastées.\n";
UTNT_INTERMAP_092 = "Vous remerciez Dieu d'être\n";
UTNT_INTERMAP_093 = "encore en vie, car vous savez\n";
UTNT_INTERMAP_094 = "qu'aucun de vos camarades\n";
UTNT_INTERMAP_095 = "n'aurait pu traverser\n";
UTNT_INTERMAP_096 = "cet édifice terrifiant.\n";
UTNT_INTERMAP_097 = "Soudain, un bruit\n";
UTNT_INTERMAP_098 = "assourdissant vous interpelle\n";
UTNT_INTERMAP_099 = "et vous regardez ce qui\n";
UTNT_INTERMAP_100 = "vous attend : une sinistre\n";
UTNT_INTERMAP_101 = "forteresse dévastée.\n";
UTNT_INTERMAP_102 = "Elle abrite le dernier\n";
UTNT_INTERMAP_103 = "portail infernal sur Terre.\n";
UTNT_INTERMAP_104 = "Bientôt, le règne de la terreur\n";
UTNT_INTERMAP_105 = "prendra fin...";
UTNT_INTERMAP_106 = "Une puanteur écœurante emplit\n";
UTNT_INTERMAP_107 = "l'air quand la dernière\n";
UTNT_INTERMAP_108 = "araignée démoniaque s'effondra\n";
UTNT_INTERMAP_109 = "au sol. Les gardiens du portail\n";
UTNT_INTERMAP_110 = "faillirent lorsque votre dernier\n";
UTNT_INTERMAP_111 = "tir transperça leurs\n";
UTNT_INTERMAP_112 = "cadavres putrides.\n";
UTNT_INTERMAP_113 = "Il ne restait plus qu'à\n";
UTNT_INTERMAP_114 = "détruire l'ultime porte infernale\n";
UTNT_INTERMAP_115 = "sur Terre pour empêcher d'autres démons\n";
UTNT_INTERMAP_116 = "de hanter votre monde.\n";
UTNT_INTERMAP_117 = "Devant le portail,\n";
UTNT_INTERMAP_118 = "en rechargeant votre\n";
UTNT_INTERMAP_119 = "lance-roquettes, vous hésitâtes\n";
UTNT_INTERMAP_120 = "un bref instant... Impossible\n";
UTNT_INTERMAP_121 = "de détruire la porte. Quelque chose\n";
UTNT_INTERMAP_122 = "vous attirait dans ce néant noir...\n";
UTNT_INTERMAP_123 = "Peut-être était-ce la curiosité,\n";
UTNT_INTERMAP_124 = "peut-être une force surhumaine...\n";
UTNT_INTERMAP_125 = "Vous ne pouviez plus résister\n";
UTNT_INTERMAP_126 = "et vous suivîtes le néant...\n";
UTNT_INTERMAP_127 = "Votre mission semblait\n";
UTNT_INTERMAP_128 = "être un échec...\n";
UTNT_INTERMAP_129 = "Vous sentez le puissant\n";
UTNT_INTERMAP_130 = "tourbillon vous aspirer\n";
UTNT_INTERMAP_131 = "dans le néant noir\n";
UTNT_INTERMAP_132 = "devant vous.\n";
UTNT_INTERMAP_133 = "Lentement, les cris\n";
UTNT_INTERMAP_134 = "de vos camarades mourants\n";
UTNT_INTERMAP_135 = "s'éteignent, tout comme\n";
UTNT_INTERMAP_136 = "la lumière derrière vous...\n";
UTNT_INTERMAP_137 = "Vos pensées se confondent\n";
UTNT_INTERMAP_138 = "tandis que vous traversez\n";
UTNT_INTERMAP_139 = "des milliers de dimensions,\n";
UTNT_INTERMAP_140 = "droit vers le cœur\n";
UTNT_INTERMAP_141 = "de tout le mal...\n";
UTNT_INTERMAP_142 = "Votre vue devient rouge\n";
UTNT_INTERMAP_143 = "alors que vous perdez connaissance.\n";
UTNT_INTERMAP_144 = "Les secondes deviennent des semaines\n";
UTNT_INTERMAP_145 = "et les heures, des siècles.\n";
UTNT_INTERMAP_146 = "Le temps et l'espace se brouillent\n";
UTNT_INTERMAP_147 = "autour de vous, et vous êtes paralysé\n";
UTNT_INTERMAP_148 = "dans ce processus sans fin.\n";
UTNT_INTERMAP_149 = "Vous sentez que la Source\n";
UTNT_INTERMAP_150 = "se rapproche, elle peut\n";
UTNT_INTERMAP_151 = "presque vous toucher,\n";
UTNT_INTERMAP_152 = "elle est ici...\n";
UTNT_INTERMAP_153 = "La fumée monte vers le ciel\n";
UTNT_INTERMAP_154 = "depuis le sombre abîme\n";
UTNT_INTERMAP_155 = "devant vous, jadis la gorge\n";
UTNT_INTERMAP_156 = "d'immondes et cruels salauds\n";
UTNT_INTERMAP_157 = "dont le seul but était de vous tuer,\n";
UTNT_INTERMAP_158 = "vous et toute votre espèce...\n";
UTNT_INTERMAP_159 = "Mais c'est fini. La Source\n";
UTNT_INTERMAP_160 = "est détruite, et l'origine\n";
UTNT_INTERMAP_161 = "du mal qui hantait la Terre\n";
UTNT_INTERMAP_162 = "est scellée...\n";
UTNT_INTERMAP_163 = "Votre mission est terminée\n";
UTNT_INTERMAP_164 = "et il est temps de vous asseoir\n";
UTNT_INTERMAP_165 = "pour repenser aux dernières\n";
UTNT_INTERMAP_166 = "minutes, heures et journées...\n";
UTNT_INTERMAP_167 = "Le temps de comprendre\n";
UTNT_INTERMAP_168 = "ce qui s'est passé, que\n";
UTNT_INTERMAP_169 = "vous revenez en héros,\n";
UTNT_INTERMAP_170 = "celui qui a sauvé l'humanité.\n";
UTNT_INTERMAP_171 = "C'est une belle sensation, mais\n";
UTNT_INTERMAP_172 = "vous n'en comprenez pas encore\n";
UTNT_INTERMAP_173 = "le sens... Cela changera\n";
UTNT_INTERMAP_174 = "un jour...";
UTNT_INTERMAP_175 = "Vous les avez trouvées.\n";
UTNT_INTERMAP_176 = "Et vous les avez tuées. \n";
UTNT_INTERMAP_177 = "Toutes ces créatures étrangères,\n";
UTNT_INTERMAP_178 = "avant qu'elles ne prennent\n";
UTNT_INTERMAP_179 = "le contrôle du portail obscur\n";
UTNT_INTERMAP_180 = "détruit. Sans le\n";
UTNT_INTERMAP_181 = "noyau, personne ne pourra\n";
UTNT_INTERMAP_182 = "plus jamais\n";
UTNT_INTERMAP_183 = "le rouvrir.\n";
UTNT_INTERMAP_184 = "...mais qu'allez-vous devenir ?\n";
UTNT_INTERMAP_185 = "Vous êtes perdu, prisonnier\n";
UTNT_INTERMAP_186 = "dans une impasse en enfer,\n";
UTNT_INTERMAP_187 = "sans autre choix que d'attendre\n";
UTNT_INTERMAP_188 = "que quelqu'un vous tue, si vous\n";
UTNT_INTERMAP_189 = "ne le faites pas vous-même...\n";
UTNT_INTERMAP_190 = "Il n'y a plus de retour,\n";
UTNT_INTERMAP_191 = "ni de chemin pour avancer...\n";
UTNT_INTERMAP_192 = "Pour vous, tout est fini.\n";
UTNT_INTERMAP_193 = "Un vrai héros est celui dont \n";
UTNT_INTERMAP_194 = "personne ne découvrira jamais\n";
UTNT_INTERMAP_195 = "les exploits !        -Outer Limits";
UTNT_INTRO_001 = "Épisode 1 : L'abîme s'ouvre";
UTNT_INTRO_002 = "Épisode 2 : L'arsenal de la douleur";
UTNT_INTRO_003 = "Épisode 3, partie 1 : Le sommet maudit";
UTNT_INTRO_004 = "Épisode 3, partie 2 : Le cœur maléfique";
UTNT_INTRO_005 = "Épisode 4, partie 1 : Dans les ténèbres";
UTNT_INTRO_006 = "Épisode 4, partie 2 : Au-delà du portail obscur";
UTNT_INTRO_007 = "Épisode 4, partie 3 : Le début et la fin (version du réalisateur)";
UTNT_INTRO_008 = "Épisode 4, partie 3 : Le début et la fin";
UTNT_INTRO_009 = "Épisode perdu : La fureur du feu";
UTNT_INTRO_010 = "Frayez-vous un chemin jusqu'au centre technique.\nTraversez le passage des cachots et quittez la première ligne de défense.";
UTNT_INTRO_011 = "Trouvez la salle de contrôle de l'installation A.\nEntrez dans l'installation B abandonnée.\nTrouvez le passage vers le sommet maudit et quittez l'arsenal.";
UTNT_INTRO_012 = "Frayez-vous un chemin jusqu'à l'entrepôt.\nTrouvez le site minier.\nQuittez l'installation par le sud, vers la forteresse.";
UTNT_INTRO_013 = "Tuez les gardiens du portail.\nDétruisez le portail obscur.";
UTNT_INTRO_014 = "Trouvez le fusil à plasma près de la tour de l'horloge.\nTuez les Spider Masterminds pour abaisser les piliers.\nEntrez dans le portail obscur.";
UTNT_INTRO_015 = "Trouvez un chemin vers les confins du chaos.\nTrouvez le BFG9000.";
UTNT_INTRO_016 = "Frayez-vous un chemin jusqu'à la caverne éternelle.\nDétruisez la Source et ses gardiens.";
UTNT_INTRO_017 = "Frayez-vous un chemin jusqu'au sommet.\nDétruisez la Source et ses gardiens.";
UTNT_INTRO_018 = "Sortez des cavernes et combattez jusqu'au sommet.\nTrouvez le cœur du noyau du portail.";
