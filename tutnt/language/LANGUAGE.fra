UTNT_TNT04B_289 = "\cGPourquoi cet endroit m'est-il si familier, bon sang ? ...";
UTNT_TNT04B_290 = "\cGLe pilier est bien trop abîmé pour être lisible !";
UTNT_TNT04B_291 = "\cCSéquence terminée, piliers abaissés !";
UTNT_TNT04B_292 = "\cGEncore un \cCrestant";
UTNT_TNT04B_293 = "\cCAu-delà se trouvent \cGLes confins du chaos\n\cCFaites demi-tour ou brûlez en enfer pour l'éternité !";
UTNT_TNT04B_294 = "\cCLa porte de \cGCentre de commandement du monde frontière \cCest ouverte !";
UTNT_TNT04B_295 = "\cGModule de commande configuré, système accessible !";
UTNT_TNT04B_296 = "\cGLe module de commande manque, impossible de l'utiliser !";
UTNT_TNT04B_297 = "\cGVous avez trouvé le module de commande manquant !";
UTNT_TNT04B_298 = "\cCCette porte s'ouvre à distance !";
UTNT_TNT04B_299 = "\cCSéquence terminée, piliers abaissés !";
UTNT_TNT04B_300 = "\cGEncore un \cCrestant";
UTNT_TNT04B_301 = "\cCCette porte ne peut pas être ouverte";
UTNT_TNT04B_302 = "\cCLes piliers d'accès au \cGPortail de la frontière infernale \cCsont abaissées !";
UTNT_TNT04B_303 = "\cGEncore un \cCrestant";
UTNT_TNT04B_304 = "\cCObjectif accompli :\n\cGVous avez trouvé le BFG9000";
UTNT_TNT04B_305 = "\cCObjectif accompli :\n\cGVous avez atteint les confins du chaos";
UTNT_TNT04B_306 = "\cCFin alternative \cGActivé";
UTNT_TNT04B_307 = "\cCPassage secret vers la \cGfin alternative \cCdécouvert :\n\cGÉpisode 4\cC, version du réalisateur";
UTNT_TNT04CN_318 = "\cGBouncy, \cCn'a pas rebondi assez vite et s'est fait attraper\n\cCpar un crâne agité dans la forêt.";
UTNT_TNT04CN_319 = "\cGCutman, \cCa disparu en enquêtant sur le meurtre\n\cCde Bouncy et d'autres chasseurs de primes.";
UTNT_TNT04CN_320 = "\cGDoomDude, \cCest mort dans la solitude en luttant pour garder\n\cCNewDoom en vie... seul.";
UTNT_TNT04CN_321 = "\cGEnjay, \cCsa future demeure s'il continue à nous tenter\n\cCavec ses captures d'écran d'Aspects.";
UTNT_TNT04CN_322 = "\cGEriance, \cCdévoré par ses dernières créations monstrueuses.";
UTNT_TNT04CN_323 = "\cGHirogen2, \cCdécoupé pour avoir fait preuve d'équité\n\cCune fois de trop.";
UTNT_TNT04CN_324 = "\cGKeksdose, \cCaveuglé et brûlé par ses propres créations maléfiques.";
UTNT_TNT04CN_325 = "\cGPhobus, \cCa connu la mort du modérateur ZDoom par\n\cCl'épée de la faction bannie de la communauté.";
UTNT_TNT04CN_326 = "\cGRandy, \cCtombé au combat dans les champs d'Azeroth,\n\cCque la lumière soit avec lui.";
UTNT_TNT04CN_327 = "\cGScuba Steve, \cCpris en embuscade par des fanatiques d'action\n\cCréclamant des suites.";
UTNT_TNT04CN_328 = "\cGSolarsnowfall, \cCaccusé de sorcellerie et condamné à mort pour avoir\n\cCrecréé des phénomènes naturels de ses mains.";
UTNT_TNT04CN_329 = "\cGTheDarkArchon, \cCmort de peur à cause de YureiodfuoidguosdfiuogiARGH !!!";
UTNT_TNT04CN_330 = "\cGVader, \cCa disparu après avoir mis dans ses cartes\n\cCplus de détails que Tormentor667.";
UTNT_TNT04CN_331 = "\cGGraf Zahl, \cCvoulait arrêter de travailler sur GZDoom,\n\cCplus jamais entendu parler de lui...";
UTNT_TNT04C_308 = "\cCAscenseur vers le \cGniveau 2 \cCaccessible";
UTNT_TNT04C_309 = "\cG";
UTNT_TNT04C_310 = " \cCrestant";
UTNT_TNT04C_311 = "\cCCet interrupteur est cassé";
UTNT_TNT04C_312 = "\cCAscenseur vers le \cGniveau 3 \cCaccessible";
UTNT_TNT04C_313 = "\cG";
UTNT_TNT04C_314 = " \cCrestant";
UTNT_TNT04C_315 = "\cCAscenseur vers le \cGniveau 4 \cCaccessible";
UTNT_TNT04C_316 = "\cG";
UTNT_TNT04C_317 = " \cCrestant";
UTNT_TNTLE_332 = "\cCVous devez désactiver le champ de force ailleurs !";
UTNT_TNTLE_333 = "\cCCette porte s'ouvre ailleurs !";
UTNT_TNTLE_334 = "\cGOh mon Dieu, du spam publicitaire !";
UTNT_TNTLE_335 = "\cCTirez sur le noyau d'énergie principal pour désactiver le champ de force !";
UTNT_TNTLE_336 = "\cCSieg Heil et beau butin, Adolf est mort !";
UTNT_TNTLE_337 = "\cCNoyau d'énergie hors ligne. Le champ de force devrait être désactivé !";
UTNT_TNTLE_338 = " monstres restants";
UTNT_TNTLE_339 = "\cCBien joué, mais vous pensiez que c'était tout ?";
UTNT_TNTLE_340 = " monstres restants";
UTNT_TNTLE_341 = "\cCBon, pour l'instant, vous pouvez quitter cette arène...";
UTNT_TNTLE_342 = "\cCCette porte s'ouvre ailleurs !";
UTNT_TNTLE_343 = "\cCCette porte ne s'ouvre qu'à distance";
UTNT_TNTLE_344 = "\cGOh mon Dieu, c'est l'antre de terreur et de mort du DopeFish !";
UTNT_TNTLE_345 = "\cCCette porte mène à un secret. Pourquoi suffirait-il de l'utiliser pour l'ouvrir ?";
UTNT_TNTLE_346 = "\cG...Je jurerais avoir déjà vu cet endroit...";
UTNT_TNTLE_347 = "\cCCette porte est cassée !";
UTNT_TNTLE_348 = "\cCCette porte ne peut pas être ouverte !";
UTNT_TNTLE_349 = "\cGQuelque chose me dit de ne pas toucher cet interrupteur...";
UTNT_TNTLE_350 = "\cGBon, on dirait que j'en ai fini ici !";
UTNT_TNTLE_351 = "\cGC'est un mur plein. Le toucher ne fera probablement rien !";
UTNT_TNTLE_352 = "\cCDébut : \cGPremière \cCsur six batailles";
UTNT_TNTLE_353 = "\cCDébut : \cGDeuxième \cCsur six batailles";
UTNT_TNTLE_354 = "\cCDébut : \cGTroisième \cCsur six batailles";
UTNT_TNTLE_355 = "\cCDébut : \cGQuatrième \cCsur six batailles";
UTNT_TNTLE_356 = "\cCDébut : \cGCinquième \cCsur six batailles";
UTNT_TNTLE_357 = "\cCDébut de la \cGDernière \cCbataille";
UTNT_TNTLE_358 = "\cCTéléporteur accessible !";
UTNT_TNTLE_359 = "\cCObjectif accompli :\n\cGVous avez atteint le plafond de la caverne";
UTNT_TNTLE_360 = "\cCObjectif accompli :\n\cGVous avez trouvé le cœur du noyau du portail";
UTNT_UI_SCALE = "Messages et objectifs : taille";
UTNT_UI_SCALE_TIP = "Règle l'espacement de l'interface et la taille du texte. Le texte garde au minimum l'échelle native des pixels.";
UTNT_VOICE_019 = "\cR''Bon, allons chercher de la viande !''";
UTNT_VOICE_020 = "\cR''Mais qu'est-ce que... !''";
UTNT_VOICE_021 = "\cR''...mmmmh, ça sent la mort et le danger ici...\n\cR  C'est peut-être juste mon après-rasage !''";
UTNT_VOICE_022 = "\cR''Oh oh !''";
UTNT_VOICE_023 = "\cR''Hmhmhm... c'était presque trop facile !''";
UTNT_VOICE_024 = "\cR''La prochaine fois, je penserai à me taire !''";
UTNT_VOICE_025 = "\cR''Il faisait bien meilleur sur Tei Tenga...\n\cR  J'aurais dû y rester !''";
UTNT_VOICE_026 = "\cR''<presque un arch-vile>...toi-même !''";
UTNT_VOICE_027 = "\cR''Ceux qui vont mourir te saluent !''";
UTNT_VOICE_028 = "\cR''C'est tout ce que vous avez ?!''";
UTNT_VOICE_029 = "\cR''Oh oh !''";
UTNT_VOICE_030 = "\cR''Affrontez le Créateur !''";
UTNT_VOICE_031 = "\cR''Je préférais l'arsenal, cette douce chaleur\n\cRde l'acier usiné et des torses de démons qui explosent.''";
UTNT_VOICE_032 = "\cR''Il y a des choses plus anciennes et plus immondes que les imps\n\cRdans les profondeurs du monde.''";
UTNT_VOICE_033 = "\cR''Oh oui, ça me réchauffe le cœur.''";
UTNT_VOICE_034 = "\cR''C'est l'heure d'allumer le barbecue !''";
UTNT_VOICE_035 = "\cR''Hmm... sortez, sortez, où que vous soyez...''";
UTNT_VOICE_036 = "\cR''Je déteste les araignées !''";
UTNT_VOICE_037 = "\cR''Plus moyen de reculer... il est temps de montrer\n\cRde quoi je suis capable !''";
UTNT_VOICE_038 = "Je peux la sentir...\nla puissance maléfique\nqui se cache derrière ce portail obscur\n...la source du mal,\n\nqui engendre des centaines de démons\ntraquant l'humanité\ncette fois sur notre monde,\nla Terre elle-même\n\nJe peux presque sentir\nla main froide de la mort me toucher";
UTNT_VOICE_039 = "et\n...s'emparer de mon âme...\nJe sais que cette dernière mission \nme coûtera la vie.\n\nC'est ma destinée,\n\nmon sort de mourir dans cette guerre...\nla seule chance...\nde sauver ceux que j'aime... \nmais s'il y avait bien plus \nau-delà de ce que je peux sentir ? ...";
UTNT_VOICE_040 = "\cR''Oh oui, on est en plein dedans, les gars !''";
UTNT_VOICE_041 = "\cR''Je les ai eus ! Il est temps de quitter ce lieu maudit !''";
UTNT_VOICE_042 = "\cR''Waouh... déjà-vu !''";
UTNT_VOICE_043 = "\cR''Bon, je doute qu'il en ait encore besoin.''";
UTNT_VOICE_044 = "\cR''Mon Dieu... c'est l'enfer !''";
UTNT_VOICE_045 = "\cR''C'est tout ?... Envoyez la suite !''";
UTNT_VOICE_046 = "\cR''Je crois que c'est ici que tout commence vraiment... et ici\n\cRque ça finit... maintenant !''";
UTNT_VOICE_047 = "\cR''Vous ne m'arrêterez pas !''";
UTNT_VOICE_048 = "\cR''Oups !''";
UTNT_VOICE_049 = "\cR''Là, je suis vraiment dans le pétrin... bon, alors, Sieg Heil !''";
UTNT_VOICE_050 = "\cR''C'est un mur plein. Le pousser ne fera sans doute rien !''";
