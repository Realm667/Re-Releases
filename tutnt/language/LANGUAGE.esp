UTNT_TNTLE_332 = "\cC¡Debes desactivar el campo de fuerza desde otro lugar!";
UTNT_TNTLE_333 = "\cC¡Esta puerta se abre desde otro lugar!";
UTNT_TNTLE_334 = "\cG¡Dios mío, es correo basura publicitario!";
UTNT_TNTLE_335 = "\cC¡Dispara al núcleo principal de energía para desactivar el campo de fuerza!";
UTNT_TNTLE_336 = "\cC¡Sieg Heil y buen botín, Adolf ha muerto!";
UTNT_TNTLE_337 = "\cC¡Núcleo de energía desconectado! El campo de fuerza debería estar desactivado.";
UTNT_TNTLE_338 = " monstruos restantes";
UTNT_TNTLE_339 = "\cCBien hecho, ¿pero crees que eso era todo?";
UTNT_TNTLE_340 = " monstruos restantes";
UTNT_TNTLE_341 = "\cCVale, por ahora puedes salir de esta arena...";
UTNT_TNTLE_342 = "\cC¡Esta puerta se abre desde otro lugar!";
UTNT_TNTLE_343 = "\cCEsta puerta solo se abre a distancia";
UTNT_TNTLE_344 = "\cG¡Dios mío, es la guarida de terror y muerte de DopeFish!";
UTNT_TNTLE_345 = "\cCEsta puerta lleva a un secreto. ¿Por qué ibas a poder abrirla simplemente usándola?";
UTNT_TNTLE_346 = "\cG...Juro que ya he visto este lugar...";
UTNT_TNTLE_347 = "\cC¡Esta puerta está rota!";
UTNT_TNTLE_348 = "\cC¡Esta puerta no se puede abrir!";
UTNT_TNTLE_349 = "\cGAlgo me dice que no debería tocar este interruptor...";
UTNT_TNTLE_350 = "\cG¡Bien, parece que he terminado aquí!";
UTNT_TNTLE_351 = "\cGEs una pared sólida. ¡Tocarla probablemente no servirá de nada!";
UTNT_TNTLE_352 = "\cCComienza: \cGPrimera \cCde seis batallas";
UTNT_TNTLE_353 = "\cCComienza: \cGSegunda \cCde seis batallas";
UTNT_TNTLE_354 = "\cCComienza: \cGTercera \cCde seis batallas";
UTNT_TNTLE_355 = "\cCComienza: \cGCuarta \cCde seis batallas";
UTNT_TNTLE_356 = "\cCComienza: \cGQuinta \cCde seis batallas";
UTNT_TNTLE_357 = "\cCComienza la \cGÚltima \cCbatalla";
UTNT_TNTLE_358 = "\cC¡Teletransportador accesible!";
UTNT_TNTLE_359 = "\cCObjetivo cumplido:\n\cGHas llegado al techo de la caverna";
UTNT_TNTLE_360 = "\cCObjetivo cumplido:\n\cGHas encontrado el corazón del núcleo del portal";
UTNT_UI_SCALE = "Mensajes y objetivos: escala";
UTNT_UI_SCALE_TIP = "Ajusta el espaciado y tamaño del texto de la interfaz. El texto conserva al menos la escala nativa de píxeles.";
UTNT_VOICE_019 = "\cR''¡Bien, vamos a buscar algo de carne!''";
UTNT_VOICE_020 = "\cR''¡Pero qué...!''";
UTNT_VOICE_021 = "\cR''...mmmmh, aquí huele a muerte y peligro...\n\cR  ¡Aunque podría ser mi loción de afeitar!''";
UTNT_VOICE_022 = "\cR''¡Oh, oh!''";
UTNT_VOICE_023 = "\cR''¡Je, je, je... eso ha sido demasiado fácil!''";
UTNT_VOICE_024 = "\cR''¡La próxima vez recordaré cerrar la boca!''";
UTNT_VOICE_025 = "\cR''El tiempo en Tei Tenga era mucho mejor...\n\cR  ¡Debería haberme quedado allí!''";
UTNT_VOICE_026 = "\cR''<casi un arch-vile>...¡tú mismo!''";
UTNT_VOICE_027 = "\cR''¡Los que van a morir te saludan!''";
UTNT_VOICE_028 = "\cR''¡¿Eso es lo mejor que tenéis?!''";
UTNT_VOICE_029 = "\cR''¡Oh, oh!''";
UTNT_VOICE_030 = "\cR''¡Enfréntate al Creador!''";
UTNT_VOICE_031 = "\cR''Me gustaba más la armería, con esa cálida sensación\n\cRde acero trabajado y torsos de demonios reventando.''";
UTNT_VOICE_032 = "\cR''Hay cosas más antiguas y repugnantes que los imps\n\cRen las profundidades del mundo.''";
UTNT_VOICE_033 = "\cR''Oh, sí, eso me da una sensación cálida y agradable.''";
UTNT_VOICE_034 = "\cR''¡Hora de encender la barbacoa!''";
UTNT_VOICE_035 = "\cR''Hmm... salid, salid, dondequiera que estéis...''";
UTNT_VOICE_036 = "\cR''¡Odio las arañas!''";
UTNT_VOICE_037 = "\cR''Ya no hay vuelta atrás... es hora de demostrar\n\cR¡de qué estoy hecho!''";
UTNT_VOICE_038 = "Puedo sentirlo...\nel poder maligno\nque yace tras este portal oscuro\n...la fuente del mal,\n\nque engendra cientos de demonios\nque cazan a la humanidad\nesta vez en nuestro hogar,\nla propia Tierra\n\nCasi puedo sentir\nla fría mano de la muerte rozándome";
UTNT_VOICE_039 = "y\n...buscando mi alma...\nSé que esta última misión \nme costará la vida.\n\nEs mi destino,\n\nmi sino morir en esta guerra...\nla única oportunidad...\nde salvar a quienes amo... \npero ¿y si hay mucho más \nmás allá de lo que puedo sentir? ...";
UTNT_VOICE_040 = "\cR''¡Oh, sí, ahora sí estamos metidos de lleno, chicos!''";
UTNT_VOICE_041 = "\cR''¡Los tengo! ¡Hora de salir de este lugar olvidado de Dios!''";
UTNT_VOICE_042 = "\cR''¡Vaya... un déjà vu!''";
UTNT_VOICE_043 = "\cR''Bueno, no creo que él vaya a usarlo.''";
UTNT_VOICE_044 = "\cR''¡Dios mío... esto es el infierno!''";
UTNT_VOICE_045 = "\cR''¿Eso es todo?... ¡Mandad más!''";
UTNT_VOICE_046 = "\cR''Supongo que aquí es donde empieza de verdad... y aquí\n\cRes donde acaba... ¡ahora!''";
UTNT_VOICE_047 = "\cR''¡No me detendréis!''";
UTNT_VOICE_048 = "\cR''¡Ups!''";
UTNT_VOICE_049 = "\cR''Ahora sí que estoy en apuros... bueno, pues, ¡Sieg Heil!''";
UTNT_VOICE_050 = "\cR''Es una pared sólida. ¡No creo que empujarla sirva de nada!''";
UTNT_VOICE_051 = "\cR''¡Sí, nena, carga y prepara el arma!''";
UTNT_VOICE_052 = "\cR''Juro que ya he visto este lugar.''";
UTNT_VOICE_053 = "\cR''Tengo un mal presentimiento... lo que haya hecho\n\cResto era muy poderoso...''";
UTNT_VOICE_SPEAKER = "Tú";
UTNT_YES = "Sí";
