UTNT_NOTICE_318 = "\c[UTNTNoticeAccent]Bouncy\c[UTNTNoticeBody] - No rebotó lo bastante rápido; lo atrapó una calavera temblorosa en el bosque.";
UTNT_NOTICE_319 = "\c[UTNTNoticeAccent]Cutman\c[UTNTNoticeBody] - Desapareció investigando los asesinatos de Bouncy y otros cazarrecompensas.";
UTNT_NOTICE_320 = "\c[UTNTNoticeAccent]DoomDude\c[UTNTNoticeBody] - Murió solo, luchando por mantener vivo a NewDoom.";
UTNT_NOTICE_321 = "\c[UTNTNoticeAccent]Enjay\c[UTNTNoticeBody] - Su nuevo hogar si sigue poniéndonos los dientes largos con capturas de Aspects.";
UTNT_NOTICE_322 = "\c[UTNTNoticeAccent]Eriance\c[UTNTNoticeBody] - Devorado por sus últimas creaciones monstruosas.";
UTNT_NOTICE_323 = "\c[UTNTNoticeAccent]Hirogen2\c[UTNTNoticeBody] - Descuartizado por ser imparcial una vez de más.";
UTNT_NOTICE_324 = "\c[UTNTNoticeAccent]Keksdose\c[UTNTNoticeBody] - Cegado y quemado por sus propias creaciones malignas.";
UTNT_NOTICE_325 = "\c[UTNTNoticeAccent]Phobus\c[UTNTNoticeBody] - Muerto por la espada de la facción expulsada: el final de un moderador de ZDoom.";
UTNT_NOTICE_326 = "\c[UTNTNoticeAccent]Randy\c[UTNTNoticeBody] - Cayó en batalla en los campos de Azeroth. Que la luz lo acompañe.";
UTNT_NOTICE_327 = "\c[UTNTNoticeAccent]Scuba Steve\c[UTNTNoticeBody] - Emboscado por fanáticos de la acción que exigían secuelas.";
UTNT_NOTICE_328 = "\c[UTNTNoticeAccent]Solarsnowfall\c[UTNTNoticeBody] - Condenado por brujería tras recrear fenómenos naturales a mano.";
UTNT_NOTICE_329 = "\c[UTNTNoticeAccent]TheDarkArchon\c[UTNTNoticeBody] - ¡Muerto del susto por YureiodfuoidguosdfiuogiARGH!!!";
UTNT_NOTICE_330 = "\c[UTNTNoticeAccent]Vader\c[UTNTNoticeBody] - Desapareció tras poner en sus mapas más detalle que Tormentor667.";
UTNT_NOTICE_331 = "\c[UTNTNoticeAccent]Graf Zahl\c[UTNTNoticeBody] - Planeaba dejar de trabajar en GZDoom. Nunca más se supo de él...";
UTNT_NOTICE_332 = "\c[UTNTNoticeAccent]Campo de fuerza\c[UTNTNoticeBody] - Desactívalo desde otro lugar";
UTNT_NOTICE_334 = "\c[UTNTNoticeAccent]Correo basura publicitario\c[UTNTNoticeBody] - ¡Dios mío!";
UTNT_NOTICE_335 = "\c[UTNTNoticeAccent]Campo de fuerza\c[UTNTNoticeBody] - Dispara al núcleo principal de energía para desactivarlo";
UTNT_NOTICE_336 = "\c[UTNTNoticeAccent]Adolf\c[UTNTNoticeBody] - Derrotado";
UTNT_NOTICE_337 = "\c[UTNTNoticeAccent]Núcleo de energía desconectado\c[UTNTNoticeBody] - El campo de fuerza debería estar desactivado";
UTNT_NOTICE_344 = "\c[UTNTNoticeAccent]DopeFish\c[UTNTNoticeBody] - ¡Guarida de terror y muerte!";
UTNT_NOTICE_345 = "\c[UTNTNoticeAccent]Puerta secreta\c[UTNTNoticeBody] - Usarla no la abrirá";
UTNT_NOTICE_346 = "\c[UTNTNoticeAccent]Este lugar\c[UTNTNoticeBody] - Juro que ya he estado aquí...";
UTNT_NOTICE_349 = "\c[UTNTNoticeAccent]Interruptor\c[UTNTNoticeBody] - Algo me dice que no lo toque...";
UTNT_NOTICE_350 = "\c[UTNTNoticeAccent]¡Parece que he terminado aquí!";
UTNT_NOTICE_351 = "\c[UTNTNoticeAccent]Pared sólida\c[UTNTNoticeBody] - Tocarla probablemente no servirá de nada";
UTNT_NOTICE_358 = "\c[UTNTNoticeAccent]Teletransportador\c[UTNTNoticeBody] - Accesible";
UTNT_NOTICE_57 = "\c[UTNTNoticeAccent]Punto de control cooperativo\c[UTNTNoticeBody] - Alcanzado";
UTNT_OBJ_1_1_TEXT = "Ábrete paso hasta el centro técnico.";
