UTNT_OBJ_5_1_TITLE = "FUSIL DE PLASMA";
UTNT_OBJ_5_2_TEXT = "Mata a las Spider Masterminds para bajar los pilares.";
UTNT_OBJ_5_2_TITLE = "SPIDER MASTERMINDS";
