UTNT_INTERMAP_059 = "\cCPulsa \cG<usar> \cCpara omitir la intermisión";
UTNT_INTERMAP_060 = "Poco a poco sales\n";
UTNT_INTERMAP_061 = "de las catacumbas\n";
UTNT_INTERMAP_062 = "y las dejas atrás.\n\n";
UTNT_INTERMAP_063 = "Tus manos son rojas como\n";
UTNT_INTERMAP_064 = "la sangre y el cielo sobre ti.\n\n";
UTNT_INTERMAP_065 = "Has logrado cruzar\n";
UTNT_INTERMAP_066 = "el cinturón defensivo exterior\n";
UTNT_INTERMAP_067 = "de esta instalación infernal\n";
UTNT_INTERMAP_068 = "y estás un paso más cerca\n";
UTNT_INTERMAP_069 = "del portal oscuro...\n\n";
UTNT_INTERMAP_070 = "Ya puedes oler\n";
UTNT_INTERMAP_071 = "el hedor del acero\n";
UTNT_INTERMAP_072 = "fundido y la carne\n";
UTNT_INTERMAP_073 = "incinerada...\n\n";
UTNT_INTERMAP_074 = "Esto no ha hecho más que empezar...";
UTNT_INTERMAP_075 = "El olor acre del acero\n";
UTNT_INTERMAP_076 = "trabajado aún flota\n";
UTNT_INTERMAP_077 = "en el aire, pero las tormentas heladas\n";
UTNT_INTERMAP_078 = "confunden tus sentidos.\n";
UTNT_INTERMAP_079 = "Ante ti se alza\n";
UTNT_INTERMAP_080 = "la cumbre helada de otra\n";
UTNT_INTERMAP_081 = "montaña maldita. El único\n";
UTNT_INTERMAP_082 = "camino es seguir adelante\n";
UTNT_INTERMAP_083 = "hacia la Fortaleza de\n";
UTNT_INTERMAP_084 = "la Condenación...\n";
UTNT_INTERMAP_085 = "Así que mantén las armas calientes\n";
UTNT_INTERMAP_086 = "y listas para perforar\n";
UTNT_INTERMAP_087 = "¡almas malditas!\n";
UTNT_INTERMAP_088 = "Al mirar por encima\n";
UTNT_INTERMAP_089 = "del hombro, aún ves\n";
UTNT_INTERMAP_090 = "la silueta oscura\n";
UTNT_INTERMAP_091 = "de las instalaciones devastadas.\n";
UTNT_INTERMAP_092 = "Das gracias a Dios por\n";
UTNT_INTERMAP_093 = "seguir vivo, pues sabes\n";
UTNT_INTERMAP_094 = "que ninguno de tus compañeros\n";
UTNT_INTERMAP_095 = "habría logrado atravesar\n";
UTNT_INTERMAP_096 = "ese edificio terrible.\n";
UTNT_INTERMAP_097 = "De repente, un ruido\n";
UTNT_INTERMAP_098 = "ensordecedor te llama la atención\n";
UTNT_INTERMAP_099 = "y miras hacia lo que\n";
UTNT_INTERMAP_100 = "te espera: una siniestra\n";
UTNT_INTERMAP_101 = "fortaleza devastada.\n";
UTNT_INTERMAP_102 = "En su interior está el último\n";
UTNT_INTERMAP_103 = "portal infernal de la Tierra.\n";
UTNT_INTERMAP_104 = "Pronto el reinado del terror\n";
UTNT_INTERMAP_105 = "habrá terminado...";
UTNT_INTERMAP_106 = "Un hedor repugnante llenó\n";
UTNT_INTERMAP_107 = "el aire cuando la última\n";
UTNT_INTERMAP_108 = "araña demoníaca cayó\n";
UTNT_INTERMAP_109 = "al suelo. Los guardianes del portal\n";
UTNT_INTERMAP_110 = "fracasaron cuando tu último\n";
UTNT_INTERMAP_111 = "disparo atravesó sus\n";
UTNT_INTERMAP_112 = "cadáveres putrefactos.\n";
UTNT_INTERMAP_113 = "Solo quedaba\n";
UTNT_INTERMAP_114 = "destruir la última puerta infernal\n";
UTNT_INTERMAP_115 = "de la Tierra para impedir que nuevos demonios\n";
UTNT_INTERMAP_116 = "atormentaran tu mundo.\n";
UTNT_INTERMAP_117 = "Frente al portal,\n";
UTNT_INTERMAP_118 = "mientras recargabas\n";
UTNT_INTERMAP_119 = "el lanzacohetes, dudaste\n";
UTNT_INTERMAP_120 = "un instante... No podías\n";
UTNT_INTERMAP_121 = "destruir la puerta. Algo\n";
UTNT_INTERMAP_122 = "te arrastraba a aquel vacío negro...\n";
UTNT_INTERMAP_123 = "Quizá solo era curiosidad,\n";
UTNT_INTERMAP_124 = "quizá un poder sobrehumano...\n";
UTNT_INTERMAP_125 = "No pudiste resistirte más\n";
UTNT_INTERMAP_126 = "y seguiste a la nada...\n";
UTNT_INTERMAP_127 = "Tu misión parecía\n";
UTNT_INTERMAP_128 = "un fracaso...\n";
UTNT_INTERMAP_129 = "Sientes el poderoso\n";
UTNT_INTERMAP_130 = "remolino que te arrastra\n";
UTNT_INTERMAP_131 = "hacia el vacío negro\n";
UTNT_INTERMAP_132 = "ante ti.\n";
UTNT_INTERMAP_133 = "Poco a poco los gritos\n";
UTNT_INTERMAP_134 = "de tus compañeros moribundos\n";
UTNT_INTERMAP_135 = "se apagan, junto con\n";
UTNT_INTERMAP_136 = "la luz a tus espaldas...\n";
UTNT_INTERMAP_137 = "Los pensamientos se mezclan\n";
UTNT_INTERMAP_138 = "mientras viajas\n";
UTNT_INTERMAP_139 = "por miles de dimensiones,\n";
UTNT_INTERMAP_140 = "directo al centro\n";
UTNT_INTERMAP_141 = "de todo el mal...\n";
UTNT_INTERMAP_142 = "Tu visión se tiñe de rojo\n";
UTNT_INTERMAP_143 = "al perder el conocimiento.\n";
UTNT_INTERMAP_144 = "Los segundos se vuelven semanas\n";
UTNT_INTERMAP_145 = "y las horas, siglos.\n";
UTNT_INTERMAP_146 = "El tiempo y el espacio se difuminan\n";
UTNT_INTERMAP_147 = "a tu alrededor y quedas paralizado\n";
UTNT_INTERMAP_148 = "en este proceso interminable.\n";
UTNT_INTERMAP_149 = "Sientes que la Fuente\n";
UTNT_INTERMAP_150 = "se acerca, casi\n";
UTNT_INTERMAP_151 = "puede tocarte,\n";
UTNT_INTERMAP_152 = "está aquí...\n";
UTNT_INTERMAP_153 = "El humo sube al cielo\n";
UTNT_INTERMAP_154 = "desde el oscuro abismo\n";
UTNT_INTERMAP_155 = "ante ti, que fue la garganta\n";
UTNT_INTERMAP_156 = "de seres viles y crueles\n";
UTNT_INTERMAP_157 = "cuyo único fin era matarte\n";
UTNT_INTERMAP_158 = "a ti y a toda tu especie...\n";
UTNT_INTERMAP_159 = "Pero ya terminó. La Fuente\n";
UTNT_INTERMAP_160 = "está destruida y el origen\n";
UTNT_INTERMAP_161 = "de todo el mal que asoló la Tierra\n";
UTNT_INTERMAP_162 = "está sellado...\n";
UTNT_INTERMAP_163 = "Tu misión ha terminado\n";
UTNT_INTERMAP_164 = "y es hora de sentarte\n";
UTNT_INTERMAP_165 = "y pensar en los últimos\n";
UTNT_INTERMAP_166 = "minutos, horas y días...\n";
UTNT_INTERMAP_167 = "Es hora de comprender lo que\n";
UTNT_INTERMAP_168 = "ha pasado, de entender que\n";
UTNT_INTERMAP_169 = "regresas como el héroe\n";
UTNT_INTERMAP_170 = "que salvó a toda la humanidad.\n";
UTNT_INTERMAP_171 = "Es una buena sensación, pero\n";
UTNT_INTERMAP_172 = "aún no comprendes\n";
UTNT_INTERMAP_173 = "su significado... Eso cambiará\n";
UTNT_INTERMAP_174 = "algún día...";
UTNT_INTERMAP_175 = "Los encontraste.\n";
UTNT_INTERMAP_176 = "Y los mataste. Mataste \n";
UTNT_INTERMAP_177 = "a todas esas criaturas alienígenas\n";
UTNT_INTERMAP_178 = "antes de que pudieran\n";
UTNT_INTERMAP_179 = "tomar el control del\n";
UTNT_INTERMAP_180 = "portal oscuro destruido. Sin\n";
UTNT_INTERMAP_181 = "el núcleo, ya nadie\n";
UTNT_INTERMAP_182 = "tiene la posibilidad\n";
UTNT_INTERMAP_183 = "de reabrirlo.\n";
UTNT_INTERMAP_184 = "...pero ¿qué será de ti ahora?\n";
UTNT_INTERMAP_185 = "Estás perdido, atrapado\n";
UTNT_INTERMAP_186 = "en un callejón sin salida del infierno,\n";
UTNT_INTERMAP_187 = "sin más opción que esperar\n";
UTNT_INTERMAP_188 = "a que alguien te mate, si no\n";
UTNT_INTERMAP_189 = "lo haces tú mismo...\n";
UTNT_INTERMAP_190 = "No hay vuelta atrás ni\n";
UTNT_INTERMAP_191 = "forma de seguir adelante...\n";
UTNT_INTERMAP_192 = "Para ti, todo ha terminado.\n";
UTNT_INTERMAP_193 = "Un verdadero héroe es aquel cuyas \n";
UTNT_INTERMAP_194 = "hazañas nadie llegará\n";
UTNT_INTERMAP_195 = "a conocer.        -Outer Limits";
UTNT_INTRO_001 = "Episodio 1: El abismo se abre";
UTNT_INTRO_002 = "Episodio 2: La armería del dolor";
UTNT_INTRO_003 = "Episodio 3, parte 1: La cumbre maldita";
UTNT_INTRO_004 = "Episodio 3, parte 2: El corazón maligno";
UTNT_INTRO_005 = "Episodio 4, parte 1: Hacia la oscuridad";
UTNT_INTRO_006 = "Episodio 4, parte 2: Más allá del portal oscuro";
UTNT_INTRO_007 = "Episodio 4, parte 3: El principio y el fin (versión del director)";
UTNT_INTRO_008 = "Episodio 4, parte 3: El principio y el fin";
UTNT_INTRO_009 = "Episodio perdido: La furia del fuego";
UTNT_INTRO_010 = "Ábrete paso hasta el centro técnico.\nCruza el pasadizo de las mazmorras y abandona el primer cinturón defensivo.";
UTNT_INTRO_011 = "Encuentra la sala de control de la instalación A.\nEntra en la instalación B abandonada.\nEncuentra el paso a la cumbre maldita y sal de la armería.";
UTNT_INTRO_012 = "Ábrete paso hasta el almacén.\nEncuentra la mina.\nSal de la instalación hacia el sur, rumbo a la fortaleza.";
UTNT_INTRO_013 = "Mata a los guardianes del portal.\nDestruye el portal oscuro.";
UTNT_INTRO_014 = "Encuentra el fusil de plasma junto a la torre del reloj.\nMata a las Spider Masterminds para bajar los pilares.\nEntra en el portal oscuro.";
UTNT_INTRO_015 = "Encuentra un camino al borde del caos.\nEncuentra la BFG9000.";
UTNT_INTRO_016 = "Ábrete paso hasta la cueva eterna.\nDestruye la Fuente y a sus guardianes.";
UTNT_INTRO_017 = "Ábrete paso hasta la cumbre.\nDestruye la Fuente y a sus guardianes.";
UTNT_INTRO_018 = "Ábrete paso desde las cuevas hasta la cima.\nEncuentra el corazón del núcleo del portal.";
