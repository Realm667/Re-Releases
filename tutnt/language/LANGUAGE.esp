UTNT_TNT04B_289 = "\cG¿Por qué me resulta tan familiar este maldito lugar? ...";
UTNT_TNT04B_290 = "\cG¡El pilar está demasiado destrozado para leerlo!";
UTNT_TNT04B_291 = "\cC¡Secuencia completada, pilares bajados!";
UTNT_TNT04B_292 = "\cGUna \cCmás pendiente";
UTNT_TNT04B_293 = "\cCMás allá está \cGEl borde del caos\n\cC¡Da la vuelta o arde en el infierno por toda la eternidad!";
UTNT_TNT04B_294 = "\cCLa puerta de \cGComandancia del mundo fronterizo \cC¡se ha abierto!";
UTNT_TNT04B_295 = "\cG¡Módulo de control configurado, sistema accesible!";
UTNT_TNT04B_296 = "\cG¡Falta el módulo de control, no puedo usarlo!";
UTNT_TNT04B_297 = "\cG¡Has encontrado el módulo de control perdido!";
UTNT_TNT04B_298 = "\cC¡Esta puerta se abre a distancia!";
UTNT_TNT04B_299 = "\cC¡Secuencia completada, pilares bajados!";
UTNT_TNT04B_300 = "\cGUna \cCmás pendiente";
UTNT_TNT04B_301 = "\cCEsta puerta no se puede abrir";
UTNT_TNT04B_302 = "\cCLos pilares de acceso al \cGPortal de la frontera infernal \cC¡han bajado!";
UTNT_TNT04B_303 = "\cGUna \cCmás pendiente";
UTNT_TNT04B_304 = "\cCObjetivo cumplido:\n\cGHas encontrado la BFG9000";
UTNT_TNT04B_305 = "\cCObjetivo cumplido:\n\cGHas llegado al borde del caos";
UTNT_TNT04B_306 = "\cCFinal alternativo \cGActivado";
UTNT_TNT04B_307 = "\cCHas encontrado el pasadizo secreto al \cGfinal alternativo\cC:\n\cGEpisodio 4\cC, versión del director";
UTNT_TNT04CN_318 = "\cGBouncy, \cCno rebotó lo bastante rápido y fue atrapado\n\cCpor una calavera temblorosa en el bosque.";
UTNT_TNT04CN_319 = "\cGCutman, \cCdesapareció al investigar el asesinato\n\cCde Bouncy y otros cazarrecompensas.";
UTNT_TNT04CN_320 = "\cGDoomDude, \cCmurió en soledad luchando por mantener\n\cCNewDoom vivo... solo.";
UTNT_TNT04CN_321 = "\cGEnjay, \cCreserva para su nuevo hogar si sigue\n\cCponiéndonos los dientes largos con capturas de Aspects.";
UTNT_TNT04CN_322 = "\cGEriance, \cCdevorado por sus últimas creaciones monstruosas.";
UTNT_TNT04CN_323 = "\cGHirogen2, \cCdescuartizado por ser imparcial\n\cCuna vez de más.";
UTNT_TNT04CN_324 = "\cGKeksdose, \cCcegado y quemado por sus propias creaciones malignas.";
UTNT_TNT04CN_325 = "\cGPhobus, \cCmurió como moderador de ZDoom por\n\cCla espada de la facción expulsada de la comunidad.";
UTNT_TNT04CN_326 = "\cGRandy, \cCcayó en batalla en los campos de Azeroth,\n\cCque la luz lo acompañe.";
UTNT_TNT04CN_327 = "\cGScuba Steve, \cCemboscado por un grupo de fanáticos de la acción\n\cCque exigían secuelas.";
UTNT_TNT04CN_328 = "\cGSolarsnowfall, \cCacusado de brujería y condenado a morir por\n\cCrecrear fenómenos naturales con sus manos.";
UTNT_TNT04CN_329 = "\cGTheDarkArchon, \cC¡Muerto del susto por YureiodfuoidguosdfiuogiARGH!!!";
UTNT_TNT04CN_330 = "\cGVader, \cCdesapareció tras poner en sus mapas\n\cCmás detalle que Tormentor667.";
UTNT_TNT04CN_331 = "\cGGraf Zahl, \cCplaneaba dejar de trabajar en GZDoom,\n\cCnunca más se supo de él...";
