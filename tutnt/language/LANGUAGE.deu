UTNT_NOTICE_315 = "\c[UTNTNoticeAccent]Ebene 4\c[UTNTNoticeBody] - Aufzug zugänglich";
UTNT_NOTICE_316 = "\c[UTNTNoticeAccent]Ebene 4\c[UTNTNoticeBody] - Noch ein Schalter fehlt";
UTNT_NOTICE_318 = "\c[UTNTNoticeAccent]Bouncy\c[UTNTNoticeBody] - Hüpfte nicht schnell genug; von einem Zappelschädel im Wald erwischt.";
UTNT_NOTICE_319 = "\c[UTNTNoticeAccent]Cutman\c[UTNTNoticeBody] - Verschollen bei der Untersuchung der Morde an Bouncy und anderen Kopfgeldjägern.";
UTNT_NOTICE_320 = "\c[UTNTNoticeAccent]DoomDude\c[UTNTNoticeBody] - Starb allein im Kampf darum, NewDoom am Leben zu halten.";
UTNT_NOTICE_321 = "\c[UTNTNoticeAccent]Enjay\c[UTNTNoticeBody] - Sein neues Heim, falls er uns weiter mit Aspects-Screenshots auf die Folter spannt.";
UTNT_NOTICE_322 = "\c[UTNTNoticeAccent]Eriance\c[UTNTNoticeBody] - Von seinen neuesten Monsterkreationen gefressen.";
UTNT_NOTICE_323 = "\c[UTNTNoticeAccent]Hirogen2\c[UTNTNoticeBody] - Zerhackt, weil er einmal zu oft unparteiisch war.";
UTNT_NOTICE_324 = "\c[UTNTNoticeAccent]Keksdose\c[UTNTNoticeBody] - Von seinen eigenen bösen Kreationen geblendet und verbrannt.";
UTNT_NOTICE_325 = "\c[UTNTNoticeAccent]Phobus\c[UTNTNoticeBody] - Vom Schwert der verbannten Community-Fraktion erschlagen: der Tod eines ZDoom-Moderators.";
UTNT_NOTICE_326 = "\c[UTNTNoticeAccent]Randy\c[UTNTNoticeBody] - Gefallen auf den Schlachtfeldern von Azeroth. Möge das Licht mit ihm sein.";
UTNT_NOTICE_327 = "\c[UTNTNoticeAccent]Scuba Steve\c[UTNTNoticeBody] - Überfallen von Actionfanatikern, die Fortsetzungen verlangten.";
UTNT_NOTICE_328 = "\c[UTNTNoticeAccent]Solarsnowfall\c[UTNTNoticeBody] - Wegen Hexerei verurteilt, nachdem er Naturphänomene mit bloßen Händen nachbildete.";
UTNT_NOTICE_329 = "\c[UTNTNoticeAccent]TheDarkArchon\c[UTNTNoticeBody] - Zu Tode erschreckt von YureiodfuoidguosdfiuogiARGH!!!";
UTNT_NOTICE_330 = "\c[UTNTNoticeAccent]Vader\c[UTNTNoticeBody] - Verschwunden, nachdem seine Karten mehr Details hatten als die von Tormentor667.";
UTNT_NOTICE_331 = "\c[UTNTNoticeAccent]Graf Zahl\c[UTNTNoticeBody] - Wollte die Arbeit an GZDoom einstellen. Seitdem nie wieder etwas von ihm gehört...";
UTNT_NOTICE_332 = "\c[UTNTNoticeAccent]Kraftfeld\c[UTNTNoticeBody] - Anderswo deaktivieren";
UTNT_NOTICE_334 = "\c[UTNTNoticeAccent]Werbespam\c[UTNTNoticeBody] - Oh mein Gott!";
UTNT_NOTICE_335 = "\c[UTNTNoticeAccent]Kraftfeld\c[UTNTNoticeBody] - Zur Deaktivierung auf den Hauptenergiekern schießen";
UTNT_NOTICE_336 = "\c[UTNTNoticeAccent]Adolf\c[UTNTNoticeBody] - Besiegt";
UTNT_NOTICE_337 = "\c[UTNTNoticeAccent]Energiekern offline\c[UTNTNoticeBody] - Kraftfeld sollte deaktiviert sein";
UTNT_NOTICE_344 = "\c[UTNTNoticeAccent]DopeFish\c[UTNTNoticeBody] - Versteck von Schrecken und Tod!";
UTNT_NOTICE_345 = "\c[UTNTNoticeAccent]Geheimtür\c[UTNTNoticeBody] - Benutzen öffnet sie nicht";
UTNT_NOTICE_346 = "\c[UTNTNoticeAccent]Dieser Ort\c[UTNTNoticeBody] - Ich schwöre, ich war schon einmal hier...";
UTNT_NOTICE_349 = "\c[UTNTNoticeAccent]Schalter\c[UTNTNoticeBody] - Etwas sagt mir, ihn nicht anzufassen...";
UTNT_NOTICE_350 = "\c[UTNTNoticeAccent]Hier bin ich wohl fertig!";
UTNT_NOTICE_351 = "\c[UTNTNoticeAccent]Massive Wand\c[UTNTNoticeBody] - Anfassen wird wohl nichts bewirken";
UTNT_NOTICE_358 = "\c[UTNTNoticeAccent]Teleporter\c[UTNTNoticeBody] - Zugänglich";
UTNT_NOTICE_57 = "\c[UTNTNoticeAccent]Koop-Kontrollpunkt\c[UTNTNoticeBody] - Erreicht";
UTNT_OBJ_1_1_TEXT = "Kämpfe dich zum Technikzentrum durch.";
UTNT_OBJ_1_1_TITLE = "TECHNIKZENTRUM";
UTNT_OBJ_1_2_TEXT = "Durchquere den Kerkergang und verlasse den ersten Verteidigungsring.";
UTNT_OBJ_1_2_TITLE = "ERSTER VERTEIDIGUNGSRING";
UTNT_OBJ_2_1_TEXT = "Finde den Kontrollraum von Anlage A.";
UTNT_OBJ_2_1_TITLE = "ANLAGE A";
UTNT_OBJ_2_2_TEXT = "Betritt die verlassene Anlage B.";
UTNT_OBJ_2_2_TITLE = "ANLAGE B";
