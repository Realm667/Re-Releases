UTNT_INTERMAP_059 = "\cCDrücke \cG<Benutzen> \cCzum Überspringen";
UTNT_INTERMAP_060 = "Langsam trittst du\n";
UTNT_INTERMAP_061 = "aus den Katakomben\n";
UTNT_INTERMAP_062 = "und lässt sie hinter dir.\n\n";
UTNT_INTERMAP_063 = "Deine Hände sind blutrot,\n";
UTNT_INTERMAP_064 = "wie der Himmel über dir.\n\n";
UTNT_INTERMAP_065 = "Du hast den äußeren\n";
UTNT_INTERMAP_066 = "Verteidigungsring dieser\n";
UTNT_INTERMAP_067 = "höllischen Anlage durchquert\n";
UTNT_INTERMAP_068 = "und bist dem dunklen Portal\n";
UTNT_INTERMAP_069 = "einen Schritt näher...\n\n";
UTNT_INTERMAP_070 = "Schon jetzt riechst du\n";
UTNT_INTERMAP_071 = "den Gestank geschmolzenen\n";
UTNT_INTERMAP_072 = "Stahls und verbrannten\n";
UTNT_INTERMAP_073 = "Fleisches...\n\n";
UTNT_INTERMAP_074 = "Das ist erst der Anfang...";
UTNT_INTERMAP_075 = "Noch immer hängt der\n";
UTNT_INTERMAP_076 = "scharfe Stahlgeruch\n";
UTNT_INTERMAP_077 = "in der Luft, doch eisige Stürme\n";
UTNT_INTERMAP_078 = "verwirren deine Sinne.\n";
UTNT_INTERMAP_079 = "Vor dir liegt der\n";
UTNT_INTERMAP_080 = "vereiste Gipfel eines weiteren\n";
UTNT_INTERMAP_081 = "verfluchten Berges. Der einzige\n";
UTNT_INTERMAP_082 = "Weg führt dich weiter\n";
UTNT_INTERMAP_083 = "zur Festung der\n";
UTNT_INTERMAP_084 = "Verdammnis...\n";
UTNT_INTERMAP_085 = "Halte deine Waffen warm\n";
UTNT_INTERMAP_086 = "und bereit, verfluchte Seelen\n";
UTNT_INTERMAP_087 = "zu durchlöchern!\n";
UTNT_INTERMAP_088 = "Als du über die Schulter\n";
UTNT_INTERMAP_089 = "zurückblickst, erkennst du noch\n";
UTNT_INTERMAP_090 = "die dunklen Umrisse der\n";
UTNT_INTERMAP_091 = "verwüsteten Anlagen.\n";
UTNT_INTERMAP_092 = "Du dankst Gott, dass du\n";
UTNT_INTERMAP_093 = "noch lebst, denn du weißt,\n";
UTNT_INTERMAP_094 = "dass keiner deiner Kameraden\n";
UTNT_INTERMAP_095 = "dieses schreckliche Gebäude\n";
UTNT_INTERMAP_096 = "hätte durchqueren können.\n";
UTNT_INTERMAP_097 = "Plötzlich erregt ein\n";
UTNT_INTERMAP_098 = "ohrenbetäubender Lärm deine Aufmerksamkeit\n";
UTNT_INTERMAP_099 = "und du blickst nach vorn,\n";
UTNT_INTERMAP_100 = "auf eine böse, verwüstete\n";
UTNT_INTERMAP_101 = "Festung.\n";
UTNT_INTERMAP_102 = "In ihr liegt das letzte\n";
UTNT_INTERMAP_103 = "Höllenportal auf Erden.\n";
UTNT_INTERMAP_104 = "Bald wird die Schreckensherrschaft\n";
UTNT_INTERMAP_105 = "ein Ende haben...";
UTNT_INTERMAP_106 = "Ein widerlicher Gestank erfüllte\n";
UTNT_INTERMAP_107 = "die Luft, als die letzte\n";
UTNT_INTERMAP_108 = "Dämonenspinne zu Boden\n";
UTNT_INTERMAP_109 = "ging. Die Portalwächter\n";
UTNT_INTERMAP_110 = "versagten, als dein letzter\n";
UTNT_INTERMAP_111 = "Schuss ihre fauligen\n";
UTNT_INTERMAP_112 = "Leiber durchbohrte.\n";
UTNT_INTERMAP_113 = "Nun blieb nur noch,\n";
UTNT_INTERMAP_114 = "das letzte Höllentor auf Erden\n";
UTNT_INTERMAP_115 = "zu zerstören, damit keine neuen Dämonen\n";
UTNT_INTERMAP_116 = "deine Heimatwelt heimsuchten.\n";
UTNT_INTERMAP_117 = "Als du vor dem Portal standest\n";
UTNT_INTERMAP_118 = "und deinen Raketenwerfer\n";
UTNT_INTERMAP_119 = "nachludst, zögertest du\n";
UTNT_INTERMAP_120 = "einen Augenblick... Du konntest\n";
UTNT_INTERMAP_121 = "das Tor nicht zerstören. Etwas\n";
UTNT_INTERMAP_122 = "zog dich in diese schwarze Leere...\n";
UTNT_INTERMAP_123 = "Vielleicht war es nur Neugier,\n";
UTNT_INTERMAP_124 = "vielleicht eine übermenschliche Macht...\n";
UTNT_INTERMAP_125 = "Du konntest nicht länger widerstehen\n";
UTNT_INTERMAP_126 = "und folgtest dem Nichts...\n";
UTNT_INTERMAP_127 = "Dein Auftrag schien\n";
UTNT_INTERMAP_128 = "gescheitert...\n";
UTNT_INTERMAP_129 = "Du spürst den mächtigen\n";
UTNT_INTERMAP_130 = "Sog, der dich in die\n";
UTNT_INTERMAP_131 = "schwarze Leere vor dir\n";
UTNT_INTERMAP_132 = "hineinzieht.\n";
UTNT_INTERMAP_133 = "Langsam verhallen die Schreie\n";
UTNT_INTERMAP_134 = "deiner sterbenden Kameraden\n";
UTNT_INTERMAP_135 = "in der Stille, zusammen mit\n";
UTNT_INTERMAP_136 = "dem Licht hinter dir...\n";
UTNT_INTERMAP_137 = "Gedanken verschmelzen\n";
UTNT_INTERMAP_138 = "miteinander, während du\n";
UTNT_INTERMAP_139 = "Tausende Dimensionen durchquerst,\n";
UTNT_INTERMAP_140 = "direkt auf das Zentrum\n";
UTNT_INTERMAP_141 = "allen Übels zu...\n";
UTNT_INTERMAP_142 = "Dein Blick färbt sich rot,\n";
UTNT_INTERMAP_143 = "als du das Bewusstsein verlierst.\n";
UTNT_INTERMAP_144 = "Sekunden werden zu Wochen\n";
UTNT_INTERMAP_145 = "und Stunden zu Jahrhunderten.\n";
UTNT_INTERMAP_146 = "Zeit und Raum verschwimmen\n";
UTNT_INTERMAP_147 = "um dich herum. Du bist gelähmt\n";
UTNT_INTERMAP_148 = "in diesem endlosen Vorgang.\n";
UTNT_INTERMAP_149 = "Du spürst, wie die Quelle\n";
UTNT_INTERMAP_150 = "näher kommt. Sie kann dich\n";
UTNT_INTERMAP_151 = "fast berühren,\n";
UTNT_INTERMAP_152 = "sie ist hier...\n";
UTNT_INTERMAP_153 = "Rauch steigt zum Himmel auf,\n";
UTNT_INTERMAP_154 = "aus dem dunklen Abgrund vor dir,\n";
UTNT_INTERMAP_155 = "dem einstigen Schlund\n";
UTNT_INTERMAP_156 = "widerlicher, grausamer Bastarde,\n";
UTNT_INTERMAP_157 = "deren einziges Ziel war, dich\n";
UTNT_INTERMAP_158 = "und deine ganze Art zu töten...\n";
UTNT_INTERMAP_159 = "Doch es ist vorbei. Die Quelle\n";
UTNT_INTERMAP_160 = "ist zerstört, und der Ursprung\n";
UTNT_INTERMAP_161 = "allen Übels, das die Erde heimsuchte,\n";
UTNT_INTERMAP_162 = "ist versiegelt...\n";
UTNT_INTERMAP_163 = "Dein Auftrag ist beendet.\n";
UTNT_INTERMAP_164 = "Es ist Zeit, dich hinzusetzen\n";
UTNT_INTERMAP_165 = "und über die letzten\n";
UTNT_INTERMAP_166 = "Minuten, Stunden und Tage nachzudenken...\n";
UTNT_INTERMAP_167 = "Zeit zu begreifen, was\n";
UTNT_INTERMAP_168 = "geschehen ist, und dass du\n";
UTNT_INTERMAP_169 = "als Held zurückkehrst,\n";
UTNT_INTERMAP_170 = "der die ganze Menschheit gerettet hat.\n";
UTNT_INTERMAP_171 = "Es ist ein gutes Gefühl, doch\n";
UTNT_INTERMAP_172 = "noch verstehst du nicht,\n";
UTNT_INTERMAP_173 = "was das bedeutet... Das wird sich ändern,\n";
UTNT_INTERMAP_174 = "irgendwann...";
UTNT_INTERMAP_175 = "Du hast sie gefunden.\n";
UTNT_INTERMAP_176 = "Und du hast sie getötet. \n";
UTNT_INTERMAP_177 = "All diese fremden Kreaturen,\n";
UTNT_INTERMAP_178 = "bevor sie die Kontrolle\n";
UTNT_INTERMAP_179 = "über das zerstörte dunkle Portal\n";
UTNT_INTERMAP_180 = "übernehmen konnten. Ohne\n";
UTNT_INTERMAP_181 = "den Kern hat niemand mehr\n";
UTNT_INTERMAP_182 = "die Möglichkeit, es wieder\n";
UTNT_INTERMAP_183 = "zu öffnen.\n";
UTNT_INTERMAP_184 = "...doch was wird nun aus dir?\n";
UTNT_INTERMAP_185 = "Du bist verloren, gefangen\n";
UTNT_INTERMAP_186 = "in einer Sackgasse der Hölle.\n";
UTNT_INTERMAP_187 = "Dir bleibt nur, darauf zu warten,\n";
UTNT_INTERMAP_188 = "dass dich jemand tötet, wenn du\n";
UTNT_INTERMAP_189 = "es nicht selbst tust...\n";
UTNT_INTERMAP_190 = "Es gibt kein Zurück und auch\n";
UTNT_INTERMAP_191 = "keinen Weg nach vorn mehr...\n";
UTNT_INTERMAP_192 = "Für dich ist es vorbei.\n";
UTNT_INTERMAP_193 = "Ein wahrer Held ist derjenige, \n";
UTNT_INTERMAP_194 = "dessen Taten niemals jemand\n";
UTNT_INTERMAP_195 = "entdecken wird!        -Outer Limits";
UTNT_INTRO_001 = "Episode 1: Der sich öffnende Abgrund";
UTNT_INTRO_002 = "Episode 2: Die Waffenkammer des Schmerzes";
UTNT_INTRO_003 = "Episode 3, Teil 1: Der verfluchte Gipfel";
UTNT_INTRO_004 = "Episode 3, Teil 2: Das böse Herz";
UTNT_INTRO_005 = "Episode 4, Teil 1: In die Dunkelheit";
UTNT_INTRO_006 = "Episode 4, Teil 2: Jenseits des dunklen Portals";
UTNT_INTRO_007 = "Episode 4, Teil 3: Der Anfang und das Ende (Director's Cut)";
UTNT_INTRO_008 = "Episode 4, Teil 3: Der Anfang und das Ende";
UTNT_INTRO_009 = "Verlorene Episode: Der Zorn des Feuers";
UTNT_INTRO_010 = "Kämpfe dich zum Technikzentrum durch.\nDurchquere den Kerkergang und verlasse den ersten Verteidigungsring.";
UTNT_INTRO_011 = "Finde den Kontrollraum von Anlage A.\nBetritt die verlassene Anlage B.\nFinde den Weg zum verfluchten Gipfel und verlasse die Waffenkammer.";
UTNT_INTRO_012 = "Kämpfe dich zum Lagerbereich durch.\nFinde die Bergbauanlage.\nVerlasse die Anlage nach Süden in Richtung Festung.";
UTNT_INTRO_013 = "Töte die Portalwächter.\nZerstöre das dunkle Portal.";
UTNT_INTRO_014 = "Finde das Plasmagewehr beim Uhrturm.\nTöte die Spider Masterminds, um die Säulen abzusenken.\nBetritt das dunkle Portal.";
UTNT_INTRO_015 = "Finde einen Weg zum Rand des Chaos.\nFinde die BFG9000.";
UTNT_INTRO_016 = "Kämpfe dich zur ewigen Höhle durch.\nZerstöre die Quelle und ihre Wächter.";
UTNT_INTRO_017 = "Kämpfe dich zum Gipfel durch.\nZerstöre die Quelle und ihre Wächter.";
UTNT_INTRO_018 = "Kämpfe dich aus den Höhlen nach oben.\nFinde das Herz des Portalkerns.";
