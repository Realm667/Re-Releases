UTNT_NOTICE_308 = "\c[UTNTNoticeAccent]Ebene 2\c[UTNTNoticeBody] - Aufzug zugänglich";
UTNT_NOTICE_309 = "\c[UTNTNoticeAccent]Ebene 2\c[UTNTNoticeBody] - {n} Gegner übrig";
