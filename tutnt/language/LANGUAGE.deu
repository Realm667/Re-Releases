UTNT_TNT04A_284 = "\cCMissionsziel erfüllt:\n\cGDu hast die Masterminds getötet! Die Säulen wurden abgesenkt";
UTNT_TNT04A_285 = "\cGEin weiterer \cCweiterer Mastermind fehlt noch";
UTNT_TNT04A_286 = "\cCHinter dieser Tür ist nichts Brauchbares!";
UTNT_TNT04A_287 = "\cCAuf diesem Weg findest du nichts Brauchbares!";
UTNT_TNT04A_288 = "\cCMissionsziel erfüllt:\n\cGDu hast das Plasmagewehr";
UTNT_TNT04A_SKIP = "BENUTZEN: INTRO ÜBERSPRINGEN";
UTNT_TNT04B_289 = "\cGWarum kommt mir dieser Ort so verdammt bekannt vor? ...";
UTNT_TNT04B_290 = "\cGDie Säule ist viel zu beschädigt, um sie zu lesen!";
UTNT_TNT04B_291 = "\cCSequenz abgeschlossen, Säulen abgesenkt!";
UTNT_TNT04B_292 = "\cGEin weiterer \cCfehlt noch";
UTNT_TNT04B_293 = "\cCDahinter liegt \cGDer Rand des Chaos\n\cCKehr jetzt um oder brenne auf ewig in der Hölle!";
UTNT_TNT04B_294 = "\cCTür zur \cGGrenzwelt-Kommandozentrale \cCwurde geöffnet!";
UTNT_TNT04B_295 = "\cGSchaltmodul eingerichtet, System zugänglich!";
UTNT_TNT04B_296 = "\cGDas Schaltmodul fehlt, ich kann das nicht benutzen!";
UTNT_TNT04B_297 = "\cGDu hast das fehlende Schaltmodul gefunden!";
UTNT_TNT04B_298 = "\cCDiese Tür wird ferngesteuert geöffnet!";
UTNT_TNT04B_299 = "\cCSequenz abgeschlossen, Säulen abgesenkt!";
UTNT_TNT04B_300 = "\cGEin weiterer \cCfehlt noch";
UTNT_TNT04B_301 = "\cCDiese Tür lässt sich nicht öffnen";
UTNT_TNT04B_302 = "\cCSäulen zum \cGPortal an der Höllengrenze \cCwurden abgesenkt!";
UTNT_TNT04B_303 = "\cGEin weiterer \cCfehlt noch";
UTNT_TNT04B_304 = "\cCMissionsziel erfüllt:\n\cGDu hast die BFG9000 gefunden";
UTNT_TNT04B_305 = "\cCMissionsziel erfüllt:\n\cGDu hast den Rand des Chaos erreicht";
UTNT_TNT04B_306 = "\cCAlternatives Ende \cGAktiviert";
UTNT_TNT04B_307 = "\cCDu hast den geheimen Weg zum \cGalternativen Ende \cCgefunden:\n\cCEpisode 4, \cGDirector's Cut";
UTNT_TNT04CN_318 = "\cGBouncy, \cChüpfte nicht schnell genug und wurde\n\cCvon einem Zappelschädel im Wald erwischt.";
UTNT_TNT04CN_319 = "\cGCutman, \cCverschollen bei der Untersuchung des Mordes\n\cCan Bouncy und anderen Kopfgeldjägern.";
UTNT_TNT04CN_320 = "\cGDoomDude, \cCstarb einsam beim Versuch,\n\cCNewDoom am Leben zu halten... allein.";
UTNT_TNT04CN_321 = "\cGEnjay, \cCPlatzhalter für sein neues Heim, falls er uns weiter\n\cCmit Aspects-Screenshots auf die Folter spannt.";
UTNT_TNT04CN_322 = "\cGEriance, \cCvon seinen neuesten Monsterkreationen gefressen.";
UTNT_TNT04CN_323 = "\cGHirogen2, \cCzerhackt, weil er einmal zu oft\n\cCunparteiisch war.";
UTNT_TNT04CN_324 = "\cGKeksdose, \cCvon seinen eigenen bösen Kreationen geblendet und verbrannt.";
UTNT_TNT04CN_325 = "\cGPhobus, \cCstarb den ZDoom-Moderatoren-Tod durch\n\cCdas Schwert der verbannten Community-Fraktion.";
UTNT_TNT04CN_326 = "\cGRandy, \cCgefallen auf den Schlachtfeldern von Azeroth.\n\cCMöge das Licht mit ihm sein.";
UTNT_TNT04CN_327 = "\cGScuba Steve, \cCüberfallen von einer Gruppe Actionfanatiker,\n\cCdie Fortsetzungen verlangten.";
UTNT_TNT04CN_328 = "\cGSolarsnowfall, \cCwegen Hexerei zum Tode verurteilt, nachdem er\n\cCNaturphänomene mit bloßen Händen nachgebildet hatte.";
UTNT_TNT04CN_329 = "\cGTheDarkArchon, \cCzu Tode erschreckt von YureiodfuoidguosdfiuogiARGH!!!";
UTNT_TNT04CN_330 = "\cGVader, \cCverschwunden, nachdem seine Karten\n\cCmehr Details hatten als die von Tormentor667.";
UTNT_TNT04CN_331 = "\cGGraf Zahl, \cCwollte die Arbeit an GZDoom einstellen,\n\cCseitdem nie wieder etwas von ihm gehört...";
UTNT_TNT04C_308 = "\cCAufzug zu \cGEbene 2 \cCzugänglich";
UTNT_TNT04C_309 = "\cG";
UTNT_TNT04C_310 = " \cCfehlt noch";
UTNT_TNT04C_311 = "\cCDieser Schalter ist defekt";
UTNT_TNT04C_312 = "\cCAufzug zu \cGEbene 3 \cCzugänglich";
UTNT_TNT04C_313 = "\cG";
UTNT_TNT04C_314 = " \cCfehlt noch";
UTNT_TNT04C_315 = "\cCAufzug zu \cGEbene 4 \cCzugänglich";
UTNT_TNT04C_316 = "\cG";
UTNT_TNT04C_317 = " \cCfehlt noch";
UTNT_TNTLE_332 = "\cCDu musst das Kraftfeld anderswo deaktivieren!";
UTNT_TNTLE_333 = "\cCDiese Tür wird anderswo geöffnet!";
UTNT_TNTLE_334 = "\cGOh Gott, das ist Werbespam!";
UTNT_TNTLE_335 = "\cCSchieße auf den Hauptenergiekern, um das Kraftfeld zu deaktivieren!";
UTNT_TNTLE_336 = "\cCSieg Heil und fette Beute, Adolf ist tot!";
UTNT_TNTLE_337 = "\cCEnergiekern offline. Kraftfeld sollte deaktiviert sein!";
UTNT_TNTLE_338 = " Monster übrig";
UTNT_TNTLE_339 = "\cCGut gemacht, aber glaubst du, das war schon alles?";
UTNT_TNTLE_340 = " Monster übrig";
UTNT_TNTLE_341 = "\cCGut, fürs Erste kannst du diese Arena verlassen...";
UTNT_TNTLE_342 = "\cCDiese Tür wird anderswo geöffnet!";
UTNT_TNTLE_343 = "\cCDiese Tür lässt sich nur ferngesteuert öffnen";
UTNT_TNTLE_344 = "\cGOh Gott, das ist DopeFishs Versteck von Schrecken und Tod!";
UTNT_TNTLE_345 = "\cCDiese Tür führt zu einem Geheimnis. Warum sollte einfaches Benutzen sie öffnen?";
UTNT_TNTLE_346 = "\cG...Ich schwöre, ich kenne diesen Ort...";
UTNT_TNTLE_347 = "\cCDiese Tür ist defekt!";
UTNT_TNTLE_348 = "\cCDiese Tür lässt sich nicht öffnen!";
UTNT_TNTLE_349 = "\cGEtwas sagt mir, dass ich diesen Schalter nicht anfassen sollte...";
UTNT_TNTLE_350 = "\cGGut, hier bin ich wohl fertig!";
UTNT_TNTLE_351 = "\cGEine massive Wand. Anfassen wird wohl nichts bewirken!";
UTNT_TNTLE_352 = "\cCEs beginnt: \cGErste \cCvon sechs Schlachten";
UTNT_TNTLE_353 = "\cCEs beginnt: \cGZweite \cCvon sechs Schlachten";
UTNT_TNTLE_354 = "\cCEs beginnt: \cGDritte \cCvon sechs Schlachten";
UTNT_TNTLE_355 = "\cCEs beginnt: \cGVierte \cCvon sechs Schlachten";
UTNT_TNTLE_356 = "\cCEs beginnt: \cGFünfte \cCvon sechs Schlachten";
UTNT_TNTLE_357 = "\cCEs beginnt die \cGLetzte \cCSchlacht";
UTNT_TNTLE_358 = "\cCTeleporter zugänglich!";
UTNT_TNTLE_359 = "\cCMissionsziel erfüllt:\n\cGDu hast die Höhlendecke erreicht";
UTNT_TNTLE_360 = "\cCMissionsziel erfüllt:\n\cGDu hast das Herz des Portalkerns gefunden";
UTNT_UI_SCALE = "Hinweise und Missionsziele: Größe";
UTNT_UI_SCALE_TIP = "Legt gemeinsame UI-Abstände und Schriftgröße fest. Text bleibt mindestens in nativer Pixelgröße.";
UTNT_VOICE_019 = "\cR''Na dann, suchen wir etwas Frischfleisch!''";
UTNT_VOICE_020 = "\cR''Was zum...!''";
UTNT_VOICE_021 = "\cR''...mmmmh, hier riecht es nach Tod und Gefahr...\n\cR  Vielleicht ist es nur mein Rasierwasser!''";
UTNT_VOICE_022 = "\cR''Oh oh!''";
UTNT_VOICE_023 = "\cR''Hmhmhm... das war fast zu einfach!''";
UTNT_VOICE_024 = "\cR''Nächstes Mal halte ich lieber die Klappe!''";
UTNT_VOICE_025 = "\cR''Das Wetter auf Tei Tenga war viel besser...\n\cR  Ich hätte dort bleiben sollen!''";
UTNT_VOICE_026 = "\cR''<fast wie ein Arch-vile>...dich selbst!''";
UTNT_VOICE_027 = "\cR''Die Totgeweihten grüßen dich!''";
UTNT_VOICE_028 = "\cR''Ist das alles, was ihr draufhabt?!''";
UTNT_VOICE_029 = "\cR''Oh oh!''";
UTNT_VOICE_030 = "\cR''Stell dich dem Schöpfer!''";
UTNT_VOICE_031 = "\cR''Irgendwie gefiel mir die Waffenkammer besser, dieses wohlige\n\cRGefühl von verarbeitetem Stahl und explodierenden Dämonentorsi.''";
UTNT_VOICE_032 = "\cR''Es gibt ältere und üblere Dinge als Imps\n\cRan den tiefen Orten der Welt.''";
UTNT_VOICE_033 = "\cR''Oh ja, da wird mir ganz warm ums Herz.''";
UTNT_VOICE_034 = "\cR''Zeit, den Grill anzuwerfen!''";
UTNT_VOICE_035 = "\cR''Hmm... kommt raus, kommt raus, wo immer ihr seid...''";
UTNT_VOICE_036 = "\cR''Ich hasse Spinnen!''";
UTNT_VOICE_037 = "\cR''Jetzt gibt es kein Zurück mehr... Zeit zu zeigen,\n\cRwas in mir steckt!''";
UTNT_VOICE_038 = "Ich kann sie spüren...\ndie böse Macht,\ndie hinter diesem dunklen Portal liegt\n...die Quelle des Bösen,\n\ndie Hunderte von Dämonen hervorbringt,\ndie die Menschheit jagen,\ndiesmal auf unserer Heimatwelt,\nder Erde selbst\n\nIch spüre beinahe,\nwie die kalte Hand des Todes mich berührt";
UTNT_VOICE_039 = "und\n...nach meiner Seele greift...\nIch weiß, dass dieser letzte Auftrag \nmein Leben fordern wird.\n\nEs ist meine Bestimmung,\n\nmein Schicksal, in diesem Krieg zu sterben...\ndie einzige Chance...\ndie zu retten, die ich liebe... \naber was, wenn da noch viel mehr ist, \njenseits dessen, was ich spüren kann? ...";
UTNT_VOICE_040 = "\cR''Oh ja, jetzt geht's richtig los, Jungs!''";
UTNT_VOICE_041 = "\cR''Erwischt! Zeit, diesen gottverlassenen Ort zu verlassen!''";
UTNT_VOICE_042 = "\cR''Wow... ein Déjà-vu!''";
UTNT_VOICE_043 = "\cR''Na ja, ich glaube kaum, dass er das noch braucht.''";
UTNT_VOICE_044 = "\cR''Oh mein Gott... das ist die Hölle!''";
UTNT_VOICE_045 = "\cR''War das schon alles?... schickt noch mehr!''";
UTNT_VOICE_046 = "\cR''Hier fängt es wohl erst richtig an... und hier\n\cRendet es... jetzt!''";
UTNT_VOICE_047 = "\cR''Ihr haltet mich nicht auf!''";
UTNT_VOICE_048 = "\cR''Hoppla!''";
UTNT_VOICE_049 = "\cR''Jetzt stecke ich richtig in Schwierigkeiten... na dann, Sieg Heil!''";
UTNT_VOICE_050 = "\cR''Eine massive Wand. Drücken bringt da vermutlich nichts!''";
UTNT_VOICE_051 = "\cR''Ja, Baby, durchladen und los!''";
UTNT_VOICE_052 = "\cR''Ich schwöre, ich kenne diesen Ort.''";
UTNT_VOICE_053 = "\cR''Ich habe ein ungutes Gefühl... was auch immer\n\cRdas angerichtet hat, war sehr mächtig...''";
UTNT_VOICE_SPEAKER = "Du";
UTNT_YES = "Ja";
WB_FLAMT = "%o wurde von %ks Flammenwerfer gegrillt.";
WB_MINIG = "%o wurde von %ks Minigun zerfetzt.";
WB_PYROC = "%o wurde von %ks Pyrokanone eingeäschert.";

