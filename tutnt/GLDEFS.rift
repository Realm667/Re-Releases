material texture URFE { shader "shaders/rift/sky-E.fp" texture nebulamap "graphics/rift/nebula.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/surround.png" }
material texture URFS { shader "shaders/rift/sky-S.fp" texture nebulamap "graphics/rift/nebula.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/surround.png" }
material texture URFW { shader "shaders/rift/sky-W.fp" texture nebulamap "graphics/rift/nebula.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/surround.png" }
material texture URFU { shader "shaders/rift/sky-U.fp" texture nebulamap "graphics/rift/nebula.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/surround.png" }
material texture URFD { shader "shaders/rift/sky-D.fp" texture nebulamap "graphics/rift/nebula.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/surround.png" }
