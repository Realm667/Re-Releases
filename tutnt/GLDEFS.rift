skybox URFSKY { URFN URFE URFS URFW URFU URFD }
material texture URFN { shader "shaders/rift/sky-N.fp" texture nebulamap "graphics/rift/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/dark-clouds.png" }
material texture URFE { shader "shaders/rift/sky-E.fp" texture nebulamap "graphics/rift/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/dark-clouds.png" }
material texture URFS { shader "shaders/rift/sky-S.fp" texture nebulamap "graphics/rift/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/dark-clouds.png" }
material texture URFW { shader "shaders/rift/sky-W.fp" texture nebulamap "graphics/rift/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/dark-clouds.png" }
material texture URFU { shader "shaders/rift/sky-U.fp" texture nebulamap "graphics/rift/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/dark-clouds.png" }
material texture URFD { shader "shaders/rift/sky-D.fp" texture nebulamap "graphics/rift/zenith.png" texture rockmap "graphics/rift/rocks-key.png" texture surroundmap "graphics/rift/dark-clouds.png" }

#include "GLDEFS.alternate"
