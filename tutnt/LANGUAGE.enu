UTNT_TNT03A2_271 = "\cGMining Facility \cCDoors have been opened";
UTNT_TNT03A2_272 = "\cCYou can't open the door from this side";
UTNT_TNT03A2_273 = "\cGSteel Processing \cCControl Center now Accessable";
UTNT_TNT03A2_274 = "\cCObjective Accomplished:\n\cGYou've found the storage area entrance";
UTNT_TNT03A2_275 = "\cCObjective Accomplished:\n\cGYou've found the mining facility";
UTNT_TNT03A2_276 = "\cCObjective Accomplished:\n\cGYou've left the installation trough the south exit";
