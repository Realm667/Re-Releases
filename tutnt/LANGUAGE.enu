[enu default]
// Presentation strings extracted from ACS; spelling and color codes preserved.
UTNT_INTRO_001 = "Episode 1: The Opening Abyss";
UTNT_INTRO_002 = "Episode 2: The Armory of Pain";
UTNT_INTRO_003 = "Episode 3, Part 1: The Cursed Peak";
UTNT_INTRO_004 = "Episode 3, Part 2: The Evil Heart";
UTNT_INTRO_005 = "Episode 4, Part 1: Into the Darkness";
UTNT_INTRO_006 = "Episode 4, Part 2: Beyond the Dark Portal";
UTNT_INTRO_007 = "Episode 4, Part 3: The Beginning and The End (Director's Cut)";
UTNT_INTRO_008 = "Episode 4, Part 3: The Beginning and The End";
UTNT_INTRO_009 = "Lost Episode: Fury of Fire";
UTNT_INTRO_010 = "\cC     -Fight your way to the Tech Center\n		\n\cC     -Pass the Dungeon passage and leave the first defense belt";
UTNT_INTRO_011 = "\cC     -Find the Facility A Control Room\n		\n\cC     -Enter the abandoned Facility B\n		\n\cC     -Find the cursed peak passage as an exit to leave the armory";
UTNT_INTRO_012 = "\cC     -Fight your way to the storage area\n		\n\cC     -Find the mining facility\n		\n\cC     -Leave the installation in the south facing the fortress";
UTNT_INTRO_013 = "\cC     -Kill the portal guards\n		\n\cC     -Destroy the Dark Portal";
UTNT_INTRO_014 = "\cC     -Find the Plasma Rifle near the clocktower\n		\n\cC     -Kill the Spider Masterminds to lower the pillars\n		\n\cC     -Enter the Dark Portal";
UTNT_INTRO_015 = "\cC     -Find a way to the edge of chaos\n		\n\cC     -Find the BFG9000";
UTNT_INTRO_016 = "\cC     -Fight your way to the eternal cave\n		\n\cC     -Destroy 'The Source' and its Guardians";
UTNT_INTRO_017 = "\cC     -Fight your way to peak\n		\n\cC     -Destroy 'The Source' and its Guardians";
UTNT_INTRO_018 = "\cC     -Battle your way out of the caves to the top\n		\n\cC     -Find the Portal Core's Heart";
UTNT_VOICE_019 = "\cR''Right, let's find some meat!''";
UTNT_VOICE_020 = "\cR''What the...!''";
UTNT_VOICE_021 = "\cR''...mmmmh, it smells like death and danger in here...\n\cR  That could just be my aftershave!''";
UTNT_VOICE_022 = "\cR''Uh oh!''";
UTNT_VOICE_023 = "\cR''Hmhmhm... that was almost too easy!''";
UTNT_VOICE_024 = "\cR''Next time, I'll remember to keep my mouth shut!''";
UTNT_VOICE_025 = "\cR''The weather on Tei Tenga was much better...\n\cR  I should have stayed there!''";
UTNT_VOICE_026 = "\cR''<almost an arch-vile>...yourself!''";
UTNT_VOICE_027 = "\cR''Those who are about to die salute you!''";
UTNT_VOICE_028 = "\cR''Is that the best you've got?!''";
UTNT_VOICE_029 = "\cR''Uh oh!''";
UTNT_VOICE_030 = "\cR''Face the Maker!''";
UTNT_VOICE_031 = "\cR''I somehow liked the armory better, the comfortable warm\n\cR\feeling of processed steel and exploding demon torsos.''";
UTNT_VOICE_032 = "\cR''There are older and fouler things than Imps\n\cR\in the deep places of the world.''";
UTNT_VOICE_033 = "\cR''Oh yeah, that gives me a warm n'fuzzy feeling.''";
UTNT_VOICE_034 = "\cR''Time to light the barbecue!''";
UTNT_VOICE_035 = "\cR''Hmm... get out, get out, wherever you are...''";
UTNT_VOICE_036 = "\cR''I hate spiders!''";
UTNT_VOICE_037 = "\cR''There's no way back now... it's time to show\n\cRwhat I'm made of!''";
UTNT_VOICE_038 = "I can feel it...\nthe evil power\nthat lies beyond this dark portal\n...the source of evil,\n\nspawning hundreds of demons\nhunting down humankind\nthis time on our homeworld,\nearth itself\n\nI can almost feel\nthe cold hand of death touching me";
UTNT_VOICE_039 = "and\n...reaching out for my soul...\nI know that this final mission \nwill claim my life.\n\nIt is my destiny,\n\nmy fate to die in this war...\nthe only chance...\nto save those I love... \nbut what if there is much more \nbeyond what I can feel? ...";
UTNT_VOICE_040 = "\cR''Oh yeah, we're into it now boys!''";
UTNT_VOICE_041 = "\cR''Got'em, time to leave this god-forsaken place now!''";
UTNT_VOICE_042 = "\cR''Whoa... deja-vu!''";
UTNT_VOICE_043 = "\cR''Well, I don't suppose he's gonna use it.''";
UTNT_VOICE_044 = "\cR''Oh my god... this is hell!''";
UTNT_VOICE_045 = "\cR''Is that all you've got?... bring on some more!''";
UTNT_VOICE_046 = "\cR''I gues this is where it really begins... and this is\n\cRwhere it ends.. now!''";
UTNT_VOICE_047 = "\cR''You won't stop me!''";
UTNT_VOICE_048 = "\cR''Oops!''";
UTNT_VOICE_049 = "\cR''Now I'm really in trouble... oh well then, Sieg Heil!''";
UTNT_VOICE_050 = "\cR''It's a solid wall. It propably won't do anything if I push it!''";
UTNT_VOICE_051 = "\cR''Yeah baby, lock and load!''";
UTNT_VOICE_052 = "\cR''I swear I've seen this place before.''";
UTNT_VOICE_053 = "\cR''I've got a bad feeling about this... whatever did\n\cR\this was very powerful...''";
UTNT_COMMON_054 = "Torment And Torture";
UTNT_COMMON_055 = "\cGObjectives:\n";
UTNT_COMMON_056 = "\cR''...damn, that's an evil machine!''";
UTNT_COMMON_057 = "\cCCoop \cGCheckpoint \cCReached";
UTNT_COMMON_058 = "\cCObjective Accomplished:\n\cGYou've killed the Portal Guards";
UTNT_INTERMAP_059 = "\cCHit \cG<use> \cCto skip intermission";
UTNT_INTERMAP_060 = "Slowly you step out\n";
UTNT_INTERMAP_061 = "of the catacombs\n";
UTNT_INTERMAP_062 = "leaving them behind you.\n\n";
UTNT_INTERMAP_063 = "Your hands are blood red\n";
UTNT_INTERMAP_064 = "like sky hanging over you.\n\n";
UTNT_INTERMAP_065 = "You managed to pass the\n";
UTNT_INTERMAP_066 = "outer defence belt of\n";
UTNT_INTERMAP_067 = "this hellish installation\n";
UTNT_INTERMAP_068 = "and got one step closer\n";
UTNT_INTERMAP_069 = "to the dark portal...\n\n";
UTNT_INTERMAP_070 = "you can already smell\n";
UTNT_INTERMAP_071 = "the stench of molten\n";
UTNT_INTERMAP_072 = "steel and incinerated\n";
UTNT_INTERMAP_073 = "flesh...\n\n";
UTNT_INTERMAP_074 = "This has just begun...";
UTNT_INTERMAP_075 = "There is still the tang\n";
UTNT_INTERMAP_076 = "of worked steel hanging\n";
UTNT_INTERMAP_077 = "in the air, but icy storms\n";
UTNT_INTERMAP_078 = "confuse your senses.\n";
UTNT_INTERMAP_079 = "In front of you lies the\n";
UTNT_INTERMAP_080 = "frozen peak of another\n";
UTNT_INTERMAP_081 = "doomed mountain. The only\n";
UTNT_INTERMAP_082 = "path open to you is onward\n";
UTNT_INTERMAP_083 = "towards the Fortress of\n";
UTNT_INTERMAP_084 = "Damnation...\n";
UTNT_INTERMAP_085 = "So keep your weapons warmed\n";
UTNT_INTERMAP_086 = "up and ready to perforate\n";
UTNT_INTERMAP_087 = "cursed souls!\n";
UTNT_INTERMAP_088 = "As you look back over your\n";
UTNT_INTERMAP_089 = "shoulder, you can still see\n";
UTNT_INTERMAP_090 = "the dark silhouette of the\n";
UTNT_INTERMAP_091 = "blasted facilities.\n";
UTNT_INTERMAP_092 = "You thank God that you are\n";
UTNT_INTERMAP_093 = "still alive, because you know\n";
UTNT_INTERMAP_094 = "that none of your comrades\n";
UTNT_INTERMAP_095 = "could have made it through\n";
UTNT_INTERMAP_096 = "this terrible building.\n";
UTNT_INTERMAP_097 = "Suddenly an ear-splitting\n";
UTNT_INTERMAP_098 = "noise grabs your attention\n";
UTNT_INTERMAP_099 = "and you look forward to what\n";
UTNT_INTERMAP_100 = "lies ahead, an evil blasted\n";
UTNT_INTERMAP_101 = "fortress.\n";
UTNT_INTERMAP_102 = "Within it lies the last hell\n";
UTNT_INTERMAP_103 = "portal on earth.\n";
UTNT_INTERMAP_104 = "Soon the reign of terror will\n";
UTNT_INTERMAP_105 = "be over...";
UTNT_INTERMAP_106 = "An unpleasant stench filled\n";
UTNT_INTERMAP_107 = "the air as the last of the\n";
UTNT_INTERMAP_108 = "demonic spiders fell to the\n";
UTNT_INTERMAP_109 = "ground. The portal guards\n";
UTNT_INTERMAP_110 = "failed their duty as your last\n";
UTNT_INTERMAP_111 = "shot pierced their rancid\n";
UTNT_INTERMAP_112 = "corpses.\n";
UTNT_INTERMAP_113 = "The last thing left to do was.\n";
UTNT_INTERMAP_114 = "to destroy the final hell gate\n";
UTNT_INTERMAP_115 = "on earth to prevent new demons\n";
UTNT_INTERMAP_116 = "from haunting your homeworld.\n";
UTNT_INTERMAP_117 = "As you stood in front of the\n";
UTNT_INTERMAP_118 = "portal, recharging your rocket\n";
UTNT_INTERMAP_119 = "launcher, you hesitated for one\n";
UTNT_INTERMAP_120 = "short moment... you couldn't.\n";
UTNT_INTERMAP_121 = "destroy the gate, something was\n";
UTNT_INTERMAP_122 = "pulling you into this black void...\n";
UTNT_INTERMAP_123 = "maybe it was just curiosity,\n";
UTNT_INTERMAP_124 = "maybe a superhuman power... you\n";
UTNT_INTERMAP_125 = "couldn't resist any longer and\n";
UTNT_INTERMAP_126 = "followed the nothingness...\n";
UTNT_INTERMAP_127 = "your mission seemed to be\n";
UTNT_INTERMAP_128 = "a failure...\n";
UTNT_INTERMAP_129 = "You feel the powerful\n";
UTNT_INTERMAP_130 = "maelstrom pulling you into\n";
UTNT_INTERMAP_131 = "the black void in front of\n";
UTNT_INTERMAP_132 = "you.\n";
UTNT_INTERMAP_133 = "Slowly the screams and cries\n";
UTNT_INTERMAP_134 = "of your dying comrades fade\n";
UTNT_INTERMAP_135 = "into silence, along with the\n";
UTNT_INTERMAP_136 = "light behind you...\n";
UTNT_INTERMAP_137 = "Thoughts are merging with each\n";
UTNT_INTERMAP_138 = "other as you travel through.\n";
UTNT_INTERMAP_139 = "thousands of dimensions,\n";
UTNT_INTERMAP_140 = "straight towards the center\n";
UTNT_INTERMAP_141 = "of all evil...\n";
UTNT_INTERMAP_142 = "Your vision turns red as\n";
UTNT_INTERMAP_143 = "you lose consciousness.\n";
UTNT_INTERMAP_144 = "Seconds turn into weeks\n";
UTNT_INTERMAP_145 = "and hours into centuries.\n";
UTNT_INTERMAP_146 = "Time and Space blur around\n";
UTNT_INTERMAP_147 = "you, and you are paralyzed\n";
UTNT_INTERMAP_148 = "in this never ending process.\n";
UTNT_INTERMAP_149 = "You can feel that the source\n";
UTNT_INTERMAP_150 = "is coming closer, it can\n";
UTNT_INTERMAP_151 = "almost touch you,\n";
UTNT_INTERMAP_152 = "it is here...\n";
UTNT_INTERMAP_153 = "Smoke takes to the sky out\n";
UTNT_INTERMAP_154 = "of the dark abyss in front\n";
UTNT_INTERMAP_155 = "of you what was the throat\n";
UTNT_INTERMAP_156 = "of foul and vicious bastards\n";
UTNT_INTERMAP_157 = "whose only aim was to kill you\n";
UTNT_INTERMAP_158 = "and all of your race...\n";
UTNT_INTERMAP_159 = "But it's over, the source is\n";
UTNT_INTERMAP_160 = "destroyed and the origin of\n";
UTNT_INTERMAP_161 = "all evil that haunted earth\n";
UTNT_INTERMAP_162 = "is sealed...\n";
UTNT_INTERMAP_163 = "Your mission came to an end\n";
UTNT_INTERMAP_164 = "and it's time to sit down\n";
UTNT_INTERMAP_165 = "and think about the last\n";
UTNT_INTERMAP_166 = "minutes, hours and days...\n";
UTNT_INTERMAP_167 = "time to realise what has\n";
UTNT_INTERMAP_168 = "happened, realise that your\n";
UTNT_INTERMAP_169 = "return is the return of a hero\n";
UTNT_INTERMAP_170 = "that saved all humankind.\n";
UTNT_INTERMAP_171 = "It's a good feeling but right\n";
UTNT_INTERMAP_172 = "now you have no idea about the\n";
UTNT_INTERMAP_173 = "meaning... but this will change\n";
UTNT_INTERMAP_174 = "sometime...";
UTNT_INTERMAP_175 = "You found them. And you\n";
UTNT_INTERMAP_176 = "killed them. You killed \n";
UTNT_INTERMAP_177 = "all of these alien creatures\n";
UTNT_INTERMAP_178 = "before they could take\n";
UTNT_INTERMAP_179 = "control over the destroyed\n";
UTNT_INTERMAP_180 = "dark portal and without the\n";
UTNT_INTERMAP_181 = "core itself, there is no\n";
UTNT_INTERMAP_182 = "chance for anyone else to\n";
UTNT_INTERMAP_183 = "reopen this.\n";
UTNT_INTERMAP_184 = "...but what about you now?\n";
UTNT_INTERMAP_185 = "You are lost, lost in a dead\n";
UTNT_INTERMAP_186 = "end in hell itself with no\n";
UTNT_INTERMAP_187 = "choice but waiting for someone\n";
UTNT_INTERMAP_188 = "to kill you if you won't\n";
UTNT_INTERMAP_189 = "take the favor yourself...\n";
UTNT_INTERMAP_190 = "there is no way back but no\n";
UTNT_INTERMAP_191 = "way through anymore...\n";
UTNT_INTERMAP_192 = "for you it is over\n";
UTNT_INTERMAP_193 = "A true hero is the one whose \n";
UTNT_INTERMAP_194 = "exploits no one will ever\n";
UTNT_INTERMAP_195 = "discover!        -Outer Limits";
UTNT_TNT01_196 = "\cCYou have reached the \cGDungeons of Torment";
