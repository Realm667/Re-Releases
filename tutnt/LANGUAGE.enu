UTNT_TNT03B_282 = "\cCYou can't return without destroying the portal!";
UTNT_TNT03B_283 = "\cGMain Gate \cChas been opened";
UTNT_TNT04A_284 = "\cCObjective Accomplished:\n\cGYou've killed the Masterminds! Pillars have been lowered";
UTNT_TNT04A_285 = "\cGOne \cCmore Mastermind to go";
UTNT_TNT04A_286 = "\cCThere is nothing useful behind this door!";
UTNT_TNT04A_287 = "\cCThere is nothing useful lying behind this path!";
UTNT_TNT04A_288 = "\cCObjective Accomplished:\n\cGYou've got the Plasma Rifle";
UTNT_TNT04B_289 = "\cGWhy does this place feel so damn familiar? ...";
UTNT_TNT04B_290 = "\cGThe pillar is by far too bursted to be readable!";
UTNT_TNT04B_291 = "\cCSequence Complete, Pillars have been lowered!";
UTNT_TNT04B_292 = "\cGOne \cCmore to go";
UTNT_TNT04B_293 = "\cCBeyond lies \cGThe Edge of Chaos\n\cCTurn around now, or burn in hell for all eternity!";
UTNT_TNT04B_294 = "\cCDoor to the \cGBorderworld Command \cChas been opened!";
UTNT_TNT04B_295 = "\cGSwitch module configurated, system accessable!";
UTNT_TNT04B_296 = "\cGThe switch module is missing, I can't use that!";
UTNT_TNT04B_297 = "\cGYou found the Missing Switch Module!";
UTNT_TNT04B_298 = "\cCThis door is opened remotely!!";
UTNT_TNT04B_299 = "\cCSequence Complete, Pillars have been lowered!";
UTNT_TNT04B_300 = "\cGOne \cCmore to go";
UTNT_TNT04B_301 = "\cCThis door can't be opened";
UTNT_TNT04B_302 = "\cCPillars to the \cGHell Frontier Portal \cChave been lowered!";
UTNT_TNT04B_303 = "\cGOne \cCmore to go";
UTNT_TNT04B_304 = "\cCObjective Accomplished:\n\cGYou've found the BFG9000";
UTNT_TNT04B_305 = "\cCObjective Accomplished:\n\cGYou've reached the Edge of Chaos";
UTNT_TNT04B_306 = "\cCAlternative Ending \cGActivated";
UTNT_TNT04B_307 = "\cCYou found the Secret \cGAlternate Ending \cCPassage \n\cCto the Episode 4 \cGDirector's Cut";
UTNT_TNT04C_308 = "\cCElevator to \cGLevel 2 \cCaccessable";
UTNT_TNT04C_309 = "\cG";
UTNT_TNT04C_310 = " \cCmore to go";
UTNT_TNT04C_311 = "\cCThis Switch is broken";
UTNT_TNT04C_312 = "\cCElevator to \cGLevel 3 \cCaccessable";
UTNT_TNT04C_313 = "\cG";
UTNT_TNT04C_314 = " \cCmore to go";
UTNT_TNT04C_315 = "\cCElevator to \cGLevel 4 \cCaccessable";
UTNT_TNT04C_316 = "\cG";
UTNT_TNT04C_317 = " \cCmore to go";
UTNT_TNT04CN_318 = "\cGBouncy, \cCcouldn't bounce fast enough and got caught\n\cCby a jitter skull in the forest.";
UTNT_TNT04CN_319 = "\cGCutman, \cClost while investigating the open murder\n\cCof Bouncy and other bounty hunters.";
UTNT_TNT04CN_320 = "\cGDoomDude, \cCdied in solitude while fighting for keeping\n\cCNewDoom alive... alone.";
UTNT_TNT04CN_321 = "\cGEnjay, \cCplaceholder for his new home if he continues\n\cCteasing us with Aspects screenshots.";
UTNT_TNT04CN_322 = "\cGEriance, \cCeaten by his latest monster creations.";
UTNT_TNT04CN_323 = "\cGHirogen2, \cCchopped after being evenhanded one time\n\cCtoo often.";
UTNT_TNT04CN_324 = "\cGKeksdose, \cCblinded and burned by his own evil creations";
UTNT_TNT04CN_325 = "\cGPhobus, \cCdied the ZDoom Forum Moderator death by\n\cCthe banned community fraction sword";
UTNT_TNT04CN_326 = "\cGRandy, \cCfell during battle on the fields of azeroth,\n\cCmay the light be with him.";
UTNT_TNT04CN_327 = "\cGScuba Steve, \cCambushed by a group of action fanatics,\n\cClooking for sequels.";
UTNT_TNT04CN_328 = "\cGSolarsnowfall, \cCaccused of witchcraft and fated to die after\n\cCreproducing natural phenomenons with his hands.";
UTNT_TNT04CN_329 = "\cGTheDarkArchon, \cCscared to death by YureiodfuoidguosdfiuogiARGH!!!";
UTNT_TNT04CN_330 = "\cGVader, \cCdisappeared after having more\n\cCdetail in his maps than Tormentor667.";
UTNT_TNT04CN_331 = "\cGGraf Zahl, \cCplanned to stop working on GZDoom,\n\cCnever heard of him again...";
UTNT_TNTLE_332 = "\cCYou must deactivate the forcefield elsewhere!";
UTNT_TNTLE_333 = "\cCThis Door is opened elsewhere!";
UTNT_TNTLE_334 = "\cGOMG, it's advertisement spam!!!!";
UTNT_TNTLE_335 = "\cCShoot the main powercore to deactivate the forcefield!";
UTNT_TNTLE_336 = "\cCSieg Heil and Fette Beute, Adolf is dead!";
UTNT_TNTLE_337 = "\cCPowercore Offline. Forcefield should be deactivated!";
UTNT_TNTLE_338 = " monsters left";
UTNT_TNTLE_339 = "\cCWell done, but do you think that was all?";
UTNT_TNTLE_340 = " monsters left";
UTNT_TNTLE_341 = "\cCOk, for now, you can leave this arena...";
UTNT_TNTLE_342 = "\cCThis Door is opened elsewhere!";
UTNT_TNTLE_343 = "\cCThis Door Can Only Be Opened Remotely";
UTNT_TNTLE_344 = "\cGOMG, it's the DopeFish's lair of terror and death!!!";
UTNT_TNTLE_345 = "\cCThis Door leads to a secret, so why should you be able to just open it by using it?";
UTNT_TNTLE_346 = "\cG...I swear, I have seen this place before...";
UTNT_TNTLE_347 = "\cCThis Door is Broken!";
UTNT_TNTLE_348 = "\cCThis Door can't be opened!";
UTNT_TNTLE_349 = "\cGSomething tells me that I shouldn't touch this switch...";
UTNT_TNTLE_350 = "\cGOkay, looks like I am done here!";
UTNT_TNTLE_351 = "\cGIt's a solid wall, it most likely won't do something upon touching!";
UTNT_TNTLE_352 = "\cCFacing \cGFirst \cCof Six Battles";
UTNT_TNTLE_353 = "\cCFacing \cGSecond \cCof Six Battles";
UTNT_TNTLE_354 = "\cCFacing \cGThird \cCof Six Battles";
UTNT_TNTLE_355 = "\cCFacing \cGFourth \cCof Six Battles";
UTNT_TNTLE_356 = "\cCFacing \cGFifth \cCof Six Battles";
UTNT_TNTLE_357 = "\cCFacing the \cGFinal \cCBattle";
UTNT_TNTLE_358 = "\cCTeleporter Accessable!";
