Material Texture "UPORTAL"
{
    Shader "shaders/portal.fp"
    Texture flowField "materials/portal/flow.png"
    Texture runeAtlas "UTRUNES"
    Texture hellCurtain "materials/portal/hell-curtain.png"
    Speed 1.0
}

// Scene pass: directional pull before the HUD is composited.
HardwareShader PostProcess scene
{
    Name "UTNTPortalSuction"
    Shader "shaders/portal-suction.fp" 330
    Uniform float amount
    Uniform float phase
    Uniform vec2 focus
}
Material Texture "UPRMA0" { Shader "shaders/portal-ember.fp" }
Material Texture "UTRAA0" { Shader "shaders/ritual-rune.fp" }
Material Texture "UTRBA0" { Shader "shaders/ritual-rune.fp" }
Material Texture "UTRCA0" { Shader "shaders/ritual-rune.fp" }
Material Texture "UTRDA0" { Shader "shaders/ritual-rune.fp" }
Material Texture "UTPSEAL" { Shader "shaders/ritual-pad.fp" Texture runeAtlas "UTRUNES" }
Material Texture "QRUNT62" { Shader "shaders/ritual-stone.fp" }
Material Texture "QRUNT63" { Shader "shaders/ritual-stone.fp" }
Material Texture "QSLIP1" { Shader "shaders/ritual-stone.fp" }
Material Texture "QSLIP2" { Shader "shaders/ritual-stone.fp" }
Material Texture "QSLIP3" { Shader "shaders/ritual-stone.fp" }
Material Texture "QSLIP4" { Shader "shaders/ritual-stone.fp" }
Material Texture "QSLIP5" { Shader "shaders/ritual-stone.fp" }
pointlight RitualFlicker1 { color 1.0 0.39 0.035 size 20 Attenuate 1 }
pointlight RitualFlicker2 { color 1.0 0.39 0.035 size 28 Attenuate 1 }
pointlight RitualFlicker3 { color 1.0 0.39 0.035 size 36 Attenuate 1 }
pointlight RitualFlicker4 { color 1.0 0.39 0.035 size 44 Attenuate 1 }
pointlight RitualFlicker5 { color 1.0 0.39 0.035 size 52 Attenuate 1 }
pointlight RitualFlicker6 { color 1.0 0.39 0.035 size 60 Attenuate 1 }
pointlight RitualFlicker7 { color 1.0 0.39 0.035 size 68 Attenuate 1 }
pointlight RitualFlicker8 { color 1.0 0.39 0.035 size 76 Attenuate 1 }
pointlight RitualFlicker9 { color 1.0 0.39 0.035 size 84 Attenuate 1 }
