//HeatEffect shader
HardwareShader PostProcess scene
{
	Name "heatshader"
	Shader "shaders/heat.fp" 330
	Uniform float amount
}

//MotionBlur shader
HardwareShader PostProcess beforebloom
{
	Name "motionblur"
	Shader "shaders/mblur.fp" 330
	Uniform vec2 steps
	Uniform int samples
	Uniform float increment
	Uniform int blendmode
}

//Underwater shader
HardwareShader PostProcess scene
{
	Name "watershader"
	Shader "shaders/waterpp.frag" 330
	Uniform float waterFactor
}



//Rotating effects not defined yet
// Timed class abilities: world edges only, before HUD composition.
HardwareShader PostProcess beforebloom
{
    Name "utnt_ability_edges"
    Shader "shaders/ability-edges.fp" 330
    Texture armorTexture "graphics/fonts/STBAR.lmp"
    Uniform vec3 signalColor
    Uniform int abilityMode
    Uniform float pulse
    Uniform float strength
    Uniform float distortion
}
